# Wynxer configuration.
#
# Format: one key = value pair per line. Lines starting with '#' are comments.
# Values may contain '\n' escapes for multi-line text and {0}/{1} placeholders
# that the caller substitutes. The shell falls back to the compiled-in copy of
# this file when it cannot be found next to the executable.

name = Wynxer
version = 0.1.0

# --- Version output ----------------------------------------------------------
version.line = Wynxer {0}

# --- CLI error messages ------------------------------------------------------
error.file_not_found = wynxer: file not found: '{0}'
error.could_not_read = wynxer: could not read '{0}': {1}
error.requires_one_file = wynxer: {0} requires exactly one file argument
error.build_failed = wynxer: build failed: {0}
error.parse_failed = wynxer: parse failed: {0}
error.unknown_element = wynxer: unknown element kind '{0}'
error.missing_entry = wynxer: no entry page found (expected index.wpf)

# --- CLI status messages -----------------------------------------------------
status.build_ok = Built: {0}
status.check_ok = Check passed: {0}
status.serve_ok = Serving {0} on port {1}

# --- Warning messages --------------------------------------------------------
# unused_variable: emitted when a local is declared but never read.
warning.unused_variable = variable '{0}' is declared but never read
