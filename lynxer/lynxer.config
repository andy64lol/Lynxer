# Lynxer configuration.
#
# Format: one key = value pair per line. Lines starting with '#' are comments.
# Values may contain '\n' escapes for multi-line text and {0}/{1} placeholders
# that the caller substitutes. The shell falls back to the compiled-in copy of
# this file when it cannot be found next to the executable.

name = Lynxer
version = 0.1.8.1

# --- Version output ----------------------------------------------------------
version.line = Lynxer {0}

# --- CLI error messages ------------------------------------------------------
error.file_not_found = lynxer: file not found: '{0}'
error.could_not_read = lynxer: could not read '{0}': {1}
error.requires_one_file = lynxer: {0} requires exactly one file argument
error.compile_usage = lynxer: --compile requires a .lynx file, optionally followed by --include <file> inputs and an output name
error.compile_failed = lynxer: compile failed: {0}
error.payload_invalid = lynxer: the embedded program payload is invalid
error.bytecode_removed = lynxer: bytecode files are no longer supported; compile the .lynx source with --compile instead
error.interpreter_failure = lynxer: interpreter failure in '{0}': {1}
error.validator_missing = lynxer: comprehensive validator is not available

# --- CLI status messages -----------------------------------------------------
status.lint_ok = Lint OK: {0}
status.compile_ok = Compiled: {0}
status.bundle_ok = Bundled: {0}

# --- Warning messages --------------------------------------------------------
# forever_no_break: emitted when a forever() body contains no break.
warning.forever_no_break = forever() has no break; it will run until the process is stopped. Add break; or call suppressForeverWarning() in global setup(){}.
