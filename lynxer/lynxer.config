# Lynxer configuration.
#
# Format: one key = value pair per line. Lines starting with '#' are comments.
# Values may contain '\n' escapes for multi-line text and {0}/{1} placeholders
# that the caller substitutes. The shell falls back to the compiled-in copy of
# this file when it cannot be found next to the executable.

name = Lynxer
version = 0.1.9b3

# --- Version output ----------------------------------------------------------
version.line = Lynxer {0}

# --- CLI error messages ------------------------------------------------------
error.file_not_found = lynxer: file not found: '{0}'
error.could_not_read = lynxer: could not read '{0}': {1}
error.requires_one_file = lynxer: {0} requires exactly one file argument
error.compile_usage = lynxer: --compile requires a .lynx file, optionally followed by --include <file> inputs and an output name
error.compile_failed = lynxer: compile failed: {0}
error.payload_invalid = lynxer: the embedded program payload is invalid
error.bytecode_removed = lynxer: bytecode files are no longer supported; compile the .lynx source with --compile instead
error.interpreter_failure = lynxer: interpreter failure in '{0}': {1}
error.validator_missing = lynxer: comprehensive validator is not available

# --- CLI argument and project messages --------------------------------------
# These used to be hard-coded in shell.cpp. {0}/{1} are filled by the caller;
# edit them here to rebrand or translate the interpreter without recompiling.
error.emit_library_failed = lynxer: emit-library failed: {0}
error.removed_flag = lynxer: '{0}' was removed with the bytecode backend
status.use_instead = ; use {0} instead
error.requires_name = lynxer: {0} requires a name
error.output_given_twice = lynxer: the output name was given twice
error.requires_file = lynxer: {0} requires a file
error.unexpected_extra_argument = lynxer: unexpected extra argument '{0}'
error.first_input_not_lynx = lynxer: the first input must be a .lynx program file
error.could_not_write = lynxer: could not write '{0}'
error.invalid_project_name = lynxer: invalid project name '{0}'
error.could_not_create_dir = lynxer: cannot create {0}/: {1}
error.project_no_entry = lynxer: lynxer.config has no 'entry' key (expected e.g. 'entry = src/main.lynx')
error.project_entry_not_found = lynxer: project entry not found: '{0}'
error.could_not_run_output = lynxer: could not run '{0}'
error.nothing_to_uninstall = lynxer: nothing to uninstall under {0}
error.retry_permission = lynxer: re-run with permission to write {0}
error.install_failed = lynxer: install failed: {0}
error.could_not_remove = lynxer: could not remove {0}: {1}
error.requires_source_file = lynxer: {0} requires a source file
error.runtime_requires_path = lynxer: --runtime requires a library path
error.cc_requires_command = lynxer: --cc requires a compiler command

# --- CLI status messages -----------------------------------------------------
status.lint_ok = Lint OK: {0}
status.compile_ok = Compiled: {0}

# --- Warning messages --------------------------------------------------------
# forever_no_break: emitted when a forever() body contains no break.
warning.forever_no_break = forever() has no break; it will run until the process is stopped. Add break; or call suppressForeverWarning() in global setup(){}.
