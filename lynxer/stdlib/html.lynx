//// HTML parsing and CSS selector queries, backed by scraper. Documents return JSON trees and selected elements. ////
fn setup(){ importAs("html.so", "nativeHtml"); }
fn htmlParse(str source) -> str { return global.nativeHtml.htmlParse(source); }
fn htmlSelect(str source, str selector) -> str { return global.nativeHtml.htmlSelect(source, selector); }
fn htmlText(str source, str selector) -> str { return global.nativeHtml.htmlText(source, selector); }
fn htmlAttr(str source, str selector, str name) -> str { return global.nativeHtml.htmlAttr(source, selector, name); }
fn main(){}
