////
Clynxer standard library: multiprocessing.
Run shell commands in parallel, backed by the native C++ module
`stdlib/multiprocessing.so`.

Commands run in worker threads (one shell subprocess each) and results are kept
in input order. The Python reference's process-pool variant is an alias here,
since every command already runs in its own process.
////
global setup(){ importAs("multiprocessing.so", "nativeMp"); }

// Read a captured-output handle back into a list of strings.
global _collectOutputs(int handle) -> list {
    list out = listRepeat("", 0);
    int count = global.nativeMp.resultCount(handle);
    int index = 0;
    while(index < count){
        out = listPush(out, global.nativeMp.resultAt(handle, index));
        index = index + 1;
    }
    global.nativeMp.release(handle);
    return out;
}
// Read a captured-exit-code handle back into a list of integers.
global _collectCodes(int handle) -> list {
    list out = listRepeat(0, 0);
    int count = global.nativeMp.resultCount(handle);
    int index = 0;
    while(index < count){
        out = listPush(out, global.nativeMp.codeAt(handle, index));
        index = index + 1;
    }
    global.nativeMp.release(handle);
    return out;
}

// Return the number of CPU cores available, or 1.
global workerCount() -> int { return global.nativeMp.workerCount(); }
// Run commands in parallel; returns a list of stdout strings in input order.
global runParallel(list commands) -> list {
    return _collectOutputs(global.nativeMp.runParallel(listJsonArray(commands)));
}
// Run commands in parallel; returns a list of exit codes.
global runParallelSilent(list commands) -> list {
    return _collectCodes(global.nativeMp.runParallelSilent(listJsonArray(commands)));
}
// Run commands in parallel using the process pool (alias of runParallel).
global runParallelProcess(list commands) -> list {
    return _collectOutputs(global.nativeMp.runParallelProcess(listJsonArray(commands)));
}
// Substitute each item into the "{}" placeholder of a command template and run
// the commands in parallel; returns a list of stdout strings.
global mapShell(str template, list items) -> list {
    return _collectOutputs(global.nativeMp.mapShell(template, listJsonArray(items)));
}
// Alias for mapShell.
global threadMap(str template, list items) -> list {
    return mapShell(template, items);
}

global main(){}
