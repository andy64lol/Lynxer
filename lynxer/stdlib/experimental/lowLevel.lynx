////
Experimental low-level memory API backed by the native C++ `c` Python module.

Addresses are represented as Lynxer integers. Memory is unmanaged: callers are
responsible for freeing allocations and for passing valid addresses and sizes.
////

global setup(){
    importPy(){"c"};
}

global malloc(int size){
    int address = 0;
    rawPy(){
        address = c.malloc(size)
    }
    return address;
}

global calloc(int count, int size){
    int address = 0;
    rawPy(){
        address = c.calloc(count, size)
    }
    return address;
}

global realloc(int address, int size){
    int newAddress = 0;
    rawPy(){
        newAddress = c.realloc(address, size)
    }
    return newAddress;
}

global free(int address){
    rawPy(){
        c.free(address)
    }
}

global memset(int address, int value, int size){
    rawPy(){
        c.memset(address, value, size)
    }
}

global memcpy(int destination, int source, int size){
    rawPy(){
        c.memcpy(destination, source, size)
    }
}

global readByte(int address, int offset){
    int value = 0;
    rawPy(){
        value = c.readByte(address, offset)
    }
    return value;
}

global writeByte(int address, int offset, int value){
    rawPy(){
        c.writeByte(address, offset, value)
    }
}

global readInt8(int address, int offset){
    int value = 0;
    rawPy(){ value = c.readInt8(address, offset) }
    return value;
}

global writeInt8(int address, int offset, int value){
    rawPy(){ c.writeInt8(address, offset, value) }
}

global readInt16(int address, int offset){
    int value = 0;
    rawPy(){ value = c.readInt16(address, offset) }
    return value;
}

global writeInt16(int address, int offset, int value){
    rawPy(){ c.writeInt16(address, offset, value) }
}

global readInt32(int address, int offset){
    int value = 0;
    rawPy(){ value = c.readInt32(address, offset) }
    return value;
}

global writeInt32(int address, int offset, int value){
    rawPy(){ c.writeInt32(address, offset, value) }
}

global readInt64(int address, int offset){
    int value = 0;
    rawPy(){ value = c.readInt64(address, offset) }
    return value;
}

global writeInt64(int address, int offset, int value){
    rawPy(){ c.writeInt64(address, offset, value) }
}

global readUInt8(int address, int offset){
    int value = 0;
    rawPy(){ value = c.readUInt8(address, offset) }
    return value;
}

global writeUInt8(int address, int offset, int value){
    rawPy(){ c.writeUInt8(address, offset, value) }
}

global readUInt16(int address, int offset){
    int value = 0;
    rawPy(){ value = c.readUInt16(address, offset) }
    return value;
}

global writeUInt16(int address, int offset, int value){
    rawPy(){ c.writeUInt16(address, offset, value) }
}

global readUInt32(int address, int offset){
    int value = 0;
    rawPy(){ value = c.readUInt32(address, offset) }
    return value;
}

global writeUInt32(int address, int offset, int value){
    rawPy(){ c.writeUInt32(address, offset, value) }
}

global readUInt64(int address, int offset){
    int value = 0;
    rawPy(){ value = c.readUInt64(address, offset) }
    return value;
}

global writeUInt64(int address, int offset, int value){
    rawPy(){ c.writeUInt64(address, offset, value) }
}

global readFloat32(int address, int offset){
    float value = 0.0;
    rawPy(){ value = c.readFloat32(address, offset) }
    return value;
}

global writeFloat32(int address, int offset, float value){
    rawPy(){ c.writeFloat32(address, offset, value) }
}

global readFloat64(int address, int offset){
    float value = 0.0;
    rawPy(){ value = c.readFloat64(address, offset) }
    return value;
}

global writeFloat64(int address, int offset, float value){
    rawPy(){ c.writeFloat64(address, offset, value) }
}

global sizeof(str typeName){
    int size = 0;
    rawPy(){
        size = c.sizeof(typeName)
    }
    return size;
}
