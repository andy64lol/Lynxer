}

fn getStdHandle(any arg0) {
    requireArchitecture("arm64");
    any result = nativeWinApi.call("getStdHandle", [arg0]);
    str error = nativeWinApi.lastError();
    if (error isnt "") {
        raise("winAPI.getStdHandle() failed: " + error);
    }
    return result;
}

