////
Windows arm64 native standard library. The module name selects the process architecture.
Typed `HANDLE`, `HWND` and `SOCKET` helpers are available alongside the
backward-compatible integer-returning functions.
////

fn setup() {
    importAs("winapi_native.so", "nativeWinApi");
}

fn architecture() -> str {
    return nativeWinApi.architecture();
}

fn requireArchitecture(str expected) {
    str actual = nativeWinApi.architecture();
    if (actual isnt expected) {
        raise("winAPI-" + expected + " requires a Windows " + expected +
              " runtime; this process is " + actual);
    }
}

class HANDLE {
    int raw;

    fn init(int value) {
        this.raw = value;
    }
}

class HWND {
    int raw;

    fn init(int value) {
        this.raw = value;
    }
}

class SOCKET {
    int raw;

    fn init(int value) {
        this.raw = value;
    }
}

fn asHANDLE(int value) {
    if (value is -1) {
        return none;
    }
    return new HANDLE(value);
}

fn asHWND(int value) {
    if (value is -1) {
        return none;
    }
    return new HWND(value);
}

fn asSOCKET(int value) {
    if (value is -1) {
        return none;
    }
    return new SOCKET(value);
}

fn handleValue(any value) {
    if (returnType(value) is "HANDLE") {
        return value.raw;
    }
    if (returnType(value) is "int") {
        return value;
    }
    raise("expected a HANDLE or integer handle");
}

fn windowValue(any value) {
    if (returnType(value) is "HWND") {
        return value.raw;
    }
    if (returnType(value) is "int") {
        return value;
    }
    raise("expected an HWND or integer handle");
}

fn socketValue(any value) {
    if (returnType(value) is "SOCKET") {
        return value.raw;
    }
    if (returnType(value) is "int") {
        return value;
    }
    raise("expected a SOCKET or integer socket");
}

fn getProcessId() {
    requireArchitecture("arm64");
    any result = nativeWinApi.call("getProcessId", []);
    str error = nativeWinApi.lastError();
    if (error isnt "") {
        raise("winAPI.getProcessId() failed: " + error);
    }
    return result;
}

