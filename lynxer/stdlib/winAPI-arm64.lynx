fn createFileHandle(str path, str mode) {
    return asHANDLE(createFile(path, mode));
}

fn currentProcessHandle() {
    return asHANDLE(getCurrentProcess());
}

fn moduleHandle(str name) {
    return asHANDLE(getModuleHandle(name));
}

fn createNamedPipeHandle(str name) {
    return asHANDLE(createNamedPipe(name));
}

fn openNamedPipeHandle(str name) {
    return asHANDLE(openNamedPipe(name));
}

fn openProcessHandle(int processId) {
    return asHANDLE(openProcess(processId));
}

fn createProcessHandle(str commandLine) {
    return asHANDLE(createProcess(commandLine));
}

fn standardHandle(str stream) {
    return asHANDLE(getStdHandle(stream));
}

fn consoleWindowHandle() {
    return asHWND(getConsoleWindow());
}

fn connectSocket(str host, int port) {
    return asSOCKET(tcpConnect(host, port));
}

fn listenSocket(str host, int port) {
    return asSOCKET(tcpListen(host, port));
}

fn acceptSocket(any socket) {
    return asSOCKET(tcpAccept(socketValue(socket)));
}
