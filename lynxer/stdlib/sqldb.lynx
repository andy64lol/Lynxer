////
Lynxer standard library: sqldb.
SQLite database module backed by Rust (`rusqlite`), exposed through the native module `stdlib/sqldb.so`.
Requires a Rust toolchain to build (see `rust/sqldb`); the module is skipped when `cargo` is unavailable.
////

fn setup(){ importAs("sqldb.so", "nativeSqlDb"); }

// Convert the backend's error result into a catchable Lynxer runtime error.
fn checkedResult(str result) -> str {
    if(returnLength(result) >= 7){
        if(substring(result, 0, 7) is "ERROR: "){
            global.raise(substring(result, 7, returnLength(result)));
        }
    }
    return result;
}

// Execute one SQL statement and commit. Raises on database errors.
fn execute(str path, str sql) -> str {
    return checkedResult(global.nativeSqlDb.execute(path, sql));
}

// Execute one parameterized SQL statement. paramsJson must be a JSON array.
fn executeArgs(str path, str sql, str paramsJson) -> str {
    return checkedResult(global.nativeSqlDb.executeArgs(path, sql, paramsJson));
}

// Execute multiple SQL statements and commit them as one transaction.
// Returns "ok" or "ERROR: <message>".
fn script(str path, str sqlScript) -> str {
    return checkedResult(global.nativeSqlDb.script(path, sqlScript));
}

// Query rows and return a JSON array of objects. SQLite BLOB columns are
// represented as {"$bytes":"<base64>"} objects so they remain distinguishable
// from ordinary text and can be supplied back through parameterized calls.
fn query(str path, str sql) -> str {
    return checkedResult(global.nativeSqlDb.query(path, sql));
}

// Parameterized form of query().
fn queryArgs(str path, str sql, str paramsJson) -> str {
    return checkedResult(global.nativeSqlDb.queryArgs(path, sql, paramsJson));
}

// Return the first column of the first row as a string, or "" when absent.
// BLOB values use "bytes:<base64>"; NULL remains the empty string.
fn scalar(str path, str sql) -> str {
    return checkedResult(global.nativeSqlDb.scalar(path, sql));
}

// Parameterized form of scalar().
fn scalarArgs(str path, str sql, str paramsJson) -> str {
    return checkedResult(global.nativeSqlDb.scalarArgs(path, sql, paramsJson));
}

// Execute an insert/update and return SQLite's lastrowid as an integer.
// Returns -1 on error or when SQLite does not provide a row id.
fn lastInsertId(str path, str sql, str paramsJson) -> int {
    return global.nativeSqlDb.lastInsertId(path, sql, paramsJson);
}

// Return whether a table exists in the database.
fn tableExists(str path, str tableName) -> bool {
    return global.nativeSqlDb.tableExists(path, tableName) isnt 0;
}

// Return table names as a JSON array.
fn tables(str path) -> str {
    return checkedResult(global.nativeSqlDb.tables(path));
}

// --- Connection handles ----------------------------------------------------
// Every function above opens a connection, does its work and closes it again.
// To reuse one connection, open it once: the handle stays valid until close(),
// and the *On forms run against it. Handles are integer handles held by the
// backend for the run; close() releases one.

// Open a database and keep the connection open. Returns the handle, or -1 when
// the database cannot be opened.
fn open(str path) -> int { return global.nativeSqlDb.open(path); }

// Close a handle from open(). Returns 1 when the handle was live, else 0.
fn close(int handle) -> int { return global.nativeSqlDb.close(handle); }

// execute() against an open connection.
fn executeOn(int handle, str sql) -> str {
    return checkedResult(global.nativeSqlDb.executeOn(handle, sql));
}

// executeArgs() against an open connection.
fn executeArgsOn(int handle, str sql, str paramsJson) -> str {
    return checkedResult(global.nativeSqlDb.executeArgsOn(handle, sql, paramsJson));
}

// script() against an open connection.
fn scriptOn(int handle, str sqlScript) -> str {
    return checkedResult(global.nativeSqlDb.scriptOn(handle, sqlScript));
}

// query() against an open connection.
fn queryOn(int handle, str sql) -> str {
    return checkedResult(global.nativeSqlDb.queryOn(handle, sql));
}

// queryArgs() against an open connection.
fn queryArgsOn(int handle, str sql, str paramsJson) -> str {
    return checkedResult(global.nativeSqlDb.queryArgsOn(handle, sql, paramsJson));
}

// scalar() against an open connection.
fn scalarOn(int handle, str sql) -> str {
    return checkedResult(global.nativeSqlDb.scalarOn(handle, sql));
}

// scalarArgs() against an open connection.
fn scalarArgsOn(int handle, str sql, str paramsJson) -> str {
    return checkedResult(global.nativeSqlDb.scalarArgsOn(handle, sql, paramsJson));
}

// lastInsertId() against an open connection.
fn lastInsertIdOn(int handle, str sql, str paramsJson) -> int {
    return global.nativeSqlDb.lastInsertIdOn(handle, sql, paramsJson);
}

// tableExists() against an open connection.
fn tableExistsOn(int handle, str tableName) -> bool {
    return global.nativeSqlDb.tableExistsOn(handle, tableName) isnt 0;
}

// tables() against an open connection.
fn tablesOn(int handle) -> str {
    return checkedResult(global.nativeSqlDb.tablesOn(handle));
}