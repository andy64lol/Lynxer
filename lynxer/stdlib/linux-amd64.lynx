////
Linux amd64 syscall standard library. The module name selects the host architecture.
////

fn setup() {
    importAs("syscalls_native.so", "nativeSyscalls");
    if (nativeSyscalls.platform() isnt "linux") {
        raise("linux-amd64 requires a Linux runtime");
    }
    if (nativeSyscalls.architecture() isnt "amd64") {
        raise("linux-amd64 requires a Linux amd64 runtime; this process is " +
              nativeSyscalls.architecture());
    }
}

fn invoke(str name, int count, int a0 = 0, int a1 = 0, int a2 = 0,
          int a3 = 0, int a4 = 0, int a5 = 0) -> int {
    int result = nativeSyscalls.call(name, count, a0, a1, a2, a3, a4, a5);
    if (result is -1) {
        raise(nativeSyscalls.lastError());
    }
    return result;
}

fn syscallGetCurrentDirectory(int buffer, int size) -> int {
    return invoke("syscallGetCurrentDirectory", 2, buffer, size, 0, 0, 0, 0);
}

fn syscallChangeDirectory(int path) -> int {
    return invoke("syscallChangeDirectory", 1, path, 0, 0, 0, 0, 0);
}

fn syscallRead(int fd, int buffer, int count) -> int {
    return invoke("syscallRead", 3, fd, buffer, count, 0, 0, 0);
}

