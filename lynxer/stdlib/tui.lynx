////
Lynxer standard library - tui.
Terminal UI helpers backed by Rust (`ratatui`/`crossterm`), exposed through the native module `stdlib/tui.so`.
Requires a Rust toolchain to build (see `rust/tui`); the module is skipped when `cargo` is unavailable.
////

global setup(){ importAs("tui.so", "nativeTui"); }

// Returns 1 if the backend is available, 0 otherwise.
global tuiExists() -> int { return global.nativeTui.exists(); }

// Returns the backend version, or "" if unavailable.
global tuiVersion() -> str { return global.nativeTui.version(); }

// Prints text with markup support.
global printText(str text) { global.nativeTui.printText(text); }

// Prints text with a Rich style such as "bold green" or "white on blue".
// Markup is disabled so the text is displayed literally.
global printStyled(str text, str style) { global.nativeTui.printStyled(text, style); }

// Renders Markdown to the terminal.
global markdown(str text) { global.nativeTui.markdown(text); }

// Renders a bordered panel. An empty title omits the panel title.
global panel(str text, str title) { global.nativeTui.panel(text, title); }

// Renders a panel with explicit border and content styles.
global panelStyled(str text, str title, str borderStyle, str contentStyle) {
    global.nativeTui.panelStyled(text, title, borderStyle, contentStyle);
}

// Prints a horizontal rule with an optional title.
global rule(str title) { global.nativeTui.rule(title); }

global ruleStyled(str title, str style) { global.nativeTui.ruleStyled(title, style); }

// Pretty-prints a JSON document with Rich syntax highlighting.
global jsonPretty(str jsonText) { global.nativeTui.jsonPretty(jsonText); }

// Syntax-highlight source code using any lexer supported by Pygments.
global printSyntax(str code, str lexer, bool lineNumbers) {
    global.nativeTui.printSyntax(code, lexer, lineNumbers);
}

// Renders a table.
// columnsJson is a JSON array of column names.
// rowsJson is a JSON array of arrays.
global table(str title, str columnsJson, str rowsJson) {
    global.nativeTui.table(title, columnsJson, rowsJson);
}

// Clears the terminal.
global clear() { global.nativeTui.clear(); }

// Reads a line using the terminal input.
global ask(str prompt) -> str { return global.nativeTui.ask(prompt); }

// Reads a yes/no answer. Returns 1 for yes and 0 for no.
global confirm(str prompt) -> bool { return global.nativeTui.confirm(prompt) isnt 0; }

// ── Console configuration ─────────────────────────────────────────────

// Create or replace the shared console.
global init(str colorSystem) { global.nativeTui.init(colorSystem); }

// Configure the shared console width. Returns the applied width.
global setWidth(int width) -> int { return global.nativeTui.setWidth(width); }

global setMarkup(bool enabled) { global.nativeTui.setMarkup(enabled); }
global setEmoji(bool enabled) { global.nativeTui.setEmoji(enabled); }
global setHighlight(bool enabled) { global.nativeTui.setHighlight(enabled); }
global setSoftWrap(bool enabled) { global.nativeTui.setSoftWrap(enabled); }

// Console logging and export.
global consoleLog(str text) { global.nativeTui.consoleLog(text); }
global consoleSaveText(str path) -> str { return global.nativeTui.consoleSaveText(path); }
global consoleSaveHtml(str path) -> str { return global.nativeTui.consoleSaveHtml(path); }

// Markup and styles.
global markupEscape(str text) -> str { return global.nativeTui.markupEscape(text); }
global styleValid(str style) -> bool { return global.nativeTui.styleValid(style) isnt 0; }

global printTextStyle(str text, str style) { global.nativeTui.printTextStyle(text, style); }
global printTextPlain(str text) { global.nativeTui.printTextPlain(text); }
global printPretty(str value) { global.nativeTui.printPretty(value); }
global printColumns(str itemsJson, bool equal, bool expand) { global.nativeTui.printColumns(itemsJson, equal, expand); }
global printAligned(str text, str align, bool pad) { global.nativeTui.printAligned(text, align, pad); }
global printPadded(str text, int top, int right, int bottom, int left) { global.nativeTui.printPadded(text, top, right, bottom, left); }

global printException() {
    global.nativeTui.printException(global.exceptionInfo());
}
global installTraceback(bool showLocals) { global.nativeTui.installTraceback(showLocals); }

// ── Stateful tables ───────────────────────────────────────────────────

global tableCreate(str title) -> int { return global.nativeTui.tableCreate(title); }
global tableAddColumn(int idx, str header, str style) { global.nativeTui.tableAddColumn(idx, header, style); }
global tableAddRow(int idx, str valuesJson) { global.nativeTui.tableAddRow(idx, valuesJson); }
global tableSetCaption(int idx, str caption) { global.nativeTui.tableSetCaption(idx, caption); }
global tableSetHeader(int idx, bool showHeader) { global.nativeTui.tableSetHeader(idx, showHeader); }
global tableSetLines(int idx, bool showLines) { global.nativeTui.tableSetLines(idx, showLines); }
global tableSetBox(int idx, str boxName) { global.nativeTui.tableSetBox(idx, boxName); }
global tableSetExpand(int idx, bool expand) { global.nativeTui.tableSetExpand(idx, expand); }
global tablePrint(int idx) { global.nativeTui.tablePrint(idx); }

// ── Trees ─────────────────────────────────────────────────────────────

global treeCreate(str label) -> int { return global.nativeTui.treeCreate(label); }
global treeAdd(int parentIdx, str label) -> int { return global.nativeTui.treeAdd(parentIdx, label); }
global treePrint(int idx) { global.nativeTui.treePrint(idx); }

// ── Layouts ───────────────────────────────────────────────────────────

global layoutCreate(str name) -> int { return global.nativeTui.layoutCreate(name); }
global layoutSplitRows(int idx, str namesJson) { global.nativeTui.layoutSplitRows(idx, namesJson); }
global layoutSplitColumns(int idx, str namesJson) { global.nativeTui.layoutSplitColumns(idx, namesJson); }
global layoutUpdate(int idx, str name, str text) { global.nativeTui.layoutUpdate(idx, name, text); }
global layoutPanel(int idx, str name, str text, str title) { global.nativeTui.layoutPanel(idx, name, text, title); }
global layoutPrint(int idx) { global.nativeTui.layoutPrint(idx); }

// ── Progress, status, and live displays ──────────────────────────────

global progressStart() -> int { return global.nativeTui.progressStart(); }
global progressAddTask(int idx, str description, float total) -> int {
    return global.nativeTui.progressAddTask(idx, description, total);
}
global progressAdvance(int idx, int taskId, float amount) { global.nativeTui.progressAdvance(idx, taskId, amount); }
global progressUpdate(int idx, int taskId, float completed, float total) { global.nativeTui.progressUpdate(idx, taskId, completed, total); }
global progressStop(int idx) { global.nativeTui.progressStop(idx); }

global statusStart(str text) -> int { return global.nativeTui.statusStart(text); }
global statusUpdate(int idx, str text) { global.nativeTui.statusUpdate(idx, text); }
global statusStop(int idx) { global.nativeTui.statusStop(idx); }

global liveStart(str text, float refreshPerSecond) -> int { return global.nativeTui.liveStart(text, refreshPerSecond); }
global liveUpdate(int idx, str text) { global.nativeTui.liveUpdate(idx, text); }
global livePanel(int idx, str text, str title) { global.nativeTui.livePanel(idx, text, title); }
global liveStop(int idx) { global.nativeTui.liveStop(idx); }

// ── Prompt variants ───────────────────────────────────────────────────

global askPassword(str prompt) -> str { return global.nativeTui.askPassword(prompt); }
global askInt(str prompt) -> int { return global.nativeTui.askInt(prompt); }
global askFloat(str prompt) -> float { return global.nativeTui.askFloat(prompt); }
global askDefault(str prompt, str defaultValue) -> str { return global.nativeTui.askDefault(prompt, defaultValue); }
global confirmDefault(str prompt, bool defaultValue) -> bool {
    return global.nativeTui.confirmDefault(prompt, defaultValue) isnt 0;
}

// ── TUI mode ──────────────────────────────────────────────────────────

global enter() -> int { return global.nativeTui.enter(); }
global exit() -> int { return global.nativeTui.exit(); }

// ── Widgets ───────────────────────────────────────────────────────────

// Renders a bulleted or numbered list from a JSON array of strings.
global list(str itemsJson, str title, bool numbered) { global.nativeTui.list(itemsJson, title, numbered); }

// Renders a row of tabs with one highlighted.
global tabs(str labelsJson, int active) { global.nativeTui.tabs(labelsJson, active); }

// Renders a bar chart from a JSON array of numbers; width/height of 0 auto-size.
global barChart(str title, str dataJson, int width, int height) {
    global.nativeTui.barChart(title, dataJson, width, height);
}

// Renders a sparkline from a JSON array of numbers.
global sparkline(str dataJson) { global.nativeTui.sparkline(dataJson); }

// Renders a month calendar.
global calendar(int year, int month) { global.nativeTui.calendar(year, month); }

// Renders JSON as an indented tree.
global jsonTree(str jsonText) { global.nativeTui.jsonTree(jsonText); }

// Renders a filled gauge for a 0..1 ratio.
global gauge(str label, float ratio, int width) { global.nativeTui.gauge(label, ratio, width); }

// Renders a one-line gauge for a 0..1 ratio.
global lineGauge(str label, float ratio, int width) { global.nativeTui.lineGauge(label, ratio, width); }

// Renders a table parsed from CSV. A multi-cell first row becomes the header.
global tableFromCsv(str title, str csvText) { global.nativeTui.tableFromCsv(title, csvText); }

// ── Terminal control ──────────────────────────────────────────────────

global terminalWidth() -> int { return global.nativeTui.terminalWidth(); }
global terminalHeight() -> int { return global.nativeTui.terminalHeight(); }
global setCursor(int x, int y) { global.nativeTui.setCursor(x, y); }
global moveCursor(int dx, int dy) { global.nativeTui.moveCursor(dx, dy); }
global hideCursor() { global.nativeTui.hideCursor(); }
global showCursor() { global.nativeTui.showCursor(); }
global bell() { global.nativeTui.bell(); }

// ── Input ─────────────────────────────────────────────────────────────

// Reads one key within `timeoutMs`; returns "" on timeout or without a TTY.
global input(int timeoutMs) -> str { return global.nativeTui.input(timeoutMs); }

// True when a key is waiting, within `timeoutMs`.
global pollInput(int timeoutMs) -> bool { return global.nativeTui.pollInput(timeoutMs) isnt 0; }

// ── Selection prompts ─────────────────────────────────────────────────

// Chooses one of the JSON choices; returns the index or -1.
global select(str prompt, str choicesJson) -> int { return global.nativeTui.select(prompt, choicesJson); }

// Chooses several of the JSON choices; returns a JSON array of indices.
global multiselect(str prompt, str choicesJson) -> str { return global.nativeTui.multiselect(prompt, choicesJson); }

// Reads multiple lines until a lone "." or end of input.
global editor(str prompt, str defaultText) -> str { return global.nativeTui.editor(prompt, defaultText); }

// ── Screen and theme ──────────────────────────────────────────────────

global screenStart(str text) { global.nativeTui.screenStart(text); }
global screenUpdate(str text) { global.nativeTui.screenUpdate(text); }
global screenStop() { global.nativeTui.screenStop(); }

// Selects a syntax-highlighting theme; returns true when the name is known.
global theme(str name) -> bool { return global.nativeTui.theme(name) isnt 0; }
global themeNames() -> str { return global.nativeTui.themeNames(); }
global themeName() -> str { return global.nativeTui.themeName(); }
// ── Interactive menu, SVG and images ──────────────────────────────────

// Chooses one of the JSON choices with arrow keys on a terminal, or a typed
// line otherwise. Returns the index, or -1 to cancel.
global menu(str prompt, str choicesJson) -> int { return global.nativeTui.menu(prompt, choicesJson); }

// Saves the recorded output as an SVG. Returns "ok" or "Error: <message>".
global consoleSaveSvg(str path) -> str { return global.nativeTui.consoleSaveSvg(path); }

// Renders an image as half blocks on a color terminal, or a placeholder.
global image(str path, int width, int height) { global.nativeTui.image(path, width, height); }
