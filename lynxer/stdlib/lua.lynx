////
Lynxer standard library: lua.
Embedded Lua 5.4 execution backed by Rust `mlua` with vendored Lua sources.
Lua print output is captured and returned as a string.
////
fn setup(){ importAs("lua.so", "nativeLua"); }

fn runLua(str code) -> str { return global.nativeLua.runLua(code); }
fn runLuaFile(str path) -> str { return global.nativeLua.runLuaFile(path); }
fn evalLua(str expr) -> str { return global.nativeLua.evalLua(expr); }
fn luaVersion() -> str { return global.nativeLua.luaVersion(); }
fn luaExists() -> bool { return global.nativeLua.luaExists() isnt 0; }

fn main(){}