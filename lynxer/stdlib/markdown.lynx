//// Markdown parsing and HTML rendering, backed by pulldown-cmark. ////
fn setup(){ importAs("markdown.so", "nativeMarkdown"); }
fn markdownRender(str source, int extensions = 1) -> str { return global.nativeMarkdown.markdownRender(source, extensions); }
fn markdownParse(str source, int extensions = 1) -> str { return global.nativeMarkdown.markdownParse(source, extensions); }
fn main(){}
