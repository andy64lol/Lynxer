////
Lynxer standard library: text.
Unicode text operations and Lynxer string helpers for searching, replacing and
repetition.
////

fn setup(){ importAs("text.so", "nativeText"); }

fn reverse(str value) -> str {
    str result = "";
    int index = returnLength(value) - 1;
    while(index >= 0){
        result = result + charAt(value, index);
        index = index - 1;
    }
    return result;
}
fn repeat(str value, int count) -> str {
    str result = "";
    int index = 0;
    while(index < count){ result = result + value; index = index + 1; }
    return result;
}
fn trim(str value) -> str { return global.trim(value); }
fn contains(str value, str needle) -> bool {
    if(needle is ""){ return true; }
    int index = 0;
    while(index <= returnLength(value) - returnLength(needle)){
        if(substring(value, index, index + returnLength(needle)) is needle){
            return true;
        }
        index = index + 1;
    }
    return false;
}
fn startsWith(str value, str prefix) -> bool {
    return substring(value, 0, returnLength(prefix)) is prefix;
}
fn endsWith(str value, str suffix) -> bool {
    int start = returnLength(value) - returnLength(suffix);
    if(start < 0){ return false; }
    return substring(value, start, returnLength(value)) is suffix;
}
fn count(str value, str needle) -> int {
    if(needle is ""){ return 0; }
    int total = 0;
    int index = 0;
    while(index <= returnLength(value) - returnLength(needle)){
        if(substring(value, index, index + returnLength(needle)) is needle){
            total = total + 1;
            index = index + returnLength(needle);
        } else { index = index + 1; }
    }
    return total;
}
fn replace(str value, str oldValue, str newValue) -> str {
    return global.replace(value, oldValue, newValue);
}
fn upper(str value) -> str { return global.nativeText.upper(value); }
fn lower(str value) -> str { return global.nativeText.lower(value); }
fn upperAscii(str value) -> str { return global.upper(value); }
fn lowerAscii(str value) -> str { return global.lower(value); }
fn isEmpty(str value) -> bool { return returnLength(value) is 0; }
fn isBlank(str value) -> bool { return returnLength(global.trim(value)) is 0; }

// Space, tab, carriage return and newline. Python's text helpers strip all
// Unicode whitespace; the ASCII set is what Lynxer matches.
fn textIsSpace(str value) -> bool {
    return returnLength(value) is 1 and contains(" \t\n\r", value);
}

// Forwarders to the interpreter's own string builtins, so that
// `global.text.<name>` resolves like the reference module.
fn substring(str value, int start, int end) -> str {
    return global.substring(value, start, end);
}
fn charAt(str value, int index) -> str {
    return global.charAt(value, index);
}
fn split(str value, str separator) -> list {
    return global.splitStr(value, separator);
}
fn join(list parts, str separator) -> str {
    return global.listJoin(parts, separator);
}
fn trimLeft(str value) -> str {
    int index = 0;
    while(index < returnLength(value) and textIsSpace(charAt(value, index))){
        index = index + 1;
    }
    return substring(value, index, returnLength(value));
}
fn trimRight(str value) -> str {
    int end = returnLength(value);
    while(end > 0 and textIsSpace(charAt(value, end - 1))){
        end = end - 1;
    }
    return substring(value, 0, end);
}
fn replaceFirst(str value, str oldValue, str newValue) -> str {
    if(returnLength(oldValue) is 0){ return value; }
    int index = 0;
    while(index <= returnLength(value) - returnLength(oldValue)){
        if(substring(value, index, index + returnLength(oldValue)) is oldValue){
            return substring(value, 0, index) + newValue +
                   substring(value, index + returnLength(oldValue),
                             returnLength(value));
        }
        index = index + 1;
    }
    return value;
}
fn remove(str value, str target) -> str {
    return global.replace(value, target, "");
}
fn capitalize(str value) -> str {
    if(returnLength(value) is 0){ return ""; }
    return upper(charAt(value, 0)) + lower(substring(value, 1, returnLength(value)));
}
fn swapCase(str value) -> str {
    str result = "";
    int index = 0;
    while(index < returnLength(value)){
        str character = charAt(value, index);
        if(lower(character) isnt character){
            result = result + lower(character);
        } elif(upper(character) isnt character){
            result = result + upper(character);
        } else {
            result = result + character;
        }
        index = index + 1;
    }
    return result;
}
fn title(str value) -> str {
    str result = "";
    bool boundary = true;
    int index = 0;
    while(index < returnLength(value)){
        str character = charAt(value, index);
        if(textIsSpace(character)){
            result = result + character;
            boundary = true;
        } elif(boundary){
            result = result + upper(lower(character));
            boundary = false;
        } else {
            result = result + lower(character);
        }
        index = index + 1;
    }
    return result;
}
fn isAlpha(str value) -> bool {
    return global.nativeText.isAlpha(value) isnt 0;
}
fn isNumeric(str value) -> bool {
    return global.nativeText.isNumeric(value) isnt 0;
}
fn isDigit(str value) -> bool { return isNumeric(value); }
fn isAlphaAscii(str value) -> bool {
    if(returnLength(value) is 0){ return false; }
    int index = 0;
    while(index < returnLength(value)){
        str character = charAt(value, index);
        if((character < "a" or character > "z") and
           (character < "A" or character > "Z")){ return false; }
        index = index + 1;
    }
    return true;
}
fn isNumericAscii(str value) -> bool {
    if(returnLength(value) is 0){ return false; }
    int index = 0;
    while(index < returnLength(value)){
        str character = charAt(value, index);
        if(character < "0" or character > "9"){ return false; }
        index = index + 1;
    }
    return true;
}
fn isDigitAscii(str value) -> bool { return isNumericAscii(value); }
fn isAlphaNumeric(str value) -> bool {
    if(returnLength(value) is 0){ return false; }
    int index = 0;
    while(index < returnLength(value)){
        str character = charAt(value, index);
        if(isAlpha(character) is false and isNumeric(character) is false){
            return false;
        }
        index = index + 1;
    }
    return true;
}
fn isAlphaNumericAscii(str value) -> bool {
    if(returnLength(value) is 0){ return false; }
    int index = 0;
    while(index < returnLength(value)){
        str character = charAt(value, index);
        if(isAlphaAscii(character) is false and
           isNumericAscii(character) is false){ return false; }
        index = index + 1;
    }
    return true;
}
fn padLeft(str value, int width, str fill) -> str {
    int missing = width - returnLength(value);
    if(missing <= 0 or returnLength(fill) is 0){ return value; }
    str padding = repeat(fill, missing /% returnLength(fill) + 1);
    return substring(padding, 0, missing) + value;
}
fn padRight(str value, int width, str fill) -> str {
    int missing = width - returnLength(value);
    if(missing <= 0 or returnLength(fill) is 0){ return value; }
    str padding = repeat(fill, missing /% returnLength(fill) + 1);
    return value + substring(padding, 0, missing);
}
fn center(str value, int width, str fill) -> str {
    int margin = width - returnLength(value);
    if(margin <= 0 or returnLength(fill) is 0){ return value; }
    int left = margin /% 2 + (margin % 2) * (width % 2);
    return padLeft("", left, fill) + value + padLeft("", margin - left, fill);
}
fn splitLines(str value) -> list {
    list parts = [];
    str current = "";
    int index = 0;
    while(index < returnLength(value)){
        str character = charAt(value, index);
        if(character is "\n"){
            if(returnLength(current) > 0 and
               charAt(current, returnLength(current) - 1) is "\r"){
                current = substring(current, 0, returnLength(current) - 1);
            }
            parts = listPush(parts, current);
            current = "";
        } else {
            current = current + character;
        }
        index = index + 1;
    }
    if(returnLength(current) > 0){ parts = listPush(parts, current); }
    return parts;
}
fn indent(str value, str prefix) -> str {
    return prefix + global.replace(value, "\n", "\n" + prefix);
}
fn indexOf(str value, str needle) -> int {
    if(returnLength(needle) is 0){ return 0; }
    int index = 0;
    while(index <= returnLength(value) - returnLength(needle)){
        if(substring(value, index, index + returnLength(needle)) is needle){
            return index;
        }
        index = index + 1;
    }
    return -1;
}
fn spaces(int count) -> str { return repeat(" ", count); }
fn zfill(str value, int width) -> str {
    if(returnLength(value) >= width){ return value; }
    str sign = "";
    str digits = value;
    if(returnLength(value) > 0){
        str first = charAt(value, 0);
        if(first is "-" or first is "+"){
            sign = first;
            digits = substring(value, 1, returnLength(value));
        }
    }
    return sign + padLeft(digits, width - returnLength(sign), "0");
}
fn wordWrap(str value, int width) -> str {
    if(width <= 0){ return value; }
    list words = split(value, " ");
    str line = "";
    list lines = [];
    int index = 0;
    while(index < returnLength(words)){
        str word = listGet(words, index);
        if(returnLength(line) is 0){
            line = word;
        } elif(returnLength(line) + 1 + returnLength(word) <= width){
            line = line + " " + word;
        } else {
            lines = listPush(lines, line);
            line = word;
        }
        index = index + 1;
    }
    if(returnLength(line) > 0){ lines = listPush(lines, line); }
    return join(lines, "\n");
}
fn expandTabs(str value, int tabSize) -> str {
    if(tabSize <= 0){ return value; }
    str result = "";
    int column = 0;
    int index = 0;
    while(index < returnLength(value)){
        str character = charAt(value, index);
        if(character is "\t"){
            int needed = tabSize - (column % tabSize);
            result = result + spaces(needed);
            column = column + needed;
        } elif(character is "\n"){
            result = result + character;
            column = 0;
        } else {
            result = result + character;
            column = column + 1;
        }
        index = index + 1;
    }
    return result;
}
fn splitFirst(str value, str separator) -> list {
    if(returnLength(separator) is 0){ return ["", value]; }
    int at = indexOf(value, separator);
    if(at < 0){ return [value, ""]; }
    return [substring(value, 0, at),
            substring(value, at + returnLength(separator), returnLength(value))];
}

fn main(){}
