////
Lynxer standard library: compress.
gzip, zlib, zstd, bzip2, brotli and lz4 streams, plus ZIP and TAR archives, backed by
the Rust crates `flate2`/`zstd`/`bzip2`/`brotli`/`lz4_flex`/`zip`/`tar` and exposed
through the native module `stdlib/compress.so`.

Binary payloads cross the module ABI as `bytes`, so an in-memory
`<codec>Compress` takes `bytes` and returns `bytes`, and its `<codec>Decompress`
does the same — a payload that is not valid UTF-8 is representable. The `*File`
ops work on paths.

Stream ops answer with an empty `bytes` on failure; file and archive ops answer
with the status string `"ok"` / `"ERROR: <message>"`. An archive extract refuses
an entry whose name escapes the destination directory, and an in-memory
decompress is capped at 64 MiB.

Requires a Rust toolchain to build (see `rust/compress`). The `zstd` backend
vendors C sources, so a C compiler is needed as well.
////
fn setup(){ importAs("compress.so", "nativeCompress"); }

// --- gzip ------------------------------------------------------------------

// The gzip stream of `data`.
fn gzipCompress(bytes data) -> bytes { return global.nativeCompress.gzipCompress(data); }
// The payload of a gzip stream, or empty bytes when it is not one.
fn gzipDecompress(bytes data) -> bytes { return global.nativeCompress.gzipDecompress(data); }
// gzip-compress a file's bytes into another file. "ok" or "ERROR: ...".
fn gzipCompressFile(str input, str output) -> str { return global.nativeCompress.gzipCompressFile(input, output); }
// Decompress a gzip file into another file. "ok" or "ERROR: ...".
fn gzipDecompressFile(str input, str output) -> str { return global.nativeCompress.gzipDecompressFile(input, output); }

// --- zlib ------------------------------------------------------------------

fn zlibCompress(bytes data) -> bytes { return global.nativeCompress.zlibCompress(data); }
fn zlibDecompress(bytes data) -> bytes { return global.nativeCompress.zlibDecompress(data); }
fn zlibCompressFile(str input, str output) -> str { return global.nativeCompress.zlibCompressFile(input, output); }
fn zlibDecompressFile(str input, str output) -> str { return global.nativeCompress.zlibDecompressFile(input, output); }

// --- zstd ------------------------------------------------------------------

fn zstdCompress(bytes data) -> bytes { return global.nativeCompress.zstdCompress(data); }
fn zstdDecompress(bytes data) -> bytes { return global.nativeCompress.zstdDecompress(data); }
fn zstdCompressFile(str input, str output) -> str { return global.nativeCompress.zstdCompressFile(input, output); }
fn zstdDecompressFile(str input, str output) -> str { return global.nativeCompress.zstdDecompressFile(input, output); }

// --- bzip2 -----------------------------------------------------------------

fn bzip2Compress(bytes data) -> bytes { return global.nativeCompress.bzip2Compress(data); }
fn bzip2Decompress(bytes data) -> bytes { return global.nativeCompress.bzip2Decompress(data); }
fn bzip2CompressFile(str input, str output) -> str { return global.nativeCompress.bzip2CompressFile(input, output); }
fn bzip2DecompressFile(str input, str output) -> str { return global.nativeCompress.bzip2DecompressFile(input, output); }

// --- brotli ----------------------------------------------------------------

fn brotliCompress(bytes data) -> bytes { return global.nativeCompress.brotliCompress(data); }
fn brotliDecompress(bytes data) -> bytes { return global.nativeCompress.brotliDecompress(data); }
fn brotliCompressFile(str input, str output) -> str { return global.nativeCompress.brotliCompressFile(input, output); }
fn brotliDecompressFile(str input, str output) -> str { return global.nativeCompress.brotliDecompressFile(input, output); }

// --- lz4 -------------------------------------------------------------------

fn lz4Compress(bytes data) -> bytes { return global.nativeCompress.lz4Compress(data); }
fn lz4Decompress(bytes data) -> bytes { return global.nativeCompress.lz4Decompress(data); }
fn lz4CompressFile(str input, str output) -> str { return global.nativeCompress.lz4CompressFile(input, output); }
fn lz4DecompressFile(str input, str output) -> str { return global.nativeCompress.lz4DecompressFile(input, output); }

// --- ZIP archives ----------------------------------------------------------

// Create a ZIP archive from a JSON array of entries. An entry is
// `{"name": "<path in archive>", "path": "<source file>"}` or
// `{"name": "...", "base64": "<inline data>"}`. Entries may also include an optional
// `"password": "..."`, which enables AES-128 encryption for that file. "ok" or "ERROR: ...".
fn zipCreate(str path, str manifest) -> str { return global.nativeCompress.zipCreate(path, manifest); }
// The entry names as a JSON array, or "ERROR: ...".
fn zipList(str path) -> str { return global.nativeCompress.zipList(path); }
// An entry's bytes, or empty bytes when it is absent.
fn zipRead(str path, str entry) -> bytes { return global.nativeCompress.zipRead(path, entry); }
// An entry's bytes with the provided password, or empty bytes when absent/incorrect.
fn zipReadWithPassword(str path, str entry, str password) -> bytes { return global.nativeCompress.zipReadWithPassword(path, entry, password); }
// Extract into a directory, refusing any entry that escapes it. "ok" or "ERROR: ...".
fn zipExtract(str path, str directory) -> str { return global.nativeCompress.zipExtract(path, directory); }
// Extract with a password for any AES-encrypted entries. "ok" or "ERROR: ...".
fn zipExtractWithPassword(str path, str directory, str password) -> str { return global.nativeCompress.zipExtractWithPassword(path, directory, password); }

// --- TAR archives ----------------------------------------------------------

// Create a TAR archive from the same JSON entry manifest as `zipCreate`.
fn tarCreate(str path, str manifest) -> str { return global.nativeCompress.tarCreate(path, manifest); }
// The entry names as a JSON array, or "ERROR: ...".
fn tarList(str path) -> str { return global.nativeCompress.tarList(path); }
// Extract into a directory, refusing any entry that escapes it. "ok" or "ERROR: ...".
fn tarExtract(str path, str directory) -> str { return global.nativeCompress.tarExtract(path, directory); }
// Create a gzip-compressed TAR archive.
fn tarGzCreate(str path, str manifest) -> str { return global.nativeCompress.tarGzCreate(path, manifest); }
// Extract a gzip-compressed TAR archive.
fn tarGzExtract(str path, str directory) -> str { return global.nativeCompress.tarGzExtract(path, directory); }

fn main(){}
