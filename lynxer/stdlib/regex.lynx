////
Lynxer standard library: regex.
Extended regular-expression helpers backed by the Rust module
`stdlib/regex.so` (`rust/regex` over the shared `rust/regex_engine`, built on
`fancy-regex`).

Named patterns are compiled once and cached by name. The Python reference
prefers the third-party `regex` package and falls back to `re`; Lynxer always
uses the `re`-equivalent engine, so `findLetters`/`findDigits` match ASCII
letters/digits and `findallOverlapping` is emulated.
////
fn setup(){ importAs("regex.so", "nativeRegex"); }

// Compile a pattern and store it under name. Flags: any of I, M, S, X
// (case-insensitive, multiline, dotall, verbose).
fn compile(str name, str pattern, str flags) {
    global.nativeRegex.compile(name, pattern, flags);
}
// Use a compiled pattern to test whether it matches string. Returns 1 or 0.
fn testCompiled(str name, str string) -> int {
    return global.nativeRegex.testCompiled(name, string);
}
// Use a compiled pattern to return the first matching substring, or "".
fn matchCompiled(str name, str string) -> str {
    return global.nativeRegex.matchCompiled(name, string);
}
// Use a compiled pattern to return all matches as a JSON array.
fn findallCompiled(str name, str string) -> str {
    return global.nativeRegex.findallCompiled(name, string);
}
// Use a compiled pattern to replace all matches with repl.
fn subCompiled(str name, str repl, str string) -> str {
    return global.nativeRegex.subCompiled(name, repl, string);
}
// Clear the compiled pattern cache.
fn clearCache() { global.nativeRegex.clearCache(); }
// Return the names of all cached patterns as a JSON array.
fn cacheKeys() -> str { return global.nativeRegex.cacheKeys(); }
// Return 1 if pattern is a valid regex, else 0.
fn isValid(str pattern) -> int { return global.nativeRegex.isValid(pattern); }
// Return a JSON object of named groups from the first match, or "{}".
fn extract(str pattern, str string) -> str {
    return global.nativeRegex.extract(pattern, string);
}
// Return a JSON array of objects, one per match, with all named groups.
fn extractAll(str pattern, str string) -> str {
    return global.nativeRegex.extractAll(pattern, string);
}
// Return a JSON array of all unique matches (no duplicates).
fn unique(str pattern, str string) -> str {
    return global.nativeRegex.unique(pattern, string);
}
// Return the last match of pattern in string, or "".
fn lastMatch(str pattern, str string) -> str {
    return global.nativeRegex.lastMatch(pattern, string);
}
// Return all overlapping matches as a JSON array.
fn findallOverlapping(str pattern, str string) -> str {
    return global.nativeRegex.findallOverlapping(pattern, string);
}
// Replace only the n-th occurrence (1-indexed) of pattern with repl.
fn replaceNth(str pattern, str repl, str string, int n) -> str {
    return global.nativeRegex.replaceNth(pattern, repl, string, n);
}
// Replace all occurrences with a literal string (no backreference expansion).
fn replaceAllLiteral(str pattern, str repl, str string) -> str {
    return global.nativeRegex.replaceAllLiteral(pattern, repl, string);
}
// Wrap every match with before and after strings.
fn highlight(str pattern, str before, str after, str string) -> str {
    return global.nativeRegex.highlight(pattern, before, after, string);
}
// Split string by pattern but keep the separators in the result (JSON array).
fn splitKeep(str pattern, str string) -> str {
    return global.nativeRegex.splitKeep(pattern, string);
}
// Return all ASCII letters in string as a JSON array.
fn findLetters(str string) -> str {
    return global.nativeRegex.findLetters(string);
}
// Return all ASCII digit runs in string as a JSON array.
fn findDigits(str string) -> str {
    return global.nativeRegex.findDigits(string);
}
// Convert a glob pattern (*, ?, [abc]) to an equivalent regex string.
fn globToRegex(str glob) -> str {
    return global.nativeRegex.globToRegex(glob);
}
// Return the number of non-overlapping matches.
fn countMatches(str pattern, str string) -> int {
    return global.nativeRegex.countMatches(pattern, string);
}
// Return the number of word runs (\\w+) in string.
fn countWords(str string) -> int {
    return global.nativeRegex.countMatches("\\w+", string);
}
// Return the start index of the first match, or -1.
fn firstMatchPos(str pattern, str string) -> int {
    return global.nativeRegex.firstMatchPos(pattern, string);
}
// Return the Unicode scalar-value index of the first match, or -1.
fn firstMatchCharPos(str pattern, str string) -> int {
    return global.nativeRegex.firstMatchCharPos(pattern, string);
}
// Return a maxLen-character window of string centred on the first match.
fn truncateMatch(str pattern, str string, int maxLen) -> str {
    return global.nativeRegex.truncateMatch(pattern, string, maxLen);
}

fn main(){}
