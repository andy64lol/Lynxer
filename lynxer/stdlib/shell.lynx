////
Shell command helpers backed by the native C++ process API.
////
fn setup(){ importAs("shell.so", "nativeShell"); }
fn runShell(str command) -> int {
    return global.nativeShell.runShell(command);
}
fn runShellCapture(str command) -> str {
    return global.nativeShell.runShellCapture(command);
}
fn runShellSilent(str command) -> int {
    return global.nativeShell.runShellSilent(command);
}
fn commandExists(str command) -> bool {
    return global.nativeShell.commandExists(command) isnt 0;
}
fn checkShell(str shell) -> bool {
    return global.nativeShell.checkShell(shell) isnt 0;
}
fn runShellCode(str command) -> int {
    return global.nativeShell.runShellCode(command);
}
fn runShellAs(str shell, str command) -> int {
    return global.nativeShell.runShellAs(shell, command);
}
fn runShellCaptureAs(str shell, str command) -> str {
    return global.nativeShell.runShellCaptureAs(shell, command);
}
fn currentShell() -> str { return global.nativeShell.currentShell(); }
fn shellPath(str command) -> str {
    return global.nativeShell.shellPath(command);
}
fn runShellErr(str command) -> str {
    return global.nativeShell.runShellErr(command);
}
fn shellVersion(str shell) -> str {
    return global.nativeShell.shellVersion(shell);
}
fn availableShells() -> str { return global.nativeShell.availableShells(); }
fn main(){}
