// Convert to RGBA (adds alpha channel if missing).  Returns new image index.
global toRGBA(int idx){
    int result = 0;
    rawPy(){
        import builtins
        if not hasattr(builtins, "_lx_images"):
            builtins._lx_images = []
        try:
            img = builtins._lx_images[idx].convert("RGBA")
            builtins._lx_images.append(img)
            result = len(builtins._lx_images) - 1
        except Exception:
            result = -1
    }
    return result;
}

// Convert to 1-bit black-and-white.  threshold 0–255 (default 127).
// Returns new image index.
global toBinary(int idx, int threshold){
    int result = 0;
    rawPy(){
        from PIL import ImageOps as _ops
        import builtins
        if not hasattr(builtins, "_lx_images"):
            builtins._lx_images = []
        try:
            gray = builtins._lx_images[idx].convert("L")
            out  = gray.point(lambda p: 255 if p > threshold else 0, "1")
            builtins._lx_images.append(out)
            result = len(builtins._lx_images) - 1
        except Exception:
            result = -1
    }
    return result;
}

// ── Enhance ────────────────────────────────────────────────────────────────

// Adjust brightness.  factor 1.0 = original, 0.0 = black, 2.0 = double.
// Returns new image index.
global brightness(int idx, float factor){
    int result = 0;
    rawPy(){
        from PIL import ImageEnhance as _enh
        import builtins
        if not hasattr(builtins, "_lx_images"):
            builtins._lx_images = []
        try:
            img = _enh.Brightness(builtins._lx_images[idx]).enhance(factor)
            builtins._lx_images.append(img)
            result = len(builtins._lx_images) - 1
        except Exception:
            result = -1
    }
    return result;
}

