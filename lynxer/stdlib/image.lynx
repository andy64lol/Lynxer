////
Lynxer standard library: image.
Image loading, creation, transforms, pixels and encoding backed by Rust's
`image` crate. Image values are integer handles owned by the native module.

The backend supports PNG, JPEG, GIF, BMP, TIFF, WebP, ICO, QOI, TGA, PNM, HDR,
OpenEXR, and farbfeld through the enabled Rust codecs, and rasterises SVG
(`openSvg`). Transform functions return new handles unless documented as
mutating (`setPixel`, `setPixelA`, `fill`, `paste`, and `pasteWithAlpha`).
////
fn setup(){ importAs("image.so", "nativeImage"); }

fn open(str path) -> int { return global.nativeImage.open(path); }

// Rasterise an SVG (or SVGZ) at its intrinsic size.
fn openSvg(str path) -> int { return global.nativeImage.openSvg(path, 0, 0); }
// Rasterise an SVG scaled to fit inside width x height, preserving aspect ratio.
fn openSvgSize(str path, int width, int height) -> int {
    return global.nativeImage.openSvg(path, width, height);
}
fn create(int width, int height, str mode, int r, int g, int b) -> int {
    return global.nativeImage.create(width, height, mode, r, g, b);
}
fn save(int idx, str path) -> bool { return global.nativeImage.save(idx, path) is 0; }
fn saveQuality(int idx, str path, int quality) -> bool {
    return global.nativeImage.saveQuality(idx, path, quality) is 0;
}
fn copy(int idx) -> int { return global.nativeImage.copy(idx); }
fn close(int idx) -> bool { return global.nativeImage.close(idx) is 0; }
fn getWidth(int idx) -> int { return global.nativeImage.getWidth(idx); }
fn getHeight(int idx) -> int { return global.nativeImage.getHeight(idx); }
fn getMode(int idx) -> str { return global.nativeImage.getMode(idx); }
fn getFormat(int idx) -> str { return global.nativeImage.getFormat(idx); }
fn info(int idx) -> str { return global.nativeImage.info(idx); }

fn resize(int idx, int width, int height) -> int {
    return global.nativeImage.resize(idx, width, height);
}
fn thumbnail(int idx, int width, int height) -> int {
    return global.nativeImage.thumbnail(idx, width, height);
}
fn scale(int idx, float factor) -> int {
    return global.nativeImage.scale(idx, factor);
}
fn crop(int idx, int x1, int y1, int x2, int y2) -> int {
    return global.nativeImage.crop(idx, x1, y1, x2, y2);
}
fn rotate(int idx, float angle, bool expand) -> int {
    return global.nativeImage.rotate(idx, angle, expand);
}
fn flipH(int idx) -> int { return global.nativeImage.flipH(idx); }
fn flipV(int idx) -> int { return global.nativeImage.flipV(idx); }
fn pad(int idx, int top, int right, int bottom, int left, int r, int g, int b) -> int {
    return global.nativeImage.pad(idx, top, right, bottom, left, r, g, b);
}

fn convert(int idx, str mode) -> int { return global.nativeImage.convert(idx, mode); }
fn grayscale(int idx) -> int { return global.nativeImage.grayscale(idx); }
fn toRGB(int idx) -> int { return global.nativeImage.toRGB(idx); }
fn toRGBA(int idx) -> int { return global.nativeImage.toRGBA(idx); }
fn toBinary(int idx, int threshold) -> int {
    return global.nativeImage.toBinary(idx, threshold);
}
fn brightness(int idx, float factor) -> int {
    return global.nativeImage.brightness(idx, factor);
}
fn contrast(int idx, float factor) -> int {
    return global.nativeImage.contrast(idx, factor);
}
fn invert(int idx) -> int { return global.nativeImage.invert(idx); }
fn blur(int idx, float radius) -> int { return global.nativeImage.blur(idx, radius); }
fn boxBlur(int idx, float radius) -> int {
    return global.nativeImage.boxBlur(idx, radius);
}
fn unsharpMask(int idx, float radius, int percent, int threshold) -> int {
    return global.nativeImage.unsharpMask(idx, radius, percent, threshold);
}
fn sharpen(int idx) -> int { return global.nativeImage.sharpen(idx); }

fn getPixel(int idx, int x, int y) -> str {
    return global.nativeImage.getPixel(idx, x, y);
}
fn setPixel(int idx, int x, int y, int r, int g, int b) -> bool {
    return global.nativeImage.setPixel(idx, x, y, r, g, b) is 0;
}
fn setPixelA(int idx, int x, int y, int r, int g, int b, int a) -> bool {
    return global.nativeImage.setPixelA(idx, x, y, r, g, b, a) is 0;
}
fn fill(int idx, int r, int g, int b) -> bool {
    return global.nativeImage.fill(idx, r, g, b) is 0;
}
fn paste(int dstIdx, int srcIdx, int x, int y) -> bool {
    return global.nativeImage.paste(dstIdx, srcIdx, x, y) is 0;
}
fn pasteWithAlpha(int dstIdx, int srcIdx, int x, int y) -> bool {
    return global.nativeImage.pasteWithAlpha(dstIdx, srcIdx, x, y) is 0;
}
fn blend(int idx1, int idx2, float alpha) -> int {
    return global.nativeImage.blend(idx1, idx2, alpha);
}
fn addAlpha(int idx) -> int { return global.nativeImage.addAlpha(idx); }
fn setAlpha(int idx, int alpha) -> int {
    return global.nativeImage.setAlpha(idx, alpha);
}
fn removeAlpha(int idx) -> int { return global.nativeImage.removeAlpha(idx); }

fn getAverageColor(int idx) -> str {
    return global.nativeImage.getAverageColor(idx);
}
fn getDominantColor(int idx) -> str {
    return global.nativeImage.getDominantColor(idx);
}
fn getHistogram(int idx) -> str {
    return global.nativeImage.getHistogram(idx);
}
fn tile(int idx, int cols, int rows) -> int {
    return global.nativeImage.tile(idx, cols, rows);
}
fn toBase64(int idx, str format) -> str {
    return global.nativeImage.toBase64(idx, format);
}
fn fromBase64(str value) -> int {
    return global.nativeImage.fromBase64(value);
}
fn toDataUrl(int idx, str format) -> str {
    return global.nativeImage.toDataUrl(idx, format);
}

fn fit(int idx, int width, int height) -> int {
    return global.nativeImage.fit(idx, width, height);
}
fn contain(int idx, int width, int height, int r, int g, int b) -> int {
    return global.nativeImage.contain(idx, width, height, r, g, b);
}
fn color(int idx, float factor) -> int {
    return global.nativeImage.color(idx, factor);
}
fn sharpness(int idx, float factor) -> int {
    return global.nativeImage.sharpness(idx, factor);
}
fn smooth(int idx) -> int { return global.nativeImage.smooth(idx); }
fn detail(int idx) -> int { return global.nativeImage.detail(idx); }
fn edgeEnhance(int idx) -> int { return global.nativeImage.edgeEnhance(idx); }
fn emboss(int idx) -> int { return global.nativeImage.emboss(idx); }
fn findEdges(int idx) -> int { return global.nativeImage.findEdges(idx); }
fn contour(int idx) -> int { return global.nativeImage.contour(idx); }
fn medianFilter(int idx, int size) -> int {
    return global.nativeImage.medianFilter(idx, size);
}
fn minFilter(int idx, int size) -> int {
    return global.nativeImage.minFilter(idx, size);
}
fn maxFilter(int idx, int size) -> int {
    return global.nativeImage.maxFilter(idx, size);
}
fn composite(int baseIdx, int overlayIdx, int maskIdx) -> int {
    return global.nativeImage.composite(baseIdx, overlayIdx, maskIdx);
}
fn autoContrast(int idx) -> int { return global.nativeImage.autoContrast(idx); }
fn equalize(int idx) -> int { return global.nativeImage.equalize(idx); }
fn solarize(int idx, int threshold) -> int {
    return global.nativeImage.solarize(idx, threshold);
}
fn posterize(int idx, int bits) -> int {
    return global.nativeImage.posterize(idx, bits);
}
fn quantize(int idx, int colors) -> int {
    return global.nativeImage.quantize(idx, colors);
