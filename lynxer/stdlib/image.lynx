// Apply a median filter (good for noise removal).  size must be odd.
// Returns new image index.
global medianFilter(int idx, int size){
    int result = 0;
    rawPy(){
        from PIL import ImageFilter as _F
        import builtins
        if not hasattr(builtins, "_lx_images"):
            builtins._lx_images = []
        try:
            s = size if size % 2 == 1 else size + 1
            img = builtins._lx_images[idx].filter(_F.MedianFilter(s))
            builtins._lx_images.append(img)
            result = len(builtins._lx_images) - 1
        except Exception:
            result = -1
    }
    return result;
}

// Apply a minimum (erosion) filter.  Returns new image index.
global minFilter(int idx, int size){
    int result = 0;
