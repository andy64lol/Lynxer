// Invert all pixel values (photo negative).  Returns new image index.
global invert(int idx){
    int result = 0;
    rawPy(){
        from PIL import ImageOps as _ops
        import builtins
        if not hasattr(builtins, "_lx_images"):
            builtins._lx_images = []
        try:
            img = _ops.invert(builtins._lx_images[idx].convert("RGB"))
            builtins._lx_images.append(img)
            result = len(builtins._lx_images) - 1
        except Exception:
            result = -1
    }
    return result;
}

// ── Filter ─────────────────────────────────────────────────────────────────

// Apply a Gaussian blur with radius.  Returns new image index.
global blur(int idx, float radius){
    int result = 0;
    rawPy(){
        from PIL import ImageFilter as _F
        import builtins
        if not hasattr(builtins, "_lx_images"):
            builtins._lx_images = []
        try:
            img = builtins._lx_images[idx].filter(_F.GaussianBlur(radius))
            builtins._lx_images.append(img)
            result = len(builtins._lx_images) - 1
        except Exception:
            result = -1
    }
    return result;
}

// Apply a box blur with radius.  Returns new image index.
global boxBlur(int idx, float radius){
    int result = 0;
    rawPy(){
        from PIL import ImageFilter as _F
        import builtins
        if not hasattr(builtins, "_lx_images"):
            builtins._lx_images = []
        try:
            img = builtins._lx_images[idx].filter(_F.BoxBlur(radius))
            builtins._lx_images.append(img)
            result = len(builtins._lx_images) - 1
        except Exception:
            result = -1
    }
    return result;
}

// Apply unsharp mask (sharpening via blur subtraction).  Returns new image index.
global unsharpMask(int idx, float radius, float percent, int threshold){
    int result = 0;
    rawPy(){
        from PIL import ImageFilter as _F
        import builtins
        if not hasattr(builtins, "_lx_images"):
            builtins._lx_images = []
        try:
            img = builtins._lx_images[idx].filter(
                _F.UnsharpMask(radius=radius, percent=int(percent), threshold=threshold))
            builtins._lx_images.append(img)
            result = len(builtins._lx_images) - 1
        except Exception:
            result = -1
    }
    return result;
}

