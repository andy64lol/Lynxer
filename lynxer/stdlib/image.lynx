fn splitChannels(int idx) -> str { return global.nativeImage.splitChannels(idx); }
fn mergeChannels(int idxR, int idxG, int idxB, int idxA) -> int {
    return global.nativeImage.mergeChannels(idxR, idxG, idxB, idxA);
}
fn drawLine(int idx, int x1, int y1, int x2, int y2, int r, int g, int b, int lineWidth) -> bool {
    return global.nativeImage.drawLine(idx, x1, y1, x2, y2, r, g, b, lineWidth) is 0;
}
fn drawRect(int idx, int x1, int y1, int x2, int y2, int r, int g, int b, bool fill) -> bool {
    return global.nativeImage.drawRect(idx, x1, y1, x2, y2, r, g, b, fill) is 0;
}
fn drawRoundedRect(int idx, int x1, int y1, int x2, int y2, int r, int g, int b, bool fill, int radius) -> bool {
    return global.nativeImage.drawRoundedRect(idx, x1, y1, x2, y2, r, g, b, fill, radius) is 0;
}
fn drawCircle(int idx, int cx, int cy, int radius, int r, int g, int b, bool fill) -> bool {
    return global.nativeImage.drawCircle(idx, cx, cy, radius, r, g, b, fill) is 0;
}
fn drawEllipse(int idx, int x1, int y1, int x2, int y2, int r, int g, int b, bool fill) -> bool {
    return global.nativeImage.drawEllipse(idx, x1, y1, x2, y2, r, g, b, fill) is 0;
}
fn drawPolygon(int idx, str coordsJson, int r, int g, int b) -> bool {
    return global.nativeImage.drawPolygon(idx, coordsJson, r, g, b) is 0;
}
fn drawText(int idx, int x, int y, str text, int r, int g, int b, int size) -> bool {
    return global.nativeImage.drawText(idx, x, y, text, r, g, b, size) is 0;
}
fn drawTextFont(int idx, int x, int y, str text, int r, int g, int b, int size, str fontPath) -> bool {
    return global.nativeImage.drawTextFont(idx, x, y, text, r, g, b, size, fontPath) is 0;
}
fn floodFill(int idx, int x, int y, int r, int g, int b) -> bool {
    return global.nativeImage.floodFill(idx, x, y, r, g, b) is 0;
}
fn show(int idx) -> bool { return global.nativeImage.show(idx) is 0; }

fn main(){}
