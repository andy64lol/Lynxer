            s = size if size % 2 == 1 else size + 1
            img = builtins._lx_images[idx].filter(_F.MinFilter(s))
            builtins._lx_images.append(img)
            result = len(builtins._lx_images) - 1
        except Exception:
            result = -1
    }
    return result;
}

// Apply a maximum (dilation) filter.  Returns new image index.
global maxFilter(int idx, int size){
