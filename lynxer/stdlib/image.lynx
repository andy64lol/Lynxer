////
Lynxer standard library: image.
Image loading, creation, transforms, pixels and encoding backed by Rust's
`image` crate. Image values are integer handles owned by the native module.

The backend supports PNG, JPEG, GIF, BMP, TIFF and WebP through the enabled
Rust codecs. Transform functions return new handles unless documented as
mutating (`setPixel`, `setPixelA`, `fill`, `paste`, and `pasteWithAlpha`).
////
global setup(){ importAs("image.so", "nativeImage"); }

global open(str path) -> int { return global.nativeImage.open(path); }
global create(int width, int height, str mode, int r, int g, int b) -> int {
    return global.nativeImage.create(width, height, mode, r, g, b);
}
global save(int idx, str path) -> bool { return global.nativeImage.save(idx, path) is 0; }
global saveQuality(int idx, str path, int quality) -> bool {
    return global.nativeImage.saveQuality(idx, path, quality) is 0;
}
global copy(int idx) -> int { return global.nativeImage.copy(idx); }
global close(int idx) -> bool { return global.nativeImage.close(idx) is 0; }
global getWidth(int idx) -> int { return global.nativeImage.getWidth(idx); }
global getHeight(int idx) -> int { return global.nativeImage.getHeight(idx); }
global getMode(int idx) -> str { return global.nativeImage.getMode(idx); }
global getFormat(int idx) -> str { return global.nativeImage.getFormat(idx); }
global info(int idx) -> str { return global.nativeImage.info(idx); }

global resize(int idx, int width, int height) -> int {
    return global.nativeImage.resize(idx, width, height);
}
global thumbnail(int idx, int width, int height) -> int {
    return global.nativeImage.thumbnail(idx, width, height);
}
global scale(int idx, float factor) -> int {
    return global.nativeImage.scale(idx, factor);
}
global crop(int idx, int x1, int y1, int x2, int y2) -> int {
    return global.nativeImage.crop(idx, x1, y1, x2, y2);
}
global rotate(int idx, float angle, bool expand) -> int {
    return global.nativeImage.rotate(idx, angle, expand);
}
global flipH(int idx) -> int { return global.nativeImage.flipH(idx); }
global flipV(int idx) -> int { return global.nativeImage.flipV(idx); }
global pad(int idx, int top, int right, int bottom, int left, int r, int g, int b) -> int {
    return global.nativeImage.pad(idx, top, right, bottom, left, r, g, b);
}

global convert(int idx, str mode) -> int { return global.nativeImage.convert(idx, mode); }
global grayscale(int idx) -> int { return global.nativeImage.grayscale(idx); }
global toRGB(int idx) -> int { return global.nativeImage.toRGB(idx); }
global toRGBA(int idx) -> int { return global.nativeImage.toRGBA(idx); }
global toBinary(int idx, int threshold) -> int {
    return global.nativeImage.toBinary(idx, threshold);
}
global brightness(int idx, float factor) -> int {
    return global.nativeImage.brightness(idx, factor);
}
global contrast(int idx, float factor) -> int {
    return global.nativeImage.contrast(idx, factor);
}
global invert(int idx) -> int { return global.nativeImage.invert(idx); }
global blur(int idx, float radius) -> int { return global.nativeImage.blur(idx, radius); }
global boxBlur(int idx, float radius) -> int {
    return global.nativeImage.boxBlur(idx, radius);
}
global unsharpMask(int idx, float radius, int percent, int threshold) -> int {
    return global.nativeImage.unsharpMask(idx, radius, percent, threshold);
}
global sharpen(int idx) -> int { return global.nativeImage.sharpen(idx); }

global getPixel(int idx, int x, int y) -> str {
    return global.nativeImage.getPixel(idx, x, y);
}
global setPixel(int idx, int x, int y, int r, int g, int b) -> bool {
    return global.nativeImage.setPixel(idx, x, y, r, g, b) is 0;
}
global setPixelA(int idx, int x, int y, int r, int g, int b, int a) -> bool {
    return global.nativeImage.setPixelA(idx, x, y, r, g, b, a) is 0;
}
global fill(int idx, int r, int g, int b) -> bool {
    return global.nativeImage.fill(idx, r, g, b) is 0;
}
global paste(int dstIdx, int srcIdx, int x, int y) -> bool {
    return global.nativeImage.paste(dstIdx, srcIdx, x, y) is 0;
}
global pasteWithAlpha(int dstIdx, int srcIdx, int x, int y) -> bool {
    return global.nativeImage.pasteWithAlpha(dstIdx, srcIdx, x, y) is 0;
}
global blend(int idx1, int idx2, float alpha) -> int {
    return global.nativeImage.blend(idx1, idx2, alpha);
}
global addAlpha(int idx) -> int { return global.nativeImage.addAlpha(idx); }
global setAlpha(int idx, int alpha) -> int {
    return global.nativeImage.setAlpha(idx, alpha);
}
global removeAlpha(int idx) -> int { return global.nativeImage.removeAlpha(idx); }

global getAverageColor(int idx) -> str {
    return global.nativeImage.getAverageColor(idx);
}
global getDominantColor(int idx) -> str {
    return global.nativeImage.getDominantColor(idx);
}
global getHistogram(int idx) -> str {
    return global.nativeImage.getHistogram(idx);
}
global tile(int idx, int cols, int rows) -> int {
    return global.nativeImage.tile(idx, cols, rows);
}
global toBase64(int idx, str format) -> str {
    return global.nativeImage.toBase64(idx, format);
}
global fromBase64(str value) -> int {
    return global.nativeImage.fromBase64(value);
}
global toDataUrl(int idx, str format) -> str {
    return global.nativeImage.toDataUrl(idx, format);
}

global fit(int idx, int width, int height) -> int {
    return global.nativeImage.fit(idx, width, height);
}
global contain(int idx, int width, int height, int r, int g, int b) -> int {
    return global.nativeImage.contain(idx, width, height, r, g, b);
}
global color(int idx, float factor) -> int {
    return global.nativeImage.color(idx, factor);
}
global sharpness(int idx, float factor) -> int {
    return global.nativeImage.sharpness(idx, factor);
}
global smooth(int idx) -> int { return global.nativeImage.smooth(idx); }
global detail(int idx) -> int { return global.nativeImage.detail(idx); }
global edgeEnhance(int idx) -> int { return global.nativeImage.edgeEnhance(idx); }
global emboss(int idx) -> int { return global.nativeImage.emboss(idx); }
global findEdges(int idx) -> int { return global.nativeImage.findEdges(idx); }
global contour(int idx) -> int { return global.nativeImage.contour(idx); }
global medianFilter(int idx, int size) -> int {
    return global.nativeImage.medianFilter(idx, size);
}
global minFilter(int idx, int size) -> int {
    return global.nativeImage.minFilter(idx, size);
}
global maxFilter(int idx, int size) -> int {
    return global.nativeImage.maxFilter(idx, size);
}
global composite(int baseIdx, int overlayIdx, int maskIdx) -> int {
    return global.nativeImage.composite(baseIdx, overlayIdx, maskIdx);
}
global autoContrast(int idx) -> int { return global.nativeImage.autoContrast(idx); }
global equalize(int idx) -> int { return global.nativeImage.equalize(idx); }
global solarize(int idx, int threshold) -> int {
    return global.nativeImage.solarize(idx, threshold);
}
global posterize(int idx, int bits) -> int {
    return global.nativeImage.posterize(idx, bits);
}
global quantize(int idx, int colors) -> int {
    return global.nativeImage.quantize(idx, colors);
}
global splitChannels(int idx) -> str { return global.nativeImage.splitChannels(idx); }
global mergeChannels(int idxR, int idxG, int idxB, int idxA) -> int {
    return global.nativeImage.mergeChannels(idxR, idxG, idxB, idxA);
}
global drawLine(int idx, int x1, int y1, int x2, int y2, int r, int g, int b, int lineWidth) -> bool {
    return global.nativeImage.drawLine(idx, x1, y1, x2, y2, r, g, b, lineWidth) is 0;
}
global drawRect(int idx, int x1, int y1, int x2, int y2, int r, int g, int b, bool fill) -> bool {
    return global.nativeImage.drawRect(idx, x1, y1, x2, y2, r, g, b, fill) is 0;
}
global drawRoundedRect(int idx, int x1, int y1, int x2, int y2, int r, int g, int b, bool fill, int radius) -> bool {
    return global.nativeImage.drawRoundedRect(idx, x1, y1, x2, y2, r, g, b, fill, radius) is 0;
}
global drawCircle(int idx, int cx, int cy, int radius, int r, int g, int b, bool fill) -> bool {
    return global.nativeImage.drawCircle(idx, cx, cy, radius, r, g, b, fill) is 0;
}
global drawEllipse(int idx, int x1, int y1, int x2, int y2, int r, int g, int b, bool fill) -> bool {
    return global.nativeImage.drawEllipse(idx, x1, y1, x2, y2, r, g, b, fill) is 0;
}
global drawPolygon(int idx, str coordsJson, int r, int g, int b) -> bool {
    return global.nativeImage.drawPolygon(idx, coordsJson, r, g, b) is 0;
}
global drawText(int idx, int x, int y, str text, int r, int g, int b, int size) -> bool {
    return global.nativeImage.drawText(idx, x, y, text, r, g, b, size) is 0;
}
global drawTextFont(int idx, int x, int y, str text, int r, int g, int b, int size, str fontPath) -> bool {
    return global.nativeImage.drawTextFont(idx, x, y, text, r, g, b, size, fontPath) is 0;
}
global floodFill(int idx, int x, int y, int r, int g, int b) -> bool {
    return global.nativeImage.floodFill(idx, x, y, r, g, b) is 0;
}
global show(int idx) -> bool { return global.nativeImage.show(idx) is 0; }

global main(){}
