////
Lynxer standard library: image.
Image processing helpers using Pillow. Requires Pillow.
////

global setup(){}

// ── Core ───────────────────────────────────────────────────────────────────

// Open an image from path.  Returns image index.
global open(str path){
    int idx = 0;
    rawPy(){
        from PIL import Image as _PIL, builtins as _b
        import builtins
        if not hasattr(builtins, "_lx_images"):
            builtins._lx_images = []
        try:
            img = _PIL.open(path)
            img.load()
            builtins._lx_images.append(img)
            idx = len(builtins._lx_images) - 1
        except Exception:
            idx = -1
    }
    return idx;
}

// Create a new blank image.
// mode: "RGB", "RGBA", "L" (grayscale), "1" (binary).
// Returns image index.
global new(int width, int height, str mode, int r, int g, int b){
    int idx = 0;
    rawPy(){
        from PIL import Image as _PIL
        import builtins
        if not hasattr(builtins, "_lx_images"):
            builtins._lx_images = []
        try:
            if mode in ("L", "1"):
                color = r
            elif mode == "RGBA":
                color = (r, g, b, 255)
            else:
                color = (r, g, b)
            img = _PIL.new(mode, (width, height), color)
            builtins._lx_images.append(img)
            idx = len(builtins._lx_images) - 1
        except Exception:
            idx = -1
    }
    return idx;
}

// Save image at idx to path.
// Format is inferred from the extension (.png, .jpg, .bmp, .gif, …).
global save(int idx, str path){
    rawPy(){
        import builtins
        try:
            builtins._lx_images[idx].save(path)
        except Exception:
            pass
    }
}

// Save image with JPEG quality (1–95).  Use for .jpg files only.
global saveQuality(int idx, str path, int quality){
    rawPy(){
        import builtins
        try:
            builtins._lx_images[idx].save(path, quality=max(1, min(95, quality)))
        except Exception:
            pass
    }
}

// Return a deep copy of image at idx as a new image.
global copy(int idx){
    int result = 0;
    rawPy(){
        import builtins
        if not hasattr(builtins, "_lx_images"):
            builtins._lx_images = []
        try:
            img = builtins._lx_images[idx].copy()
            builtins._lx_images.append(img)
            result = len(builtins._lx_images) - 1
        except Exception:
            result = -1
    }
    return result;
}

// Open the image in the system's default image viewer.
global show(int idx){
    rawPy(){
        import builtins
        try:
            builtins._lx_images[idx].show()
        except Exception:
            pass
    }
}

// Free the image at idx from memory (sets the slot to None).
global close(int idx){
    rawPy(){
        import builtins
        try:
            builtins._lx_images[idx].close()
            builtins._lx_images[idx] = None
        except Exception:
            pass
    }
}

// Return the width of an image in pixels.
global getWidth(int idx){
    int result = 0;
    rawPy(){
        import builtins
        try:
            result = builtins._lx_images[idx].width
        except Exception:
            result = 0
    }
    return result;
}

// Return the height of an image in pixels.
global getHeight(int idx){
    int result = 0;
    rawPy(){
        import builtins
        try:
            result = builtins._lx_images[idx].height
        except Exception:
            result = 0
    }
    return result;
}

// Return the color mode string: "RGB", "RGBA", "L", "P", "1", etc.
global getMode(int idx){
    str result = "";
    rawPy(){
        import builtins
        try:
            result = builtins._lx_images[idx].mode
        except Exception:
            result = ""
    }
    return result;
}

// Return the file format string ("PNG", "JPEG", "GIF", …), or "" if unknown.
global getFormat(int idx){
    str result = "";
    rawPy(){
        import builtins
        try:
            result = builtins._lx_images[idx].format or ""
        except Exception:
            result = ""
    }
    return result;
}

// Return a JSON string with basic image info (width, height, mode, format).
global info(int idx){
    str result = "{}";
    rawPy(){
        import builtins, json as _json
        try:
            img = builtins._lx_images[idx]
            result = _json.dumps({
                "width":  img.width,
                "height": img.height,
                "mode":   img.mode,
                "format": img.format or ""
            })
        except Exception:
            result = "{}"
    }
    return result;
}

// ── Transform ──────────────────────────────────────────────────────────────

// Resize an image to (width, height) using high-quality Lanczos resampling.
// Returns new image index.
global resize(int idx, int width, int height){
    int result = 0;
    rawPy(){
        from PIL import Image as _PIL
        import builtins
        if not hasattr(builtins, "_lx_images"):
            builtins._lx_images = []
        try:
            img = builtins._lx_images[idx].resize((width, height), _PIL.LANCZOS)
            builtins._lx_images.append(img)
            result = len(builtins._lx_images) - 1
        except Exception:
            result = -1
    }
    return result;
}

// Shrink image so it fits within (maxWidth, maxHeight), preserving aspect ratio.
// Returns new image index.
global thumbnail(int idx, int maxWidth, int maxHeight){
    int result = 0;
    rawPy(){
        from PIL import Image as _PIL
        import builtins
        if not hasattr(builtins, "_lx_images"):
            builtins._lx_images = []
        try:
            img = builtins._lx_images[idx].copy()
            img.thumbnail((maxWidth, maxHeight), _PIL.LANCZOS)
            builtins._lx_images.append(img)
            result = len(builtins._lx_images) - 1
        except Exception:
            result = -1
    }
    return result;
}

// Scale image uniformly by a factor (e.g. 0.5 = half size, 2.0 = double).
// Returns new image index.
global scale(int idx, float factor){
    int result = 0;
    rawPy(){
        from PIL import Image as _PIL
        import builtins
        if not hasattr(builtins, "_lx_images"):
            builtins._lx_images = []
        try:
            img = builtins._lx_images[idx]
            nw  = int(img.width  * factor)
            nh  = int(img.height * factor)
            out = img.resize((max(1,nw), max(1,nh)), _PIL.LANCZOS)
            builtins._lx_images.append(out)
            result = len(builtins._lx_images) - 1
        except Exception:
            result = -1
    }
    return result;
}

// Resize image to exactly (width, height), cropping to fill (cover fit).
// Returns new image index.
global fit(int idx, int width, int height){
    int result = 0;
    rawPy(){
        from PIL import ImageOps as _ops
        import builtins
        if not hasattr(builtins, "_lx_images"):
            builtins._lx_images = []
        try:
            out = _ops.fit(builtins._lx_images[idx], (width, height))
            builtins._lx_images.append(out)
            result = len(builtins._lx_images) - 1
        except Exception:
            result = -1
    }
    return result;
}

// Resize image to fit inside (width, height), adding padding to fill the gap.
// Padding colour: (r, g, b).  Returns new image index.
global contain(int idx, int width, int height, int r, int g, int b){
    int result = 0;
    rawPy(){
        from PIL import ImageOps as _ops, Image as _PIL
        import builtins
        if not hasattr(builtins, "_lx_images"):
            builtins._lx_images = []
        try:
            src = builtins._lx_images[idx]
            out = _PIL.new(src.mode, (width, height), (r, g, b))
            thumb = src.copy()
            thumb.thumbnail((width, height), _PIL.LANCZOS)
            x = (width  - thumb.width)  // 2
            y = (height - thumb.height) // 2
            out.paste(thumb, (x, y))
            builtins._lx_images.append(out)
            result = len(builtins._lx_images) - 1
        except Exception:
            result = -1
    }
    return result;
}

// Crop image to the rectangle (x1, y1, x2, y2).  Returns new image index.
global crop(int idx, int x1, int y1, int x2, int y2){
    int result = 0;
    rawPy(){
        import builtins
        if not hasattr(builtins, "_lx_images"):
            builtins._lx_images = []
        try:
            img = builtins._lx_images[idx].crop((x1, y1, x2, y2))
            builtins._lx_images.append(img)
            result = len(builtins._lx_images) - 1
        except Exception:
            result = -1
    }
    return result;
}

// Rotate image by angle degrees (counter-clockwise).
// expand=true enlarges canvas to fit the rotated image.
// Returns new image index.
global rotate(int idx, float angle, bool expand){
    int result = 0;
    rawPy(){
        import builtins
        if not hasattr(builtins, "_lx_images"):
            builtins._lx_images = []
        try:
            img = builtins._lx_images[idx].rotate(angle, expand=bool(expand))
            builtins._lx_images.append(img)
            result = len(builtins._lx_images) - 1
        except Exception:
            result = -1
    }
    return result;
}

// Flip image left-to-right (mirror horizontally).  Returns new index.
global flipH(int idx){
    int result = 0;
    rawPy(){
        from PIL import ImageOps as _ops
        import builtins
        if not hasattr(builtins, "_lx_images"):
            builtins._lx_images = []
        try:
            img = _ops.mirror(builtins._lx_images[idx])
            builtins._lx_images.append(img)
            result = len(builtins._lx_images) - 1
        except Exception:
            result = -1
    }
    return result;
}

// Flip image top-to-bottom (mirror vertically).  Returns new index.
global flipV(int idx){
    int result = 0;
    rawPy(){
        from PIL import ImageOps as _ops
        import builtins
        if not hasattr(builtins, "_lx_images"):
            builtins._lx_images = []
        try:
            img = _ops.flip(builtins._lx_images[idx])
            builtins._lx_images.append(img)
            result = len(builtins._lx_images) - 1
        except Exception:
            result = -1
    }
    return result;
}

// Add padding (in pixels) around an image.  Returns new image index.
global pad(int idx, int top, int right, int bottom, int left, int r, int g, int b){
    int result = 0;
    rawPy(){
        from PIL import Image as _PIL
        import builtins
        if not hasattr(builtins, "_lx_images"):
            builtins._lx_images = []
        try:
            src = builtins._lx_images[idx]
            nw  = src.width  + left + right
            nh  = src.height + top  + bottom
            out = _PIL.new(src.mode, (nw, nh), (r, g, b))
            out.paste(src, (left, top))
            builtins._lx_images.append(out)
            result = len(builtins._lx_images) - 1
        except Exception:
            result = -1
    }
    return result;
}

// ── Convert ────────────────────────────────────────────────────────────────

// Convert image to a different mode.
// mode: "RGB", "RGBA", "L", "P", "1", "CMYK", "YCbCr".
// Returns new image index.
global convert(int idx, str mode){
    int result = 0;
    rawPy(){
        import builtins
        if not hasattr(builtins, "_lx_images"):
            builtins._lx_images = []
        try:
            img = builtins._lx_images[idx].convert(mode)
            builtins._lx_images.append(img)
            result = len(builtins._lx_images) - 1
        except Exception:
            result = -1
    }
    return result;
}

