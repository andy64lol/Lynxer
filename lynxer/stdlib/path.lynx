////
Lynxer standard library: path.
pathlib-style path manipulation backed by the native C++ module
`stdlib/path.so`.

Paths are plain strings. Functions return "" / an empty list / false / -1 when
the underlying operation fails. `readTextEncoding`/`writeTextEncoding` use
UTF-8 by default and support ASCII, Latin-1, Windows-1252, UTF-16/32 and
host-supported `iconv` encodings; invalid conversions use the failure sentinel.
////
fn setup(){ importAs("path.so", "nativePath"); }

fn platform() -> str { return global.nativePath.platform(); }
fn separator() -> str { return global.nativePath.separator(); }
fn listSeparator() -> str { return global.nativePath.listSeparator(); }
fn cwd() -> str { return global.nativePath.cwd(); }
fn home() -> str { return global.nativePath.home(); }
fn absolute(str path) -> str { return global.nativePath.absolute(path); }
fn resolve(str path) -> str { return global.nativePath.resolve(path); }
fn expandUser(str path) -> str { return global.nativePath.expandUser(path); }
fn join(str base, str child) -> str {
    return global.nativePath.join(base, child);
}
fn join3(str first, str second, str third) -> str {
    return global.nativePath.join3(first, second, third);
}
fn normalize(str path) -> str { return global.nativePath.normalize(path); }
fn name(str path) -> str { return global.nativePath.name(path); }
fn stem(str path) -> str { return global.nativePath.stem(path); }
fn suffix(str path) -> str { return global.nativePath.suffix(path); }
fn suffixes(str path) -> list {
    str raw = global.nativePath.suffixes(path);
    if(raw is ""){ return seqFromTo(0, 0, 1); }
    return splitStr(raw, "\n");
}
fn parent(str path) -> str { return global.nativePath.parent(path); }
fn anchor(str path) -> str { return global.nativePath.anchor(path); }
fn root(str path) -> str { return global.nativePath.root(path); }
fn drive(str path) -> str { return global.nativePath.drive(path); }
fn isAbsolute(str path) -> bool {
    return global.nativePath.isAbsolute(path) isnt 0;
}
fn parts(str path) -> list {
    str raw = global.nativePath.parts(path);
    if(raw is ""){ return seqFromTo(0, 0, 1); }
    return splitStr(raw, "\n");
}
fn match(str path, str pattern) -> bool {
    return global.nativePath.match(path, pattern) isnt 0;
}
fn relativeTo(str path, str base) -> str {
    return global.nativePath.relativeTo(path, base);
}
fn withName(str path, str newName) -> str {
    return global.nativePath.withName(path, newName);
}
fn withSuffix(str path, str newSuffix) -> str {
    return global.nativePath.withSuffix(path, newSuffix);
}
fn exists(str path) -> bool { return global.nativePath.exists(path) isnt 0; }
fn isFile(str path) -> bool { return global.nativePath.isFile(path) isnt 0; }
fn isDir(str path) -> bool { return global.nativePath.isDir(path) isnt 0; }
fn isSymlink(str path) -> bool {
    return global.nativePath.isSymlink(path) isnt 0;
}
fn isMount(str path) -> bool { return global.nativePath.isMount(path) isnt 0; }
fn sameFile(str first, str second) -> bool {
    return global.nativePath.sameFile(first, second) isnt 0;
}
fn iterDir(str path) -> list {
    str raw = global.nativePath.iterDir(path);
    if(raw is ""){ return seqFromTo(0, 0, 1); }
    return splitStr(raw, "\n");
}
fn glob(str path, str pattern) -> list {
    str raw = global.nativePath.glob(path, pattern);
    if(raw is ""){ return seqFromTo(0, 0, 1); }
    return splitStr(raw, "\n");
}
fn rglob(str path, str pattern) -> list {
    str raw = global.nativePath.rglob(path, pattern);
    if(raw is ""){ return seqFromTo(0, 0, 1); }
    return splitStr(raw, "\n");
}
fn mkdir(str path) -> bool { return global.nativePath.mkdir(path) isnt 0; }
fn mkdirs(str path) -> bool { return global.nativePath.mkdirs(path) isnt 0; }
fn rmdir(str path) -> bool { return global.nativePath.rmdir(path) isnt 0; }
fn unlink(str path) -> bool { return global.nativePath.unlink(path) isnt 0; }
fn unlinkMissingOk(str path) -> bool {
    return global.nativePath.unlinkMissingOk(path) isnt 0;
}
fn touch(str path) -> bool { return global.nativePath.touch(path) isnt 0; }
fn rename(str path, str target) -> str {
    return global.nativePath.rename(path, target);
}
fn replace(str path, str target) -> str {
    return global.nativePath.replace(path, target);
}
fn readText(str path) -> str { return global.nativePath.readText(path); }
fn readTextEncoding(str path, str encoding) -> str {
    return global.nativePath.readTextEncoding(path, encoding);
}
fn writeText(str path, str content) -> bool {
    return global.nativePath.writeText(path, content) isnt 0;
}
fn writeTextEncoding(str path, str content, str encoding) -> bool {
    return global.nativePath.writeTextEncoding(path, content, encoding) isnt 0;
}
fn appendText(str path, str content) -> bool {
    return global.nativePath.appendText(path, content) isnt 0;
}
fn size(str path) -> int { return global.nativePath.size(path); }
fn modifiedTime(str path) -> float {
    return global.nativePath.modifiedTime(path);
}
fn asUri(str path) -> str { return global.nativePath.asUri(path); }

fn main(){}
