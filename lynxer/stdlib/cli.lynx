////
Clynxer standard library: cli.
Command-line helpers backed by the native C++ module `stdlib/cli.so`:
arguments, environment, terminal queries and process execution.

The Python reference also wraps Click and Typer command builders. Those are
Python packages with no Lynxer equivalent, so `clickExists()`/`typerExists()`
return false and the `click*`/`typer*` builders are not defined; calling one is
a hard "unknown function" error rather than a silent no-op.
////
global setup(){ importAs("cli.so", "nativeCli"); }

// Click/Typer are Python packages and are never available under Lynxer.
global clickExists() -> bool { return false; }
global typerExists() -> bool { return false; }
global clickVersion() -> str { return ""; }
global typerVersion() -> str { return ""; }

// Return the process command line as a JSON array.
global argv() -> str { return global.nativeCli.argv(); }
// Return the number of command-line entries.
global argCount() -> int { return global.nativeCli.argCount(); }
// Return the command-line entry at index, or "".
global getArg(int index) -> str { return global.nativeCli.getArg(index); }
// Return an environment variable's value, or "".
global envGet(str name) -> str { return global.nativeCli.envGet(name); }
// Return true if the environment variable is set.
global envHas(str name) -> bool { return global.nativeCli.envHas(name) isnt 0; }
// Return all environment variables as a JSON object.
global envAll() -> str { return global.nativeCli.envAll(); }
// Return the current working directory.
global cwd() -> str { return global.nativeCli.cwd(); }
// Change the working directory.
global chdir(str path) -> bool { return global.nativeCli.chdir(path) isnt 0; }
// Return true if stdin is a terminal.
global stdinIsTty() -> bool { return global.nativeCli.stdinIsTty() isnt 0; }
// Return true if stdout is a terminal.
global stdoutIsTty() -> bool { return global.nativeCli.stdoutIsTty() isnt 0; }
// Read all of stdin.
global readStdin() -> str { return global.nativeCli.readStdin(); }
// Write text to stdout.
global writeStdout(str text) { global.nativeCli.writeStdout(text); }
// Write text to stderr.
global writeStderr(str text) { global.nativeCli.writeStderr(text); }
// Return the terminal size as JSON {"columns": N, "lines": M}.
global terminalSize() -> str { return global.nativeCli.terminalSize(); }
// Exit the process with the given code.
global exit(int code) { global.nativeCli.exit(code); }
// Return true if the path exists.
global pathExists(str path) -> bool {
    return global.nativeCli.pathExists(path) isnt 0;
}
// Return true if the path is a regular file.
global isFile(str path) -> bool { return global.nativeCli.isFile(path) isnt 0; }
// Return true if the path is a directory.
global isDirectory(str path) -> bool {
    return global.nativeCli.isDirectory(path) isnt 0;
}
// Resolve an executable on PATH, or "".
global which(str executable) -> str { return global.nativeCli.which(executable); }
// Run a command. With capture=true return its stdout; otherwise return the exit
// code as a string.
global run(str command, bool capture) -> str {
    if(capture){ return global.nativeCli.run(command, 1); }
    return global.nativeCli.run(command, 0);
}
// Run a command silently and return its exit code.
global runCode(str command) -> int { return global.nativeCli.runCode(command); }

global main(){}
