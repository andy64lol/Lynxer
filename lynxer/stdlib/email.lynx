//// MIME message parsing and construction, backed by mailparse and mail-builder. Messages are raw RFC 5322 strings; structured results are JSON. ////
fn setup(){ importAs("email.so", "nativeEmail"); }
fn emailParse(str message) -> str { return global.nativeEmail.emailParse(message); }
fn emailBuild(str json) -> str { return global.nativeEmail.emailBuild(json); }
fn main(){}
