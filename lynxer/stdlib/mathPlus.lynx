////
Lynxer standard library: mathPlus.
Extended math and NumPy helpers. Requires NumPy.
////

global setup(){
    import("math");
}

// Re-export the dependency-free math API.
global abs(int n){ return global.math.abs(n); }
global max(int a, int b){ return global.math.max(a, b); }
global min(int a, int b){ return global.math.min(a, b); }
global clamp(int val, int lo, int hi){ return global.math.clamp(val, lo, hi); }
global pow(int base, int exp){ return global.math.pow(base, exp); }
global floor(float n){ return global.math.floor(n); }
global ceil(float n){ return global.math.ceil(n); }
global sqrt(float n){ return global.math.sqrt(n); }
global round(float n){ return global.math.round(n); }
global roundNum(float n){ return global.math.roundNum(n); }
global pi(){ return global.math.pi(); }
global PI(){ return global.math.PI(); }
global Pi(){ return global.math.Pi(); }
global e(){ return global.math.e(); }
global log(float n){ return global.math.log(n); }
global log2(float n){ return global.math.log2(n); }
global log10(float n){ return global.math.log10(n); }
global sin(float n){ return global.math.sin(n); }
global cos(float n){ return global.math.cos(n); }
global tan(float n){ return global.math.tan(n); }
global degrees(float n){ return global.math.degrees(n); }
global radians(float n){ return global.math.radians(n); }
global sign(float n){ return global.math.sign(n); }
global isEven(int n){ return global.math.isEven(n); }
global isOdd(int n){ return global.math.isOdd(n); }
global factorial(int n){ return global.math.factorial(n); }
global gcd(int a, int b){ return global.math.gcd(a, b); }
global hypot(float a, float b){ return global.math.hypot(a, b); }
global truncate(float n){ return global.math.truncate(n); }
global randInt(int lo, int hi){ return global.math.randInt(lo, hi); }
global randFloat(float lo, float hi){ return global.math.randFloat(lo, hi); }
global lcm(int a, int b){ return global.math.lcm(a, b); }
global isPrime(int n){ return global.math.isPrime(n); }
global nextPrime(int n){ return global.math.nextPrime(n); }
global binomial(int n, int k){ return global.math.binomial(n, k); }
global isqrt(int n){ return global.math.isqrt(n); }
global sumRange(int lo, int hi){ return global.math.sumRange(lo, hi); }
global lerp(float lo, float hi, float t){ return global.math.lerp(lo, hi, t); }
global clampFloat(float val, float lo, float hi){
    return global.math.clampFloat(val, lo, hi);
}
global mapRange(float value, float inLo, float inHi, float outLo, float outHi){
    return global.math.mapRange(value, inLo, inHi, outLo, outHi);
}

// All functions below require numpy to be installed.

global tau(){
    float result = 0.0;
    rawPy(){
        import numpy as _np
        result = float(_np.pi * 2)
    }
    return result;
}

global exp(float n){
    float result = 0.0;
    rawPy(){
        import numpy as _np
        result = float(_np.exp(n))
    }
    return result;
}

global arcsin(float n){
    float result = 0.0;
    rawPy(){
        import numpy as _np
        try:
            result = float(_np.arcsin(n))
        except Exception:
            result = 0.0
    }
    return result;
}

