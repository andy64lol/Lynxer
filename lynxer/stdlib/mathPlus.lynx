    }
    return result;
}

global linspace(float start, float stop, int n){
    str result = "";
    rawPy(){
        import numpy as _np
        try:
            arr = _np.linspace(start, stop, n)
            result = "\x1f".join(str(float(x)) for x in arr)
        except Exception:
            result = ""
    }
    if(result is ""){ return seqFromTo(0, 0, 1); }
    return splitStr(result, "\x1f");
}

global cumsum(list lst){
    str result = "";
    rawPy(){
        import numpy as _np
        try:
            arr = _np.cumsum(lst)
            result = "\x1f".join(str(float(x)) for x in arr)
        except Exception:
            result = ""
    }
    if(result is ""){ return seqFromTo(0, 0, 1); }
    return splitStr(result, "\x1f");
}

global diff(list lst){
    str result = "";
