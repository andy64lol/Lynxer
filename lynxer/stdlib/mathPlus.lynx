            arr = _np.diff(lst)
            result = "\x1f".join(str(float(x)) for x in arr)
        except Exception:
            result = ""
    }
    if(result is ""){ return seqFromTo(0, 0, 1); }
    return splitStr(result, "\x1f");
}

global clip(list lst, float lo, float hi){
    str result = "";
    rawPy(){
        import numpy as _np
        try:
            arr = _np.clip(lst, lo, hi)
            result = "\x1f".join(str(float(x)) for x in arr)
        except Exception:
            result = ""
    }
    if(result is ""){ return seqFromTo(0, 0, 1); }
    return splitStr(result, "\x1f");
}

global normalize(list lst){
    str result = "";
    rawPy(){
        import numpy as _np
        try:
            arr = _np.array(lst, dtype=float)
            n = _np.linalg.norm(arr)
            if n == 0:
                out = arr
            else:
                out = arr / n
            result = "\x1f".join(str(float(x)) for x in out)
        except Exception:
            result = ""
    }
    if(result is ""){ return seqFromTo(0, 0, 1); }
    return splitStr(result, "\x1f");
}

global main(){}
