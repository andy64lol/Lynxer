/// Pearson correlation coefficient between two equal-length numeric lists.
Returns a value in [-1, 1]. Returns 0.0 if inputs are invalid. ///
global corrcoef(any a, any b){
    float result = 0.0;
    rawPy(){
        import numpy as _np
        try:
            m = _np.corrcoef(a, b)
            result = float(m[0, 1])
        except Exception:
            result = 0.0
    }
    return result;
}

