global lcm(int a, int b){
    int result = 0;
    rawPy(){
        import math as _m
        try:
            result = _m.lcm(a, b)
        except AttributeError:
            g = _m.gcd(a, b)
            result = abs(a * b) // g if g else 0
    }
    return result;
}

global isPrime(int n){
    bool result = false;
    rawPy(){
        import math as _m
        if n < 2:
            result = False
        elif n == 2:
            result = True
        elif n % 2 == 0:
            result = False
        else:
            result = all(n % i != 0 for i in range(3, _m.isqrt(n) + 1, 2))
    }
    return result;
}

global nextPrime(int n){
    int result = 2;
    rawPy(){
        import math as _m
        candidate = n + 1
        while True:
            if candidate < 2:
                candidate = 2
                continue
            if candidate == 2:
                result = 2
                break
            if candidate % 2 == 0:
                candidate += 1
                continue
            ok = all(candidate % i != 0 for i in range(3, _m.isqrt(candidate) + 1, 2))
            if ok:
                result = candidate
                break
            candidate += 1
    }
    return result;
}

global binomial(int n, int k){
