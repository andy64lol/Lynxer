////
Lynxer standard library: math.
Math and number helpers.
////

global setup(){}

global abs(int n){
    if(n < 0){ return n * -1; }
    return n;
}

global max(int a, int b){
    if(a > b){ return a; }
    return b;
}

global min(int a, int b){
    if(a < b){ return a; }
    return b;
}

global clamp(int val, int lo, int hi){
    if(val < lo){ return lo; }
    if(val > hi){ return hi; }
    return val;
}

global pow(int base, int exp){
    int result = 1;
    int i = 0;
    while(i < exp){
        result = result * base;
        i = i + 1;
    }
    return result;
}

global floor(float n){
    rawPy(){
        import math as _m
        n = float(_m.floor(n))
    }
    return n;
}

global ceil(float n){
    rawPy(){
        import math as _m
        n = float(_m.ceil(n))
    }
    return n;
}

