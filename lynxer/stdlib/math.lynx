// ── List-returning functions ─────────────────────────────────────────────────
// These functions return a Lynxer list of strings.
// Convert elements to float with floatOf() when you need to do arithmetic:
//
//   any pts = global.math.linspace(0.0, 1.0, 5);
//   float v  = floatOf(listGet(pts, 0));

/// Return n evenly-spaced float values between start and stop (inclusive).
Elements are returned as strings; use floatOf() to convert. ///
global linspace(float start, float stop, int n){
    str result = "";
    rawPy(){
        import numpy as _np
        try:
            arr = _np.linspace(start, stop, n)
            result = "\x1f".join(str(float(x)) for x in arr)
        except Exception:
            result = ""
    }
    if(result is ""){ return seqFromTo(0, 0, 1); }
    return splitStr(result, "\x1f");
}

/// Cumulative sum of a numeric list. Elements are returned as strings. ///
global cumsum(list lst){
    str result = "";
    rawPy(){
        import numpy as _np
        try:
            arr = _np.cumsum(lst)
            result = "\x1f".join(str(float(x)) for x in arr)
        except Exception:
            result = ""
    }
    if(result is ""){ return seqFromTo(0, 0, 1); }
    return splitStr(result, "\x1f");
}

/// Differences between consecutive elements of a numeric list.
Returns a list one shorter than the input. Elements are strings. ///
global diff(list lst){
    str result = "";
    rawPy(){
        import numpy as _np
        try:
            arr = _np.diff(lst)
            result = "\x1f".join(str(float(x)) for x in arr)
        except Exception:
            result = ""
    }
    if(result is ""){ return seqFromTo(0, 0, 1); }
    return splitStr(result, "\x1f");
}

/// Clip each element of a numeric list to the range [lo, hi].
Returns a list of strings; use floatOf() to convert. ///
global clip(list lst, float lo, float hi){
    str result = "";
    rawPy(){
        import numpy as _np
        try:
            arr = _np.clip(lst, lo, hi)
            result = "\x1f".join(str(float(x)) for x in arr)
        except Exception:
            result = ""
    }
    if(result is ""){ return seqFromTo(0, 0, 1); }
    return splitStr(result, "\x1f");
}

/// Normalize a numeric list to unit L2 length.
If the norm is 0 the original list (as strings) is returned unchanged.
Elements are strings; use floatOf() to convert. ///
global normalize(list lst){
    str result = "";
    rawPy(){
        import numpy as _np
        try:
            arr = _np.array(lst, dtype=float)
            n = _np.linalg.norm(arr)
            if n == 0:
                out = arr
            else:
                out = arr / n
            result = "\x1f".join(str(float(x)) for x in out)
        except Exception:
            result = ""
    }
    if(result is ""){ return seqFromTo(0, 0, 1); }
    return splitStr(result, "\x1f");
}

global main(){}
