////
Math standard library backed by the native C++ module `stdlib/math.so`.

Importing `math` loads the C++ ABI implementation and exposes integer,
floating-point, number-theory, rounding, logarithmic, and trigonometric
helpers through the Lynxer-facing wrapper API.
////
fn setup(){
    importAs("math.so", "nativeMath");
}

// Return the absolute value of value.
fn abs(int value) -> int { return global.nativeMath.abs(value); }
// Return the absolute value of a floating-point value.
fn absFloat(float value) -> float {
    return global.nativeMath.absFloat(value);
}
// Return the greater of two values.
fn max(int left, int right) -> int {
    return global.nativeMath.max(left, right);
}
// Return the lesser of two values.
fn min(int left, int right) -> int {
    return global.nativeMath.min(left, right);
}
// Return the greater of two floating-point values.
fn maxFloat(float left, float right) -> float {
    return global.nativeMath.maxFloat(left, right);
}
// Return the lesser of two floating-point values.
fn minFloat(float left, float right) -> float {
    return global.nativeMath.minFloat(left, right);
}
// Clamp value to the inclusive range [low, high].
fn clamp(int value, int low, int high) -> int {
    return global.nativeMath.clamp(value, low, high);
}
// Clamp a floating-point value to the inclusive range.
fn clampFloat(float value, float low, float high) -> float {
    return global.nativeMath.clampFloat(value, low, high);
}
// Raise base to a non-negative integer exponent.
fn pow(int base, int exponent) -> int {
    return global.nativeMath.pow(base, exponent);
}
// Raise a floating-point base to a floating-point exponent.
fn powFloat(float base, float exponent) -> float {
    return global.nativeMath.powFloat(base, exponent);
}
// Return the square root of value.
fn sqrt(float value) -> float { return global.nativeMath.sqrt(value); }
// Return the cube root of value.
fn cbrt(float value) -> float { return global.nativeMath.cbrt(value); }
// Return the hypotenuse for x and y.
fn hypot(float x, float y) -> float {
    return global.nativeMath.hypot(x, y);
}
// Return -1 for negative, 1 for positive, or 0 for zero.
fn sign(int value) -> int { return global.nativeMath.sign(value); }
// Return the sign of a floating-point value.
fn signFloat(float value) -> float {
    return global.nativeMath.signFloat(value);
}
// Return whether value is divisible by two.
fn isEven(int value) -> bool {
    return global.nativeMath.sign(value % 2) is 0;
}
// Return whether value is not divisible by two.
fn isOdd(int value) -> bool {
    return global.nativeMath.sign(value % 2) isnt 0;
}
// Return value factorial, with factorial(0) equal to 1.
fn factorial(int value) -> int {
    return global.nativeMath.factorial(value);
}
// Return the greatest common divisor of two values.
fn gcd(int left, int right) -> int {
    return global.nativeMath.gcd(left, right);
}
// Return the least common multiple of two values.
fn lcm(int left, int right) -> int {
    return global.nativeMath.lcm(left, right);
}
// Return whether value is prime. Values below two are not prime.
fn isPrime(int value) -> bool {
    return global.nativeMath.isPrime(value) isnt 0;
}
// Return the first prime strictly greater than value.
fn nextPrime(int value) -> int {
    return global.nativeMath.nextPrime(value);
}
// Return the binomial coefficient n choose k, or zero for invalid k.
fn binomial(int n, int k) -> int {
    return global.nativeMath.binomial(n, k);
}
// Return the inclusive sum of all integers from low through high.
fn sumRange(int low, int high) -> int {
    return global.nativeMath.sumRange(low, high);
}
// Apply common rounding operations.
fn floor(float value) -> float { return global.nativeMath.floor(value); }
fn ceil(float value) -> float { return global.nativeMath.ceil(value); }
fn round(float value) -> float { return global.nativeMath.round(value); }
fn trunc(float value) -> float { return global.nativeMath.trunc(value); }
// Apply exponential, logarithmic, and trigonometric operations.
fn exp(float value) -> float { return global.nativeMath.exp(value); }
fn exp2(float value) -> float { return global.nativeMath.exp2(value); }
fn log(float value) -> float { return global.nativeMath.log(value); }
fn log10(float value) -> float { return global.nativeMath.log10(value); }
fn log2(float value) -> float { return global.nativeMath.log2(value); }
fn sin(float value) -> float { return global.nativeMath.sin(value); }
fn cos(float value) -> float { return global.nativeMath.cos(value); }
fn tan(float value) -> float { return global.nativeMath.tan(value); }
fn asin(float value) -> float { return global.nativeMath.asin(value); }
fn acos(float value) -> float { return global.nativeMath.acos(value); }
fn atan(float value) -> float { return global.nativeMath.atan(value); }
fn atan2(float y, float x) -> float {
    return global.nativeMath.atan2(y, x);
}
fn sinh(float value) -> float { return global.nativeMath.sinh(value); }
fn cosh(float value) -> float { return global.nativeMath.cosh(value); }
fn tanh(float value) -> float { return global.nativeMath.tanh(value); }
fn isFinite(float value) -> bool {
    return global.nativeMath.isFinite(value) isnt 0;
}
fn isNaN(float value) -> bool {
    return global.nativeMath.isNaN(value) isnt 0;
}
fn isInfinite(float value) -> bool {
    return global.nativeMath.isInfinite(value) isnt 0;
}
fn fmod(float left, float right) -> float {
    return global.nativeMath.fmod(left, right);
}
fn remainder(float left, float right) -> float {
    return global.nativeMath.remainder(left, right);
}
fn roundNum(float value) -> float { return global.round(value); }
fn pi() -> float { return global.nativeMath.pi(); }
fn e() -> float { return global.nativeMath.e(); }
fn degrees(float value) -> float {
    return global.nativeMath.degrees(value);
}
fn radians(float value) -> float {
    return global.nativeMath.radians(value);
}
fn truncate(float value) -> int {
    return global.nativeMath.truncate(value);
}
fn randInt(int low, int high) -> int {
    return global.nativeMath.randInt(low, high);
}
fn randFloat(float low, float high) -> float {
    return global.nativeMath.randFloat(low, high);
}
fn tau() -> float { return global.nativeMath.tau(); }
fn isqrt(int value) -> int { return global.nativeMath.isqrt(value); }
fn lerp(float low, float high, float t) -> float {
    return global.nativeMath.lerp(low, high, t);
}
fn roundTo(float value, int decimals) -> float {
    return global.nativeMath.roundTo(value, decimals);
}
fn mapRange(float value, float inLo, float inHi,
                float outLo, float outHi) -> float {
    if(inHi is inLo){ return outLo; }
    return outLo + (value - inLo) * (outHi - outLo) / (inHi - inLo);
}
fn arcsin(float value) -> float { return global.asin(value); }
fn arccos(float value) -> float { return global.acos(value); }
fn arctan(float value) -> float { return global.atan(value); }
fn arctan2(float y, float x) -> float { return global.atan2(y, x); }
fn mean(list values) -> float {
    if(returnLength(values) is 0){ return 0.0; }
    return sumOf(values) / returnLength(values);
}
fn prod(list values) -> float {
    float result = 1.0;
    int index = 0;
    while(index < returnLength(values)){
        result = result * listGet(values, index);
        index = index + 1;
    }
    return result;
}
fn norm(list values) -> float {
    float total = 0.0;
    int index = 0;
    while(index < returnLength(values)){
        float item = listGet(values, index);
        total = total + item * item;
        index = index + 1;
    }
    return sqrt(total);
}
fn argmax(list values) -> int {
    if(returnLength(values) is 0){ return 0; }
    int best = 0;
    int index = 1;
    while(index < returnLength(values)){
        if(listGet(values, index) > listGet(values, best)){ best = index; }
        index = index + 1;
    }
    return best;
}
fn argmin(list values) -> int {
    if(returnLength(values) is 0){ return 0; }
    int best = 0;
    int index = 1;
    while(index < returnLength(values)){
        if(listGet(values, index) < listGet(values, best)){ best = index; }
        index = index + 1;
    }
    return best;
}

// ── Constants ──
// The native module registers `maxInt`/`minInt` as integer constants on its own
// namespace; these wrappers expose them on the `math` namespace.
fn maxInt() -> int { return global.nativeMath.maxInt; }
fn minInt() -> int { return global.nativeMath.minInt; }

// ── Statistics and vectors ──
// List arguments cross the native ABI as a `bytes` buffer of little-endian
// f64 (the `listToBytes` / `bytesToList` encoding).
// Return the middle value, averaging the two middle values for even lengths.
fn median(list values) -> float {
    return global.nativeMath.median(listToBytes(values));
}
// Return the population standard deviation.
fn std(list values) -> float {
    return global.nativeMath.std(listToBytes(values));
}
// Return the population variance.
fn variance(list values) -> float {
    return global.nativeMath.variance(listToBytes(values));
}
// Return the p-th percentile using linear interpolation between order statistics.
fn percentile(list values, float p) -> float {
    return global.nativeMath.percentile(listToBytes(values), p);
}
// Return the Pearson correlation coefficient of two equal-length lists.
fn corrcoef(list a, list b) -> float {
    return global.nativeMath.corrcoef(listToBytes(a), listToBytes(b));
}
// Return the dot product of two equal-length lists.
fn dot(list a, list b) -> float {
    return global.nativeMath.dot(listToBytes(a), listToBytes(b));
}
// Return n evenly spaced values from start to stop, inclusive.
fn linspace(float start, float stop, int n) -> list {
    return bytesToList(global.nativeMath.linspace(start, stop, n));
}
// Return the running sums of the list.
fn cumsum(list values) -> list {
    return bytesToList(global.nativeMath.cumsum(listToBytes(values)));
}
// Return the consecutive differences of the list.
fn diff(list values) -> list {
    return bytesToList(global.nativeMath.diff(listToBytes(values)));
}
// Return the list with every element clamped to [lo, hi].
fn clip(list values, float lo, float hi) -> list {
    return bytesToList(global.nativeMath.clip(listToBytes(values), lo, hi));
}
// Return the list scaled to unit norm (unchanged when the norm is zero).
fn normalize(list values) -> list {
    return bytesToList(global.nativeMath.normalize(listToBytes(values)));
}

fn main(){}
