// Register a JSON GET route with a custom status code.
global jsonWithStatus(str path, str jsonBody, int status){
    rawPy(){
        import builtins
        _body   = jsonBody
        _status = int(status)
        _p      = path
        def _h(**kw):
            hdrs = dict(getattr(builtins, "_lx_global_headers", {}))
            hdrs["Content-Type"] = "application/json"
            if getattr(builtins, "_lx_cors_origins", None):
                hdrs["Access-Control-Allow-Origin"] = builtins._lx_cors_origins
            return _body, _status, hdrs
        _ep = "JWS_" + _p.replace("/","_").replace("<","").replace(">","")
        builtins._lx_flask.add_url_rule(
            _p, endpoint=_ep, view_func=_h,
            methods=["GET","POST","PUT","DELETE","PATCH"]
        )
    }
}

// ── Jinja2 template routes ─────────────────────────────────────────────────

// Register a GET route that renders a Jinja2 template file.
global templateGet(str path, str templateFile){
    rawPy(){
        import builtins
        from flask import render_template
        _tpl = templateFile
        _p   = path
        def _h(**kw):
            hdrs = dict(getattr(builtins, "_lx_global_headers", {}))
            if getattr(builtins, "_lx_cors_origins", None):
                hdrs["Access-Control-Allow-Origin"] = builtins._lx_cors_origins
            body = render_template(_tpl, **kw)
            return body, 200, hdrs
        _ep = "TPLGET_" + _p.replace("/","_").replace("<","").replace(">","")
        builtins._lx_flask.add_url_rule(_p, endpoint=_ep, view_func=_h, methods=["GET"])
    }
}

// Register a POST route that renders a Jinja2 template file.
global templatePost(str path, str templateFile){
    rawPy(){
        import builtins
        from flask import render_template
        _tpl = templateFile
        _p   = path
        def _h(**kw):
            hdrs = dict(getattr(builtins, "_lx_global_headers", {}))
            if getattr(builtins, "_lx_cors_origins", None):
                hdrs["Access-Control-Allow-Origin"] = builtins._lx_cors_origins
            body = render_template(_tpl, **kw)
            return body, 200, hdrs
        _ep = "TPLPOST_" + _p.replace("/","_").replace("<","").replace(">","")
        builtins._lx_flask.add_url_rule(_p, endpoint=_ep, view_func=_h, methods=["POST"])
    }
}

// Register a GET route that renders an inline Jinja2 template string.
global inlineTemplate(str path, str templateStr){
    rawPy(){
        import builtins
        from flask import render_template_string
        _tpl = templateStr
        _p   = path
        def _h(**kw):
            hdrs = dict(getattr(builtins, "_lx_global_headers", {}))
            if getattr(builtins, "_lx_cors_origins", None):
                hdrs["Access-Control-Allow-Origin"] = builtins._lx_cors_origins
            body = render_template_string(_tpl, **kw)
            return body, 200, hdrs
        _ep = "ITPL_" + _p.replace("/","_").replace("<","").replace(">","")
        builtins._lx_flask.add_url_rule(_p, endpoint=_ep, view_func=_h, methods=["GET"])
    }
}

// ── Static files ───────────────────────────────────────────────────────────

// Serve a directory of static files under a URL prefix.
// Example: global.server.staticDir("./public", "/static");
global staticDir(str dir, str urlPrefix){
    rawPy(){
        import builtins, os
        from flask import send_from_directory
        _dir    = os.path.abspath(dir)
        _prefix = urlPrefix.rstrip("/")
        def _static(filename):
            hdrs = dict(getattr(builtins, "_lx_global_headers", {}))
            if getattr(builtins, "_lx_cors_origins", None):
                hdrs["Access-Control-Allow-Origin"] = builtins._lx_cors_origins
            resp = send_from_directory(_dir, filename)
            for k, v in hdrs.items():
                resp.headers[k] = v
            return resp
        _ep = "STATIC_" + _prefix.replace("/","_")
        builtins._lx_flask.add_url_rule(
            _prefix + "/<path:filename>", endpoint=_ep, view_func=_static
        )
    }
}

// Serve an entire directory as a static site (index.html at /).
global staticSite(str dir, str urlPrefix){
    rawPy(){
        import builtins, os
        from flask import send_from_directory
        _dir    = os.path.abspath(dir)
        _prefix = urlPrefix.rstrip("/")
        def _index():
            return send_from_directory(_dir, "index.html")
        def _files(filename):
            return send_from_directory(_dir, filename)
        _ep_idx = "SSITE_IDX_" + _prefix.replace("/","_")
        _ep_fls = "SSITE_FLS_" + _prefix.replace("/","_")
        builtins._lx_flask.add_url_rule(_prefix + "/", endpoint=_ep_idx, view_func=_index)
        builtins._lx_flask.add_url_rule(
            _prefix + "/<path:filename>", endpoint=_ep_fls, view_func=_files
        )
    }
}

// Send a file as a downloadable attachment.
// path is the URL path; filePath is the local file path; filename is the download name.
global sendFile(str path, str filePath, str filename){
    rawPy(){
        import builtins, os
        from flask import send_file as _sf
        _fp  = os.path.abspath(filePath)
        _fn  = filename
        _p   = path
        def _h(**kw):
            return _sf(_fp, as_attachment=True, download_name=_fn)
        _ep = "SENDFILE_" + _p.replace("/","_").replace("<","").replace(">","")
        builtins._lx_flask.add_url_rule(_p, endpoint=_ep, view_func=_h, methods=["GET"])
    }
}

// ── Redirects ──────────────────────────────────────────────────────────────

// Register a temporary (302) redirect from path to destination.
global redirect(str path, str destination){
    rawPy(){
        import builtins
        from flask import redirect as _redir
        _dest = destination
        _p    = path
        def _h(**kw):
            return _redir(_dest, 302)
        _ep = "REDIR_" + _p.replace("/","_").replace("<","").replace(">","")
        builtins._lx_flask.add_url_rule(_p, endpoint=_ep, view_func=_h, methods=["GET"])
    }
}

// Register a permanent (301) redirect from path to destination.
global permanentRedirect(str path, str destination){
    rawPy(){
        import builtins
        from flask import redirect as _redir
        _dest = destination
        _p    = path
        def _h(**kw):
            return _redir(_dest, 301)
        _ep = "PERMAREDIR_" + _p.replace("/","_").replace("<","").replace(">","")
        builtins._lx_flask.add_url_rule(_p, endpoint=_ep, view_func=_h, methods=["GET"])
    }
}

// ── Error pages ────────────────────────────────────────────────────────────

// Set a custom 404 (Not Found) error page.
global errorPage(str html){
    rawPy(){
        import builtins
        _html = html
        @builtins._lx_flask.errorhandler(404)
        def _404(e):
            return _html, 404
    }
}

// Set a custom 500 (Internal Server Error) page.
global errorPage500(str html){
    rawPy(){
        import builtins
        _html = html
        @builtins._lx_flask.errorhandler(500)
        def _500(e):
            return _html, 500
    }
}

// Set a custom 403 (Forbidden) error page.
global forbidden(str html){
    rawPy(){
        import builtins
        _html = html
        @builtins._lx_flask.errorhandler(403)
        def _403(e):
            return _html, 403
    }
}

// Set a custom 405 (Method Not Allowed) error page.
global errorPage405(str html){
    rawPy(){
        import builtins
        _html = html
        @builtins._lx_flask.errorhandler(405)
        def _405(e):
            return _html, 405
    }
}

// Set a custom 413 (Request Entity Too Large) error page.
global errorPage413(str html){
    rawPy(){
        import builtins
        _html = html
        @builtins._lx_flask.errorhandler(413)
        def _413(e):
            return _html, 413
    }
}

// ── CORS ───────────────────────────────────────────────────────────────────

// Enable CORS for all responses using a wildcard origin (*).
global enableCORS(){
    rawPy(){
        import builtins
        builtins._lx_cors_origins = "*"
    }
}

// Set a specific CORS origin header value (e.g. "https://example.com").
global setCORSOrigin(str origin){
    rawPy(){
        import builtins
        builtins._lx_cors_origins = origin
    }
}

// Disable CORS headers.
global disableCORS(){
    rawPy(){
        import builtins
        builtins._lx_cors_origins = None
    }
}

// ── Global response headers ────────────────────────────────────────────────

// Add a header that will be included in every response.
global addHeader(str name, str value){
    rawPy(){
        import builtins
        if not hasattr(builtins, "_lx_global_headers"):
            builtins._lx_global_headers = {}
        builtins._lx_global_headers[name] = value
    }
}

// Remove a previously added global response header.
global removeHeader(str name){
    rawPy(){
        import builtins
        if hasattr(builtins, "_lx_global_headers"):
            builtins._lx_global_headers.pop(name, None)
    }
}

// ── Per-request logging ────────────────────────────────────────────────────

// Enable per-request console logging (method + path + status).
global enableLogging(){
    rawPy(){
        import builtins
        from flask import request as _req
        @builtins._lx_flask.after_request
        def _log(resp):
            print(f"[Lynxer server] {_req.method} {_req.path} -> {resp.status_code}")
            return resp
    }
}

// ── Cookies ────────────────────────────────────────────────────────────────

// Read a cookie value by name. Returns empty string if not found.
// Call only inside a request handler (rawPy block in a route callback).
global getCookie(str name){
    str result = "";
    rawPy(){
        try:
            from flask import request as _req
            result = _req.cookies.get(name, "")
        except Exception:
            result = ""
    }
    return result;
}

// Set a cookie on the current response context.
// Must be used with a rawPy route that builds a Response object.
global setCookieHeader(str name, str value, int maxAge){
    str result = "";
    rawPy(){
        result = f"Set-Cookie: {name}={value}; Max-Age={int(maxAge)}; Path=/"
    }
    return result;
}

// ── Request-context readers ────────────────────────────────────────────────

// Get a URL query-string parameter by name.
// Example: /search?q=hello  →  getArg("q") returns "hello".
global getArg(str name){
    str result = "";
    rawPy(){
        try:
            from flask import request as _req
            result = _req.args.get(name, "")
        except Exception:
            result = ""
    }
    return result;
}

// Get all URL query-string parameters as a JSON string.
// Example: /search?q=hi&lang=en → "{\"q\":\"hi\",\"lang\":\"en\"}".
global getQueryAll(){
    str result = "";
    rawPy(){
        try:
            import json as _json
            from flask import request as _req
            result = _json.dumps(dict(_req.args))
        except Exception:
            result = "{}"
    }
    return result;
}

// Get a URL route parameter by name.
// Requires a route defined with a <paramName> placeholder,
// e.g. path "/user/<id>".  Call inside a rawPy block.
global getRouteParam(str name){
    str result = "";
    rawPy(){
        try:
            from flask import request as _req
            result = str(_req.view_args.get(name, "")) if _req.view_args else ""
        except Exception:
            result = ""
    }
    return result;
}

// Get a form-data field value by name (from a POST/PUT form submission).
global getFormField(str name){
    str result = "";
    rawPy(){
        try:
            from flask import request as _req
            result = _req.form.get(name, "")
        except Exception:
            result = ""
    }
    return result;
}

// Get the raw request body as a string.
global getBody(){
    str result = "";
    rawPy(){
        try:
            from flask import request as _req
            result = _req.get_data(as_text=True)
        except Exception:
            result = ""
    }
    return result;
}

// Get the request body parsed as a JSON string (re-serialised).
// Returns "{}" on failure.
global getBodyJson(){
    str result = "";
    rawPy(){
        try:
            import json as _json
            from flask import request as _req
            data = _req.get_json(silent=True, force=True)
            result = _json.dumps(data) if data is not None else "{}"
        except Exception:
            result = "{}"
    }
    return result;
}

// Get a request header value by name. Returns empty string if absent.
global getHeader(str name){
    str result = "";
    rawPy(){
        try:
            from flask import request as _req
            result = _req.headers.get(name, "")
        except Exception:
            result = ""
    }
    return result;
}

// Get the HTTP method of the current request (e.g. "GET", "POST").
global getMethod(){
    str result = "";
    rawPy(){
        try:
            from flask import request as _req
            result = _req.method
        except Exception:
            result = ""
    }
    return result;
}

// Get the full URL of the current request.
global getURL(){
    str result = "";
    rawPy(){
        try:
            from flask import request as _req
            result = _req.url
        except Exception:
            result = ""
    }
    return result;
}

// Get the client IP address of the current request.
global getIP(){
    str result = "";
    rawPy(){
        try:
            from flask import request as _req
            result = _req.remote_addr or ""
        except Exception:
            result = ""
    }
    return result;
}

// Get the Content-Type header of the current request.
global getContentType(){
    str result = "";
    rawPy(){
        try:
            from flask import request as _req
            result = _req.content_type or ""
        except Exception:
            result = ""
    }
    return result;
}

// Return true (1) if the current request method is GET.
global isGet(){
    int result = 0;
    rawPy(){
        try:
            from flask import request as _req
            result = 1 if _req.method == "GET" else 0
        except Exception:
            result = 0
    }
    return result;
}

// Return true (1) if the current request method is POST.
global isPost(){
    int result = 0;
    rawPy(){
        try:
            from flask import request as _req
            result = 1 if _req.method == "POST" else 0
        except Exception:
            result = 0
    }
    return result;
}

// Get all request headers as a JSON string.
global getAllHeaders(){
    str result = "";
    rawPy(){
        try:
            import json as _json
            from flask import request as _req
            result = _json.dumps(dict(_req.headers))
        except Exception:
            result = "{}"
    }
    return result;
}

// ── Server startup ─────────────────────────────────────────────────────────

// Start the server (blocking). Uses host and port set by init().
global run(){
    rawPy(){
        import builtins
        _h = builtins._lx_host
        _p = builtins._lx_port
        _d = getattr(builtins, "_lx_debug", False)
        print("[Lynxer server] Running on http://" + str(_h) + ":" + str(_p))
        builtins._lx_flask.run(host=_h, port=_p, debug=_d)
    }
}

// Start the server with SSL/HTTPS.
// cert and key are paths to PEM certificate and private-key files.
global runHTTPS(str cert, str key){
    rawPy(){
        import builtins
        _h    = builtins._lx_host
        _p    = builtins._lx_port
        _d    = getattr(builtins, "_lx_debug", False)
        _cert = cert
        _key  = key
        print("[Lynxer server] Running on https://" + str(_h) + ":" + str(_p))
        builtins._lx_flask.run(host=_h, port=_p, debug=_d, ssl_context=(_cert, _key))
    }
}

// Start the server with an auto-generated self-signed certificate (requires pyOpenSSL).
global runSSLAdhoc(){
    rawPy(){
        import builtins
        _h = builtins._lx_host
        _p = builtins._lx_port
        _d = getattr(builtins, "_lx_debug", False)
        print("[Lynxer server] Running on https://" + str(_h) + ":" + str(_p) + " (adhoc SSL)")
        builtins._lx_flask.run(host=_h, port=_p, debug=_d, ssl_context="adhoc")
    }
}

global main(){}
