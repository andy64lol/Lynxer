////
  Lynxer Standard Library — server
  Full-featured HTTP server built on Flask.

  Supports:
    • Plain text / HTML routes (GET, POST, PUT, DELETE, PATCH, any-method, multi-method)
    • Routes with URL parameters: /user/<id>
    • JSON API routes (fixed and dynamic via rawPy callback)
    • Jinja2 template file and inline-string routes
    • Static file directories
    • Complete static-site hosting
    • Temporary and permanent redirects
    • Custom 404 / 500 / 403 error pages
    • CORS (wildcard or single origin)
    • Per-request logging
    • Global response headers
    • Cookie reading and setting
    • Request-context readers:
        getArg(name), getFormField(name), getBody(), getBodyJson(),
        getHeader(name), getMethod(), getURL(), getIP(),
        getContentType(), getQueryAll(), getRouteParam(name)
    • Response helpers: withStatus, jsonWithStatus
    • Max request body size
    • HTTPS / SSL
    • Debug mode

  Quick start:
    global setup(){ import("server"); }
    global main(){
        global.server.init("0.0.0.0", 8080);
        global.server.get("/", "<h1>Hello from Lynxer!</h1>");
        global.server.run();
    }
////

global setup(){}

// ── App initialisation ─────────────────────────────────────────────────────

// Create the Flask application and bind it to host:port.
// Must be called before any route registration.
global init(str host, int port){
    rawPy(){
        import os
        from flask import Flask
        import builtins
        builtins._lx_flask = Flask("lynxer",root_path=os.getcwd())
        builtins._lx_host         = host
        builtins._lx_port         = port
        builtins._lx_debug        = False
        builtins._lx_cors_origins = None
        builtins._lx_global_headers = {}
    }
}

// Enable or disable Flask debug mode (auto-reloader + debugger).
global setDebug(bool enabled){
    rawPy(){
        import builtins
        builtins._lx_debug = bool(enabled)
    }
}

// Set the folder from which Jinja2 template files are loaded.
// Defaults to the Flask app's template_folder ("templates").
global setTemplateFolder(str path){
    rawPy(){
        import builtins, os
        builtins._lx_flask.template_folder = os.path.abspath(path)
    }
}

// Set the maximum allowed request body size in bytes.
// Requests larger than this limit receive a 413 error automatically.
// Example: global.server.setMaxBodySize(1048576);  // 1 MB
global setMaxBodySize(int bytes){
    rawPy(){
        import builtins
        builtins._lx_flask.config["MAX_CONTENT_LENGTH"] = int(bytes)
    }
}

// ── Internal helper ────────────────────────────────────────────────────────

// Build a unique Flask endpoint name from path + method list
global _epName(str prefix, str path){
    str result = "";
    rawPy(){
        result = prefix + "_" + path.replace("/","_").replace("<","").replace(">","").replace(":","")
    }
    return result;
}

// ── Plain text / HTML routes ───────────────────────────────────────────────

// Register a GET route that returns *response* as HTML/text.
global get(str path, str response){
    rawPy(){
        import builtins
        _resp = response
        _p    = path
        def _h(**kw):
            hdrs = dict(getattr(builtins, "_lx_global_headers", {}))
            hdrs["Content-Type"] = "text/html; charset=utf-8"
            if getattr(builtins, "_lx_cors_origins", None):
                hdrs["Access-Control-Allow-Origin"] = builtins._lx_cors_origins
            return _resp, 200, hdrs
        _ep = "GET_" + _p.replace("/","_").replace("<","").replace(">","")
        builtins._lx_flask.add_url_rule(_p, endpoint=_ep, view_func=_h, methods=["GET"])
    }
}

// Register a GET route with a custom HTTP status code.
global getWithStatus(str path, str response, int status){
    rawPy(){
        import builtins
        _resp   = response
        _status = int(status)
        _p      = path
        def _h(**kw):
            hdrs = dict(getattr(builtins, "_lx_global_headers", {}))
            hdrs["Content-Type"] = "text/html; charset=utf-8"
            if getattr(builtins, "_lx_cors_origins", None):
                hdrs["Access-Control-Allow-Origin"] = builtins._lx_cors_origins
            return _resp, _status, hdrs
        _ep = "GWS_" + _p.replace("/","_").replace("<","").replace(">","")
        builtins._lx_flask.add_url_rule(_p, endpoint=_ep, view_func=_h, methods=["GET"])
    }
}

