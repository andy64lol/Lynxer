/// 
Lynxer Standard Library — server
Wraps Flask to provide a simple HTTP server.
///

global setup(){}

global init(str host, int port){
    rawPy(){
        from flask import Flask
        import builtins

        builtins._lx_flask = Flask(__name__)
        builtins._lx_host = host
        builtins._lx_port = port
    }
}

global get(str path, str response){
    rawPy(){
        import builtins

        def handler():
            return response

        builtins._lx_flask.add_url_rule(
            path,
            endpoint="GET_" + path.replace("/", "_"),
            view_func=handler,
            methods=["GET"]
        )
    }
}

global post(str path, str response){
    rawPy(){
        import builtins

        def handler():
            return response

        builtins._lx_flask.add_url_rule(
            path,
            endpoint="POST_" + path.replace("/", "_"),
            view_func=handler,
            methods=["POST"]
        )
    }
}

global run(){
    rawPy(){
        import builtins

        print("Server running on http://" + builtins._lx_host + ":" + str(builtins._lx_port))

        builtins._lx_flask.run(
            host=builtins._lx_host,
            port=builtins._lx_port
        )
    }
}

global main(){}