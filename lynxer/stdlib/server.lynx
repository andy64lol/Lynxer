// Register a route that accepts any HTTP method.
global anyHttp(str path, str response){
    rawPy(){
        import builtins
        _resp = response
        _p    = path
        def _h(**kw):
            hdrs = dict(getattr(builtins, "_lx_global_headers", {}))
            hdrs["Content-Type"] = "text/html; charset=utf-8"
            if getattr(builtins, "_lx_cors_origins", None):
                hdrs["Access-Control-Allow-Origin"] = builtins._lx_cors_origins
            return _resp, 200, hdrs
        _ep = "ANY_" + _p.replace("/","_").replace("<","").replace(">","")
        builtins._lx_flask.add_url_rule(
            _p, endpoint=_ep, view_func=_h,
            methods=["GET","POST","PUT","DELETE","PATCH","HEAD","OPTIONS"]
        )
    }
}

// Register a route for multiple specific methods.
// methods is a comma-separated string, e.g. "GET,POST".
global multiMethod(str path, str response, str methods){
    rawPy(){
        import builtins
        _resp    = response
        _p       = path
        _methods = [m.strip().upper() for m in methods.split(",") if m.strip()]
        def _h(**kw):
            hdrs = dict(getattr(builtins, "_lx_global_headers", {}))
            hdrs["Content-Type"] = "text/html; charset=utf-8"
            if getattr(builtins, "_lx_cors_origins", None):
                hdrs["Access-Control-Allow-Origin"] = builtins._lx_cors_origins
            return _resp, 200, hdrs
        _ep = "MULTI_" + "_".join(_methods) + "_" + _p.replace("/","_").replace("<","").replace(">","")
        builtins._lx_flask.add_url_rule(_p, endpoint=_ep, view_func=_h, methods=_methods)
    }
}

// ── JSON routes ────────────────────────────────────────────────────────────

