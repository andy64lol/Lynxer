// ── Jinja2 template routes ─────────────────────────────────────────────────

/// Register a GET route that renders a Jinja2 template file.
  templateFile is relative to the template folder (default: "templates/").
  dataJson is a JSON object whose keys become template variables,
  e.g. '{"title":"Home","user":"Alice"}'. Pass "{}" for no variables. ///
global template(str path, str templateFile, str dataJson){
    rawPy(){
        import builtins, json as _json
        from flask import render_template
        _tpl  = templateFile
        _data = dataJson
        def _h():
            try:
                ctx = _json.loads(_data) if _data.strip() else {}
            except Exception:
                ctx = {}
            hdrs = {}
            if getattr(builtins, "_lx_cors_origins", None):
                hdrs["Access-Control-Allow-Origin"] = builtins._lx_cors_origins
            return render_template(_tpl, **ctx), 200, hdrs
        builtins._lx_flask.add_url_rule(
            path, endpoint="TPL_" + path.replace("/","_").replace("<","").replace(">",""),
            view_func=_h, methods=["GET"]
        )
    }
}

/// Register a POST route that renders a Jinja2 template file with dataJson context. ///
global templatePost(str path, str templateFile, str dataJson){
    rawPy(){
        import builtins, json as _json
        from flask import render_template
        _tpl  = templateFile
        _data = dataJson
        def _h():
            try:
                ctx = _json.loads(_data) if _data.strip() else {}
            except Exception:
                ctx = {}
            hdrs = {}
            if getattr(builtins, "_lx_cors_origins", None):
                hdrs["Access-Control-Allow-Origin"] = builtins._lx_cors_origins
            return render_template(_tpl, **ctx), 200, hdrs
        builtins._lx_flask.add_url_rule(
            path, endpoint="TPLP_" + path.replace("/","_").replace("<","").replace(">",""),
            view_func=_h, methods=["POST"]
        )
    }
}

/// Register a GET route with an inline Jinja2 template string.
  templateStr is the full HTML/Jinja2 source code.
  dataJson is a JSON object of template variables, e.g. '{"name":"World"}'. ///
global templateString(str path, str templateStr, str dataJson){
    rawPy(){
        import builtins, json as _json
        from flask import render_template_string
        _tpl  = templateStr
        _data = dataJson
        def _h():
            try:
                ctx = _json.loads(_data) if _data.strip() else {}
            except Exception:
                ctx = {}
            hdrs = {}
            if getattr(builtins, "_lx_cors_origins", None):
                hdrs["Access-Control-Allow-Origin"] = builtins._lx_cors_origins
            return render_template_string(_tpl, **ctx), 200, hdrs
        builtins._lx_flask.add_url_rule(
            path, endpoint="TPLSTR_" + path.replace("/","_").replace("<","").replace(">",""),
            view_func=_h, methods=["GET"]
        )
    }
}

// ── Static files & sites ───────────────────────────────────────────────────

/// Serve files from directory under the given URL prefix.
  e.g. staticFiles("/assets", "./public/assets") serves
  ./public/assets/logo.png at /assets/logo.png. ///
global staticFiles(str urlPrefix, str directory){
    rawPy(){
        import builtins, os
        from flask import send_from_directory
        _dir = os.path.abspath(directory)
        _pfx = urlPrefix.rstrip("/")
        def _sh(filename):
            return send_from_directory(_dir, filename)
        ep = "SF_" + urlPrefix.replace("/","_")
        builtins._lx_flask.add_url_rule(
            _pfx + "/<path:filename>", endpoint=ep, view_func=_sh
        )
    }
}

/// Host a complete static site from a local directory.
  "/" serves index.html; all other paths serve the matching file.
  Ideal for deploying a Vite/React/plain-HTML build. ///
global staticSite(str directory){
    rawPy(){
        import builtins, os
        from flask import send_from_directory
        _dir = os.path.abspath(directory)
        def _root():
            return send_from_directory(_dir, "index.html")
        def _file(filename):
            return send_from_directory(_dir, filename)
        builtins._lx_flask.add_url_rule("/",                endpoint="SROOT", view_func=_root)
        builtins._lx_flask.add_url_rule("/<path:filename>", endpoint="SFILE", view_func=_file)
    }
}

/// Serve a single HTML file at path. ///
global serveFile(str path, str filepath){
    rawPy(){
        import builtins, os
        from flask import send_file
        _fp = os.path.abspath(filepath)
        def _h():
            return send_file(_fp)
        builtins._lx_flask.add_url_rule(
            path, endpoint="FILE_" + path.replace("/","_"),
            view_func=_h, methods=["GET"]
        )
    }
}

// ── Redirects ──────────────────────────────────────────────────────────────

/// Register a temporary (302) redirect from path to target URL. ///
global redirect(str path, str target){
    rawPy(){
        import builtins
        from flask import redirect as _rd
        _tgt = target
        def _h(): return _rd(_tgt, 302)
        builtins._lx_flask.add_url_rule(
            path, endpoint="RD_" + path.replace("/","_"), view_func=_h
        )
    }
}

/// Register a permanent (301) redirect from path to target URL. ///
global redirect301(str path, str target){
    rawPy(){
        import builtins
        from flask import redirect as _rd
        _tgt = target
        def _h(): return _rd(_tgt, 301)
        builtins._lx_flask.add_url_rule(
            path, endpoint="RD301_" + path.replace("/","_"), view_func=_h
        )
    }
}

// ── Error handlers ─────────────────────────────────────────────────────────

/// Register a custom 404 Not Found page. response is HTML/text. ///
global notFound(str response){
    rawPy(){
        import builtins
        _resp = response
        @builtins._lx_flask.errorhandler(404)
        def _404(e):
            return _resp, 404, {"Content-Type": "text/html; charset=utf-8"}
    }
}

/// Register a custom 500 Internal Server Error page. ///
global serverError(str response){
    rawPy(){
        import builtins
        _resp = response
        @builtins._lx_flask.errorhandler(500)
        def _500(e):
            return _resp, 500, {"Content-Type": "text/html; charset=utf-8"}
    }
}

/// Register a custom 403 Forbidden page. ///
global forbidden(str response){
    rawPy(){
        import builtins
        _resp = response
        @builtins._lx_flask.errorhandler(403)
        def _403(e):
            return _resp, 403, {"Content-Type": "text/html; charset=utf-8"}
    }
}

/// Register a custom 405 Method Not Allowed page. ///
global methodNotAllowed(str response){
    rawPy(){
        import builtins
        _resp = response
        @builtins._lx_flask.errorhandler(405)
        def _405(e):
            return _resp, 405, {"Content-Type": "text/html; charset=utf-8"}
    }
}

// ── CORS ───────────────────────────────────────────────────────────────────

/// Add Access-Control-Allow-Origin: * to every response (open CORS). ///
global cors(){
    rawPy(){
        import builtins
        builtins._lx_cors_origins = "*"
        @builtins._lx_flask.after_request
        def _cors(resp):
            resp.headers["Access-Control-Allow-Origin"]  = "*"
            resp.headers["Access-Control-Allow-Headers"] = "Content-Type, Authorization"
            resp.headers["Access-Control-Allow-Methods"] = "GET, POST, PUT, DELETE, PATCH, OPTIONS"
            return resp
    }
}

/// Allow only the specified origin (e.g. "https://example.com"). ///
global corsOrigin(str origin){
    rawPy(){
        import builtins
        _origin = origin
        builtins._lx_cors_origins = _origin
        @builtins._lx_flask.after_request
        def _cors_o(resp):
            resp.headers["Access-Control-Allow-Origin"]  = _origin
            resp.headers["Access-Control-Allow-Headers"] = "Content-Type, Authorization"
            resp.headers["Access-Control-Allow-Methods"] = "GET, POST, PUT, DELETE, PATCH, OPTIONS"
            return resp
    }
}

// ── Global response headers ────────────────────────────────────────────────

/// Append a header to every response.  Call before run(). ///
global addGlobalHeader(str key, str val){
    rawPy(){
        import builtins
        _k = key
        _v = val
        @builtins._lx_flask.after_request
        def _gh(resp):
            resp.headers[_k] = _v
            return resp
    }
}

// ── Request logging ────────────────────────────────────────────────────────

/// Log METHOD /path to stdout before every request. ///
global enableRequestLog(){
    rawPy(){
        import builtins
        @builtins._lx_flask.before_request
        def _log():
            from flask import request as _req
            print("[Lynxer server]", _req.method, _req.path)
    }
}

// ── Request context readers ────────────────────────────────────────────────

/// Return the value of URL query-string parameter name, or "" if absent.
  Example URL: /search?q=hello  →  getArg("q") returns "hello". ///
global getArg(str name){
    str result = "";
    rawPy(){
        try:
            from flask import request as _req
            result = _req.args.get(name, "")
        except Exception:
            result = ""
    }
    return result;
}

/// Return a form field from the POST body, or "" if absent. ///
global getForm(str name){
    str result = "";
    rawPy(){
        try:
            from flask import request as _req
            result = _req.form.get(name, "")
        except Exception:
            result = ""
    }
    return result;
}

/// Return the raw request body as a string (useful for JSON APIs). ///
global getBody(){
    str result = "";
    rawPy(){
        try:
            from flask import request as _req
            result = _req.get_data(as_text=True)
        except Exception:
            result = ""
    }
    return result;
}

/// Return the value of a request header, or "" if absent. ///
global getHeader(str name){
    str result = "";
    rawPy(){
        try:
            from flask import request as _req
            result = _req.headers.get(name, "")
        except Exception:
            result = ""
    }
    return result;
}

/// Return the HTTP method of the current request ("GET", "POST", etc.). ///
global getMethod(){
    str result = "";
    rawPy(){
        try:
            from flask import request as _req
            result = _req.method
        except Exception:
            result = ""
    }
    return result;
}

/// Return the full URL of the current request. ///
global getUrl(){
    str result = "";
    rawPy(){
        try:
            from flask import request as _req
            result = _req.url
        except Exception:
            result = ""
    }
    return result;
}

/// Return the request path (without host or query string). ///
global getPath(){
    str result = "";
    rawPy(){
        try:
            from flask import request as _req
            result = _req.path
        except Exception:
            result = ""
    }
    return result;
}

/// Return the remote IP address of the client. ///
global getRemoteAddr(){
    str result = "";
    rawPy(){
        try:
            from flask import request as _req
            result = _req.remote_addr or ""
        except Exception:
            result = ""
    }
    return result;
}

/// Return the value of a cookie from the current request, or "" if absent. ///
global getCookie(str name){
    str result = "";
    rawPy(){
        try:
            from flask import request as _req
            result = _req.cookies.get(name, "")
        except Exception:
            result = ""
    }
    return result;
}

/// Return the Content-Type header of the current request. ///
global getContentType(){
    str result = "";
    rawPy(){
        try:
            from flask import request as _req
            result = _req.content_type or ""
        except Exception:
            result = ""
    }
    return result;
}

// ── Server startup ─────────────────────────────────────────────────────────

/// Start the server (blocking). Uses host and port set by init(). ///
global run(){
    rawPy(){
        import builtins
        _h = builtins._lx_host
        _p = builtins._lx_port
        _d = getattr(builtins, "_lx_debug", False)
        print("[Lynxer server] Running on http://" + str(_h) + ":" + str(_p))
        builtins._lx_flask.run(host=_h, port=_p, debug=_d)
    }
}

/// Start the server with SSL/HTTPS.
  cert and key are paths to PEM certificate and private-key files. ///
global runHTTPS(str cert, str key){
    rawPy(){
        import builtins
        _h    = builtins._lx_host
        _p    = builtins._lx_port
        _d    = getattr(builtins, "_lx_debug", False)
        _cert = cert
        _key  = key
        print("[Lynxer server] Running on https://" + str(_h) + ":" + str(_p))
        builtins._lx_flask.run(host=_h, port=_p, debug=_d, ssl_context=(_cert, _key))
    }
}

/// Start the server with an auto-generated self-signed certificate (requires pyOpenSSL). ///
global runSSLAdhoc(){
    rawPy(){
        import builtins
        _h = builtins._lx_host
        _p = builtins._lx_port
        _d = getattr(builtins, "_lx_debug", False)
        print("[Lynxer server] Running on https://" + str(_h) + ":" + str(_p) + " (adhoc SSL)")
        builtins._lx_flask.run(host=_h, port=_p, debug=_d, ssl_context="adhoc")
    }
}

global main(){}
