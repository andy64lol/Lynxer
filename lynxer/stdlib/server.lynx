////
Lynxer standard library: server.
HTTP and WebSocket server backed by Rust (`axum` on `tokio`), exposed through
the native module `stdlib/server.so`. Register routes, then start/stop a
listener on 127.0.0.1.

Requires a Rust toolchain to build (see `rust/server`); the module is skipped
when `cargo` is unavailable.
////
fn setup(){ importAs("server.so", "nativeServer"); }

fn routeGet(str path, str body) -> str {
    return global.nativeServer.routeGet(path, body);
}
fn routePost(str path, str body) -> str {
    return global.nativeServer.routePost(path, body);
}
fn routeGetCallback(str path, str handlerName) -> str {
    return global.nativeServer.routeGetCallback(path, handlerName);
}
fn routePostCallback(str path, str handlerName) -> str {
    return global.nativeServer.routePostCallback(path, handlerName);
}
fn routeCallback(str path, str handlerName) -> str {
    return global.nativeServer.routeCallback(path, handlerName);
}
fn respond(int status, str contentType, str body) -> str {
    return global.nativeServer.respond(status, contentType, body);
}
// Register fixed HTML responses. These aliases match the higher-level server
// API while routeGet/routePost remain available for existing Lynxer programs.
fn get(str path, str html) -> str {
    return routeGet(path, html);
}
fn post(str path, str html) -> str {
    return routePost(path, html);
}
fn htmlGet(str path, str html) -> str {
    return routeGet(path, html);
}
fn htmlPost(str path, str html) -> str {
    return routePost(path, html);
}
fn routeEcho(str path) -> str { return global.nativeServer.routeEcho(path); }
fn wsEcho(str path) -> str { return global.nativeServer.wsEcho(path); }
fn clearRoutes() -> str { return global.nativeServer.clearRoutes(); }
fn start(int port) -> str { return global.nativeServer.start(port); }
fn stop() -> str { return global.nativeServer.stop(); }
fn running() -> bool { return global.nativeServer.running() isnt 0; }
fn port() -> int { return global.nativeServer.port(); }

// Additional HTTP verbs and JSON/template/file route kinds.
fn put(str path, str body) -> str { return global.nativeServer.put(path, body); }
fn delete(str path, str body) -> str { return global.nativeServer.delete(path, body); }
fn patch(str path, str body) -> str { return global.nativeServer.patch(path, body); }
fn anyHttp(str path, str body) -> str { return global.nativeServer.anyHttp(path, body); }
fn getStatus(str path, str body, int status) -> str {
    return global.nativeServer.getStatus(path, body, status);
}
fn jsonGet(str path, str json) -> str {
    return global.nativeServer.jsonGet(path, json);
}
fn jsonPost(str path, str json) -> str {
    return global.nativeServer.jsonPost(path, json);
}
fn jsonRoute(str path, str json) -> str {
    return global.nativeServer.jsonRoute(path, json);
}
fn jsonStatus(str path, str json, int status) -> str {
    return global.nativeServer.jsonStatus(path, json, status);
}
fn redirect(str path, str target) -> str {
    return global.nativeServer.redirect(path, target);
}
fn redirect301(str path, str target) -> str {
    return global.nativeServer.redirect301(path, target);
}
fn template(str path, str file, str dataJson) -> str {
    return global.nativeServer.template(path, file, dataJson);
}
fn templatePost(str path, str file, str dataJson) -> str {
    return global.nativeServer.templatePost(path, file, dataJson);
}
fn templateString(str path, str source, str dataJson) -> str {
    return global.nativeServer.templateString(path, source, dataJson);
}
fn serveFile(str path, str filepath) -> str {
    return global.nativeServer.serveFile(path, filepath);
}
fn staticFiles(str prefix, str directory) -> str {
    return global.nativeServer.staticFiles(prefix, directory);
}
fn staticSite(str directory) -> str {
    return global.nativeServer.staticSite(directory);
}
fn setTemplateFolder(str folder) -> str {
    return global.nativeServer.setTemplateFolder(folder);
}
// Custom error bodies.
fn notFound(str body) -> str { return global.nativeServer.notFound(body); }
fn serverError(str body) -> str { return global.nativeServer.serverError(body); }
fn forbidden(str body) -> str { return global.nativeServer.forbidden(body); }
fn methodNotAllowed(str body) -> str {
    return global.nativeServer.methodNotAllowed(body);
}
// Middleware.
fn cors() -> str { return global.nativeServer.cors(); }
fn corsOrigin(str origin) -> str { return global.nativeServer.corsOrigin(origin); }
fn addGlobalHeader(str key, str value) -> str {
    return global.nativeServer.addGlobalHeader(key, value);
}
fn enableRequestLog() -> str { return global.nativeServer.enableRequestLog(); }
fn setDebug(bool enabled) -> str { return global.nativeServer.setDebug(enabled); }
// Readers for the most recently handled request.
fn getMethod() -> str { return global.nativeServer.getMethod(); }
fn getPath() -> str { return global.nativeServer.getPath(); }
fn getUrl() -> str { return global.nativeServer.getUrl(); }
fn getBody() -> str { return global.nativeServer.getBody(); }
fn getContentType() -> str { return global.nativeServer.getContentType(); }
fn getRemoteAddr() -> str { return global.nativeServer.getRemoteAddr(); }
fn getHeader(str name) -> str { return global.nativeServer.getHeader(name); }
fn getCookie(str name) -> str { return global.nativeServer.getCookie(name); }
fn getArg(str name) -> str { return global.nativeServer.getArg(name); }
fn getForm(str name) -> str { return global.nativeServer.getForm(name); }
// Lifecycle.
fn init(str host, int port) -> str { return global.nativeServer.init(host, port); }
fn run() -> str { return global.nativeServer.run(); }
fn runHTTPS(str cert, str key) -> str {
    return global.nativeServer.runHTTPS(cert, key);
}
fn runSSLAdhoc() -> str { return global.nativeServer.runSSLAdhoc(); }

fn main(){}
