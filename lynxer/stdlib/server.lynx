///
  Lynxer Standard Library — server
  Full-featured HTTP server built on Flask.

  Supports:
    • Plain text / HTML routes (GET, POST, PUT, DELETE, any-method)
    • JSON API routes
    • Jinja2 template file and inline-string routes
    • Static file directories
    • Complete static-site hosting  
    • Temporary and permanent redirects
    • Custom 404 / 500 / 403 error pages
    • CORS (wildcard or single origin)
    • Per-request logging
    • Global response headers
    • Request-context readers (args, form, body, headers, method, URL, IP)
    • HTTPS / SSL
    • Debug mode

  Quick start:
    global setup(){ import("server"); }
    global main(){
        global.server.init("0.0.0.0", 8080);
        global.server.get("/", "<h1>Hello from Lynxer!</h1>");
        global.server.run();
    }
///

global setup(){}

// ── App initialisation ─────────────────────────────────────────────────────

/// Create the Flask application and bind it to host:port.
  Must be called before any route registration. ///
global init(str host, int port){
    rawPy(){
        from flask import Flask
        import builtins
        builtins._lx_flask        = Flask(__name__)
        builtins._lx_host         = host
        builtins._lx_port         = port
        builtins._lx_debug        = False
        builtins._lx_cors_origins = None
    }
}

/// Enable or disable Flask debug mode (auto-reloader + debugger). ///
global setDebug(bool enabled){
    rawPy(){
        import builtins
        builtins._lx_debug = bool(enabled)
    }
}

/// Set the folder from which Jinja2 template files are loaded.
  Defaults to the Flask app's template_folder ("templates"). ///
global setTemplateFolder(str path){
    rawPy(){
        import builtins, os
        builtins._lx_flask.template_folder = os.path.abspath(path)
    }
}

// ── Plain text / HTML routes ───────────────────────────────────────────────

/// Register a GET route that returns response as HTML/text. ///
global get(str path, str response){
    rawPy(){
        import builtins
        _resp = response
        def _h():
            hdrs = {"Content-Type": "text/html; charset=utf-8"}
            if getattr(builtins, "_lx_cors_origins", None):
                hdrs["Access-Control-Allow-Origin"] = builtins._lx_cors_origins
            return _resp, 200, hdrs
        builtins._lx_flask.add_url_rule(
            path, endpoint="GET_" + path.replace("/","_").replace("<","").replace(">",""),
            view_func=_h, methods=["GET"]
        )
    }
}

