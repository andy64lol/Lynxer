////
Lynxer standard library: numutils.
Exact decimal and rational (fraction) arithmetic, backed by Rust crates
(`rust_decimal`, `num-rational`) and exposed through the native module
`stdlib/numutils.so`.

Floating point makes `0.1 + 0.2` print as `0.30000000000000004`. This module
keeps values as canonical strings and does the arithmetic exactly, so results
round-trip cleanly. Use the `*ToFloat` helpers (or `int()`) to get a native
number back when needed.

Requires a Rust toolchain to build (see `rust/numutils`).
////
fn setup(){ importAs("numutils.so", "nativeNumutils"); }

// --- decimal ---------------------------------------------------------------

// Constructs a canonical decimal string from any value (int, float, or str).
fn decimal(any value) -> str {
    if (returnType(value) is "int") { return global.nativeNumutils.decimalFromInt(value); }
    if (returnType(value) is "float") { return global.nativeNumutils.decimalFromFloat(value); }
    return global.nativeNumutils.decimalFromStr(strOf(value));
}

// Exact decimal arithmetic. Operands may be int, float, str, or decimal strings.
fn decimalAdd(any a, any b) -> str {
    str da = decimal(a);
    str db = decimal(b);
    return global.nativeNumutils.decimalAdd(da, db);
}
fn decimalSub(any a, any b) -> str {
    str da = decimal(a);
    str db = decimal(b);
    return global.nativeNumutils.decimalSub(da, db);
}
fn decimalMul(any a, any b) -> str {
    str da = decimal(a);
    str db = decimal(b);
    return global.nativeNumutils.decimalMul(da, db);
}
fn decimalDiv(any a, any b) -> str {
    str da = decimal(a);
    str db = decimal(b);
    return global.nativeNumutils.decimalDiv(da, db);
}
// Division rounded to `places` decimal places.
fn decimalDivScale(any a, any b, int places) -> str {
    str da = decimal(a);
    str db = decimal(b);
    return global.nativeNumutils.decimalDivScale(da, db, places);
}
fn decimalNeg(any value) -> str {
    return global.nativeNumutils.decimalNeg(decimal(value));
}
fn decimalAbs(any value) -> str {
    return global.nativeNumutils.decimalAbs(decimal(value));
}
fn decimalRound(any value, int places) -> str {
    return global.nativeNumutils.decimalRound(decimal(value), places);
}
// Returns -1 / 0 / 1.
fn decimalCmp(any a, any b) -> int {
    str da = decimal(a);
    str db = decimal(b);
    return global.nativeNumutils.decimalCmp(da, db);
}
fn decimalEq(any a, any b) -> bool {
    str da = decimal(a);
    str db = decimal(b);
    return global.nativeNumutils.decimalEq(da, db) isnt 0;
}
fn decimalPow(any value, int exponent) -> str {
    return global.nativeNumutils.decimalPow(decimal(value), exponent);
}
fn decimalToFloat(str value) -> float {
    return global.nativeNumutils.decimalToFloat(value);
}
fn decimalToInt(str value) -> int {
    return global.nativeNumutils.decimalToInt(value);
}

// --- fraction --------------------------------------------------------------

// Builds a canonical (reduced) fraction string from a numerator and denominator.
fn fraction(any num, any den) -> str {
    if (returnType(num) is "int" and returnType(den) is "int") {
        return global.nativeNumutils.fractionFromInts(num, den);
    }
    str n = decimal(num);
    str d = decimal(den);
    str fracN = global.nativeNumutils.fractionFromDecimal(n);
    str fracD = global.nativeNumutils.fractionFromDecimal(d);
    // divide the two fractions
    return global.nativeNumutils.fractionDiv(fracN, fracD);
}
// Parses a fraction string ("a/b" or an integer).
fn fractionParse(str value) -> str {
    return global.nativeNumutils.fractionFromStr(value);
}

fn fractionAdd(any a, any b) -> str {
    str fa = fractionToFraction(a);
    str fb = fractionToFraction(b);
    return global.nativeNumutils.fractionAdd(fa, fb);
}
fn fractionSub(any a, any b) -> str {
    str fa = fractionToFraction(a);
    str fb = fractionToFraction(b);
    return global.nativeNumutils.fractionSub(fa, fb);
}
fn fractionMul(any a, any b) -> str {
    str fa = fractionToFraction(a);
    str fb = fractionToFraction(b);
    return global.nativeNumutils.fractionMul(fa, fb);
}
fn fractionDiv(any a, any b) -> str {
    str fa = fractionToFraction(a);
    str fb = fractionToFraction(b);
    return global.nativeNumutils.fractionDiv(fa, fb);
}
fn fractionNeg(any value) -> str {
    return global.nativeNumutils.fractionNeg(fractionToFraction(value));
}
fn fractionAbs(any value) -> str {
    return global.nativeNumutils.fractionAbs(fractionToFraction(value));
}
fn fractionCmp(any a, any b) -> int {
    str fa = fractionToFraction(a);
    str fb = fractionToFraction(b);
    return global.nativeNumutils.fractionCmp(fa, fb);
}
fn fractionEq(any a, any b) -> bool {
    str fa = fractionToFraction(a);
    str fb = fractionToFraction(b);
    return global.nativeNumutils.fractionEq(fa, fb) isnt 0;
}
fn fractionToFloat(str value) -> float {
    return global.nativeNumutils.fractionToFloat(value);
}
fn fractionToDecimal(str value, int places) -> str {
    return global.nativeNumutils.fractionToDecimal(value, places);
}
fn fractionNumerator(str value) -> str {
    return global.nativeNumutils.fractionNumerator(value);
}
fn fractionDenominator(str value) -> str {
    return global.nativeNumutils.fractionDenominator(value);
}

// helper: normalize any value into a fraction string
fn fractionToFraction(any value) -> str {
    if (returnType(value) is "str") {
        str s = value;
        return global.nativeNumutils.fractionFromStr(s);
    }
    if (returnType(value) is "int") {
        return global.nativeNumutils.fractionFromInts(value, 1);
    }
    str d = decimal(value);
    return global.nativeNumutils.fractionFromDecimal(d);
}

// --- misc ------------------------------------------------------------------

// Returns the shortest round-tripping decimal text for a float.
fn cleanFloat(float value) -> str {
    return global.nativeNumutils.cleanFloat(value);
}
