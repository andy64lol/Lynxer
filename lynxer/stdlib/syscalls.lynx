////
Linux named syscall functions, backed by the native syscalls module.
Select the host OS and architecture with select() before calling a syscall.
////

fn setup() {
    importAs("syscalls_native.so", "nativeSyscalls");
    str selectedOS = "";
    str selectedArch = "";
}

fn select(str os, str arch) {
    str canonicalOS = "";
    if (os is "linux" or os is "Linux" or os is "LINUX") {
        canonicalOS = "Linux";
    } else {
        raise("unknown syscall operating system '" + os + "'");
    }
    str canonicalArch = "";
    if (arch is "amd64" or arch is "x86-64") {
        canonicalArch = "amd64";
    } else if (arch is "arm64" or arch is "aarch64") {
        canonicalArch = "arm64";
    } else {
        raise("unknown syscall architecture '" + arch + "'");
    }
    if (nativeSyscalls.platform() isnt "linux") {
        raise("syscalls() is not available on this operating system");
    }
    if (canonicalArch isnt nativeSyscalls.architecture()) {
        raise("syscalls(\"" + arch + "\") selects " +
              canonicalArch + ", but this machine is " +
              nativeSyscalls.architecture());
    }
    selectedOS = canonicalOS;
    selectedArch = canonicalArch;
}

fn invoke(str targetArch, str name, int count, int a0 = 0, int a1 = 0,
          int a2 = 0, int a3 = 0, int a4 = 0, int a5 = 0) -> int {
    if (selectedOS is "") {
        raise("syscalls.select(\"Linux\", \"" + targetArch +
              "\") must run before a syscall call");
    }
    if (selectedArch isnt targetArch) {
        raise(targetArch + "." + name + "() needs syscalls.select(\"Linux\", \"" +
              targetArch + "\"), but this program selected \"" +
              selectedOS + "\", \"" + selectedArch + "\"");
    }
    int result = nativeSyscalls.call(name, count, a0, a1, a2, a3, a4, a5);
    if (result is -1) {
        raise(nativeSyscalls.lastError());
    }
    return result;
}

