////
  Lynxer Standard Library — typing
  Provides: toStr, toInt, toFloat, toBool, isNumeric, lenStr,
            repeat, contains,
            toList, isList, lenList, flatten, unique
////

global setup(){}

global toStr(int n){
    str result = "";
    rawPy(){
        result = str(n)
    }
    return result;
}

global toInt(str s){
    int result = 0;
    rawPy(){
        try:
            result = int(float(s))
        except Exception:
            result = 0
    }
    return result;
}

global toFloat(str s){
    float result = 0.0;
    rawPy(){
        try:
            result = float(s)
        except Exception:
            result = 0.0
    }
    return result;
}

global toBool(int n){
    if(n not is 0){
        return true;
    }
    return false;
}

global isNumeric(str s){
    int result = 0;
    rawPy(){
        try:
            float(s)
            result = 1
        except Exception:
            result = 0
    }
    if(result not is 0){ return true; }
    return false;
}

global lenStr(str s){
    return returnLength(s);
}

global repeat(str s, int n){
    str result = "";
    rawPy(){
        result = s * n
    }
    return result;
}

global contains(str haystack, str needle){
    int result = 0;
    rawPy(){
        result = 1 if needle in haystack else 0
    }
    if(result not is 0){ return true; }
    return false;
}

// Splits a string by sep and returns a list.
global toList(str s, str sep){
    return splitStr(s, sep);
}

// Returns 1 if val is a list, 0 otherwise.
global isList(any val){
    if(returnType(val) is "list"){
        return true;
    }
    return false;
}

// Returns the number of elements in a list (alias for returnLength).
global lenList(list lst){
    return returnLength(lst);
}

// Flattens one level of nested lists into a single flat list.
global flatten(list lst){
    return listFlatten(lst);
}

// Returns a new list with duplicate values removed (order preserved).
global unique(list lst){
    return listUnique(lst);
}

// Strip leading and trailing whitespace from s.
global trim(str s){
    str result = "";
    rawPy(){
        result = s.strip()
    }
    return result;
}

// Convert s to uppercase.
global upper(str s){
    str result = "";
    rawPy(){
        result = s.upper()
    }
    return result;
}

// Convert s to lowercase.
global lower(str s){
    str result = "";
    rawPy(){
        result = s.lower()
    }
    return result;
}

// Returns true if s starts with prefix.
global startsWith(str s, str prefix){
    int result = 0;
    rawPy(){
        result = 1 if s.startswith(prefix) else 0
    }
    if(result not is 0){ return true; }
    return false;
}

// Returns true if s ends with suffix.
global endsWith(str s, str suffix){
    int result = 0;
    rawPy(){
        result = 1 if s.endswith(suffix) else 0
    }
    if(result not is 0){ return true; }
    return false;
}

// Replace all occurrences of old with new in s.
global replace(str s, str old, str new){
    str result = "";
    rawPy(){
        result = s.replace(old, new)
    }
    return result;
}

// Return the index of the first occurrence of sub in s, or -1 if not found.
global indexOf(str s, str sub){
    int result = 0;
    rawPy(){
        result = s.find(sub)
    }
    return result;
}

// Return s[start:end] (Python-style slice). Negative indices count from the end.
global substr(str s, int start, int end){
    str result = "";
    rawPy(){
        result = s[start:end]
    }
    return result;
}

// Left-pad s with ch until it is at least width characters wide.
global padLeft(str s, int width, str ch){
    str result = "";
    rawPy(){
        pad_ch = ch[0] if ch else " "
        result = s.rjust(width, pad_ch)
    }
    return result;
}

// Right-pad s with ch until it is at least width characters wide.
global padRight(str s, int width, str ch){
    str result = "";
    rawPy(){
        pad_ch = ch[0] if ch else " "
        result = s.ljust(width, pad_ch)
    }
    return result;
}

// Return s with its characters in reverse order.
global strReverse(str s){
    str result = "";
    rawPy(){
        result = s[::-1]
    }
    return result;
}

// Return the Unicode code point of the first character of s.
// Returns -1 if s is empty.
global charCode(str s){
    int result = -1;
    rawPy(){
        try:
            result = ord(s[0]) if s else -1
        except Exception:
            result = -1
    }
    return result;
}

// Return the character whose Unicode code point is code. Returns "" on error.
global charOf(int code){
    str result = "";
    rawPy(){
        try:
            result = chr(code)
        except Exception:
            result = ""
    }
    return result;
}

// Count how many times sub appears in s (non-overlapping).
global countOccurrences(str s, str sub){
    int result = 0;
    rawPy(){
        try:
            result = s.count(sub) if sub else 0
        except Exception:
            result = 0
    }
    return result;
}

// Split s on the first occurrence of sep and return a 2-element list.
// If sep is not found the second element is "".
global splitFirst(str s, str sep){
    str result = "";
    rawPy(){
        if sep and sep in s:
            idx    = s.index(sep)
            first  = s[:idx]
            second = s[idx + len(sep):]
            result = first + "\x1f" + second
        else:
            result = s + "\x1f"
    }
    return splitStr(result, "\x1f");
}

// Centre s in a field of width characters, padded with ch on both sides.
global center(str s, int width, str ch){
    str result = "";
    rawPy(){
        pad_ch = ch[0] if ch else " "
        result = s.center(width, pad_ch)
    }
    return result;
}

// Strip leading whitespace from s.
global stripLeft(str s){
    str result = "";
    rawPy(){
        result = s.lstrip()
    }
    return result;
}

// Strip trailing whitespace from s.
global stripRight(str s){
    str result = "";
    rawPy(){
        result = s.rstrip()
    }
    return result;
}

// Return true if every character in s is a letter (a-z, A-Z). Returns false if empty.
global isAlpha(str s){
    bool result = false;
    rawPy(){
        result = s.isalpha()
    }
    return result;
}

// Return true if every character in s is a decimal digit. Returns false if empty.
global isDigit(str s){
    bool result = false;
    rawPy(){
        result = s.isdigit()
    }
    return result;
}

// Return true if every character in s is alphanumeric. Returns false if empty.
global isAlphaNum(str s){
    bool result = false;
    rawPy(){
        result = s.isalnum()
    }
    return result;
}

// Return true if every character in s is a whitespace character. Returns false if empty.
global isSpace(str s){
    bool result = false;
    rawPy(){
        result = s.isspace()
    }
    return result;
}

// Convert s to title case (first letter of each word capitalised).
global titleCase(str s){
    str result = "";
    rawPy(){
        result = s.title()
    }
    return result;
}

// Swap the case of every character in s (upper↔lower).
global swapCase(str s){
    str result = "";
    rawPy(){
        result = s.swapcase()
    }
    return result;
}

// Repeat s exactly n times.
global repeatStr(str s, int n){
    str result = "";
    rawPy(){
        result = s * max(0, n)
    }
    return result;
}

// Return a string of n space characters.
global spaces(int n){
    str result = "";
    rawPy(){
        result = " " * max(0, n)
    }
    return result;
}

// Wrap long text to at most width characters per line, returning the wrapped text.
global wordWrap(str s, int width){
    str result = "";
    rawPy(){
        import textwrap as _tw
        result = _tw.fill(s, width)
    }
    return result;
}

// Expand tab characters in s to spaces, using tabSize-character tab stops.
global expandTabs(str s, int tabSize){
    str result = "";
    rawPy(){
        result = s.expandtabs(tabSize)
    }
    return result;
}


// ─── Type checks ───────────────────────────────────────────────────────────

// Return true if val is a char.
global isChar(any val){
    if(returnType(val) is "char"){ return true; }
    return false;
}

// Convert a single-char string or an int char-code to a char.
global toChar(any val){
    str kind = returnType(val);
    if(kind is "char"){ return val; }
    if(kind is "int"){
        str result = "";
        rawPy(){
            try:
                result = chr(val)
            except Exception:
                result = "\0"
        }
        char c = result;
        return c;
    }
    if(kind is "str"){
        char c = val;
        return c;
    }
    char fallback = "\0";
    return fallback;
}

// Return the Unicode code point of a char or the first char of a string.
global charCodeOf(any val){
    int result = -1;
    rawPy(){
        try:
            result = ord(str(val)[0])
        except Exception:
            result = -1
    }
    return result;
}

// Return the char at index idx in string s.
global charAt(str s, int idx){
    str sub = "";
    rawPy(){
        try:
            sub = s[idx]
        except Exception:
            sub = ""
    }
    if(sub is ""){ return none; }
    char c = sub;
    return c;
}

// Return true if val is int or float (i.e. numeric).
global isNum(any val){
    str t = returnType(val);
    if(t is "int"){ return true; }
    if(t is "float"){ return true; }
    return false;
}

// Return true if val is an int.
global isInt(any val){
    if(returnType(val) is "int"){ return true; }
    return false;
}

// Return true if val is a float.
global isFloat(any val){
    if(returnType(val) is "float"){ return true; }
    return false;
}

// Return true if val is a str.
global isStr(any val){
    if(returnType(val) is "str"){ return true; }
    return false;
}

// Return true if val is a bool.
global isBool(any val){
    if(returnType(val) is "bool"){ return true; }
    return false;
}

// Return true if val is a tuple.
global isTuple(any val){
    if(returnType(val) is "tuple"){ return true; }
    return false;
}

// Return true if val is none.
global isNone(any val){
    if(returnType(val) is "none"){ return true; }
    return false;
}

// ─── List extras ───────────────────────────────────────────────────────────

// Return the first element of lst. Runtime error if lst is empty.
global listFirst(list lst){
    return listGet(lst, 0);
}

// Return the last element of lst. Runtime error if lst is empty.
global listLast(list lst){
    int idx = returnLength(lst) - 1;
    return listGet(lst, idx);
}

// Return the first n elements of lst as a new list.
global listHead(list lst, int n){
    return listSlice(lst, 0, n);
}

// Return the last n elements of lst as a new list.
global listTail(list lst, int n){
    int len = returnLength(lst);
    int start = len - n;
    if(start < 0){ start = 0; }
    return listSlice(lst, start, len);
}

// Sum all numeric elements in lst (alias for sumOf).
global listSum(list lst){
    return sumOf(lst);
}

// Count how many times val appears in lst.
global listCount(list lst, any val){
    int count = 0;
    int i = 0;
    int len = returnLength(lst);
    while(i < len){
        any elem = listGet(lst, i);
        if(strOf(elem) is strOf(val)){ count = count + 1; }
        i = i + 1;
    }
    return count;
}

// Zip two lists into a list of JSON pair strings: ["{\"a\":v1,\"b\":v2}", ...].
// Length is min(len(lst1), len(lst2)).
global listZip(list lst1, list lst2){
    int len1 = returnLength(lst1);
    int len2 = returnLength(lst2);
    int len = len1;
    if(len2 < len1){ len = len2; }
    list result = seqFromTo(0, -1, 1);
    int i = 0;
    while(i < len){
        any a = listGet(lst1, i);
        any b = listGet(lst2, i);
        str pair = "";
        rawPy(){
            import json as _json
            pair = _json.dumps({"a": str(a), "b": str(b)})
        }
        result = listPush(result, pair);
        i = i + 1;
    }
    return result;
}

// ─── Number extras ─────────────────────────────────────────────────────────

// Clamp n to the range [lo, hi]. Returns lo if n < lo, hi if n > hi.
global clamp(float n, float lo, float hi){
    if(n < lo){ return lo; }
    if(n > hi){ return hi; }
    return n;
}

// Absolute value of n.
global abs(num n){
    if(n < 0){ return n * -1; }
    return n;
}

// Sign of n: returns 1 if n > 0, -1 if n < 0, 0 if n is 0.
global sign(num n){
    if(n > 0){ return 1; }
    if(n < 0){ return -1; }
    return 0;
}

// Return the larger of two numeric values.
global maxOf(num a, num b){
    if(a > b){ return a; }
    return b;
}

// Return the smaller of two numeric values.
global minOf(num a, num b){
    if(a < b){ return a; }
    return b;
}

// Return true if lo <= n <= hi.
global between(num n, num lo, num hi){
    if(n >= lo and n <= hi){ return true; }
    return false;
}

// Round n to digits decimal places.
global roundTo(float n, int digits){
    float result = 0.0;
    rawPy(){
        result = round(n, digits)
    }
    return result;
}

// ─── String extras ─────────────────────────────────────────────────────────

// Zero-pad s on the left to at least width characters.
global zfill(str s, int width){
    str result = "";
    rawPy(){
        result = s.zfill(width)
    }
    return result;
}

// Split s by newlines and return a list of lines.
global linesOf(str s){
    return splitStr(s, "\n");
}

// ─── List extras continued ─────────────────────────────────────────────────

// Average (mean) of all numeric elements in lst.
global listAvg(list lst){
    int len = returnLength(lst);
    if(len is 0){ return 0.0; }
    float total = sumOf(lst);
    float result = 0.0;
    rawPy(){
        result = total / len
    }
    return result;
}

// Return a new list of n copies of val.
global listRepeat(any val, int n){
    list result = range(0, 0, 1);
    int i = 0;
    while(i < n){
        result = listPush(result, val);
        i = i + 1;
    }
    return result;
}

// Split lst into consecutive chunks of size n.
// The last chunk may be smaller than n. Returns a list of lists encoded
// as JSON arrays (use listGet + json.parseArray to access).
global listChunk(list lst, int n){
    list result = range(0, 0, 1);
    int len = returnLength(lst);
    int i = 0;
    while(i < len){
        int stop = i + n;
        if(stop > len){ stop = len; }
        list chunk = listSlice(lst, i, stop);
        str encoded = "";
        rawPy(){
            import json as _json
            encoded = _json.dumps(chunk)
        }
        result = listPush(result, encoded);
        i = i + n;
    }
    return result;
}

// ─── Tuple extras ──────────────────────────────────────────────────────────
// These functions compose the built-in tupleXxx() functions.
// The core built-ins (tupleCreate, tupleGet, tupleLen, tupleContains,
// tupleIndex, tupleSlice, tupleToList, listToTuple, tupleConcat, tupleCount,
// tupleFirst, tupleLast, tupleJsonArray) are always available without import.

// Return a new tuple with the elements in reversed order.
global tupleReverse(any t){
    list lst = tupleToList(t);
    lst = reverseList(lst);
    return listToTuple(lst);
}

// Return a new tuple sorted in ascending order (numeric or string).
global tupleSort(any t){
    list lst = tupleToList(t);
    lst = sortList(lst);
    return listToTuple(lst);
}

// Return a new tuple sorted in descending order.
global tupleSortDesc(any t){
    list lst = tupleToList(t);
    lst = sortList(lst, true);
    return listToTuple(lst);
}

// Return the minimum element of a numeric tuple.
global tupleMin(any t){
    list lst = tupleToList(t);
    return listMin(lst);
}

// Return the maximum element of a numeric tuple.
global tupleMax(any t){
    list lst = tupleToList(t);
    return listMax(lst);
}

// Return the sum of all elements in a numeric tuple.
global tupleSum(any t){
    list lst = tupleToList(t);
    return sumOf(lst);
}

// Return true if any element in the tuple is truthy.
global tupleAny(any t){
    list lst = tupleToList(t);
    return anyOf(lst);
}

// Return true if all elements in the tuple are truthy.
global tupleAll(any t){
    list lst = tupleToList(t);
    return allOf(lst);
}

// Return a new tuple with duplicate values removed (order preserved).
global tupleUnique(any t){
    list lst = tupleToList(t);
    lst = listUnique(lst);
    return listToTuple(lst);
}

// Return the average (mean) of a numeric tuple.
global tupleMean(any t){
    int len = tupleLen(t);
    if(len is 0){ return 0.0; }
    float s = tupleSum(t);
    float result = 0.0;
    rawPy(){
        result = s / len
    }
    return result;
}

// Flatten one level: if elements are themselves tuples, concatenate them.
global tupleFlatten(any t){
    any result = tupleCreate();
    int i = 0;
    int len = tupleLen(t);
    while(i < len){
        any elem = tupleGet(t, i);
        str kind = returnType(elem);
        if(kind is "tuple"){
            result = tupleConcat(result, elem);
        }
        if(kind not is "tuple"){
            result = tupleConcat(result, tupleCreate(elem));
        }
        i = i + 1;
    }
    return result;
}

// Zip two tuples into a list of JSON pair strings: ["{\"a\":v1,\"b\":v2}", ...]
global tupleZip(any t1, any t2){
    int len1 = tupleLen(t1);
    int len2 = tupleLen(t2);
    int len = len1;
    if(len2 < len1){ len = len2; }
    any result = seqFromTo(0, -1, 1);
    int i = 0;
    while(i < len){
        any a = tupleGet(t1, i);
        any b = tupleGet(t2, i);
        str pair = "";
        rawPy(){
            import json as _json
            pair = _json.dumps({"a": str(a), "b": str(b)})
        }
        result = listPush(result, pair);
        i = i + 1;
    }
    return result;
}

// Return a comma-separated string of the tuple's elements.
global tupleJoin(any t, str sep){
    list lst = tupleToList(t);
    return listJoin(lst, sep);
}

global main(){}
