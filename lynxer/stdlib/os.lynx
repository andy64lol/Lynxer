////
Lynxer standard library: os.
Operating system, filesystem, environment and platform helpers backed by the
native C++ module `stdlib/os.so`.

Directory listings return newline-joined entries; the wrapper splits them into
lists. Platform helpers report the host through uname(2).
////
fn setup(){ importAs("os.so", "nativeOs"); }

// ---------- Files and directories ----------
fn getcwd() -> str { return global.nativeOs.getcwd(); }
fn chdir(str path) -> bool { return global.nativeOs.chdir(path) isnt 0; }
fn listdir(str path) -> list {
    str raw = global.nativeOs.listdir(path);
    if(raw is ""){ return seqFromTo(0, 0, 1); }
    return splitStr(raw, "\n");
}
fn mkdir(str path) -> bool { return global.nativeOs.mkdir(path) isnt 0; }
fn makedirs(str path) -> bool { return global.nativeOs.makedirs(path) isnt 0; }
fn rmdir(str path) -> bool { return global.nativeOs.rmdir(path) isnt 0; }
fn remove(str path) -> bool { return global.nativeOs.remove(path) isnt 0; }
fn rename(str src, str dst) -> bool {
    return global.nativeOs.rename(src, dst) isnt 0;
}
fn exists(str path) -> bool { return global.nativeOs.exists(path) isnt 0; }
fn isFile(str path) -> bool { return global.nativeOs.isFile(path) isnt 0; }
fn isDir(str path) -> bool { return global.nativeOs.isDir(path) isnt 0; }
fn rmTree(str path) -> bool { return global.nativeOs.rmTree(path) isnt 0; }
fn copyTree(str src, str dst) -> bool {
    return global.nativeOs.copyTree(src, dst) isnt 0;
}
fn listdirExt(str path, str ext) -> list {
    str raw = global.nativeOs.listdirExt(path, ext);
    if(raw is ""){ return seqFromTo(0, 0, 1); }
    return splitStr(raw, "\n");
}
fn walkFiles(str path) -> str { return global.nativeOs.walkFiles(path); }

// ---------- Paths and environment ----------
fn joinPath(str a, str b) -> str { return global.nativeOs.joinPath(a, b); }
fn basename(str path) -> str { return global.nativeOs.basename(path); }
fn dirname(str path) -> str { return global.nativeOs.dirname(path); }
fn absPath(str path) -> str { return global.nativeOs.absPath(path); }
fn extname(str path) -> str { return global.nativeOs.extname(path); }
fn normPath(str path) -> str { return global.nativeOs.normPath(path); }
fn expandUser(str path) -> str { return global.nativeOs.expandUser(path); }
fn sep() -> str { return global.nativeOs.sep(); }
fn getenv(str key) -> str { return global.nativeOs.getenv(key); }
fn setenv(str key, str val) -> bool {
    return global.nativeOs.setenv(key, val) isnt 0;
}
fn tempDir() -> str { return global.nativeOs.tempDir(); }
fn homedir() -> str { return global.nativeOs.homedir(); }
fn configDir() -> str { return global.nativeOs.configDir(); }
fn dataDir() -> str { return global.nativeOs.dataDir(); }
fn cacheDir() -> str { return global.nativeOs.cacheDir(); }
fn username() -> str { return global.nativeOs.username(); }
fn hostname() -> str { return global.nativeOs.hostname(); }
fn getpid() -> int { return global.nativeOs.getpid(); }
fn cpuCount() -> int { return global.nativeOs.cpuCount(); }
fn diskTotal(str path) -> int { return global.nativeOs.diskTotal(path); }
fn diskFree(str path) -> int { return global.nativeOs.diskFree(path); }

// ---------- Platform and runtime information ----------
fn getSystemName() -> str { return global.nativeOs.getSystemName(); }
fn getSystemRelease() -> str { return global.nativeOs.getSystemRelease(); }
fn getSystemVersion() -> str { return global.nativeOs.getSystemVersion(); }
fn getSystemMachine() -> str { return global.nativeOs.getSystemMachine(); }
fn getSystemProcessor() -> str {
    return global.nativeOs.getSystemProcessor();
}
fn getSystemArchitecture() -> str {
    return global.nativeOs.getSystemArchitecture();
}
fn getSystemNode() -> str { return global.nativeOs.getSystemNode(); }
fn getSystemUname() -> str { return global.nativeOs.getSystemUname(); }
fn getSystemInfo() -> str { return global.nativeOs.getSystemInfo(); }
fn getSystemDistro() -> str { return global.nativeOs.getSystemDistro(); }

fn main(){}
