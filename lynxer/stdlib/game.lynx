global drawRectOutline(float cx, float cy, float width, float height, int r, int g, int b, float lineWidth){
    rawPy(){
        import arcade
        arcade.draw_rect_outline(cx, cy, width, height,
                                      arcade.color.Color(r, g, b), lineWidth)
    }
}

