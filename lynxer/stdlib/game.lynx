}

// Update a single sprite's position by its velocity.
global updateSprite(int idx){
    rawPy(){
        import builtins
        try:
            builtins._lx_sprites[idx].update()
        except Exception:
            pass
    }
}

// Draw a single sprite.
global drawSprite(int idx){
    rawPy(){
        import builtins
        try:
            builtins._lx_sprites[idx].draw()
        except Exception:
            pass
    }
}

// Destroy a sprite and remove it from every SpriteList.
// The index is not reused, so references held by game code stay safe.
global destroySprite(int idx){
    rawPy(){
        import builtins
        try:
            sp = builtins._lx_sprites[idx]
            if sp is not None:
                for lst in builtins._lx_spr_lists:
                    if sp in lst:
                        lst.remove(sp)
                builtins._lx_sprites[idx] = None
        except Exception:
            pass
    }
}

// Return whether a sprite index still refers to a live sprite.
global spriteExists(int idx){
    bool result = false;
    rawPy(){
        import builtins
        try:
            result = builtins._lx_sprites[idx] is not None
        except Exception:
            result = false
    }
    return result;
}

// Return true if sprite A collides with sprite B.
global spriteCollides(int idxA, int idxB){
    bool result = false;
    rawPy(){
        import builtins, arcade
        try:
            a = builtins._lx_sprites[idxA]
            b = builtins._lx_sprites[idxB]
            result = bool(arcade.check_for_collision(a, b))
        except Exception:
            result = False
    }
    return result;
}

// ── Sprite lists ─────────────────────────────────────────────────────────────

// Create a new SpriteList.  Returns list index.
global makeSpriteList(){
    int idx = 0;
    rawPy(){
        import arcade, builtins
        sl = arcade.SpriteList()
        builtins._lx_spr_lists.append(sl)
        idx = len(builtins._lx_spr_lists) - 1
    }
    return idx;
}

// Add sprite at sprIdx to the SpriteList at listIdx.
global addToList(int listIdx, int sprIdx){
    rawPy(){
        import builtins
        try:
            builtins._lx_spr_lists[listIdx].append(builtins._lx_sprites[sprIdx])
        except Exception:
            pass
    }
}

// Create a SpriteList with optional spatial hashing for static collision walls.
global makeSpatialSpriteList(){
    int idx = 0;
    rawPy(){
        import arcade, builtins
        try:
            builtins._lx_spr_lists.append(arcade.SpriteList(use_spatial_hash=True))
            idx = len(builtins._lx_spr_lists) - 1
        except Exception:
            idx = -1
    }
    return idx;
}

// Return the global sprite index at a SpriteList position, or -1.
global getSpriteFromList(int listIdx, int position){
    int result = -1;
    rawPy(){
        import builtins
        try:
            candidate = builtins._lx_spr_lists[listIdx][position]
            for i, sprite in enumerate(builtins._lx_sprites):
                if sprite is candidate:
                    result = i
                    break
        except Exception:
            result = -1
    }
    return result;
}

// Draw all sprites in a SpriteList.
global drawSpriteList(int listIdx){
    rawPy(){
        import builtins
        try:
            builtins._lx_spr_lists[listIdx].draw()
        except Exception:
            pass
    }
}

// Update all sprites in a SpriteList (apply velocities).
global updateSpriteList(int listIdx){
    rawPy(){
        import builtins
        try:
            builtins._lx_spr_lists[listIdx].update()
        except Exception:
            pass
    }
}

// ── Input ───────────────────────────────────────────────────────────────────

// Return true if the named key is currently held down.
// Key names: "UP", "DOWN", "LEFT", "RIGHT", "SPACE", "ENTER",
// "ESCAPE", "A"–"Z", "0"–"9", "F1"–"F12".
// e.g. keyDown("LEFT")
global keyDown(str key){
    bool result = false;
    rawPy(){
        import builtins, arcade
        try:
            _KEY_MAP = {
                "UP":    arcade.key.UP,    "DOWN":  arcade.key.DOWN,
                "LEFT":  arcade.key.LEFT,  "RIGHT": arcade.key.RIGHT,
                "SPACE": arcade.key.SPACE, "ENTER": arcade.key.RETURN,
                "ESCAPE": arcade.key.ESCAPE,
                "A": arcade.key.A, "B": arcade.key.B, "C": arcade.key.C,
                "D": arcade.key.D, "E": arcade.key.E, "F": arcade.key.F,
                "G": arcade.key.G, "H": arcade.key.H, "I": arcade.key.I,
                "J": arcade.key.J, "K": arcade.key.K, "L": arcade.key.L,
                "M": arcade.key.M, "N": arcade.key.N, "O": arcade.key.O,
                "P": arcade.key.P, "Q": arcade.key.Q, "R": arcade.key.R,
                "S": arcade.key.S, "T": arcade.key.T, "U": arcade.key.U,
                "V": arcade.key.V, "W": arcade.key.W, "X": arcade.key.X,
                "Y": arcade.key.Y, "Z": arcade.key.Z,
                "0": arcade.key.KEY_0, "1": arcade.key.KEY_1,
                "2": arcade.key.KEY_2, "3": arcade.key.KEY_3,
                "4": arcade.key.KEY_4, "5": arcade.key.KEY_5,
                "6": arcade.key.KEY_6, "7": arcade.key.KEY_7,
                "8": arcade.key.KEY_8, "9": arcade.key.KEY_9,
                "F1": arcade.key.F1, "F2": arcade.key.F2,
                "F3": arcade.key.F3, "F4": arcade.key.F4,
                "F5": arcade.key.F5, "F6": arcade.key.F6,
                "F7": arcade.key.F7, "F8": arcade.key.F8,
                "F9": arcade.key.F9, "F10": arcade.key.F10,
                "F11": arcade.key.F11, "F12": arcade.key.F12
            }
            sym = _KEY_MAP.get(key.upper())
            result = sym in builtins._lx_game_win._key_state if sym is not None else False
        except Exception:
            result = False
    }
    return result;
}

// Return true if the named key is NOT held down.
global keyUp(str key){
    bool result = false;
    rawPy(){
        result = not result
    }
    // delegate to keyDown and invert
    bool down = false;
    down = global.keyDown(key);
    if(down == false){ return true; }
    return false;
}

// Return true once when a key has been pressed since the previous query.
// Unlike keyDown, this is useful for actions such as jump or pause.
global keyPressed(str key){
    bool result = false;
    rawPy(){
        import builtins, arcade
        try:
            _KEY_MAP = {
                "UP": arcade.key.UP, "DOWN": arcade.key.DOWN,
                "LEFT": arcade.key.LEFT, "RIGHT": arcade.key.RIGHT,
                "SPACE": arcade.key.SPACE, "ENTER": arcade.key.RETURN,
                "ESCAPE": arcade.key.ESCAPE,
                "A": arcade.key.A, "B": arcade.key.B, "C": arcade.key.C,
                "D": arcade.key.D, "E": arcade.key.E, "F": arcade.key.F,
                "G": arcade.key.G, "H": arcade.key.H, "I": arcade.key.I,
                "J": arcade.key.J, "K": arcade.key.K, "L": arcade.key.L,
                "M": arcade.key.M, "N": arcade.key.N, "O": arcade.key.O,
                "P": arcade.key.P, "Q": arcade.key.Q, "R": arcade.key.R,
                "S": arcade.key.S, "T": arcade.key.T, "U": arcade.key.U,
                "V": arcade.key.V, "W": arcade.key.W, "X": arcade.key.X,
                "Y": arcade.key.Y, "Z": arcade.key.Z,
                "0": arcade.key.KEY_0, "1": arcade.key.KEY_1,
                "2": arcade.key.KEY_2, "3": arcade.key.KEY_3,
                "4": arcade.key.KEY_4, "5": arcade.key.KEY_5,
                "6": arcade.key.KEY_6, "7": arcade.key.KEY_7,
                "8": arcade.key.KEY_8, "9": arcade.key.KEY_9,
                "F1": arcade.key.F1, "F2": arcade.key.F2,
                "F3": arcade.key.F3, "F4": arcade.key.F4,
                "F5": arcade.key.F5, "F6": arcade.key.F6,
                "F7": arcade.key.F7, "F8": arcade.key.F8,
                "F9": arcade.key.F9, "F10": arcade.key.F10,
                "F11": arcade.key.F11, "F12": arcade.key.F12
            }
            sym = _KEY_MAP.get(key.upper())
            result = sym in builtins._lx_game_win._key_pressed if sym is not None else False
            if sym is not None:
                builtins._lx_game_win._key_pressed.discard(sym)
        except Exception:
            result = False
    }
    return result;
}

// Return true once when a key has been released since the previous query.
