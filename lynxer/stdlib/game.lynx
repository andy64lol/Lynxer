// Draw a filled rectangle centered at (cx, cy).
global drawRect(float cx, float cy, float width, float height, int r, int g, int b){
    rawPy(){
        import arcade
        arcade.draw_rect_filled(cx, cy, width, height, arcade.color.Color(r, g, b))
    }
}

