////
Lynxer standard library: game.
2D game helpers using Arcade. Requires Arcade.
////

global setup(){}

// ── Window ─────────────────────────────────────────────────────────────────

// Create the arcade game window.  Must be called first.
// Stores the window in builtins._lx_game_win.
// background defaults to black; change with setBackground.
global init(str title, int width, int height){
    rawPy(){
        import arcade, builtins

        # Arcade keeps a process-wide current window.  Closing a previous
        # wrapper window makes repeated tests and scene changes deterministic.
        previous = getattr(builtins, "_lx_game_win", None)
        if previous is not None:
            try:
                previous.close()
            except Exception:
                pass

        class _LynxGameWindow(arcade.Window):
            def __init__(self, title, width, height):
                super().__init__(width, height, title)
                self._draw_fn   = None
                self._update_fn = None
                self._key_press_fn = None
                self._key_release_fn = None
                self._mouse_press_fn = None
                self._mouse_release_fn = None
                self._mouse_motion_fn = None
                self._mouse_scroll_fn = None
                self._key_state = set()
                self._key_pressed = set()
                self._key_released = set()
                self._mouse_x   = 0
                self._mouse_y   = 0
                self._mouse_dx  = 0
                self._mouse_dy  = 0
                self._mouse_btn = set()
                self._mouse_pressed = set()
                self._mouse_released = set()
                self._scroll_x  = 0
                self._scroll_y  = 0

            def on_draw(self):
                self.clear()
                if self._draw_fn:
                    self._draw_fn()

            def on_update(self, delta_time):
                builtins._lx_game_dt = delta_time
                if self._update_fn:
                    self._update_fn(delta_time)

            def on_key_press(self, symbol, modifiers):
                self._key_state.add(symbol)
                self._key_pressed.add(symbol)
                if self._key_press_fn:
                    self._key_press_fn(symbol, modifiers)

            def on_key_release(self, symbol, modifiers):
                self._key_state.discard(symbol)
                self._key_released.add(symbol)
                if self._key_release_fn:
                    self._key_release_fn(symbol, modifiers)

            def on_mouse_motion(self, x, y, dx, dy):
                self._mouse_x = x
                self._mouse_y = y
                self._mouse_dx += dx
                self._mouse_dy += dy
                if self._mouse_motion_fn:
                    self._mouse_motion_fn(x, y, dx, dy)

            def on_mouse_press(self, x, y, button, modifiers):
                self._mouse_btn.add(button)
                self._mouse_pressed.add(button)
                if self._mouse_press_fn:
                    self._mouse_press_fn(x, y, button, modifiers)

            def on_mouse_release(self, x, y, button, modifiers):
                self._mouse_btn.discard(button)
                self._mouse_released.add(button)
                if self._mouse_release_fn:
                    self._mouse_release_fn(x, y, button, modifiers)

            def on_mouse_scroll(self, x, y, scroll_x, scroll_y):
                self._scroll_x += scroll_x
                self._scroll_y += scroll_y
                if self._mouse_scroll_fn:
                    self._mouse_scroll_fn(x, y, scroll_x, scroll_y)

        win = _LynxGameWindow(title, width, height)
        builtins._lx_game_win  = win
        builtins._lx_game_dt   = 0.0
        builtins._lx_sprites   = []
        builtins._lx_sounds    = []
        builtins._lx_spr_lists = []
        builtins._lx_cameras   = []
        builtins._lx_labels    = []
        builtins._lx_scenes    = []
        builtins._lx_tilemaps  = []
        builtins._lx_textures  = []
        builtins._lx_shape_lists = []
        builtins._lx_physics_engines = []
        builtins._lx_scheduled_callbacks = {}
        builtins._lx_start_time = None
    }
}

// Set the window title.
global setTitle(str title){
    rawPy(){
        import builtins
        builtins._lx_game_win.set_caption(title)
    }
}

// Set the background clear colour (r, g, b each 0–255).
global setBackground(int r, int g, int b){
    rawPy(){
        import arcade, builtins
        builtins._lx_game_win.background_color = arcade.color.Color(r, g, b)
    }
}

// Return the window width in pixels.
global getWidth(){
    int result = 0;
    rawPy(){
        import builtins
        result = builtins._lx_game_win.width
    }
    return result;
}

// Return the window height in pixels.
global getHeight(){
    int result = 0;
    rawPy(){
        import builtins
        result = builtins._lx_game_win.height
    }
    return result;
}

// Change the window size.
global setWindowSize(int width, int height){
    rawPy(){
        import builtins
        try:
            builtins._lx_game_win.set_size(width, height)
        except Exception:
            pass
    }
}

// Allow or prevent interactive window resizing.
global setResizable(bool enabled){
    rawPy(){
        import builtins
        try:
            builtins._lx_game_win.set_resizable(bool(enabled))
        except Exception:
            pass
    }
}

