///
  Lynxer Standard Library — game
  2-D game development toolkit wrapping Python's arcade library.
  Requires: arcade  (pip install arcade)

  Provides:
    Window:      init, setTitle, setBackground, getWidth, getHeight, close
    App:         run
    Draw loop:   beginDraw, endDraw
    Shapes:      drawRect, drawRectOutline, drawCircle, drawCircleOutline,
                 drawEllipse, drawEllipseOutline, drawLine, drawTriangle,
                 drawTriangleOutline, drawPolygon, drawArc, drawPoint
    Text:        drawText, drawTextStyled
    Sprites:     loadSprite, getSpriteX, getSpriteY, getSpriteAngle,
                 setSpritePos, setSpriteAngle, setSpriteScale,
                 setSpriteVelocity, updateSprite, drawSprite,
                 spriteCollidesWithList, loadSpriteList, addToList,
                 drawSpriteList, updateSpriteList
    Input:       keyDown, keyUp (bool checks), mouseX, mouseY
    Sound:       loadSound, playSound, stopSound
    Camera:      useCamera, resetCamera
    Timer:       deltaTime
    Physics:     makePhysicsEngine, updatePhysics
    Scene:       makeScene, addSpriteToScene, drawScene, updateScene

  Usage pattern
  ─────────────
  import("game") inside setup(), then:

    global main(){
        global.game.init("My Game", 800, 600);
        global.game.setBackground(30, 30, 30);
        // game loop driven by rawPy — see docs/stdlib/game.md
        global.game.run();
    }

  The on_draw / on_update hooks must be set via rawPy before run():
    rawPy(){
        import builtins, arcade
        def _draw():
            global.game.beginDraw()
            global.game.drawCircle(400, 300, 50, 255, 100, 100)
            global.game.endDraw()
        def _update(dt):
            builtins._lx_game_dt = dt
        builtins._lx_game_win.on_draw   = _draw
        builtins._lx_game_win.on_update = _update
    }
///

global setup(){}

// ── Window ─────────────────────────────────────────────────────────────────

/// Create the arcade game window.  Must be called first.
  Stores the window in builtins._lx_game_win.
  background defaults to black; change with setBackground. ///
global init(str title, int width, int height){
    rawPy(){
        import arcade, builtins

        class _LynxGameWindow(arcade.Window):
            def __init__(self, title, width, height):
                super().__init__(width, height, title)
                self._draw_fn   = None
                self._update_fn = None
                self._key_state = set()
                self._mouse_x   = 0
                self._mouse_y   = 0
                self._mouse_btn = set()

            def on_draw(self):
                self.clear()
                if self._draw_fn:
                    self._draw_fn()

            def on_update(self, delta_time):
                builtins._lx_game_dt = delta_time
                if self._update_fn:
                    self._update_fn(delta_time)

            def on_key_press(self, symbol, modifiers):
                self._key_state.add(symbol)

            def on_key_release(self, symbol, modifiers):
                self._key_state.discard(symbol)

            def on_mouse_motion(self, x, y, dx, dy):
                self._mouse_x = x
                self._mouse_y = y

            def on_mouse_press(self, x, y, button, modifiers):
                self._mouse_btn.add(button)

            def on_mouse_release(self, x, y, button, modifiers):
                self._mouse_btn.discard(button)

        win = _LynxGameWindow(title, width, height)
        builtins._lx_game_win  = win
        builtins._lx_game_dt   = 0.0
        builtins._lx_sprites   = []
        builtins._lx_sounds    = []
        builtins._lx_spr_lists = []
        builtins._lx_cameras   = []
    }
}

/// Set the window title. ///
global setTitle(str title){
    rawPy(){
        import builtins
        builtins._lx_game_win.set_caption(title)
    }
}

/// Set the background clear colour (r, g, b each 0–255). ///
global setBackground(int r, int g, int b){
    rawPy(){
        import arcade, builtins
        builtins._lx_game_win.background_color = arcade.color.Color(r, g, b)
    }
}

/// Return the window width in pixels. ///
global getWidth(){
    int result = 0;
    rawPy(){
        import builtins
        result = builtins._lx_game_win.width
    }
    return result;
}

/// Return the window height in pixels. ///
global getHeight(){
    int result = 0;
    rawPy(){
        import builtins
        result = builtins._lx_game_win.height
    }
    return result;
}

/// Close the game window. ///
global close(){
    rawPy(){
        import builtins, arcade
        try:
            builtins._lx_game_win.close()
        except Exception:
            pass
    }
}

// ── App lifecycle ───────────────────────────────────────────────────────────

/// Start the arcade event loop (blocking). ///
global run(){
    rawPy(){
        import arcade
        arcade.run()
    }
}

// ── Draw loop ───────────────────────────────────────────────────────────────

/// Call at the start of your on_draw to clear the screen. ///
global beginDraw(){
    rawPy(){
        import builtins
        builtins._lx_game_win.clear()
    }
}

/// No-op — retained for API symmetry with beginDraw. ///
global endDraw(){
}

// ── Shape drawing ───────────────────────────────────────────────────────────

/// Draw a filled rectangle centered at (cx, cy). ///
global drawRect(float cx, float cy, float width, float height, int r, int g, int b){
    rawPy(){
        import arcade
        arcade.draw_rectangle_filled(cx, cy, width, height, arcade.color.Color(r, g, b))
    }
}

/// Draw a rectangle outline centered at (cx, cy). ///
global drawRectOutline(float cx, float cy, float width, float height, int r, int g, int b, float lineWidth){
    rawPy(){
        import arcade
        arcade.draw_rectangle_outline(cx, cy, width, height,
                                      arcade.color.Color(r, g, b), lineWidth)
    }
}

