// Draw a filled polygon.  coordsJson is a JSON array of [x,y,...] floats.
// e.g. drawPolygon("[100,100, 200,100, 150,200]", 0, 200, 100)
global drawPolygon(str coordsJson, int r, int g, int b){
    rawPy(){
        import arcade, json as _json
        try:
            flat = _json.loads(coordsJson)
            pts  = [(flat[i], flat[i+1]) for i in range(0, len(flat)-1, 2)]
            arcade.draw_polygon_filled(pts, arcade.color.Color(r, g, b))
        except Exception:
            pass
    }
}

// Draw an arc (sector outline) centered at (cx, cy).
// startAngle and endAngle are in degrees (0 = right, counter-clockwise).
global drawArc(float cx, float cy, float w, float h, int r, int g, int b, float startAngle, float endAngle, float lineWidth){
    rawPy(){
        import arcade
        arcade.draw_arc_outline(cx, cy, w, h,
                                arcade.color.Color(r, g, b),
                                startAngle, endAngle, lineWidth)
    }
}

// Draw a filled point (small circle) at (x, y).
global drawPoint(float x, float y, int r, int g, int b, float size){
    rawPy(){
        import arcade
        arcade.draw_point(x, y, arcade.color.Color(r, g, b), size)
    }
}

// ── Text ────────────────────────────────────────────────────────────────────

// Draw text at (x, y) with font size.  anchor_x: "left", "center", "right".
global drawText(str text, float x, float y, int r, int g, int b, int size){
    rawPy(){
        import arcade
        arcade.draw_text(text, x, y, arcade.color.Color(r, g, b), size)
    }
}

// Draw text with font family, size, style, and horizontal anchor.
global drawTextStyled(str text, float x, float y, int r, int g, int b, int size, str fontName, bool bold, bool italic, str anchorX){
    rawPy(){
        import arcade
        arcade.draw_text(text, x, y,
                         arcade.color.Color(r, g, b),
                         font_size=size,
                         font_name=fontName,
                         bold=bool(bold),
                         italic=bool(italic),
                         anchor_x=anchorX)
    }
}

// ── Sprites ─────────────────────────────────────────────────────────────────

// Load a sprite image from path with optional scale.
// Returns sprite index.
global loadSprite(str path, float scale, float x, float y){
    int idx = 0;
    rawPy(){
        import arcade, builtins
        try:
            sp = arcade.Sprite(path, scale)
            sp.center_x = x
            sp.center_y = y
            builtins._lx_sprites.append(sp)
            idx = len(builtins._lx_sprites) - 1
        except Exception:
            idx = -1
    }
    return idx;
}

// Return the center X position of sprite at idx.
global getSpriteX(int idx){
    float result = 0.0;
    rawPy(){
        import builtins
        try:
            result = float(builtins._lx_sprites[idx].center_x)
        except Exception:
            result = 0.0
    }
    return result;
}

// Return the center Y position of sprite at idx.
global getSpriteY(int idx){
    float result = 0.0;
    rawPy(){
        import builtins
        try:
            result = float(builtins._lx_sprites[idx].center_y)
        except Exception:
            result = 0.0
    }
    return result;
}

// Return the angle (degrees) of sprite at idx.
global getSpriteAngle(int idx){
    float result = 0.0;
    rawPy(){
        import builtins
        try:
            result = float(builtins._lx_sprites[idx].angle)
        except Exception:
            result = 0.0
    }
    return result;
}

// Set the position of sprite at idx.
global setSpritePos(int idx, float x, float y){
    rawPy(){
