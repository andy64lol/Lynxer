// ── Physics ───────────────────────────────────────────────────────────────────

// Create a SimplePhysicsEngine with gravity and walls SpriteList.
// Returns engine index.  wallsListIdx = -1 for no walls.
global makePhysicsEngine(float gravity, int wallsListIdx){
    int idx = 0;
    rawPy(){
        import arcade, builtins
        try:
            walls = builtins._lx_spr_lists[wallsListIdx] if wallsListIdx >= 0 else arcade.SpriteList()
            // Engines are stored inline; we return the index into a new engines list.
            if not hasattr(builtins, "_lx_physics_engines"):
                builtins._lx_physics_engines = []
            // placeholder — engine is created when a player sprite is assigned
            builtins._lx_physics_engines.append({"gravity": gravity, "walls": walls, "engine": None})
            idx = len(builtins._lx_physics_engines) - 1
        except Exception:
            idx = -1
    }
    return idx;
}

// Assign a player sprite to a physics engine and initialise it.
// Must be called before updatePhysics.
global setPhysicsPlayer(int engineIdx, int sprIdx){
    rawPy(){
        import arcade, builtins
        try:
            entry = builtins._lx_physics_engines[engineIdx]
            player = builtins._lx_sprites[sprIdx]
            entry["engine"] = arcade.PhysicsEnginePlatformer(
                player, gravity_constant=entry["gravity"],
                walls=entry["walls"])
        except Exception:
            pass
    }
}

// Step the physics engine at engineIdx.
global updatePhysics(int engineIdx){
    rawPy(){
        import builtins
        try:
            eng = builtins._lx_physics_engines[engineIdx]["engine"]
            if eng:
                eng.update()
        except Exception:
            pass
    }
}

// Return true if the player can jump (is on the ground).
global canJump(int engineIdx){
    bool result = false;
    rawPy(){
        import builtins
        try:
            eng = builtins._lx_physics_engines[engineIdx]["engine"]
            result = bool(eng.can_jump()) if eng else False
        except Exception:
            result = False
    }
    return result;
}


// ── Extra drawing ─────────────────────────────────────────────────────────────

// Draw a filled rounded rectangle using four corner circles + two inner rects.
global drawRectRoundedFilled(float cx, float cy, float w, float h, int r, int g, int b, float cr){
    rawPy(){
        import arcade
        col = arcade.color.Color(r, g, b)
        hw = w / 2;  hh = h / 2
        arcade.draw_rectangle_filled(cx, cy, w - cr*2, h, col)
        arcade.draw_rectangle_filled(cx, cy, w, h - cr*2, col)
        for ox, oy in [(-1,-1),(1,-1),(1,1),(-1,1)]:
            arcade.draw_circle_filled(cx + ox*(hw-cr), cy + oy*(hh-cr), cr, col)
    }
}

// Draw a rounded rectangle outline.
global drawRectRoundedOutline(float cx, float cy, float w, float h, int r, int g, int b, float cr, float lw){
    rawPy(){
        import arcade
        col = arcade.color.Color(r, g, b)
        hw = w/2;  hh = h/2
        arcade.draw_line(cx-hw+cr, cy+hh,   cx+hw-cr, cy+hh,   col, lw)
        arcade.draw_line(cx-hw+cr, cy-hh,   cx+hw-cr, cy-hh,   col, lw)
        arcade.draw_line(cx-hw,    cy-hh+cr, cx-hw,    cy+hh-cr, col, lw)
        arcade.draw_line(cx+hw,    cy-hh+cr, cx+hw,    cy+hh-cr, col, lw)
        arcade.draw_arc_outline(cx-hw+cr, cy+hh-cr, cr*2, cr*2, col, 90,  180, lw)
        arcade.draw_arc_outline(cx+hw-cr, cy+hh-cr, cr*2, cr*2, col, 0,   90,  lw)
        arcade.draw_arc_outline(cx-hw+cr, cy-hh+cr, cr*2, cr*2, col, 180, 270, lw)
        arcade.draw_arc_outline(cx+hw-cr, cy-hh+cr, cr*2, cr*2, col, 270, 360, lw)
    }
}

// Draw a filled arc/pie sector.
global drawArcFilled(float cx, float cy, float w, float h, int r, int g, int b, float startAngle, float endAngle){
    rawPy(){
        import arcade
        arcade.draw_arc_filled(cx, cy, w, h,
                               arcade.color.Color(r, g, b),
                               startAngle, endAngle)
    }
}

// Draw a filled n-point star.
global drawStar(float cx, float cy, float outerR, float innerR, int n, int r, int g, int b){
    rawPy(){
        import arcade, math as _m
        col  = arcade.color.Color(r, g, b)
        step = _m.pi / n
        pts  = []
        for i in range(n * 2):
            angle = i * step - _m.pi/2
            rad   = outerR if i % 2 == 0 else innerR
            pts.append((cx + rad * _m.cos(angle), cy + rad * _m.sin(angle)))
        arcade.draw_polygon_filled(pts, col)
    }
}

// Draw a dashed line between two points.
global drawDashedLine(float x1, float y1, float x2, float y2, int r, int g, int b, float lw, float dashLen){
    rawPy(){
        import arcade, math as _m
        col  = arcade.color.Color(r, g, b)
        dx   = x2 - x1;  dy = y2 - y1
        dist = _m.hypot(dx, dy)
        if dist > 0:
            nx   = dx / dist;  ny = dy / dist
            pos  = 0.0;  draw = True
            while pos < dist:
                end = min(pos + dashLen, dist)
                if draw:
                    arcade.draw_line(x1+nx*pos, y1+ny*pos,
                                     x1+nx*end, y1+ny*end, col, lw)
                pos  = end;  draw = not draw
    }
}

// Draw a cross/plus shape.
global drawCross(float cx, float cy, float size, int r, int g, int b, float lw){
    rawPy(){
        import arcade
        col = arcade.color.Color(r, g, b)
        arcade.draw_line(cx - size, cy, cx + size, cy, col, lw)
        arcade.draw_line(cx, cy - size, cx, cy + size, col, lw)
    }
}

// Draw a polyline through many points.  coordsJson: flat [x,y,...] JSON array.
global drawPolyline(str coordsJson, int r, int g, int b, float lw){
    rawPy(){
        import arcade, json as _json
        try:
            flat = _json.loads(coordsJson)
            col  = arcade.color.Color(r, g, b)
            pts  = [(flat[i], flat[i+1]) for i in range(0, len(flat)-1, 2)]
            for i in range(len(pts)-1):
                arcade.draw_line(pts[i][0], pts[i][1],
                                 pts[i+1][0], pts[i+1][1], col, lw)
        except Exception:
            pass
    }
}

// Draw many points at once.  coordsJson: flat [x,y,...] JSON array.
global drawPoints(str coordsJson, int r, int g, int b, float size){
    rawPy(){
        import arcade, json as _json
        try:
            flat = _json.loads(coordsJson)
            col  = arcade.color.Color(r, g, b)
            for i in range(0, len(flat)-1, 2):
                arcade.draw_point(flat[i], flat[i+1], col, size)
        except Exception:
            pass
    }
}

// Draw a simple two-color vertical gradient rectangle.
global drawGradientRect(float cx, float cy, float w, float h, int r1, int g1, int b1, int r2, int g2, int b2){
    rawPy(){
        import arcade
        arcade.draw_rectangle_filled(cx, cy + h*0.25, w, h*0.5,
                                     arcade.color.Color(r1, g1, b1))
        arcade.draw_rectangle_filled(cx, cy - h*0.25, w, h*0.5,
                                     arcade.color.Color(r2, g2, b2))
    }
}

// Draw an image from a file path centered at (cx, cy).
global drawTextureAt(str imagePath, float cx, float cy, float scale){
    rawPy(){
        import arcade
        try:
            tex = arcade.load_texture(imagePath)
            arcade.draw_scaled_texture_rectangle(cx, cy,
                tex.width*scale, tex.height*scale, tex)
        except Exception:
            pass
    }
}

// ── Texture cache ─────────────────────────────────────────────────────────────

// Load and cache a texture for fast repeated drawing.  Returns texture index.
global loadTexture(str imagePath){
    int idx = 0;
    rawPy(){
        import arcade, builtins
        if not hasattr(builtins, "_lx_textures"):
            builtins._lx_textures = []
        try:
            tex = arcade.load_texture(imagePath)
            builtins._lx_textures.append(tex)
            idx = len(builtins._lx_textures) - 1
        except Exception:
            idx = -1
    }
    return idx;
}

// Draw a cached texture centered at (cx, cy).
global drawTexture(int texIdx, float cx, float cy, float w, float h, float angle){
    rawPy(){
        import arcade, builtins
        try:
            tex = builtins._lx_textures[texIdx]
            arcade.draw_scaled_texture_rectangle(cx, cy, w, h, tex, angle)
        except Exception:
            pass
    }
}

