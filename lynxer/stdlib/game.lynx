// ── Tilemap (Tiled editor) ────────────────────────────────────────────────────

// Load a Tiled .tmx file.  Returns a scene index.
global loadTilemap(str tmxPath, float scaling){
    int idx = 0;
    rawPy(){
        import arcade, builtins
        if not hasattr(builtins, "_lx_scenes"):
            builtins._lx_scenes = []
        try:
            tilemap = arcade.load_tilemap(tmxPath, scaling=scaling)
            sc      = arcade.Scene.from_tilemap(tilemap)
            builtins._lx_scenes.append(sc)
            idx = len(builtins._lx_scenes) - 1
            if not hasattr(builtins, "_lx_tilemaps"):
                builtins._lx_tilemaps = []
            builtins._lx_tilemaps.append(tilemap)
        except Exception:
            idx = -1
    }
    return idx;
}

// Get a named layer from a tilemap scene as a SpriteList index.
global getTilemapLayer(int sceneIdx, str layerName){
    int idx = 0;
    rawPy(){
        import builtins
        try:
            sc  = builtins._lx_scenes[sceneIdx]
            lst = sc.get_sprite_list(layerName)
            builtins._lx_spr_lists.append(lst)
            idx = len(builtins._lx_spr_lists) - 1
        except Exception:
            idx = -1
    }
    return idx;
}

