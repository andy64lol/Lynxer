// Lerp camera toward (tx, ty) by speed factor (0.0–1.0).
global smoothScrollCamera(int camIdx, float tx, float ty, float speed){
    rawPy(){
        import builtins
        try:
            cam = builtins._lx_cameras[camIdx]
            cx, cy = cam.position
            cam.position = (cx + (tx - cx) * speed,
                            cy + (ty - cy) * speed)
        except Exception:
            pass
    }
}

// ── Physics extended ──────────────────────────────────────────────────────────

// Jump the physics player if it is on the ground.
global jumpPlayer(int engineIdx, float jumpSpeed){
    rawPy(){
        import builtins
        try:
            eng = builtins._lx_physics_engines[engineIdx]["engine"]
            if eng and eng.can_jump():
                eng.player_sprite.change_y = jumpSpeed
        except Exception:
            pass
    }
}

// Return the physics player's current Y velocity.
global getPlayerVY(int engineIdx){
    float result = 0.0;
    rawPy(){
        import builtins
        try:
            eng = builtins._lx_physics_engines[engineIdx]["engine"]
            result = float(eng.player_sprite.change_y) if eng else 0.0
        except Exception:
            result = 0.0
    }
    return result;
}

// ── Grid helpers ──────────────────────────────────────────────────────────────

// Convert screen pixel (x, y) to tile coordinates.
// Returns "tx,ty" string.
global screenToTile(float x, float y, int tileSize){
    str result = "0,0";
    rawPy(){
        tx = int(x // tileSize)
        ty = int(y // tileSize)
        result = f"{tx},{ty}"
    }
    return result;
}

// Convert tile (tx, ty) to screen pixel center.
// Returns "sx,sy" string.
global tileToScreen(int tx, int ty, int tileSize){
    str result = "0,0";
    rawPy(){
        sx = tx * tileSize + tileSize // 2
        sy = ty * tileSize + tileSize // 2
        result = f"{sx},{sy}"
    }
    return result;
}

global main(){}
