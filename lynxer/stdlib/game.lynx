        import arcade
        arcade.draw_text(text, x, y, arcade.color.Color(r, g, b), size)
    }
}

// Draw text with font family, size, style, and horizontal anchor.
global drawTextStyled(str text, float x, float y, int r, int g, int b, int size, str fontName, bool bold, bool italic, str anchorX){
    rawPy(){
        import arcade
        arcade.draw_text(text, x, y,
                         arcade.color.Color(r, g, b),
                         font_size=size,
                         font_name=fontName,
                         bold=bool(bold),
                         italic=bool(italic),
                         anchor_x=anchorX)
    }
}

global drawTextAnchored(str text, float x, float y, int r, int g, int b, int size, str anchorX, str anchorY){
    rawPy(){
        import arcade
        arcade.draw_text(
            text, x, y, arcade.color.Color(r, g, b), font_size=size,
            anchor_x=anchorX, anchor_y=anchorY
        )
    }
}

// ── Sprites ─────────────────────────────────────────────────────────────────

// Load a sprite image from path with optional scale.
// Returns sprite index.
global loadSprite(str path, float scale, float x, float y){
    int idx = 0;
    rawPy(){
        import arcade, builtins
        try:
            sp = arcade.Sprite(path, scale)
            sp.center_x = x
            sp.center_y = y
            builtins._lx_sprites.append(sp)
            idx = len(builtins._lx_sprites) - 1
        except Exception:
            idx = -1
    }
    return idx;
}

// Create a rectangle sprite without loading an image. Returns a sprite index.
global makeSolidSprite(int width, int height, int r, int g, int b, float x, float y){
    int idx = -1;
    rawPy(){
        import arcade, builtins
        try:
            sp = arcade.SpriteSolidColor(width, height, arcade.color.Color(r, g, b))
            sp.center_x = x
            sp.center_y = y
            builtins._lx_sprites.append(sp)
            idx = len(builtins._lx_sprites) - 1
        except Exception:
            idx = -1
    }
    return idx;
}

// Replace a sprite's image with a texture previously returned by loadTexture.
global setSpriteTexture(int idx, int texIdx){
    rawPy(){
        import builtins
        try:
            builtins._lx_sprites[idx].texture = builtins._lx_textures[texIdx]
        except Exception:
            pass
    }
}

