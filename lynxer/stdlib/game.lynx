}

// Close the game window.
global close(){
    rawPy(){
        import builtins, arcade
        try:
            builtins._lx_game_win.close()
        except Exception:
            pass
    }
}

// ── App lifecycle ───────────────────────────────────────────────────────────

// Start the arcade event loop (blocking).
global run(){
    rawPy(){
        import arcade
        arcade.run()
    }
}

// Register Lynxer functions as Arcade event callbacks.  The functions are
// named to keep callback registration simple and predictable:
// draw(), update(float dt), keyPress(int symbol, int modifiers), etc.
global setDrawCallback(str callbackName){
    rawPy(){
        import builtins
        builtins._lx_game_win._draw_fn = (
            lambda: builtins._lx_invoke_lynxer(callbackName)
        )
    }
}

global setUpdateCallback(str callbackName){
    rawPy(){
        import builtins
        builtins._lx_game_win._update_fn = (
            lambda dt: builtins._lx_invoke_lynxer(callbackName, dt)
        )
    }
}

global setKeyPressCallback(str callbackName){
    rawPy(){
        import builtins
        builtins._lx_game_win._key_press_fn = (
            lambda symbol, modifiers:
                builtins._lx_invoke_lynxer(callbackName, symbol, modifiers)
        )
    }
}

global setKeyReleaseCallback(str callbackName){
    rawPy(){
        import builtins
        builtins._lx_game_win._key_release_fn = (
            lambda symbol, modifiers:
                builtins._lx_invoke_lynxer(callbackName, symbol, modifiers)
        )
    }
}

global setMousePressCallback(str callbackName){
    rawPy(){
        import builtins
        builtins._lx_game_win._mouse_press_fn = (
            lambda x, y, button, modifiers:
                builtins._lx_invoke_lynxer(callbackName, x, y, button, modifiers)
        )
    }
}

global setMouseReleaseCallback(str callbackName){
    rawPy(){
        import builtins
        builtins._lx_game_win._mouse_release_fn = (
            lambda x, y, button, modifiers:
                builtins._lx_invoke_lynxer(callbackName, x, y, button, modifiers)
        )
    }
}

global setMouseMotionCallback(str callbackName){
    rawPy(){
        import builtins
        builtins._lx_game_win._mouse_motion_fn = (
            lambda x, y, dx, dy:
                builtins._lx_invoke_lynxer(callbackName, x, y, dx, dy)
        )
    }
}

global setMouseScrollCallback(str callbackName){
    rawPy(){
        import builtins
        builtins._lx_game_win._mouse_scroll_fn = (
            lambda x, y, sx, sy:
                builtins._lx_invoke_lynxer(callbackName, x, y, sx, sy)
        )
    }
}

// Schedule a named Lynxer function through Arcade's clock.  The callback
// receives one float argument: elapsed seconds since the previous call.
global schedule(str callbackName, float interval){
    rawPy(){
        import arcade, builtins
        def _scheduled(dt):
            builtins._lx_invoke_lynxer(callbackName, dt)
        old = builtins._lx_scheduled_callbacks.get(callbackName)
        if old is not None:
            arcade.unschedule(old)
        builtins._lx_scheduled_callbacks[callbackName] = _scheduled
        arcade.schedule(_scheduled, max(0.001, interval))
    }
}

global unschedule(str callbackName){
    rawPy(){
        import arcade, builtins
        callback = builtins._lx_scheduled_callbacks.pop(callbackName, None)
        if callback is not None:
            arcade.unschedule(callback)
    }
}

// ── Draw loop ───────────────────────────────────────────────────────────────

// Call at the start of your on_draw to clear the screen.
global beginDraw(){
    rawPy(){
        import builtins
        builtins._lx_game_win.clear()
    }
}

// No-op — retained for API symmetry with beginDraw.
global endDraw(){
}

