// Lerp camera toward (tx, ty) by speed factor (0.0–1.0).
global smoothScrollCamera(int camIdx, float tx, float ty, float speed){
    rawPy(){
        import builtins
        try:
            cam = builtins._lx_cameras[camIdx]
            cx, cy = cam.position
            cam.position = (cx + (tx - cx) * speed,
                            cy + (ty - cy) * speed)
        except Exception:
            pass
    }
}

