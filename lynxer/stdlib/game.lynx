// Jump the physics player if it is on the ground.
global jumpPlayer(int engineIdx, float jumpSpeed){
    rawPy(){
        import builtins
        try:
            eng = builtins._lx_physics_engines[engineIdx]["engine"]
            if eng and eng.can_jump():
                eng.player_sprite.change_y = jumpSpeed
        except Exception:
            pass
    }
}

// Return the physics player's current Y velocity.
global getPlayerVY(int engineIdx){
    float result = 0.0;
    rawPy(){
        import builtins
        try:
            eng = builtins._lx_physics_engines[engineIdx]["engine"]
            result = float(eng.player_sprite.change_y) if eng else 0.0
        except Exception:
            result = 0.0
    }
    return result;
}

// ── Grid helpers ──────────────────────────────────────────────────────────────

// Convert screen pixel (x, y) to tile coordinates.
// Returns "tx,ty" string.
global screenToTile(float x, float y, int tileSize){
    str result = "0,0";
    rawPy(){
        tx = int(x // tileSize)
        ty = int(y // tileSize)
        result = f"{tx},{ty}"
    }
    return result;
}

// Convert tile (tx, ty) to screen pixel center.
// Returns "sx,sy" string.
global tileToScreen(int tx, int ty, int tileSize){
    str result = "0,0";
    rawPy(){
        sx = tx * tileSize + tileSize // 2
        sy = ty * tileSize + tileSize // 2
        result = f"{sx},{sy}"
    }
    return result;
}

// ── Arcade-compatible drawing and resource helpers ───────────────────────────

// Edge-based rectangle variants mirror Arcade's LBWH and LRBT helpers.
global drawRectLBWH(float left, float bottom, float width, float height, int r, int g, int b){
    global.drawRect(left + width / 2, bottom + height / 2, width, height, r, g, b);
}

global drawRectEdges(float left, float right, float bottom, float top, int r, int g, int b){
    global.drawRect((left + right) / 2, (bottom + top) / 2,
                    right - left, top - bottom, r, g, b);
}

global drawRectLBWHOutline(float left, float bottom, float width, float height, int r, int g, int b, float lineWidth){
    global.drawRectOutline(left + width / 2, bottom + height / 2,
                           width, height, r, g, b, lineWidth);
}

global drawRectEdgesOutline(float left, float right, float bottom, float top, int r, int g, int b, float lineWidth){
    global.drawRectOutline((left + right) / 2, (bottom + top) / 2,
                           right - left, top - bottom, r, g, b, lineWidth);
}

global drawParabolaFilled(float startX, float startY, float endX, float height, int r, int g, int b, float tiltAngle){
    rawPy(){
        import arcade
        arcade.draw_parabola_filled(
            startX, startY, endX, height,
            arcade.color.Color(r, g, b), tiltAngle
        )
    }
}

global drawParabolaOutline(float startX, float startY, float endX, float height, int r, int g, int b, float lineWidth, float tiltAngle){
    rawPy(){
        import arcade
        arcade.draw_parabola_outline(
            startX, startY, endX, height,
            arcade.color.Color(r, g, b), lineWidth, tiltAngle
        )
    }
}

// segmentsJson is an array of [x1,y1,x2,y2] arrays.
global drawLines(str segmentsJson, int r, int g, int b, float lineWidth){
    rawPy(){
        import arcade, json as _json
        try:
            segments = _json.loads(segmentsJson)
            col = arcade.color.Color(r, g, b)
            for segment in segments:
                if len(segment) >= 4:
                    arcade.draw_line(
                        segment[0], segment[1], segment[2], segment[3],
                        col, lineWidth
                    )
        except Exception:
            pass
    }
}

// Obtain Arcade constants without making game code import Python.
global keyCode(str key){
    int result = -1;
    rawPy(){
        import arcade
        try:
            name = key.upper()
            aliases = {"ENTER": "RETURN", "CTRL": "LCTRL", "ALT": "LALT"}
            name = aliases.get(name, name)
            value = getattr(arcade.key, name, None)
            if value is None and len(name) == 1 and name.isdigit():
                value = getattr(arcade.key, "KEY_" + name, None)
            result = int(value) if value is not None else -1
        except Exception:
            result = -1
    }
    return result;
}

global mouseButtonCode(str button){
    int result = -1;
    rawPy(){
        import arcade
        result = {
            "LEFT": arcade.MOUSE_BUTTON_LEFT,
            "MIDDLE": arcade.MOUSE_BUTTON_MIDDLE,
            "RIGHT": arcade.MOUSE_BUTTON_RIGHT
        }.get(button.upper(), -1)
    }
    return result;
}

