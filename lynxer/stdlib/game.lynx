// Create an Arcade text object. Returns a label index.
global makeTextLabel(str text, float x, float y, int r, int g, int b, int size, str anchorX){
    int idx = -1;
    rawPy(){
        import arcade, builtins
        try:
            label = arcade.Text(
                text=text, x=x, y=y,
                color=arcade.color.Color(r, g, b),
                font_size=size, anchor_x=anchorX)
            builtins._lx_labels.append(label)
            idx = len(builtins._lx_labels) - 1
        except Exception:
            idx = -1
    }
    return idx;
}

