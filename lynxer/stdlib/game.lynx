// ── Sound extended ────────────────────────────────────────────────────────────

// Set the playback volume of a sound (0.0 silent, 1.0 full).
global setSoundVolume(int soundIdx, float volume){
    rawPy(){
        import builtins
        try:
            entry = builtins._lx_sounds[soundIdx]
            if entry["player"] is not None:
                level = max(0.0, min(1.0, volume))
                entry["sound"].set_volume(level, entry["player"])
        except Exception:
            pass
    }
}

// Return true if the sound is currently playing.
global isSoundPlaying(int soundIdx){
    bool result = false;
    rawPy(){
        import builtins
        try:
            entry = builtins._lx_sounds[soundIdx]
            player = entry["player"]
            result = bool(player is not None and entry["sound"].is_playing(player))
        except Exception:
            result = False
    }
    return result;
}

// Play a sound on an infinite loop.
global loopSound(int soundIdx){
    rawPy(){
        import builtins, arcade
        try:
            entry = builtins._lx_sounds[soundIdx]
            if entry["player"] is not None:
                try:
                    arcade.stop_sound(entry["player"])
                except Exception:
                    pass
            try:
                entry["player"] = arcade.play_sound(entry["sound"], looping=True)
            except TypeError:
                entry["player"] = arcade.play_sound(entry["sound"], loop=True)
        except Exception:
            pass
    }
}

