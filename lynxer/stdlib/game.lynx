// ── Sprite convenience and collection queries ────────────────────────────────

global makeCircleSprite(float radius, int r, int g, int b, float x, float y){
    int idx = -1;
    rawPy(){
        import arcade, builtins
        try:
            sp = arcade.SpriteCircle(radius, arcade.color.Color(r, g, b))
            sp.center_x = x
            sp.center_y = y
            builtins._lx_sprites.append(sp)
            idx = len(builtins._lx_sprites) - 1
        except Exception:
            idx = -1
    }
    return idx;
}

global setSpritePosition(int idx, float x, float y){
    global.setSpritePos(idx, x, y);
}

global getSpritePosition(int idx){
    str result = "0,0";
    rawPy(){
        import builtins
        try:
            sp = builtins._lx_sprites[idx]
            result = f"{sp.center_x},{sp.center_y}"
        except Exception:
            result = "0,0"
    }
    return result;
}

global setSpriteTextureIndex(int idx, int textureIndex){
    rawPy(){
        import builtins
        try:
            builtins._lx_sprites[idx].set_texture(textureIndex)
        except Exception:
            pass
    }
}

global appendSpriteTexture(int idx, int texIdx){
    rawPy(){
        import builtins
        try:
            builtins._lx_sprites[idx].append_texture(
                builtins._lx_textures[texIdx]
            )
        except Exception:
            pass
    }
}

global setSpriteListVisible(int listIdx, bool visible){
    rawPy(){
        import builtins
        try:
            builtins._lx_spr_lists[listIdx].visible = bool(visible)
        except Exception:
            pass
    }
}

global setSpriteListAlpha(int listIdx, int alpha){
    rawPy(){
        import builtins
        try:
            builtins._lx_spr_lists[listIdx].alpha = max(0, min(255, alpha))
        except Exception:
            pass
    }
}

global setSpriteListColor(int listIdx, int r, int g, int b, int a){
    rawPy(){
        import arcade, builtins
        try:
            builtins._lx_spr_lists[listIdx].color = arcade.color.Color(r, g, b, a)
        except Exception:
            pass
    }
}

global getClosestSprite(int sprIdx, int listIdx){
    int result = -1;
    rawPy(){
        import arcade, builtins
        try:
            source = builtins._lx_sprites[sprIdx]
            closest, distance = arcade.get_closest_sprite(
                source, builtins._lx_spr_lists[listIdx]
            )
            if closest is not None:
                for i, candidate in enumerate(builtins._lx_sprites):
                    if candidate is closest:
                        result = i
                        break
        except Exception:
            result = -1
    }
    return result;
}

global getSpritesAtPoint(float x, float y, int listIdx){
    str result = "[]";
    rawPy(){
        import arcade, builtins, json as _json
        try:
            hits = arcade.get_sprites_at_point(
                (x, y), builtins._lx_spr_lists[listIdx]
            )
            result = _json.dumps([
                i for i, candidate in enumerate(builtins._lx_sprites)
                if candidate in hits
            ])
        except Exception:
            result = "[]"
    }
    return result;
}

global getSpritesInRect(float left, float right, float bottom, float top, int listIdx){
    str result = "[]";
    rawPy(){
        import arcade, builtins, json as _json
        try:
            hits = arcade.get_sprites_in_rect(
                arcade.LRBT(left, right, bottom, top),
                builtins._lx_spr_lists[listIdx]
            )
            result = _json.dumps([
                i for i, candidate in enumerate(builtins._lx_sprites)
                if candidate in hits
            ])
        except Exception:
            result = "[]"
    }
    return result;
}

global areSpritesColliding(int idxA, int idxB){
    return global.spriteCollides(idxA, idxB);
}

global collisionListCount(int sprIdx, int listIdx){
    str hits = global.getCollidingSprites(sprIdx, listIdx);
    int count = 0;
    rawPy(){
        import json as _json
        try:
            count = len(_json.loads(hits))
        except Exception:
            count = 0
    }
    return count;
}

// ── Window, mouse, sound, and camera compatibility helpers ───────────────────

global getDisplaySize(){
    str result = "0,0";
    rawPy(){
        import arcade
        try:
            width, height = arcade.get_display_size()
            result = f"{width},{height}"
        except Exception:
            result = "0,0"
    }
    return result;
}

global setVSync(bool enabled){
    rawPy(){
        import builtins
        try:
            builtins._lx_game_win.set_vsync(bool(enabled))
        except Exception:
            pass
    }
}

global mouseScrollX(){
    float result = 0.0;
    rawPy(){
        import builtins
        try:
            result = float(getattr(builtins._lx_game_win, "_scroll_x", 0.0))
            builtins._lx_game_win._scroll_x = 0.0
        except Exception:
            result = 0.0
    }
    return result;
}

global loadSoundStreaming(str path, bool streaming){
    int idx = -1;
    rawPy(){
        import arcade, builtins
        try:
            snd = arcade.load_sound(path, streaming=bool(streaming))
            builtins._lx_sounds.append({"sound": snd, "player": None})
            idx = len(builtins._lx_sounds) - 1
        except Exception:
            idx = -1
    }
    return idx;
}

global getSoundLength(int soundIdx){
    float result = 0.0;
    rawPy(){
        import builtins
        try:
            result = float(builtins._lx_sounds[soundIdx]["sound"].get_length())
        except Exception:
            result = 0.0
    }
    return result;
}

global getCameraZoom(int camIdx){
    float result = 1.0;
    rawPy(){
        import builtins
        try:
            result = float(builtins._lx_cameras[camIdx].zoom)
        except Exception:
            result = 1.0
    }
    return result;
}

global main(){}
