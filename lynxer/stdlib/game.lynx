// ── Animated sprites ──────────────────────────────────────────────────────────

// Create a sprite that cycles through a list of images.
// pathsJson: JSON array of image paths.  fps: frames per second.
global makeAnimatedSprite(str pathsJson, float fps, float x, float y){
    int idx = 0;
    rawPy(){
        import arcade, builtins, json as _json
        try:
            paths    = _json.loads(pathsJson)
            textures = [arcade.load_texture(p) for p in paths]
            from arcade import TextureAnimation, TextureAnimationSprite, TextureKeyframe
            dur = int(1000 / max(fps, 1))
            animation = TextureAnimation([
                TextureKeyframe(tex, dur, i)
                for i, tex in enumerate(textures)
            ])
            sp = TextureAnimationSprite(
                center_x=x, center_y=y, animation=animation
            )
            builtins._lx_sprites.append(sp)
            idx = len(builtins._lx_sprites) - 1
        except Exception:
            idx = -1
    }
    return idx;
}

// Advance animated sprite by dt seconds.  Call inside on_update.
global updateAnimation(int idx, float dt){
    rawPy(){
        import builtins
        try:
            builtins._lx_sprites[idx].update_animation(dt)
        except Exception:
            pass
    }
}

// ── Scene management ──────────────────────────────────────────────────────────

// Create an arcade Scene (named collection of SpriteLists).
// Returns scene index.
global makeScene(){
    int idx = 0;
    rawPy(){
        import arcade, builtins
        if not hasattr(builtins, "_lx_scenes"):
            builtins._lx_scenes = []
        sc = arcade.Scene()
        builtins._lx_scenes.append(sc)
        idx = len(builtins._lx_scenes) - 1
    }
    return idx;
}

// Add a SpriteList to a Scene under a name.
global addListToScene(int sceneIdx, int listIdx, str name){
    rawPy(){
        import builtins
        try:
            sc  = builtins._lx_scenes[sceneIdx]
            lst = builtins._lx_spr_lists[listIdx]
            sc.add_sprite_list(name, sprite_list=lst,
                               use_spatial_hash=True)
        except Exception:
            pass
    }
}

// Draw all SpriteLists in a Scene.
global drawScene(int sceneIdx){
    rawPy(){
        import builtins
        try:
            builtins._lx_scenes[sceneIdx].draw()
        except Exception:
            pass
