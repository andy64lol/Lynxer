}

// ── Animated sprites ──────────────────────────────────────────────────────────

// Create a sprite that cycles through a list of images.
// pathsJson: JSON array of image paths.  fps: frames per second.
global makeAnimatedSprite(str pathsJson, float fps, float x, float y){
    int idx = 0;
    rawPy(){
        import arcade, builtins, json as _json
        try:
            paths    = _json.loads(pathsJson)
            textures = [arcade.load_texture(p) for p in paths]
            sp       = arcade.AnimatedTimeBasedSprite()
            from arcade import AnimationKeyframe
            dur = int(1000 / max(fps, 1))
            for i, tex in enumerate(textures):
                sp.frames.append(AnimationKeyframe(i, dur, tex))
            sp.texture   = textures[0]
            sp.center_x  = x;  sp.center_y = y
            builtins._lx_sprites.append(sp)
            idx = len(builtins._lx_sprites) - 1
        except Exception:
            idx = -1
    }
    return idx;
}

// Advance animated sprite by dt seconds.  Call inside on_update.
global updateAnimation(int idx, float dt){
    rawPy(){
        import builtins
        try:
            builtins._lx_sprites[idx].update_animation(dt)
        except Exception:
            pass
    }
}

// ── Scene management ──────────────────────────────────────────────────────────

// Create an arcade Scene (named collection of SpriteLists).
// Returns scene index.
global makeScene(){
    int idx = 0;
    rawPy(){
        import arcade, builtins
        if not hasattr(builtins, "_lx_scenes"):
            builtins._lx_scenes = []
        sc = arcade.Scene()
        builtins._lx_scenes.append(sc)
        idx = len(builtins._lx_scenes) - 1
    }
    return idx;
}

// Add a SpriteList to a Scene under a name.
global addListToScene(int sceneIdx, int listIdx, str name){
    rawPy(){
        import builtins
        try:
            sc  = builtins._lx_scenes[sceneIdx]
            lst = builtins._lx_spr_lists[listIdx]
            sc.add_sprite_list(name, sprite_list=lst,
                               use_spatial_hash=True)
        except Exception:
            pass
    }
}

// Draw all SpriteLists in a Scene.
global drawScene(int sceneIdx){
    rawPy(){
        import builtins
        try:
            builtins._lx_scenes[sceneIdx].draw()
        except Exception:
            pass
    }
}

// Update all SpriteLists in a Scene (apply velocities).
global updateScene(int sceneIdx){
    rawPy(){
        import builtins
        try:
            builtins._lx_scenes[sceneIdx].update()
        except Exception:
            pass
    }
}

// ── Tilemap (Tiled editor) ────────────────────────────────────────────────────

// Load a Tiled .tmx file.  Returns a scene index.
global loadTilemap(str tmxPath, float scaling){
    int idx = 0;
    rawPy(){
        import arcade, builtins
        if not hasattr(builtins, "_lx_scenes"):
            builtins._lx_scenes = []
        try:
            tilemap = arcade.load_tilemap(tmxPath, scaling=scaling)
            sc      = arcade.Scene.from_tilemap(tilemap)
            builtins._lx_scenes.append(sc)
            idx = len(builtins._lx_scenes) - 1
            if not hasattr(builtins, "_lx_tilemaps"):
                builtins._lx_tilemaps = []
            builtins._lx_tilemaps.append(tilemap)
        except Exception:
            idx = -1
    }
    return idx;
}

// Get a named layer from a tilemap scene as a SpriteList index.
global getTilemapLayer(int sceneIdx, str layerName){
    int idx = 0;
    rawPy(){
        import builtins
        try:
            sc  = builtins._lx_scenes[sceneIdx]
            lst = sc.get_sprite_list(layerName)
            builtins._lx_spr_lists.append(lst)
            idx = len(builtins._lx_spr_lists) - 1
        except Exception:
            idx = -1
    }
    return idx;
}

