/// Draw a filled triangle. ///
global drawTriangle(float x1, float y1, float x2, float y2, float x3, float y3, int r, int g, int b){
    rawPy(){
        import arcade
        arcade.draw_triangle_filled(x1, y1, x2, y2, x3, y3, arcade.color.Color(r, g, b))
    }
}

/// Draw a triangle outline. ///
global drawTriangleOutline(float x1, float y1, float x2, float y2, float x3, float y3, int r, int g, int b, float lineWidth){
    rawPy(){
        import arcade
        arcade.draw_triangle_outline(x1, y1, x2, y2, x3, y3,
                                     arcade.color.Color(r, g, b), lineWidth)
    }
}

/// Draw a filled polygon.  coordsJson is a JSON array of [x,y,...] floats.
  e.g. drawPolygon("[100,100, 200,100, 150,200]", 0, 200, 100) ///
global drawPolygon(str coordsJson, int r, int g, int b){
    rawPy(){
        import arcade, json as _json
        try:
            flat = _json.loads(coordsJson)
            pts  = [(flat[i], flat[i+1]) for i in range(0, len(flat)-1, 2)]
            arcade.draw_polygon_filled(pts, arcade.color.Color(r, g, b))
        except Exception:
            pass
    }
}

/// Draw an arc (sector outline) centered at (cx, cy).
  startAngle and endAngle are in degrees (0 = right, counter-clockwise). ///
global drawArc(float cx, float cy, float w, float h, int r, int g, int b, float startAngle, float endAngle, float lineWidth){
    rawPy(){
        import arcade
        arcade.draw_arc_outline(cx, cy, w, h,
                                arcade.color.Color(r, g, b),
                                startAngle, endAngle, lineWidth)
    }
}

/// Draw a filled point (small circle) at (x, y). ///
global drawPoint(float x, float y, int r, int g, int b, float size){
    rawPy(){
        import arcade
        arcade.draw_point(x, y, arcade.color.Color(r, g, b), size)
    }
}

// ── Text ────────────────────────────────────────────────────────────────────

/// Draw text at (x, y) with font size.  anchor_x: "left", "center", "right". ///
global drawText(str text, float x, float y, int r, int g, int b, int size){
    rawPy(){
        import arcade
        arcade.draw_text(text, x, y, arcade.color.Color(r, g, b), size)
    }
}

/// Draw text with font family, size, style, and horizontal anchor. ///
global drawTextStyled(str text, float x, float y, int r, int g, int b, int size, str fontName, bool bold, bool italic, str anchorX){
    rawPy(){
        import arcade
        arcade.draw_text(text, x, y,
                         arcade.color.Color(r, g, b),
                         font_size=size,
                         font_name=fontName,
                         bold=bool(bold),
                         italic=bool(italic),
                         anchor_x=anchorX)
    }
}

// ── Sprites ─────────────────────────────────────────────────────────────────

/// Load a sprite image from path with optional scale.
  Returns sprite index. ///
global loadSprite(str path, float scale, float x, float y){
    int idx = 0;
    rawPy(){
        import arcade, builtins
        try:
            sp = arcade.Sprite(path, scale)
            sp.center_x = x
            sp.center_y = y
            builtins._lx_sprites.append(sp)
            idx = len(builtins._lx_sprites) - 1
        except Exception:
            idx = -1
    }
    return idx;
}

/// Return the center X position of sprite at idx. ///
global getSpriteX(int idx){
    float result = 0.0;
    rawPy(){
        import builtins
        try:
            result = float(builtins._lx_sprites[idx].center_x)
        except Exception:
            result = 0.0
    }
    return result;
}

/// Return the center Y position of sprite at idx. ///
global getSpriteY(int idx){
    float result = 0.0;
    rawPy(){
        import builtins
        try:
            result = float(builtins._lx_sprites[idx].center_y)
        except Exception:
            result = 0.0
    }
    return result;
}

/// Return the angle (degrees) of sprite at idx. ///
global getSpriteAngle(int idx){
    float result = 0.0;
    rawPy(){
        import builtins
        try:
            result = float(builtins._lx_sprites[idx].angle)
        except Exception:
            result = 0.0
    }
    return result;
}

/// Set the position of sprite at idx. ///
global setSpritePos(int idx, float x, float y){
    rawPy(){
        import builtins
        try:
            sp = builtins._lx_sprites[idx]
            sp.center_x = x
            sp.center_y = y
        except Exception:
            pass
    }
}

/// Set the rotation angle (degrees, counter-clockwise) of sprite at idx. ///
global setSpriteAngle(int idx, float angle){
    rawPy(){
        import builtins
        try:
            builtins._lx_sprites[idx].angle = angle
        except Exception:
            pass
    }
}

/// Set the scale of sprite at idx. ///
global setSpriteScale(int idx, float scale){
    rawPy(){
        import builtins
        try:
            builtins._lx_sprites[idx].scale = scale
        except Exception:
            pass
    }
}

/// Set the velocity of sprite at idx (pixels per second). ///
global setSpriteVelocity(int idx, float vx, float vy){
    rawPy(){
        import builtins
        try:
            sp = builtins._lx_sprites[idx]
            sp.change_x = vx
            sp.change_y = vy
        except Exception:
            pass
    }
}

/// Update a single sprite's position by its velocity. ///
global updateSprite(int idx){
    rawPy(){
        import builtins
        try:
            builtins._lx_sprites[idx].update()
        except Exception:
            pass
    }
}

/// Draw a single sprite. ///
global drawSprite(int idx){
    rawPy(){
        import builtins
        try:
            builtins._lx_sprites[idx].draw()
        except Exception:
            pass
    }
}

/// Return true if sprite A collides with sprite B. ///
global spriteCollides(int idxA, int idxB){
    bool result = false;
    rawPy(){
        import builtins, arcade
        try:
            a = builtins._lx_sprites[idxA]
            b = builtins._lx_sprites[idxB]
            result = bool(arcade.check_for_collision(a, b))
        except Exception:
            result = False
    }
    return result;
}

// ── Sprite lists ─────────────────────────────────────────────────────────────

/// Create a new SpriteList.  Returns list index. ///
global makeSpriteList(){
    int idx = 0;
    rawPy(){
        import arcade, builtins
        sl = arcade.SpriteList()
        builtins._lx_spr_lists.append(sl)
        idx = len(builtins._lx_spr_lists) - 1
    }
    return idx;
}

/// Add sprite at sprIdx to the SpriteList at listIdx. ///
global addToList(int listIdx, int sprIdx){
    rawPy(){
        import builtins
        try:
            builtins._lx_spr_lists[listIdx].append(builtins._lx_sprites[sprIdx])
        except Exception:
            pass
    }
}

/// Draw all sprites in a SpriteList. ///
global drawSpriteList(int listIdx){
    rawPy(){
        import builtins
        try:
            builtins._lx_spr_lists[listIdx].draw()
        except Exception:
            pass
    }
}

/// Update all sprites in a SpriteList (apply velocities). ///
global updateSpriteList(int listIdx){
    rawPy(){
        import builtins
        try:
            builtins._lx_spr_lists[listIdx].update()
        except Exception:
            pass
    }
}

// ── Input ───────────────────────────────────────────────────────────────────

/// Return true if the named key is currently held down.
  Key names: "UP", "DOWN", "LEFT", "RIGHT", "SPACE", "ENTER",
  "ESCAPE", "A"–"Z", "0"–"9", "F1"–"F12".
  e.g. keyDown("LEFT") ///
global keyDown(str key){
    bool result = false;
    rawPy(){
        import builtins, arcade
        try:
            _KEY_MAP = {
                "UP":    arcade.key.UP,    "DOWN":  arcade.key.DOWN,
                "LEFT":  arcade.key.LEFT,  "RIGHT": arcade.key.RIGHT,
                "SPACE": arcade.key.SPACE, "ENTER": arcade.key.RETURN,
                "ESCAPE": arcade.key.ESCAPE,
                "A": arcade.key.A, "B": arcade.key.B, "C": arcade.key.C,
                "D": arcade.key.D, "E": arcade.key.E, "F": arcade.key.F,
                "G": arcade.key.G, "H": arcade.key.H, "I": arcade.key.I,
                "J": arcade.key.J, "K": arcade.key.K, "L": arcade.key.L,
                "M": arcade.key.M, "N": arcade.key.N, "O": arcade.key.O,
                "P": arcade.key.P, "Q": arcade.key.Q, "R": arcade.key.R,
                "S": arcade.key.S, "T": arcade.key.T, "U": arcade.key.U,
                "V": arcade.key.V, "W": arcade.key.W, "X": arcade.key.X,
                "Y": arcade.key.Y, "Z": arcade.key.Z,
                "0": arcade.key.KEY_0, "1": arcade.key.KEY_1,
                "2": arcade.key.KEY_2, "3": arcade.key.KEY_3,
                "4": arcade.key.KEY_4, "5": arcade.key.KEY_5,
                "6": arcade.key.KEY_6, "7": arcade.key.KEY_7,
                "8": arcade.key.KEY_8, "9": arcade.key.KEY_9,
            }
            sym = _KEY_MAP.get(key.upper())
            result = sym in builtins._lx_game_win._key_state if sym is not None else False
        except Exception:
            result = False
    }
    return result;
}

/// Return true if the named key is NOT held down. ///
global keyUp(str key){
    bool result = false;
    rawPy(){
        result = not result
    }
    // delegate to keyDown and invert
    bool down = false;
    down = global.keyDown(key);
    if(down is false){ return true; }
    return false;
}

/// Return the current mouse X position (pixels from left). ///
global mouseX(){
    float result = 0.0;
    rawPy(){
        import builtins
        try:
            result = float(builtins._lx_game_win._mouse_x)
        except Exception:
            result = 0.0
    }
    return result;
}

/// Return the current mouse Y position (pixels from bottom). ///
global mouseY(){
    float result = 0.0;
    rawPy(){
        import builtins
        try:
            result = float(builtins._lx_game_win._mouse_y)
        except Exception:
            result = 0.0
    }
    return result;
}

/// Return true if the left mouse button is held. ///
global mouseLeft(){
    bool result = false;
    rawPy(){
        import builtins, arcade
        try:
            result = arcade.MOUSE_BUTTON_LEFT in builtins._lx_game_win._mouse_btn
        except Exception:
            result = False
    }
    return result;
}

/// Return true if the right mouse button is held. ///
global mouseRight(){
    bool result = false;
    rawPy(){
        import builtins, arcade
        try:
            result = arcade.MOUSE_BUTTON_RIGHT in builtins._lx_game_win._mouse_btn
        except Exception:
            result = False
    }
    return result;
}

// ── Sound ────────────────────────────────────────────────────────────────────

/// Load a sound from path.  Returns sound index. ///
global loadSound(str path){
    int idx = 0;
    rawPy(){
        import arcade, builtins
        try:
            snd = arcade.load_sound(path)
            builtins._lx_sounds.append({"sound": snd, "player": None})
            idx = len(builtins._lx_sounds) - 1
        except Exception:
            idx = -1
    }
    return idx;
}

/// Play the sound at soundIdx.  Stops any previous play of the same sound. ///
global playSound(int soundIdx){
    rawPy(){
        import arcade, builtins
        try:
            entry = builtins._lx_sounds[soundIdx]
            if entry["player"] is not None:
                try:
                    arcade.stop_sound(entry["player"])
                except Exception:
                    pass
            entry["player"] = arcade.play_sound(entry["sound"])
        except Exception:
            pass
    }
}

/// Stop the sound at soundIdx. ///
global stopSound(int soundIdx){
    rawPy(){
        import arcade, builtins
        try:
            entry = builtins._lx_sounds[soundIdx]
            if entry["player"] is not None:
                arcade.stop_sound(entry["player"])
                entry["player"] = None
        except Exception:
            pass
    }
}

// ── Timer ────────────────────────────────────────────────────────────────────

/// Return the delta time (seconds) from the last on_update call. ///
global deltaTime(){
    float result = 0.0;
    rawPy(){
        import builtins
        try:
            result = float(builtins._lx_game_dt)
        except Exception:
            result = 0.0
    }
    return result;
}

// ── Camera ───────────────────────────────────────────────────────────────────

/// Create a Camera2D and return its index. ///
global makeCamera(){
    int idx = 0;
    rawPy(){
        import arcade, builtins
        try:
            cam = arcade.camera.Camera2D()
            builtins._lx_cameras.append(cam)
            idx = len(builtins._lx_cameras) - 1
        except Exception:
            idx = -1
    }
    return idx;
}

/// Activate the camera at camIdx (draws subsequent geometry through it). ///
global useCamera(int camIdx){
    rawPy(){
        import builtins
        try:
            builtins._lx_cameras[camIdx].use()
        except Exception:
            pass
    }
}

/// Move a camera's position to (x, y). ///
global setCameraPos(int camIdx, float x, float y){
    rawPy(){
        import builtins
        try:
            builtins._lx_cameras[camIdx].position = (x, y)
        except Exception:
            pass
    }
}

/// Reset the viewport to the default (full window). ///
global resetCamera(){
    rawPy(){
        import arcade, builtins
        try:
            builtins._lx_game_win.use()
        except Exception:
            pass
    }
}

// ── Physics ───────────────────────────────────────────────────────────────────

/// Create a SimplePhysicsEngine with gravity and walls SpriteList.
  Returns engine index.  wallsListIdx = -1 for no walls. ///
global makePhysicsEngine(float gravity, int wallsListIdx){
    int idx = 0;
    rawPy(){
        import arcade, builtins
        try:
            walls = builtins._lx_spr_lists[wallsListIdx] if wallsListIdx >= 0 else arcade.SpriteList()
            // Engines are stored inline; we return the index into a new engines list.
            if not hasattr(builtins, "_lx_physics_engines"):
                builtins._lx_physics_engines = []
            // placeholder — engine is created when a player sprite is assigned
            builtins._lx_physics_engines.append({"gravity": gravity, "walls": walls, "engine": None})
            idx = len(builtins._lx_physics_engines) - 1
        except Exception:
            idx = -1
    }
    return idx;
}

/// Assign a player sprite to a physics engine and initialise it.
  Must be called before updatePhysics. ///
global setPhysicsPlayer(int engineIdx, int sprIdx){
    rawPy(){
        import arcade, builtins
        try:
            entry = builtins._lx_physics_engines[engineIdx]
            player = builtins._lx_sprites[sprIdx]
            entry["engine"] = arcade.PhysicsEnginePlatformer(
                player, gravity_constant=entry["gravity"],
                walls=entry["walls"])
        except Exception:
            pass
    }
}

/// Step the physics engine at engineIdx. ///
global updatePhysics(int engineIdx){
    rawPy(){
        import builtins
        try:
            eng = builtins._lx_physics_engines[engineIdx]["engine"]
            if eng:
                eng.update()
        except Exception:
            pass
    }
}

/// Return true if the player can jump (is on the ground). ///
global canJump(int engineIdx){
    bool result = false;
    rawPy(){
        import builtins
        try:
            eng = builtins._lx_physics_engines[engineIdx]["engine"]
            result = bool(eng.can_jump()) if eng else False
        except Exception:
            result = False
    }
    return result;
}

global main(){}
