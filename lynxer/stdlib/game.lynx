////
Lynxer standard library: game.

2-D game toolkit backed by Rust + macroquad, exposed through the native module
`stdlib/game.so`. It provides a window, drawing primitives, sprites, sprite
lists, a camera, input polling and frame timing through the `global.game`
namespace.

Coordinates use a bottom-left origin with +Y pointing up. Register frame
callbacks by name with `setDrawCallback` / `setUpdateCallback`, then call
`run()`, which blocks and drives the window until it is closed or the program
is interrupted (Ctrl-C exits with code 130).

Set the environment variable `LYNXER_GAME_HEADLESS=1` to run without a window:
`run()` executes a few deterministic frames and drawing is a no-op, which is
useful for tests.

Requires a Rust toolchain to build (see `rust/game`); the compiled module is
optional and skipped when `cargo` is unavailable.
////
fn setup(){ importAs("game.so", "nativeGame"); }

// ── Window ──────────────────────────────────────────────────────────────────

// Create the game window. Must be called before any other game function.
fn init(str title, int width, int height){ global.nativeGame.init(title, width, height); }
// Change the window title. Applied when run() opens the window.
fn setTitle(str title){ global.nativeGame.setTitle(title); }
// Set the background clear colour (0-255 per channel).
fn setBackground(int r, int g, int b){ global.nativeGame.setBackground(r, g, b); }
// Window width in pixels.
fn getWidth() -> int { return global.nativeGame.getWidth(); }
// Window height in pixels.
fn getHeight() -> int { return global.nativeGame.getHeight(); }
// Resize the window.
fn setWindowSize(int width, int height){ global.nativeGame.setWindowSize(width, height); }
// Accepted for API compatibility (the window is resizable by default).
fn setResizable(bool enabled){ global.nativeGame.setResizable(enabled); }
// Enter or leave fullscreen.
fn setFullscreen(bool enabled){ global.nativeGame.setFullscreen(enabled); }
// Show or hide the mouse cursor.
fn setMouseVisible(bool visible){ global.nativeGame.setMouseVisible(visible); }
// Alias of setMouseVisible(false)/setMouseVisible(true).
fn hideCursor(){ global.nativeGame.setMouseVisible(false); }
fn showCursor(){ global.nativeGame.setMouseVisible(true); }
// Cap the frame rate (0 disables the cap).
fn setFPSCap(int fps){ global.nativeGame.setFPSCap(fps); }
// Current frames per second (0 in headless mode).
fn getFPS() -> int { return global.nativeGame.getFPS(); }
// Ask the window to close at the end of the current frame.
fn close(){ global.nativeGame.close(); }
// True while the window is open.
fn isOpen() -> bool { return global.nativeGame.isOpen() isnt 0; }

// ── App lifecycle ───────────────────────────────────────────────────────────

// Blocking frame loop. Invokes the update callback (with the frame time in
// seconds) and then the draw callback once per frame.
fn run(){ global.nativeGame.run(); }
// Name of the Lynxer function called once per frame to draw.
fn setDrawCallback(str callbackName){ global.nativeGame.setDrawCallback(callbackName); }
// Name of the Lynxer function called once per frame with the delta time.
fn setUpdateCallback(str callbackName){ global.nativeGame.setUpdateCallback(callbackName); }
// Seconds since the previous frame.
fn deltaTime() -> float { return global.nativeGame.deltaTime(); }
// Seconds since the program started.
fn getTime() -> float { return global.nativeGame.getTime(); }

// ── Draw loop ───────────────────────────────────────────────────────────────

// Clear the screen to the background colour.
fn beginDraw(){ global.nativeGame.beginDraw(); }
// No-op, kept for symmetry with beginDraw.
fn endDraw(){ global.nativeGame.endDraw(); }

// ── Shapes ──────────────────────────────────────────────────────────────────

fn drawRect(float cx, float cy, float width, float height, int r, int g, int b){
    global.nativeGame.drawRect(cx, cy, width, height, r, g, b);
}
fn drawRectOutline(float cx, float cy, float width, float height, int r, int g, int b, float lineWidth){
    global.nativeGame.drawRectOutline(cx, cy, width, height, r, g, b, lineWidth);
}
fn drawCircle(float cx, float cy, float radius, int r, int g, int b){
    global.nativeGame.drawCircle(cx, cy, radius, r, g, b);
}
fn drawCircleOutline(float cx, float cy, float radius, int r, int g, int b, float lineWidth){
    global.nativeGame.drawCircleOutline(cx, cy, radius, r, g, b, lineWidth);
}
fn drawEllipse(float cx, float cy, float width, float height, int r, int g, int b){
    global.nativeGame.drawEllipse(cx, cy, width, height, r, g, b);
}
fn drawEllipseOutline(float cx, float cy, float width, float height, int r, int g, int b, float lineWidth){
    global.nativeGame.drawEllipseOutline(cx, cy, width, height, r, g, b, lineWidth);
}
fn drawLine(float x1, float y1, float x2, float y2, int r, int g, int b, float lineWidth){
    global.nativeGame.drawLine(x1, y1, x2, y2, r, g, b, lineWidth);
}
fn drawTriangle(float x1, float y1, float x2, float y2, float x3, float y3, int r, int g, int b){
    global.nativeGame.drawTriangle(x1, y1, x2, y2, x3, y3, r, g, b);
}
fn drawTriangleOutline(float x1, float y1, float x2, float y2, float x3, float y3, int r, int g, int b, float lineWidth){
    global.nativeGame.drawTriangleOutline(x1, y1, x2, y2, x3, y3, r, g, b, lineWidth);
}
fn drawPoint(float x, float y, int r, int g, int b, float size){
    global.nativeGame.drawPoint(x, y, r, g, b, size);
}
fn drawRectRoundedFilled(float cx, float cy, float width, float height, int r, int g, int b, float cornerRadius){
    global.nativeGame.drawRectRoundedFilled(cx, cy, width, height, r, g, b, cornerRadius);
}
fn drawRectRoundedOutline(float cx, float cy, float width, float height, int r, int g, int b, float cornerRadius, float lineWidth){
    global.nativeGame.drawRectRoundedOutline(cx, cy, width, height, r, g, b, cornerRadius, lineWidth);
}
fn drawStar(float cx, float cy, float outerRadius, float innerRadius, int points, int r, int g, int b){
    global.nativeGame.drawStar(cx, cy, outerRadius, innerRadius, points, r, g, b);
}
fn drawDashedLine(float x1, float y1, float x2, float y2, int r, int g, int b, float lineWidth, float dashLength){
    global.nativeGame.drawDashedLine(x1, y1, x2, y2, r, g, b, lineWidth, dashLength);
}
fn drawCross(float cx, float cy, float size, int r, int g, int b, float lineWidth){
    global.nativeGame.drawCross(cx, cy, size, r, g, b, lineWidth);
}
fn drawGradientRect(float cx, float cy, float width, float height, int r1, int g1, int b1, int r2, int g2, int b2){
    global.nativeGame.drawGradientRect(cx, cy, width, height, r1, g1, b1, r2, g2, b2);
}
fn drawArc(float cx, float cy, float width, float height, int r, int g, int b, float startAngle, float endAngle, float lineWidth){
    global.nativeGame.drawArc(cx, cy, width, height, r, g, b, startAngle, endAngle, lineWidth);
}
fn drawArcFilled(float cx, float cy, float width, float height, int r, int g, int b, float startAngle, float endAngle){
    global.nativeGame.drawArcFilled(cx, cy, width, height, r, g, b, startAngle, endAngle);
}
// coordsJson is a flat "x,y,x,y,..." list.
fn drawPolygon(str coordsJson, int r, int g, int b){ global.nativeGame.drawPolygon(coordsJson, r, g, b); }
fn drawPolygonOutline(str coordsJson, int r, int g, int b, float lineWidth){
    global.nativeGame.drawPolygonOutline(coordsJson, r, g, b, lineWidth);
}
fn drawPolyline(str coordsJson, int r, int g, int b, float lineWidth){
    global.nativeGame.drawPolyline(coordsJson, r, g, b, lineWidth);
}
fn drawPoints(str coordsJson, int r, int g, int b, float size){
    global.nativeGame.drawPoints(coordsJson, r, g, b, size);
}
// segmentsJson is a flat "x1,y1,x2,y2,..." list of segment endpoints.
fn drawLines(str segmentsJson, int r, int g, int b, float lineWidth){
    global.nativeGame.drawLines(segmentsJson, r, g, b, lineWidth);
}

// ── Text ────────────────────────────────────────────────────────────────────

fn drawText(str text, float x, float y, int r, int g, int b, int size){
    global.nativeGame.drawText(text, x, y, r, g, b, size);
}
// anchorX is "left", "center" or "right"; fontName may be "".
fn drawTextStyled(str text, float x, float y, int r, int g, int b, int size, str fontName, bool bold, bool italic, str anchorX){
    global.nativeGame.drawTextStyled(text, x, y, r, g, b, size, fontName, bold, italic, anchorX);
}
// anchorX/anchorY are "left"/"center"/"right" and "bottom"/"center"/"top".
fn drawTextAnchored(str text, float x, float y, int r, int g, int b, int size, str anchorX, str anchorY){
    global.nativeGame.drawTextAnchored(text, x, y, r, g, b, size, anchorX, anchorY);
}

// ── Input ───────────────────────────────────────────────────────────────────

fn keyDown(str key) -> bool { return global.nativeGame.keyDown(key) isnt 0; }
fn keyUp(str key) -> bool { return global.nativeGame.keyUp(key) isnt 0; }
fn keyPressed(str key) -> bool { return global.nativeGame.keyPressed(key) isnt 0; }
fn keyReleased(str key) -> bool { return global.nativeGame.keyReleased(key) isnt 0; }
// Numeric key code used by this backend (macroquad/keysym), or -1.
fn keyCode(str key) -> int { return global.nativeGame.keyCode(key); }
fn mouseX() -> float { return global.nativeGame.mouseX(); }
fn mouseY() -> float { return global.nativeGame.mouseY(); }
fn mouseDeltaX() -> float { return global.nativeGame.mouseDeltaX(); }
fn mouseDeltaY() -> float { return global.nativeGame.mouseDeltaY(); }
fn mouseScrollX() -> float { return global.nativeGame.mouseScrollX(); }
fn mouseScrollY() -> float { return global.nativeGame.mouseScrollY(); }
fn mouseLeft() -> bool { return global.nativeGame.mouseLeft() isnt 0; }
fn mouseRight() -> bool { return global.nativeGame.mouseRight() isnt 0; }
fn mouseMiddle() -> bool { return global.nativeGame.mouseMiddle() isnt 0; }
fn mouseButtonDown(str button) -> bool { return global.nativeGame.mouseButtonDown(button) isnt 0; }
fn mouseButtonPressed(str button) -> bool { return global.nativeGame.mouseButtonPressed(button) isnt 0; }
fn mouseButtonReleased(str button) -> bool { return global.nativeGame.mouseButtonReleased(button) isnt 0; }
fn mouseButtonCode(str button) -> int { return global.nativeGame.mouseButtonCode(button); }

// ── Textures ────────────────────────────────────────────────────────────────

// Load and cache a texture. Returns a texture index or -1.
fn loadTexture(str imagePath) -> int { return global.nativeGame.loadTexture(imagePath); }
fn drawTexture(int texIdx, float cx, float cy, float width, float height, float angle){
    global.nativeGame.drawTexture(texIdx, cx, cy, width, height, angle);
}
fn drawTextureAt(str imagePath, float cx, float cy, float scale){
    global.nativeGame.drawTextureAt(imagePath, cx, cy, scale);
}
fn drawTextureRect(int texIdx, float left, float bottom, float width, float height){
    global.nativeGame.drawTextureRect(texIdx, left, bottom, width, height);
}

// ── Sprites ─────────────────────────────────────────────────────────────────

// Coloured rectangle sprite. Returns a sprite index.
fn makeSolidSprite(int width, int height, int r, int g, int b, float x, float y) -> int {
    return global.nativeGame.makeSolidSprite(width, height, r, g, b, x, y);
}
// Image sprite. Returns a sprite index, or -1 on error.
fn loadSprite(str path, float scale, float x, float y) -> int {
    return global.nativeGame.loadSprite(path, scale, x, y);
}
fn setSpriteTexture(int idx, int texIdx){ global.nativeGame.setSpriteTexture(idx, texIdx); }
fn getSpriteX(int idx) -> float { return global.nativeGame.getSpriteX(idx); }
fn getSpriteY(int idx) -> float { return global.nativeGame.getSpriteY(idx); }
fn getSpriteAngle(int idx) -> float { return global.nativeGame.getSpriteAngle(idx); }
fn getSpriteScale(int idx) -> float { return global.nativeGame.getSpriteScale(idx); }
fn getSpriteWidth(int idx) -> float { return global.nativeGame.getSpriteWidth(idx); }
fn getSpriteHeight(int idx) -> float { return global.nativeGame.getSpriteHeight(idx); }
fn getSpriteVX(int idx) -> float { return global.nativeGame.getSpriteVX(idx); }
fn getSpriteVY(int idx) -> float { return global.nativeGame.getSpriteVY(idx); }
fn getSpriteAngularVelocity(int idx) -> float { return global.nativeGame.getSpriteAngularVelocity(idx); }
fn getSpriteAlpha(int idx) -> int { return global.nativeGame.getSpriteAlpha(idx); }
fn getSpriteVisible(int idx) -> bool { return global.nativeGame.getSpriteVisible(idx) isnt 0; }
// Returns "x,y".
fn getSpritePosition(int idx) -> str { return global.nativeGame.getSpritePosition(idx); }
fn setSpritePos(int idx, float x, float y){ global.nativeGame.setSpritePos(idx, x, y); }
fn setSpritePosition(int idx, float x, float y){ global.nativeGame.setSpritePosition(idx, x, y); }
fn setSpriteAngle(int idx, float angle){ global.nativeGame.setSpriteAngle(idx, angle); }
fn setSpriteScale(int idx, float scale){ global.nativeGame.setSpriteScale(idx, scale); }
// Velocity is in pixels per second.
fn setSpriteVelocity(int idx, float vx, float vy){ global.nativeGame.setSpriteVelocity(idx, vx, vy); }
fn setSpriteAngularVelocity(int idx, float degreesPerSecond){
    global.nativeGame.setSpriteAngularVelocity(idx, degreesPerSecond);
}
fn stopSprite(int idx){ global.nativeGame.stopSprite(idx); }
fn moveSpriteToward(int idx, float tx, float ty, float speed){ global.nativeGame.moveSpriteToward(idx, tx, ty, speed); }
fn faceSpriteTo(int idx, float tx, float ty){ global.nativeGame.faceSpriteTo(idx, tx, ty); }
fn setSpriteAlpha(int idx, int alpha){ global.nativeGame.setSpriteAlpha(idx, alpha); }
fn setSpriteColor(int idx, int r, int g, int b, int a){ global.nativeGame.setSpriteColor(idx, r, g, b, a); }
fn setSpriteVisible(int idx, bool visible){ global.nativeGame.setSpriteVisible(idx, visible); }
fn flipSpriteH(int idx){ global.nativeGame.flipSpriteH(idx); }
fn flipSpriteV(int idx){ global.nativeGame.flipSpriteV(idx); }
fn destroySprite(int idx){ global.nativeGame.destroySprite(idx); }
fn spriteExists(int idx) -> bool { return global.nativeGame.spriteExists(idx) isnt 0; }
// Apply velocity for one frame.
fn updateSprite(int idx){ global.nativeGame.updateSprite(idx); }
fn drawSprite(int idx){ global.nativeGame.drawSprite(idx); }
fn spriteCollides(int idxA, int idxB) -> bool { return global.nativeGame.spriteCollides(idxA, idxB) isnt 0; }
fn spriteCollidesWithList(int sprIdx, int listIdx) -> bool {
    return global.nativeGame.spriteCollidesWithList(sprIdx, listIdx) isnt 0;
}
// Colliding sprite indexes as a flat "[1,2]" string.
fn getCollidingSprites(int sprIdx, int listIdx) -> str {
    return global.nativeGame.getCollidingSprites(sprIdx, listIdx);
}
fn spriteDistance(int idxA, int idxB) -> float { return global.nativeGame.spriteDistance(idxA, idxB); }
fn spriteNear(int idx, float tx, float ty, float range) -> bool {
    return global.nativeGame.spriteNear(idx, tx, ty, range) isnt 0;
}

// ── Sprite lists ────────────────────────────────────────────────────────────

fn makeSpriteList() -> int { return global.nativeGame.makeSpriteList(); }
fn addToList(int listIdx, int sprIdx){ global.nativeGame.addToList(listIdx, sprIdx); }
fn removeSpriteFromList(int listIdx, int sprIdx){ global.nativeGame.removeSpriteFromList(listIdx, sprIdx); }
fn clearSpriteList(int listIdx){ global.nativeGame.clearSpriteList(listIdx); }
fn getSpriteListCount(int listIdx) -> int { return global.nativeGame.getSpriteListCount(listIdx); }
fn drawSpriteList(int listIdx){ global.nativeGame.drawSpriteList(listIdx); }
fn updateSpriteList(int listIdx){ global.nativeGame.updateSpriteList(listIdx); }

// ── Camera ──────────────────────────────────────────────────────────────────

fn makeCamera() -> int { return global.nativeGame.makeCamera(); }
fn useCamera(int camIdx){ global.nativeGame.useCamera(camIdx); }
fn setCameraPos(int camIdx, float x, float y){ global.nativeGame.setCameraPos(camIdx, x, y); }
fn getCameraX(int camIdx) -> float { return global.nativeGame.getCameraX(camIdx); }
fn getCameraY(int camIdx) -> float { return global.nativeGame.getCameraY(camIdx); }
fn zoomCamera(int camIdx, float zoom){ global.nativeGame.zoomCamera(camIdx, zoom); }
fn getCameraZoom(int camIdx) -> float { return global.nativeGame.getCameraZoom(camIdx); }
fn smoothScrollCamera(int camIdx, float tx, float ty, float speed){
    global.nativeGame.smoothScrollCamera(camIdx, tx, ty, speed);
}
fn resetCamera(){ global.nativeGame.resetCamera(); }

// ── Grid helpers ────────────────────────────────────────────────────────────

// Pixel -> tile coordinate, returned as "tx,ty".
fn screenToTile(float x, float y, int tileSize) -> str {
    return global.nativeGame.screenToTile(x, y, tileSize);
}
// Tile -> pixel centre, returned as "sx,sy".
fn tileToScreen(int tx, int ty, int tileSize) -> str {
    return global.nativeGame.tileToScreen(tx, ty, tileSize);
}

// Scenes.
fn makeScene() -> int { return global.nativeGame.makeScene(); }
fn addListToScene(int sceneIdx, int listIdx, str name) -> int {
    return global.nativeGame.addListToScene(sceneIdx, listIdx, name);
}
fn drawScene(int sceneIdx) -> int { return global.nativeGame.drawScene(sceneIdx); }
fn updateScene(int sceneIdx) -> int { return global.nativeGame.updateScene(sceneIdx); }
// Text labels.
fn makeTextLabel(str text, float x, float y, int r, int g, int b, int size, str anchorX) -> int {
    return global.nativeGame.makeTextLabel(text, x, y, r, g, b, size, anchorX);
}
fn setTextLabel(int idx, str text) -> int {
    return global.nativeGame.setTextLabel(idx, text);
}
fn setTextLabelPos(int idx, float x, float y) -> int {
    return global.nativeGame.setTextLabelPos(idx, x, y);
}
fn setTextLabelColor(int idx, int r, int g, int b, int a) -> int {
    return global.nativeGame.setTextLabelColor(idx, r, g, b, a);
}
fn drawTextLabel(int idx) -> int { return global.nativeGame.drawTextLabel(idx); }
fn destroyTextLabel(int idx) -> int { return global.nativeGame.destroyTextLabel(idx); }
// Tilemaps.
fn loadTilemap(str tmxPath, float scaling) -> int {
    return global.nativeGame.loadTilemap(tmxPath, scaling);
}
fn getTilemapLayer(int sceneIdx, str layerName) -> int {
    return global.nativeGame.getTilemapLayer(sceneIdx, layerName);
}
// Physics.
// A wall sprite with a non-zero angle is a slope; oneWayListIdx names a sprite
// list of one-way platforms (solid only from above), or -1 for none.
fn makePhysicsEngine(float gravity, int wallsListIdx, int oneWayListIdx = -1) -> int {
    return global.nativeGame.makePhysicsEngine(gravity, wallsListIdx, oneWayListIdx);
}
fn setPhysicsPlayer(int engineIdx, int sprIdx) -> int {
    return global.nativeGame.setPhysicsPlayer(engineIdx, sprIdx);
}
fn updatePhysics(int engineIdx) -> int {
    return global.nativeGame.updatePhysics(engineIdx);
}
fn canJump(int engineIdx) -> bool { return global.nativeGame.canJump(engineIdx) isnt 0; }
fn jumpPlayer(int engineIdx, float jumpSpeed) -> int {
    return global.nativeGame.jumpPlayer(engineIdx, jumpSpeed);
}
fn getPlayerVY(int engineIdx) -> float {
    return global.nativeGame.getPlayerVY(engineIdx);
}
// Animation.
fn makeAnimatedSprite(str pathsJson, float fps, float x, float y) -> int {
    return global.nativeGame.makeAnimatedSprite(pathsJson, fps, x, y);
}
fn updateAnimation(int idx, float dt) -> int {
    return global.nativeGame.updateAnimation(idx, dt);
}
// Sound.
fn loadSound(str path) -> int { return global.nativeGame.loadSound(path); }
fn playSound(int soundIdx) -> int { return global.nativeGame.playSound(soundIdx); }
fn loopSound(int soundIdx) -> int { return global.nativeGame.loopSound(soundIdx); }
fn stopSound(int soundIdx) -> int { return global.nativeGame.stopSound(soundIdx); }
fn setSoundVolume(int soundIdx, float volume) -> int {
    return global.nativeGame.setSoundVolume(soundIdx, volume);
}
fn isSoundPlaying(int soundIdx) -> bool {
    return global.nativeGame.isSoundPlaying(soundIdx) isnt 0;
}
// Window.
fn setWindowPos(int x, int y) -> int {
    return global.nativeGame.setWindowPos(x, y);
}
fn screenshot(str path) -> int { return global.nativeGame.screenshot(path); }

fn main(){}
