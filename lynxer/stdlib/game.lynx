// Return seconds elapsed since program start.
global getTime(){
    float result = 0.0;
    rawPy(){
        import time as _t, builtins
        try:
            if not hasattr(builtins, "_lx_start_time"):
                builtins._lx_start_time = _t.time()
            result = float(_t.time() - builtins._lx_start_time)
        except Exception:
            result = 0.0
    }
    return result;
}

