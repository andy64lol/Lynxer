// Stop a sprite (set velocity to 0).
global stopSprite(int idx){
    rawPy(){
        import builtins
        try:
            builtins._lx_sprites[idx].change_x = 0
            builtins._lx_sprites[idx].change_y = 0
        except Exception:
            pass
    }
}

// Move a sprite toward (tx, ty) at speed pixels/frame.
global moveSpriteToward(int idx, float tx, float ty, float speed){
    rawPy(){
        import builtins, math as _m
        try:
            sp = builtins._lx_sprites[idx]
            dx = tx - sp.center_x;  dy = ty - sp.center_y
            dist = _m.hypot(dx, dy)
            if dist > 0:
                sp.change_x = (dx / dist) * speed
                sp.change_y = (dy / dist) * speed
            else:
                sp.change_x = 0;  sp.change_y = 0
        except Exception:
            pass
    }
}

// Rotate sprite so it faces (tx, ty).
global faceSpriteTo(int idx, float tx, float ty){
    rawPy(){
        import builtins, math as _m
        try:
            sp = builtins._lx_sprites[idx]
            dx = tx - sp.center_x;  dy = ty - sp.center_y
            sp.angle = _m.degrees(_m.atan2(dy, dx))
        except Exception:
            pass
    }
}

// Return the distance between two sprites.
global spriteDistance(int idxA, int idxB){
    float result = 0.0;
    rawPy(){
        import builtins, math as _m
        try:
            a = builtins._lx_sprites[idxA]
            b = builtins._lx_sprites[idxB]
            result = float(_m.hypot(a.center_x - b.center_x,
                                    a.center_y - b.center_y))
        except Exception:
            result = 0.0
    }
    return result;
}

// Return true if a sprite is within range pixels of (tx, ty).
global spriteNear(int idx, float tx, float ty, float range){
    bool result = false;
    rawPy(){
        import builtins, math as _m
        try:
            sp = builtins._lx_sprites[idx]
            result = _m.hypot(sp.center_x - tx,
                              sp.center_y - ty) <= range
        except Exception:
            result = False
    }
    return result;
}

// Show or hide a sprite (hidden sprites still exist in lists).
global setSpriteVisible(int idx, bool visible){
    rawPy(){
        import builtins
        try:
            builtins._lx_sprites[idx].visible = bool(visible)
        except Exception:
            pass
    }
}

// Return true if the sprite is currently visible.
global getSpriteVisible(int idx){
    bool result = true;
    rawPy(){
        import builtins
        try:
            result = bool(builtins._lx_sprites[idx].visible)
        except Exception:
            result = True
    }
    return result;
}

// Return true if a sprite collides with any sprite in a SpriteList.
global spriteCollidesWithList(int sprIdx, int listIdx){
    bool result = false;
    rawPy(){
        import builtins, arcade
        try:
            sp  = builtins._lx_sprites[sprIdx]
            lst = builtins._lx_spr_lists[listIdx]
            result = bool(arcade.check_for_collision_with_list(sp, lst))
        except Exception:
            result = False
    }
    return result;
}

// Return colliding sprite indexes as a JSON array.
global getCollidingSprites(int sprIdx, int listIdx){
    str result = "[]";
    rawPy(){
        import builtins, arcade, json as _json
        try:
            sp = builtins._lx_sprites[sprIdx]
            hits = arcade.check_for_collision_with_list(
                sp, builtins._lx_spr_lists[listIdx])
            result = _json.dumps([
                i for i, candidate in enumerate(builtins._lx_sprites)
                if candidate in hits
            ])
        except Exception:
            result = "[]"
    }
    return result;
}

// Remove a sprite from a SpriteList without destroying it.
global removeSpriteFromList(int listIdx, int sprIdx){
    rawPy(){
        import builtins
        try:
            sp  = builtins._lx_sprites[sprIdx]
            lst = builtins._lx_spr_lists[listIdx]
            if sp in lst:
                lst.remove(sp)
        except Exception:
            pass
    }
}

// Remove all sprites from a SpriteList.
global clearSpriteList(int listIdx){
    rawPy(){
        import builtins
        try:
            builtins._lx_spr_lists[listIdx].clear()
        except Exception:
            pass
    }
}

// Return the number of sprites in a SpriteList.
global getSpriteListCount(int listIdx){
    int result = 0;
    rawPy(){
