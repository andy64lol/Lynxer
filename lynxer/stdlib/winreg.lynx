////
Lynxer standard library: winreg.
Windows registry reader/writer backed by the native C++ module
`stdlib/winreg.so`.

Roots are named `HKCU`, `HKLM`, `HKCR`, `HKU` or `HKCC`; the long `HKEY_*`
spellings are accepted too. `readString`/`readInt` return `""`/`-1` when the
value is missing or has an unexpected type. Writes create the key when needed.
`deleteKey` removes an empty key; `deleteTree` removes a key and its children.
This module exists only in Windows builds.
////
fn setup(){ importAs("winreg.so", "nativeWinreg"); }

fn keyExists(str root, str path) -> bool {
    return global.nativeWinreg.keyExists(root, path) isnt 0;
}
fn valueExists(str root, str path, str name) -> bool {
    return global.nativeWinreg.valueExists(root, path, name) isnt 0;
}
fn readString(str root, str path, str name) -> str {
    return global.nativeWinreg.readString(root, path, name);
}
fn readInt(str root, str path, str name) -> int {
    return global.nativeWinreg.readInt(root, path, name);
}
fn readDefault(str root, str path) -> str {
    return global.nativeWinreg.readDefault(root, path);
}
fn writeString(str root, str path, str name, str value) -> bool {
    return global.nativeWinreg.writeString(root, path, name, value) isnt 0;
}
fn writeExpandString(str root, str path, str name, str value) -> bool {
    return global.nativeWinreg.writeExpandString(root, path, name, value) isnt 0;
}
fn writeInt(str root, str path, str name, int value) -> bool {
    return global.nativeWinreg.writeInt(root, path, name, value) isnt 0;
}
fn writeDefault(str root, str path, str value) -> bool {
    return global.nativeWinreg.writeDefault(root, path, value) isnt 0;
}
fn createKey(str root, str path) -> bool {
    return global.nativeWinreg.createKey(root, path) isnt 0;
}
fn deleteValue(str root, str path, str name) -> bool {
    return global.nativeWinreg.deleteValue(root, path, name) isnt 0;
}
fn deleteKey(str root, str path) -> bool {
    return global.nativeWinreg.deleteKey(root, path) isnt 0;
}
fn deleteTree(str root, str path) -> bool {
    return global.nativeWinreg.deleteTree(root, path) isnt 0;
}
fn listKeys(str root, str path) -> list {
    str raw = global.nativeWinreg.listKeys(root, path);
    if(raw is ""){ return seqFromTo(0, 0, 1); }
    return splitStr(raw, "\n");
}
fn listValues(str root, str path) -> list {
    str raw = global.nativeWinreg.listValues(root, path);
    if(raw is ""){ return seqFromTo(0, 0, 1); }
    return splitStr(raw, "\n");
}

fn main(){}
