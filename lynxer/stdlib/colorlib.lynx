////
Lynxer standard library: colorlib.
ANSI color helpers.
////

fn setup(){}

// foreground
fn black(str text)   { return "\e[30m" + text + "\e[0m"; }
fn red(str text)     { return "\e[31m" + text + "\e[0m"; }
fn green(str text)   { return "\e[32m" + text + "\e[0m"; }
fn yellow(str text)  { return "\e[33m" + text + "\e[0m"; }
fn blue(str text)    { return "\e[34m" + text + "\e[0m"; }
fn magenta(str text) { return "\e[35m" + text + "\e[0m"; }
fn cyan(str text)    { return "\e[36m" + text + "\e[0m"; }
fn white(str text)   { return "\e[37m" + text + "\e[0m"; }
fn brightBlack(str text)   { return "\e[90m" + text + "\e[0m"; }
fn brightRed(str text)     { return "\e[91m" + text + "\e[0m"; }
fn brightGreen(str text)   { return "\e[92m" + text + "\e[0m"; }
fn brightYellow(str text)  { return "\e[93m" + text + "\e[0m"; }
fn brightBlue(str text)    { return "\e[94m" + text + "\e[0m"; }
fn brightMagenta(str text) { return "\e[95m" + text + "\e[0m"; }
fn brightCyan(str text)    { return "\e[96m" + text + "\e[0m"; }
fn brightWhite(str text)   { return "\e[97m" + text + "\e[0m"; }

// backgrounds

fn bgBlack(str text)   { return "\e[40m" + text + "\e[0m"; }
fn bgRed(str text)     { return "\e[41m" + text + "\e[0m"; }
fn bgGreen(str text)   { return "\e[42m" + text + "\e[0m"; }
fn bgYellow(str text)  { return "\e[43m" + text + "\e[0m"; }
fn bgBlue(str text)    { return "\e[44m" + text + "\e[0m"; }
fn bgMagenta(str text) { return "\e[45m" + text + "\e[0m"; }
fn bgCyan(str text)    { return "\e[46m" + text + "\e[0m"; }
fn bgWhite(str text)   { return "\e[47m" + text + "\e[0m"; }
fn bgBrightBlack(str text)   { return "\e[100m" + text + "\e[0m"; }
fn bgBrightRed(str text)     { return "\e[101m" + text + "\e[0m"; }
fn bgBrightGreen(str text)   { return "\e[102m" + text + "\e[0m"; }
fn bgBrightYellow(str text)  { return "\e[103m" + text + "\e[0m"; }
fn bgBrightBlue(str text)    { return "\e[104m" + text + "\e[0m"; }
fn bgBrightMagenta(str text) { return "\e[105m" + text + "\e[0m"; }
fn bgBrightCyan(str text)    { return "\e[106m" + text + "\e[0m"; }
fn bgBrightWhite(str text)   { return "\e[107m" + text + "\e[0m"; }

// text
fn bold(str text)      { return "\e[1m" + text + "\e[0m"; }
fn dim(str text)       { return "\e[2m" + text + "\e[0m"; }
fn italic(str text)    { return "\e[3m" + text + "\e[0m"; } // some doesn't support this
fn underline(str text) { return "\e[4m" + text + "\e[0m"; }
fn blink(str text)     { return "\e[5m" + text + "\e[0m"; } // same as italic
fn inverse(str text)   { return "\e[7m" + text + "\e[0m"; }
fn strike(str text)    { return "\e[9m" + text + "\e[0m"; }
fn error(str text)   { return "\e[1;31m" + text + "\e[0m"; }
fn success(str text) { return "\e[1;32m" + text + "\e[0m"; }
fn warn(str text)    { return "\e[1;33m" + text + "\e[0m"; }
fn info(str text)    { return "\e[1;36m" + text + "\e[0m"; }
fn heading(str text) { return "\e[1;37m" + text + "\e[0m"; }

// Low level helpers
fn reset() { return "\e[0m"; }
fn ansi(str text, str code) { return "\e[" + code + "m" + text + "\e[0m"; }
fn clearScreen() { return "\e[2J\e[H"; }
fn cursorHome() { return "\e[H"; }

fn main(){}
