////
Lynxer standard library: csv.
CSV and TSV data helpers backed by the native C++ module `stdlib/csv.so`.

Rows are exchanged as JSON strings. Parsing and writing follow Python's `csv`
module defaults: ',' delimiter, '"' quoting with '""' escaping, and "\r\n" line
terminators on output. Non-string JSON values are rendered as "" / true / false.
////
fn setup(){ importAs("csv.so", "nativeCsv"); }

// ── Read / Write ──
// Read a CSV file and return its raw content. Returns "ERROR: ..." on failure.
fn readCSV(str path) -> str { return global.nativeCsv.readCSV(path); }
// Write a CSV file from a JSON array of objects and a comma-separated header list.
fn writeCSV(str path, str jsonRows, str headers) -> str {
    return global.nativeCsv.writeCSV(path, jsonRows, headers);
}
// Append a single row (JSON array of values) to an existing CSV string.
fn appendRow(str csvStr, str jsonRow) -> str {
    return global.nativeCsv.appendRow(csvStr, jsonRow);
}
// Build a CSV string from a JSON array of objects and a header list.
fn buildCSV(str jsonRows, str headers) -> str {
    return global.nativeCsv.buildCSV(jsonRows, headers);
}

// ── Parsing ──
// Parse a CSV string into a JSON array-of-arrays (includes the header row).
fn parseRows(str csvStr) -> str { return global.nativeCsv.parseRows(csvStr); }
// Return the header row as a JSON array.
fn parseHeaders(str csvStr) -> str {
    return global.nativeCsv.parseHeaders(csvStr);
}
// Parse a CSV string into a JSON array of objects (first row = keys).
fn parseToJson(str csvStr) -> str {
    return global.nativeCsv.parseToJson(csvStr);
}

// ── Column and row access ──
// Return a JSON array of all values in the named column (excludes header).
fn getColumn(str csvStr, str colName) -> str {
    return global.nativeCsv.getColumn(csvStr, colName);
}
// Return a JSON array of values for data row rowIdx (0-based).
fn getRow(str csvStr, int rowIdx) -> str {
    return global.nativeCsv.getRow(csvStr, rowIdx);
}
// Return the number of data rows (excluding the header).
fn rowCount(str csvStr) -> int { return global.nativeCsv.rowCount(csvStr); }
// Return the number of columns in the header row.
fn colCount(str csvStr) -> int { return global.nativeCsv.colCount(csvStr); }
// Return 1 if the CSV has a column with the given name, else 0.
fn hasColumn(str csvStr, str colName) -> int {
    return global.nativeCsv.hasColumn(csvStr, colName);
}

// ── Filtering and sorting ──
// Return a CSV string with only rows where colName equals value.
fn filterRows(str csvStr, str colName, str value) -> str {
    return global.nativeCsv.filterRows(csvStr, colName, value);
}
// Return a CSV string sorted ascending by colName (lexicographic).
fn sortCSV(str csvStr, str colName) -> str {
    return global.nativeCsv.sortCSV(csvStr, colName);
}
// Return a CSV string sorted descending by colName.
fn sortCSVDesc(str csvStr, str colName) -> str {
    return global.nativeCsv.sortCSVDesc(csvStr, colName);
}

// ── Column statistics ──
// Return JSON {count, min, max, sum, mean} for a numeric column, or "{}".
fn columnStats(str csvStr, str colName) -> str {
    return global.nativeCsv.columnStats(csvStr, colName);
}

// ── TSV ──
// Convert a CSV string to TSV.
fn toTSV(str csvStr) -> str { return global.nativeCsv.toTSV(csvStr); }
// Convert a TSV string to CSV.
fn fromTSV(str tsvStr) -> str { return global.nativeCsv.fromTSV(tsvStr); }
// Read a file using a custom delimiter (returns raw content).
fn readWithDelimiter(str path, str delimiter) -> str {
    return global.nativeCsv.readWithDelimiter(path, delimiter);
}
// Parse a custom-delimited string into a JSON array of objects.
fn parseDelimited(str csvStr, str delimiter) -> str {
    return global.nativeCsv.parseDelimited(csvStr, delimiter);
}

// ── Legacy aliases ──
// Names from the earlier csv API, kept as forwarders. Note two intentional
// divergences from the legacy shapes: `csvRow` returns a JSON object keyed by
// the header row (the same as one element of parseToJson), and `csvHeaders`
// returns a comma-joined string rather than a JSON array.
fn parseCSV(str csvStr) -> str { return parseToJson(csvStr); }
fn parseCSVRaw(str csvStr) -> str { return parseRows(csvStr); }
fn readCSVRaw(str path) -> str {
    str raw = readCSV(path);
    if (returnLength(raw) >= 6 and global.substring(raw, 0, 6) is "ERROR:") {
        return "[]";
    }
    return parseRows(raw);
}
fn csvColumn(str csvStr, str colName) -> str { return getColumn(csvStr, colName); }
fn csvRowCount(str csvStr) -> int { return rowCount(csvStr); }
fn csvHeaders(str csvStr) -> str { return global.nativeCsv.csvHeaders(csvStr); }
fn csvRow(str csvStr, int rowIdx) -> str {
    return global.nativeCsv.csvRow(csvStr, rowIdx);
}
fn filterCSV(str csvStr, str colName, str value) -> str {
    return filterRows(csvStr, colName, value);
}
fn dedupCSV(str csvStr, str colName) -> str {
    return global.nativeCsv.dedupCSV(csvStr, colName);
}

fn main(){}
