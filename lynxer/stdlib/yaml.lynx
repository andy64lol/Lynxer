////
Lynxer standard library: yaml.
YAML parsing and serialization, backed by the Rust `serde_yml` crate and exposed
through the native module `stdlib/yaml.so`.

A document crosses as a JSON string (the shared structured-value bridge): a
mapping becomes an object and a sequence an array; a non-string mapping key
(which JSON cannot hold) is a failure. Anchors and aliases are resolved while
parsing, so the input is capped at 1 MiB to bound an alias-expansion payload. A
failure is the scalar sentinel: `""` for a document operation and `false` for
`yamlValid`.

Requires a Rust toolchain to build (see `rust/yaml`).
////
global setup(){ importAs("yaml.so", "nativeYaml"); }

// The YAML document as a JSON string, or "" when it does not parse.
global yamlParse(str text) -> str { return global.nativeYaml.yamlParse(text); }
// The JSON value as a YAML document, or "".
global yamlSerialize(str json) -> str { return global.nativeYaml.yamlSerialize(json); }
// True when `text` is valid YAML (and within the input cap).
global yamlValid(str text) -> bool { return global.nativeYaml.yamlValid(text) isnt 0; }
// The value at a dotted `key` (`a.b`) as a JSON string, or "".
global yamlGet(str text, str key) -> str { return global.nativeYaml.yamlGet(text, key); }

global main(){}
