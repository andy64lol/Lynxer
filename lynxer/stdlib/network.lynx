////
Lynxer standard library: network.
HTTP and WebSocket client backed by Rust (`ureq` + rustls + `tungstenite`),
exposed through the native module `stdlib/network.so`. Replaces the older
`http` and `net` modules for Lynxer; HTTPS/WSS need no system OpenSSL.

Also carries the RFC 3986 URL helpers (`urlParse`, `urlJoin`, `urlNormalize`,
the `urlGet`/`urlSet*`/`urlQuery*` family, and component percent-encoding),
backed by the Rust `url` crate.

Requires a Rust toolchain to build (see `rust/network`); the module is skipped
when `cargo` is unavailable.
////
fn setup(){ importAs("network.so", "nativeNetwork"); }

fn get(str url) -> str { return global.nativeNetwork.get(url); }
fn getStatus(str url) -> int { return global.nativeNetwork.getStatus(url); }
fn getHeaders(str url) -> str { return global.nativeNetwork.getHeaders(url); }
fn post(str url, str body, str contentType) -> str {
    return global.nativeNetwork.post(url, body, contentType);
}
fn put(str url, str body, str contentType) -> str {
    return global.nativeNetwork.put(url, body, contentType);
}
fn delete(str url) -> str { return global.nativeNetwork.delete(url); }
fn patch(str url, str body, str contentType) -> str {
    return global.nativeNetwork.patch(url, body, contentType);
}
fn getJson(str url) -> str { return global.nativeNetwork.getJson(url); }
fn postJson(str url, str jsonBody) -> str {
    return global.nativeNetwork.postJson(url, jsonBody);
}
fn download(str url, str filepath) -> str {
    return global.nativeNetwork.download(url, filepath);
}
fn urlencode(str text) -> str { return global.nativeNetwork.urlencode(text); }
fn httpHead(str url) -> int { return global.nativeNetwork.httpHead(url); }
fn urlScheme(str url) -> str { return global.nativeNetwork.urlScheme(url); }
fn urlHost(str url) -> str { return global.nativeNetwork.urlHost(url); }
fn urlPath(str url) -> str { return global.nativeNetwork.urlPath(url); }
fn urlParse(str url) -> str { return global.nativeNetwork.urlParse(url); }
fn getHostname() -> str { return global.nativeNetwork.getHostname(); }
fn resolveHost(str hostname) -> str {
    return global.nativeNetwork.resolveHost(hostname);
}

// RFC 3986 URL manipulation (the Rust `url` crate).
fn urlIsValid(str url) -> bool {
    return global.nativeNetwork.urlIsValid(url) isnt 0;
}
fn urlJoin(str base, str ref) -> str {
    return global.nativeNetwork.urlJoin(base, ref);
}
fn urlNormalize(str url) -> str {
    return global.nativeNetwork.urlNormalize(url);
}
fn urlGet(str url, str part) -> str {
    return global.nativeNetwork.urlGet(url, part);
}
fn urlSetScheme(str url, str scheme) -> str {
    return global.nativeNetwork.urlSetScheme(url, scheme);
}
fn urlSetHost(str url, str host) -> str {
    return global.nativeNetwork.urlSetHost(url, host);
}
fn urlSetPort(str url, int port) -> str {
    return global.nativeNetwork.urlSetPort(url, port);
}
fn urlSetPath(str url, str path) -> str {
    return global.nativeNetwork.urlSetPath(url, path);
}
fn urlQueryGet(str url, str key) -> str {
    return global.nativeNetwork.urlQueryGet(url, key);
}
fn urlQuerySet(str url, str key, str value) -> str {
    return global.nativeNetwork.urlQuerySet(url, key, value);
}
fn urlQueryRemove(str url, str key) -> str {
    return global.nativeNetwork.urlQueryRemove(url, key);
}
fn urlQueryAppend(str url, str key, str value) -> str {
    return global.nativeNetwork.urlQueryAppend(url, key, value);
}
fn urlEncodeComponent(str text) -> str {
    return global.nativeNetwork.urlEncodeComponent(text);
}
fn urlDecodeComponent(str text) -> str {
    return global.nativeNetwork.urlDecodeComponent(text);
}

fn wsConnect(str name, str uri) -> str {
    return global.nativeNetwork.wsConnect(name, uri);
}
fn wsSend(str name, str message) -> str {
    return global.nativeNetwork.wsSend(name, message);
}
fn wsReceive(str name) -> str { return global.nativeNetwork.wsReceive(name); }
fn wsSendReceive(str name, str message) -> str {
    return global.nativeNetwork.wsSendReceive(name, message);
}
fn wsClose(str name) -> str { return global.nativeNetwork.wsClose(name); }
fn wsConnected(str name) -> bool {
    return global.nativeNetwork.wsConnected(name) isnt 0;
}

fn tcpConnect(str name, str host, int port) -> str {
    return global.nativeNetwork.tcpConnect(name, host, port);
}
fn tcpSend(str name, str data) -> str {
    return global.nativeNetwork.tcpSend(name, data);
}
fn tcpReceive(str name, int bufSize) -> str {
    return global.nativeNetwork.tcpReceive(name, bufSize);
}
fn tcpSendReceive(str name, str data, int bufSize) -> str {
    return global.nativeNetwork.tcpSendReceive(name, data, bufSize);
}
fn tcpClose(str name) -> str {
    return global.nativeNetwork.tcpClose(name);
}
fn isPortOpen(str host, int port, int timeoutSecs) -> bool {
    return global.nativeNetwork.isPortOpen(host, port, timeoutSecs) isnt 0;
}
fn ping(str host) -> bool {
    return global.nativeNetwork.ping(host) isnt 0;
}
fn getLocalIP() -> str { return global.nativeNetwork.getLocalIP(); }

fn main(){}
