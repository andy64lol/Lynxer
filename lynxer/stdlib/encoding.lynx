////
Lynxer standard library: encoding.
Base64, hex, base32, base58, ascii85, percent-encoding and quoted-printable
codecs, backed by Rust crates (`base64`, `hex`, `data-encoding`, `bs58`,
`ascii85`, `percent-encoding`, `quoted_printable`) and exposed through the
native module `stdlib/encoding.so`.

Strings are byte sequences here: an encode function uses the UTF-8 bytes of its
input, and a decode function returns the decoded bytes as text. A payload that
is not valid UTF-8 has no representation in this module, so a decode that
produces one yields `""` (Lynxer has no byte type yet; see
docs/limitations.md). Test a decode result for `""` rather than expecting an
exception — `*Valid` reports whether the input is well formed in its codec.

Decoding is strict except that base64 and base32 padding is optional (encoding
always emits it) and base32 accepts either case. Whitespace is never accepted,
and a malformed `%` escape fails rather than passing through.

Requires a Rust toolchain to build (see `rust/encoding`).
////
global setup(){ importAs("encoding.so", "nativeEncoding"); }

// --- base64 ---------------------------------------------------------------

// Encodes a string as standard base64. Output is padded.
global base64Encode(str s) -> str { return global.nativeEncoding.base64Encode(s); }
// Decodes standard base64. Padding is optional. Returns "" on failure.
global base64Decode(str s) -> str { return global.nativeEncoding.base64Decode(s); }
// True if s is well-formed standard base64.
global base64Valid(str s) -> bool { return global.nativeEncoding.base64Valid(s) isnt 0; }

// Encodes a string as URL-safe base64 (`-` and `_` instead of `+` and `/`).
global base64UrlEncode(str s) -> str { return global.nativeEncoding.base64UrlEncode(s); }
// Decodes URL-safe base64. Padding is optional. Returns "" on failure.
global base64UrlDecode(str s) -> str { return global.nativeEncoding.base64UrlDecode(s); }
// True if s is well-formed URL-safe base64.
global base64UrlValid(str s) -> bool { return global.nativeEncoding.base64UrlValid(s) isnt 0; }

// --- hex ------------------------------------------------------------------

// Encodes a string as lower-case hexadecimal.
global hexEncode(str s) -> str { return global.nativeEncoding.hexEncode(s); }
// Encodes a string as upper-case hexadecimal.
global hexEncodeUpper(str s) -> str { return global.nativeEncoding.hexEncodeUpper(s); }
// Decodes hexadecimal (either case). Returns "" on failure.
global hexDecode(str s) -> str { return global.nativeEncoding.hexDecode(s); }
// True if s is well-formed hexadecimal (even length, hex digits only).
global hexValid(str s) -> bool { return global.nativeEncoding.hexValid(s) isnt 0; }

// --- base32 ---------------------------------------------------------------

// Encodes a string as upper-case RFC 4648 base32. Output is padded.
global base32Encode(str s) -> str { return global.nativeEncoding.base32Encode(s); }
// Decodes base32, either case, padding optional. Returns "" on failure.
global base32Decode(str s) -> str { return global.nativeEncoding.base32Decode(s); }
// True if s is well-formed base32.
global base32Valid(str s) -> bool { return global.nativeEncoding.base32Valid(s) isnt 0; }

// --- base58 ---------------------------------------------------------------

// Encodes a string as base58 (the Bitcoin alphabet, without 0, O, I and l).
global base58Encode(str s) -> str { return global.nativeEncoding.base58Encode(s); }
// Decodes base58. Returns "" on failure.
global base58Decode(str s) -> str { return global.nativeEncoding.base58Decode(s); }
// True if s is well-formed base58.
global base58Valid(str s) -> bool { return global.nativeEncoding.base58Valid(s) isnt 0; }

// --- ascii85 --------------------------------------------------------------

// Encodes a string as Adobe ascii85, including the `<~` and `~>` frame.
global ascii85Encode(str s) -> str { return global.nativeEncoding.ascii85Encode(s); }
// Decodes ascii85. The `<~`/`~>` frame is optional, whitespace is ignored and
// `z` (four zero bytes) is accepted. Returns "" on failure.
global ascii85Decode(str s) -> str { return global.nativeEncoding.ascii85Decode(s); }
// True if s is well-formed ascii85.
global ascii85Valid(str s) -> bool { return global.nativeEncoding.ascii85Valid(s) isnt 0; }

// --- percent-encoding -----------------------------------------------------

// Percent-encodes a string as a URI component (`encodeURIComponent` semantics:
// `A-Z a-z 0-9 - _ . ! ~ * ' ( )` stay unescaped).
global percentEncode(str s) -> str { return global.nativeEncoding.percentEncode(s); }
// Percent-decodes a string. A malformed `%` escape fails. Returns "" on failure.
global percentDecode(str s) -> str { return global.nativeEncoding.percentDecode(s); }
// True if every `%` in s is followed by two hexadecimal digits.
global percentValid(str s) -> bool { return global.nativeEncoding.percentValid(s) isnt 0; }

// --- quoted-printable -----------------------------------------------------

// Encodes text as quoted-printable (RFC 2045), with soft line breaks at 76
// columns.
global quotedPrintableEncode(str s) -> str { return global.nativeEncoding.quotedPrintableEncode(s); }
// Decodes quoted-printable. Returns "" on failure.
global quotedPrintableDecode(str s) -> str { return global.nativeEncoding.quotedPrintableDecode(s); }
// True if s is well-formed quoted-printable.
global quotedPrintableValid(str s) -> bool { return global.nativeEncoding.quotedPrintableValid(s) isnt 0; }
