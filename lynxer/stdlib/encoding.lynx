////
Lynxer standard library: encoding.
Base64, hex, base32, base58, ascii85, percent-encoding and quoted-printable
codecs, backed by Rust crates (`base64`, `hex`, `data-encoding`, `bs58`,
`ascii85`, `percent-encoding`, `quoted_printable`) and exposed through the
native module `stdlib/encoding.so`.

The encoded form of a payload is always text and the raw form is always a
`bytes` value: an encode function takes `bytes` and returns `str`, a decode
function takes `str` and returns `bytes`. A payload that is not valid UTF-8 is
therefore representable — a decode that used to yield `""` now returns those
bytes. A decode failure (malformed input) yields an empty `bytes`; `*Valid`
reports whether the input is well formed in its codec.

Decoding is strict except that base64 and base32 padding is optional (encoding
always emits it) and base32 accepts either case. Whitespace is never accepted,
and a malformed `%` escape fails rather than passing through.

Requires a Rust toolchain to build (see `rust/encoding`).
////
fn setup(){ importAs("encoding.so", "nativeEncoding"); }

// --- base64 ---------------------------------------------------------------

// Encodes bytes as standard base64. Output is padded.
fn base64Encode(bytes b) -> str { return global.nativeEncoding.base64Encode(b); }
// Decodes standard base64. Padding is optional. Returns empty bytes on failure.
fn base64Decode(str s) -> bytes { return global.nativeEncoding.base64Decode(s); }
// True if s is well-formed standard base64.
fn base64Valid(str s) -> bool { return global.nativeEncoding.base64Valid(s) isnt 0; }

// Encodes bytes as URL-safe base64 (`-` and `_` instead of `+` and `/`).
fn base64UrlEncode(bytes b) -> str { return global.nativeEncoding.base64UrlEncode(b); }
// Decodes URL-safe base64. Padding is optional. Returns empty bytes on failure.
fn base64UrlDecode(str s) -> bytes { return global.nativeEncoding.base64UrlDecode(s); }
// True if s is well-formed URL-safe base64.
fn base64UrlValid(str s) -> bool { return global.nativeEncoding.base64UrlValid(s) isnt 0; }

// --- hex ------------------------------------------------------------------

// Encodes bytes as lower-case hexadecimal.
fn hexEncode(bytes b) -> str { return global.nativeEncoding.hexEncode(b); }
// Encodes bytes as upper-case hexadecimal.
fn hexEncodeUpper(bytes b) -> str { return global.nativeEncoding.hexEncodeUpper(b); }
// Decodes hexadecimal (either case). Returns empty bytes on failure.
fn hexDecode(str s) -> bytes { return global.nativeEncoding.hexDecode(s); }
// True if s is well-formed hexadecimal (even length, hex digits only).
fn hexValid(str s) -> bool { return global.nativeEncoding.hexValid(s) isnt 0; }

// --- base32 ---------------------------------------------------------------

// Encodes bytes as upper-case RFC 4648 base32. Output is padded.
fn base32Encode(bytes b) -> str { return global.nativeEncoding.base32Encode(b); }
// Decodes base32, either case, padding optional. Returns empty bytes on failure.
fn base32Decode(str s) -> bytes { return global.nativeEncoding.base32Decode(s); }
// True if s is well-formed base32.
fn base32Valid(str s) -> bool { return global.nativeEncoding.base32Valid(s) isnt 0; }

// --- base58 ---------------------------------------------------------------

// Encodes bytes as base58 (the Bitcoin alphabet, without 0, O, I and l).
fn base58Encode(bytes b) -> str { return global.nativeEncoding.base58Encode(b); }
// Decodes base58. Returns empty bytes on failure.
fn base58Decode(str s) -> bytes { return global.nativeEncoding.base58Decode(s); }
// True if s is well-formed base58.
fn base58Valid(str s) -> bool { return global.nativeEncoding.base58Valid(s) isnt 0; }

// --- ascii85 --------------------------------------------------------------

// Encodes bytes as Adobe ascii85, including the `<~` and `~>` frame.
fn ascii85Encode(bytes b) -> str { return global.nativeEncoding.ascii85Encode(b); }
// Decodes ascii85. The `<~`/`~>` frame is optional, whitespace is ignored and
// `z` (four zero bytes) is accepted. Returns empty bytes on failure.
fn ascii85Decode(str s) -> bytes { return global.nativeEncoding.ascii85Decode(s); }
// True if s is well-formed ascii85.
fn ascii85Valid(str s) -> bool { return global.nativeEncoding.ascii85Valid(s) isnt 0; }

// --- percent-encoding -----------------------------------------------------

// Percent-encodes bytes as a URI component (`encodeURIComponent` semantics:
// `A-Z a-z 0-9 - _ . ! ~ * ' ( )` stay unescaped).
fn percentEncode(bytes b) -> str { return global.nativeEncoding.percentEncode(b); }
// Percent-decodes a string. A malformed `%` escape fails. Returns empty bytes
// on failure.
fn percentDecode(str s) -> bytes { return global.nativeEncoding.percentDecode(s); }
// True if every `%` in s is followed by two hexadecimal digits.
fn percentValid(str s) -> bool { return global.nativeEncoding.percentValid(s) isnt 0; }

// --- quoted-printable -----------------------------------------------------

// Encodes bytes as quoted-printable (RFC 2045), with soft line breaks at 76
// columns.
fn quotedPrintableEncode(bytes b) -> str { return global.nativeEncoding.quotedPrintableEncode(b); }
// Decodes quoted-printable. Returns empty bytes on failure.
fn quotedPrintableDecode(str s) -> bytes { return global.nativeEncoding.quotedPrintableDecode(s); }
// True if s is well-formed quoted-printable.
fn quotedPrintableValid(str s) -> bool { return global.nativeEncoding.quotedPrintableValid(s) isnt 0; }
