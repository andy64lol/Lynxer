////
Time and calendar helpers backed by the native C++ chrono/time backend.
////
fn setup(){ importAs("time.so", "nativeTime"); }
fn now() -> str { return global.nativeTime.now(); }
fn getTime() -> str { return global.nativeTime.getTime(); }
fn getDate() -> str { return global.nativeTime.getDate(); }
fn isoNow() -> str { return global.nativeTime.isoNow(); }
fn format(str pattern) -> str { return global.nativeTime.format(pattern); }
fn fromTimestamp(float value) -> str {
    return global.nativeTime.fromTimestamp(value);
}
fn toTimestamp(str value) -> float {
    return global.nativeTime.toTimestamp(value);
}
fn addDays(str date, int days) -> str {
    return global.nativeTime.addDays(date, days);
}
fn diffDays(str left, str right) -> int {
    return global.nativeTime.diffDays(left, right);
}
fn getYear() -> int { return global.nativeTime.getYear(); }
fn getMonth() -> int { return global.nativeTime.getMonth(); }
fn getDay() -> int { return global.nativeTime.getDay(); }
fn getHour() -> int { return global.nativeTime.getHour(); }
fn getMinute() -> int { return global.nativeTime.getMinute(); }
fn getSecond() -> int { return global.nativeTime.getSecond(); }
fn getWeekdayNum() -> int { return global.nativeTime.getWeekdayNum(); }
fn getWeekday() -> str { return global.nativeTime.getWeekday(); }
fn timestamp() -> float { return global.nativeTime.timestamp(); }
fn isLeapYear(int year) -> bool {
    return global.nativeTime.isLeapYear(year) isnt 0;
}
fn daysInMonth(int year, int month) -> int {
    return global.nativeTime.daysInMonth(year, month);
}
fn main(){}
