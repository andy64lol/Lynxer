//// PDF generation, text extraction and metadata, backed by printpdf and lopdf. PDF values cross the ABI as base64 strings. ////
fn setup(){ importAs("pdf.so", "nativePdf"); }
fn pdfGenerate(str text) -> str { return global.nativePdf.pdfGenerate(text); }
fn pdfText(str base64Pdf) -> str { return global.nativePdf.pdfText(base64Pdf); }
fn pdfInfo(str base64Pdf) -> str { return global.nativePdf.pdfInfo(base64Pdf); }
fn main(){}
