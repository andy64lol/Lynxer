////
Lynxer standard library: random.
Random number and character helpers backed by the native C++ module
`stdlib/random.so`.

The generator is a seeded linear congruential sequence, so a given seed always
produces the same sequence. `seed(0)` restores the default seed.
////
global setup(){ importAs("random.so", "nativeRandom"); }

// Reseed the generator; 0 restores the default seed.
global seed(int value) { global.nativeRandom.seed(value); }
// Uniform integer in [low, high]. Returns low when high <= low.
global randint(int low, int high) -> int {
    return global.nativeRandom.randint(low, high);
}
// Uniform integer in [start, stop). Returns start when stop <= start.
global randrange(int start, int stop) -> int {
    return global.nativeRandom.randrange(start, stop);
}
// Float in [0.0, 1.0).
global random() -> float { return global.nativeRandom.random(); }
// Float in [low, high].
global uniform(float low, float high) -> float {
    return global.nativeRandom.uniform(low, high);
}
// Equal-probability boolean.
global coinflip() -> bool { return global.nativeRandom.coinflip() isnt 0; }
// Alias of coinflip.
global randBool() -> bool { return global.nativeRandom.coinflip() isnt 0; }
// Pick one character of the input string, or "" when it is empty.
global choice(str items) -> str { return global.nativeRandom.choice(items); }

// A random lowercase hex string of `n` characters.
global randHex(int n) -> str {
    str digits = "0123456789abcdef";
    str result = "";
    int index = 0;
    while(index < n){
        result = result + global.charAt(digits, randint(0, 15));
        index = index + 1;
    }
    return result;
}
// Uniform multiple of `step` in [start, stop). Returns start when the range is
// empty or `step` is not positive.
global randrangeStep(int start, int stop, int step) -> int {
    if(step <= 0 or start >= stop){ return start; }
    int terms = (stop - start + step - 1) /% step;
    return start + randint(0, terms - 1) * step;
}
// The non-empty "|"-separated parts of `items`.
func splitParts(str items) -> list {
    list parts = global.splitStr(items, "|");
    list kept = [];
    int index = 0;
    while(index < returnLength(parts)){
        str part = global.listGet(parts, index);
        if(returnLength(part) > 0){ kept = global.listPush(kept, part); }
        index = index + 1;
    }
    return kept;
}
// A random non-empty part of a "|"-separated list, trimmed; "" when there is none.
global sampleStr(str items) -> str {
    list kept = splitParts(items);
    if(returnLength(kept) is 0){ return ""; }
    return global.trim(global.listGet(kept, randint(0, returnLength(kept) - 1)));
}
// Like sampleStr, parsed as an integer; 0 when the part is missing or not a number.
global sampleInt(str items) -> int {
    str chosen = sampleStr(items);
    if(returnLength(chosen) is 0){ return 0; }
    try {
        return global.intOf(chosen);
    } catch (str error) {
        return 0;
    }
}
// `k` distinct parts chosen without replacement, joined by "|".
global sample(str items, int k) -> str {
    list kept = splitParts(items);
    int count = returnLength(kept);
    if(k > count){ k = count; }
    int position = 0;
    while(position < k){
        int pick = randint(position, count - 1);
        str temporary = global.listGet(kept, position);
        kept = global.listSet(kept, position, global.listGet(kept, pick));
        kept = global.listSet(kept, pick, temporary);
        position = position + 1;
    }
    list chosen = [];
    position = 0;
    while(position < k){
        chosen = global.listPush(chosen, global.listGet(kept, position));
        position = position + 1;
    }
    return global.listJoin(chosen, "|");
}
// A shuffled copy of the non-empty parts, joined by "|".
global shuffle(str items) -> str {
    list kept = splitParts(items);
    int last = returnLength(kept) - 1;
    while(last > 0){
        int pick = randint(0, last);
        str temporary = global.listGet(kept, last);
        kept = global.listSet(kept, last, global.listGet(kept, pick));
        kept = global.listSet(kept, pick, temporary);
        last = last - 1;
    }
    return global.listJoin(kept, "|");
}
// Gaussian sample with mean `mu` and standard deviation `sigma`.
global gauss(float mu, float sigma) -> float {
    return global.nativeRandom.gauss(mu, sigma);
}
// Triangular sample over [low, high] peaking at `mid`.
global triangular(float low, float high, float mid) -> float {
    return global.nativeRandom.triangular(low, high, mid);
}
// A random RFC 4122 version-4 UUID, lowercase.
global uuid4() -> str {
    str raw = randHex(32);
    str versioned = global.substring(raw, 0, 12) + "4" +
                    global.substring(raw, 13, 16) + "8" +
                    global.substring(raw, 17, 32);
    return global.substring(versioned, 0, 8) + "-" +
           global.substring(versioned, 8, 12) + "-" +
           global.substring(versioned, 12, 16) + "-" +
           global.substring(versioned, 16, 20) + "-" +
           global.substring(versioned, 20, 32);
}

global main(){}
