////
Clynxer standard library: fileIO.
File and text input/output helpers backed by the native C++ module
`stdlib/fileIO.so`.

Functions return "" / false / -1 on error; check return values in calling code.
`readLines` splits the file content on newlines, matching the Python reference.
////
global setup(){ importAs("fileIO.so", "nativeFileIO"); }

// Read the entire contents of path. Returns "" on error.
global readFile(str path) -> str { return global.nativeFileIO.readFile(path); }
// Write content to path (overwrites). Returns true on success.
global writeFile(str path, str content) -> bool {
    return global.nativeFileIO.writeFile(path, content) isnt 0;
}
// Append content to path. Returns true on success.
global appendFile(str path, str content) -> bool {
    return global.nativeFileIO.appendFile(path, content) isnt 0;
}
// Returns true if path refers to an existing file.
global fileExists(str path) -> bool {
    return global.nativeFileIO.fileExists(path) isnt 0;
}
// Delete path. Returns true on success.
global deleteFile(str path) -> bool {
    return global.nativeFileIO.deleteFile(path) isnt 0;
}
// Read path and return a list of lines (newlines stripped).
global readLines(str path) -> list {
    str raw = global.nativeFileIO.readFile(path);
    if(raw is ""){ return seqFromTo(0, 0, 1); }
    return splitStr(raw, "\n");
}
// Copy src to dst (overwriting dst). Returns true on success.
global copyFile(str src, str dst) -> bool {
    return global.nativeFileIO.copyFile(src, dst) isnt 0;
}
// Return the size of path in bytes, or -1 on error.
global fileSize(str path) -> int { return global.nativeFileIO.fileSize(path); }
// Move (rename) a file from src to dst. Returns true on success.
global moveFile(str src, str dst) -> bool {
    return global.nativeFileIO.moveFile(src, dst) isnt 0;
}
// Return the number of lines in a file, or -1 on error.
global countLines(str path) -> int {
    return global.nativeFileIO.countLines(path);
}
// Return the nth line (0-based) of path, or "" on error.
global readLine(str path, int n) -> str {
    return global.nativeFileIO.readLine(path, n);
}
// Return the last-modified timestamp as "YYYY-MM-DD HH:MM:SS", or "".
global fileModTime(str path) -> str {
    return global.nativeFileIO.fileModTime(path);
}
// Return the file extension including the dot, or "".
global fileExtension(str path) -> str {
    return global.nativeFileIO.fileExtension(path);
}
// Return true if path is a file and its size is 0 bytes.
global fileIsEmpty(str path) -> bool {
    return global.nativeFileIO.fileIsEmpty(path) isnt 0;
}
// Create a temporary file with the given suffix and return its path.
global tempFile(str suffix) -> str {
    return global.nativeFileIO.tempFile(suffix);
}
// Create a temporary directory and return its path.
global tempDir() -> str { return global.nativeFileIO.tempDir(); }
// Return the file name without directory or extension.
global stemName(str path) -> str {
    return global.nativeFileIO.stemName(path);
}
// Read path, split into lines, and join them with sep.
global readFileLines(str path, str sep) -> str {
    return global.nativeFileIO.readFileLines(path, sep);
}

global main(){}
