////
Runtime and operating-system information backed by the native C++ module
`stdlib/sys.so`.

Lynxer has no Python runtime, so `version()` reports the Lynxer version and
`implementation()` returns "Lynxer". The Python-specific surface
(sys.path, sys.modules, recursion limits) is not applicable and is deliberately
absent. Because Lynxer does not forward extra arguments to a program,
`argv()`/`getArg()` describe the lynxer process command line.
////
global setup(){ importAs("sys.so", "nativeSys"); }
global platform() -> str { return global.nativeSys.platform(); }
global version() -> str { return global.nativeSys.version(); }
global versionInfo() -> str { return global.nativeSys.versionInfo(); }
global implementation() -> str { return global.nativeSys.implementation(); }
global apiVersion() -> str { return global.nativeSys.apiVersion(); }
global isFrozen() -> bool { return global.nativeSys.isFrozen() isnt 0; }
global getpid() -> int { return global.nativeSys.getpid(); }
global getMaxSize() -> int { return global.nativeSys.getMaxSize(); }
global getByteOrder() -> str { return global.nativeSys.getByteOrder(); }
global getDefaultEncoding() -> str {
    return global.nativeSys.getDefaultEncoding();
}
global getFilesystemEncoding() -> str {
    return global.nativeSys.getFilesystemEncoding();
}
global isatty() -> bool { return global.nativeSys.isatty() isnt 0; }
global stdinName() -> str { return global.nativeSys.stdinName(); }
global stdoutName() -> str { return global.nativeSys.stdoutName(); }
global executable() -> str { return global.nativeSys.executable(); }
global prefix() -> str { return global.nativeSys.prefix(); }
global execPrefix() -> str { return global.nativeSys.execPrefix(); }
global argv() -> str { return global.nativeSys.argv(); }
global argCount() -> int { return global.nativeSys.argCount(); }
global getArg(int index) -> str { return global.nativeSys.getArg(index); }
// Exit the process with the given code (0 = success).
global exit(int code) { global.nativeSys.exit(code); }
global exitOk() { global.nativeSys.exit(0); }
global exitError() { global.nativeSys.exit(1); }
global main(){}
