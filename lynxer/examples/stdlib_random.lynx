////
Fixture for the random stdlib. Interpreted only (module imports are not
bytecode-compilable). Seeded, so output is reproducible.
////
fn setup(){ import("random"); }

fn main(){
    random.seed(7);
    println(random.randint(1, 6));
    println(random.randrange(0, 10));
    println(random.choice("abc"));
    println(random.coinflip());
    println(random.randBool());
    println(random.uniform(0.0, 1.0));
    println(random.random() < 1.0);
    println(random.randint(5, 5));
    println(random.choice(""));
    random.seed(0);
    println(random.randint(0, 100));
}
