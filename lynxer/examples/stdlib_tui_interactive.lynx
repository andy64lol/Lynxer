////
Selection APIs keep line-based fallbacks when output is redirected and use
keyboard selection when stdin and stdout are terminals.
////
fn setup(){ import("tui"); }

fn main(){
    println(tui.menu("menu", "[\"alpha\",\"beta\"]"));
    println(tui.select("select", "[\"alpha\",\"beta\",\"gamma\"]"));
    println(tui.multiselect("many", "[\"alpha\",\"beta\",\"gamma\"]"));
}
