////
Fixture for the os stdlib. Interpreted only (module imports are not
bytecode-compilable). Uses a repo-local scratch directory and removes it.
////
fn setup(){ import("os"); import("fileIO"); }

fn main(){
    str root = ".lynxer_scratch_os";
    if(os.exists(root)){ os.rmTree(root); }
    println(os.mkdir(root));
    println(os.mkdir(root));
    println(os.isDir(root));
    println(os.makedirs(root + "/a/b"));
    println(os.isDir(root + "/a/b"));
    println(os.isFile(root + "/a/b"));
    println(os.isDir(root + "/missing"));

    fileIO.writeFile(root + "/one.txt", "1");
    fileIO.writeFile(root + "/two.txt", "2");
    fileIO.writeFile(root + "/three.log", "3");
    println(sortList(os.listdir(root)));
    println(sortList(os.listdirExt(root, ".txt")));
    println(os.walkFiles(root) is "");
    println(os.isFile(root + "/one.txt"));

    println(os.joinPath("a", "b"));
    println(os.joinPath("a/", "b"));
    println(os.basename("/x/y.txt"));
    println(os.basename("/x/"));
    println(os.dirname("/x/y.txt"));
    println(os.extname("/x/y.txt"));
    println(os.extname("/x/.bashrc"));
    println(os.normPath("a/./b/../c"));
    println(os.normPath(""));
    println(os.sep());
    println(os.getpid() > 0);
    println(os.cpuCount() > 0);
    println(os.diskTotal(root) > 0);
    println(os.diskFree(root) > 0);
    println(os.setenv("LYNXER_OS_TEST", "hello"));
    println(os.getenv("LYNXER_OS_TEST"));
    println(os.getenv("LYNXER_OS_MISSING") is "");
    println(os.expandUser("~") is os.homedir());
    println(returnLength(os.homedir()) > 0);
    println(returnLength(os.username()) > 0);
    println(returnLength(os.hostname()) > 0);
    println(returnLength(os.tempDir()) > 0);
    println(os.exists(root));
    println(os.rename(root + "/one.txt", root + "/renamed.txt"));
    println(fileIO.fileExists(root + "/renamed.txt"));
    println(os.remove(root + "/renamed.txt"));
    println(os.rmdir(root + "/a/b"));
    println(os.rmdir(root + "/a"));
    println(os.rmTree(root));
    println(os.exists(root));

    println(returnLength(os.getSystemName()) > 0);
    println(os.getSystemArchitecture());
    println(os.getSystemUname() isnt "{}");
    println(returnLength(os.getSystemDistro()) > 2);
    println(returnLength(os.getSystemInfo()) > 2);
}
