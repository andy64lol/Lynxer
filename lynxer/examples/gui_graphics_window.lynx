////
Windowed graphics smoke test for virtual-display CI.
Requires an X11 display and OpenGL context; stops after four update callbacks.
////
fn setup(){
    import("graphics");
    import("image");
    import("fileIO");
    int updates = 0;
    int draws = 0;
    int texture = -1;
    bool windowReady = false;
}

fn onUpdate(float dt){
    updates += 1;
    if(updates is 1){
        texture = graphics.loadTexture("assets/lynxer.png");
    }
    if(updates is 3){
        graphics.screenshot("/tmp/lynxer_gui_graphics.png");
    }
    windowReady = graphics.isRunning()
        and graphics.screenWidth() >= 64.0
        and graphics.screenHeight() >= 48.0;
    if(updates is 4){
        graphics.stop();
    }
}

fn onDraw(){
    draws += 1;
    graphics.clearBackground(0, 0, 0);
    graphics.drawRectangle(8.0, 8.0, 24.0, 24.0, 255, 0, 0);
    if(texture >= 0){
        graphics.drawTexture(texture, 32.0, 0.0);
    }
}

fn main(){
    graphics.init("Lynxer GUI CI", 64, 48);
    graphics.setTargetFps(60.0);
    graphics.setUpdateCallback("onUpdate");
    graphics.setDrawCallback("onDraw");
    graphics.run();

    println("window-ready ", windowReady);
    println("updates ", updates);
    println("draws ", draws);
    println("texture-loaded ", texture >= 0);
    println("texture-size ", graphics.textureWidth(texture), "x", graphics.textureHeight(texture));
    int screenshot = image.open("/tmp/lynxer_gui_graphics.png");
    println("screenshot-size ", image.getWidth(screenshot), "x", image.getHeight(screenshot));
    image.close(screenshot);
    fileIO.deleteFile("/tmp/lynxer_gui_graphics.png");
}
