    fails += check(fileIO.readFileLines(scratch, "|"), "line1|line2|line3|line4", "fileIO.readFileLines");
    fails += check(fileIO.copyFile(scratch, scratch + ".bak"), "true", "fileIO.copyFile");
    fails += check(fileIO.fileExists(scratch + ".bak"), "true", "fileIO.copyFile.exists");
    fails += check(fileIO.moveFile(scratch + ".bak", scratch + ".mov"), "true", "fileIO.moveFile");
    fails += check(fileIO.fileExists(scratch + ".bak"), "false", "fileIO.moveFile.sourceGone");
    fails += check(fileIO.fileExists(scratch + ".mov"), "true", "fileIO.moveFile.target");
    fails += check(fileIO.deleteFile(scratch + ".mov"), "true", "fileIO.deleteFile");
    fails += check(fileIO.fileExists(scratch + ".mov"), "false", "fileIO.deleteFile.gone");
    fails += check(fileIO.deleteFile(scratch), "true", "fileIO.deleteFile.main");
    fails += check(fileIO.readFile(scratch) is "", "true", "fileIO.readFile.missing");
    fails += check(returnLength(fileIO.readLines(scratch)), "0", "fileIO.readLines.missing");
    fails += check(fileIO.fileModTime(scratch) is "", "true", "fileIO.fileModTime.missing");
    fails += check(fileIO.countLines(scratch), "-1", "fileIO.countLines.missing");
    str temp = fileIO.tempFile(".tmp");
