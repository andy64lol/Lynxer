    fails += check(fileIO.countLines(scratch), "3", "fileIO.countLines");
    fails += check(fileIO.readLine(scratch, 1), "line2", "fileIO.readLine");
    fails += check(fileIO.readLine(scratch, 99), "", "fileIO.readLine.oob");
    fails += check(fileIO.fileSize(scratch), "18", "fileIO.fileSize");
    fails += check(fileIO.fileExtension(scratch), ".txt", "fileIO.fileExtension");
    fails += check(fileIO.stemName(scratch), ".lynxer_scratch_fileio", "fileIO.stemName");
    fails += check(fileIO.fileIsEmpty(scratch), "false", "fileIO.fileIsEmpty");
    fails += check(fileIO.appendFile(scratch, "line4\n"), "true", "fileIO.appendFile");
