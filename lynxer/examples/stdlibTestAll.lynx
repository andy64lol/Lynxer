    fails += check(returnLength(tempDir) > 0, "true", "fileIO.tempDir");
    fails += check(os.rmdir(tempDir), "true", "fileIO.tempDir.rmdir");

    // ---------------------------------------------------------------- random
    println("== random ==");
    random.seed(7);
    fails += check(random.randint(1, 6), "4", "random.randint");
    fails += check(random.randrange(0, 10), "3", "random.randrange");
