    fails += check(fileIO.writeFile(scratch, "line1\nline2\nline3\n"), "true", "fileIO.writeFile");
    fails += check(fileIO.fileExists(scratch), "true", "fileIO.fileExists");
    fails += check(fileIO.readFile(scratch), "line1\nline2\nline3\n", "fileIO.readFile");
