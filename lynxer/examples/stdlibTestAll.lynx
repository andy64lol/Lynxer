////
stdlibTestAll.lynx — one self-checking test for every lynxer stdlib module.

It imports every stdlib module in `setup()` and then asserts the behaviour of
each one against the values pinned by the per-module `stdlib_*.lynx` fixtures.
All modules are covered, including the Rust-backed `game`, `image`, `json`,
`lua`, `network` and `server` crates.
`check(actual, expected, label)` renders the actual value with `strOf` and
compares it to the expected text, so a mismatch prints both values and the run
continues; at the end the program exits with status 1 if any check failed.

The test is location-independent: it works from any working directory (all
filesystem checks use scratch files it creates and removes) and forces the game
module into headless mode itself, so no environment variable is required:

    ./lynxer examples/stdlibTestAll.lynx
////

fn setup(){
    import("math");
    import("time");
    import("shell");
    import("sys");
    import("typing");
    import("text");
    import("colorlib");
    import("random");
    import("multiprocessing");
    import("js");
    import("lua");
    import("csv");
    import("regex");
    import("re");
    import("cli");
    import("debug");
    import("image");
    import("fileIO");
    import("os");
    import("server");
    import("path");
    import("json");
    import("network");
    // Graphics needs a display, which a CI runner does not have. When the suite
    // sets LYNXER_SKIP_DISPLAY=1 the game module is not imported and the game
    // section below is skipped; every other module still runs.
    str skipDisplayValue = os.getenv("LYNXER_SKIP_DISPLAY");
    bool skipDisplay = skipDisplayValue is "1";
    if(not skipDisplay){
        import("game");
        import("graphics");
    }
}

// Compare the rendered form of `actual` to `expected`, reporting mismatches
// without aborting so a single run lists every failing check.
fn check(any actual, str expected, str label){
    str rendered = strOf(actual);
    if(rendered is expected){
        println("ok   ", label);
        return 0;
    }
    println("FAIL ", label, "  expected=[", expected, "]  actual=[", rendered, "]");
    return 1;
}

// Frame callbacks registered with the game module; headless `run()` drives them
// for a few deterministic frames.
// Frame callbacks registered with the graphics module, kept apart from the
// game ones so each section's output identifies its own backend.
fn graphicsUpdate(float dt){
    println("graphics.update ", dt);
}

fn graphicsDraw(){
    println("graphics.draw");
}

fn onUpdate(float dt){
    println("game.update ", dt);
}

fn onDraw(){
    println("game.draw");
}

fn main(){
    int fails = 0;

    // ------------------------------------------------------------------ math
    println("== math ==");
    fails += check(math.abs(-5), "5", "math.abs");
    fails += check(math.absFloat(-2.5), "2.5", "math.absFloat");
    fails += check(math.max(3, 9), "9", "math.max");
    fails += check(math.min(3, 9), "3", "math.min");
    fails += check(math.clamp(11, 0, 10), "10", "math.clamp");
    fails += check(math.pow(2, 10), "1024", "math.pow");
    fails += check(math.sqrt(16.0), "4", "math.sqrt");
    fails += check(math.sign(-4), "-1", "math.sign");
    fails += check(math.isEven(8), "true", "math.isEven");
    fails += check(math.isOdd(8), "false", "math.isOdd");
    fails += check(math.factorial(5), "120", "math.factorial");
    fails += check(math.gcd(12, 18), "6", "math.gcd");
    fails += check(math.lcm(4, 6), "12", "math.lcm");
    fails += check(math.isPrime(97), "true", "math.isPrime");
    fails += check(math.nextPrime(100), "101", "math.nextPrime");
    fails += check(math.binomial(5, 2), "10", "math.binomial");
    fails += check(math.sumRange(1, 4), "10", "math.sumRange");
    fails += check(math.isqrt(50), "7", "math.isqrt");
    fails += check(math.floor(2.7), "2", "math.floor");
    fails += check(math.ceil(2.1), "3", "math.ceil");
    fails += check(math.round(2.5), "3", "math.round");
    fails += check(math.truncate(-2.7), "-2", "math.truncate");
    fails += check(math.roundTo(3.14159, 2), "3.14", "math.roundTo");
    fails += check(math.fmod(7.5, 2.0), "1.5", "math.fmod");
    fails += check(math.pi(), "3.141592653589793", "math.pi");
    fails += check(math.tau(), "6.283185307179586", "math.tau");
    fails += check(math.gcd(0, 0), "0", "math.gcd.zero");
    fails += check(math.maxInt() > 0, "true", "math.maxInt");
    fails += check(math.minInt() < 0, "true", "math.minInt");
    fails += check(math.mean(seqFromTo(1, 5, 1)), "2.5", "math.mean");
    fails += check(math.prod(seqFromTo(1, 4, 1)), "6", "math.prod");
    fails += check(math.norm(seqFromTo(3, 5, 1)), "5", "math.norm");
    fails += check(math.argmax(seqFromTo(1, 5, 1)), "3", "math.argmax");
    fails += check(math.argmin(seqFromTo(5, 1, -1)), "3", "math.argmin");
    fails += check(math.median(seqFromTo(1, 5, 1)), "2.5", "math.median.odd");
    fails += check(math.median(seqFromTo(1, 4, 1)), "2", "math.median.even");
    fails += check(math.std(seqFromTo(1, 5, 1)), "1.118033988749895", "math.std");
    fails += check(math.variance(seqFromTo(1, 5, 1)), "1.25", "math.variance");
    fails += check(math.percentile(seqFromTo(1, 5, 1), 50.0), "2.5", "math.percentile");
    fails += check(math.dot(seqFromTo(1, 3, 1), seqFromTo(4, 6, 1)), "14", "math.dot");
    fails += check(math.corrcoef(seqFromTo(1, 3, 1), seqFromTo(2, 6, 2)), "1", "math.corrcoef");
    fails += check(math.linspace(0.0, 1.0, 5), "[0, 0.25, 0.5, 0.75, 1]", "math.linspace");
    fails += check(math.cumsum(seqFromTo(1, 4, 1)), "[1, 3, 6]", "math.cumsum");
    fails += check(math.diff(seqFromTo(1, 4, 1)), "[1, 1]", "math.diff");
    fails += check(math.clip(seqFromTo(1, 5, 1), 2.0, 4.0), "[2, 2, 3, 4]", "math.clip");
    list pair = listPush(listPush(listRepeat(0, 0), 3), 4);
    fails += check(math.normalize(pair), "[0.6, 0.8]", "math.normalize");
    fails += check(math.dot(pair, pair), "25", "math.dot.pair");
    fails += check(math.median(pair), "3.5", "math.median.pair");
    fails += check(math.percentile(pair, 25.0), "3.25", "math.percentile.pair");
    list noneList = listRepeat(0, 0);
    fails += check(math.median(noneList), "0", "math.median.empty");
    fails += check(math.median(noneList) is 0.0, "true", "math.median.empty.eq");
    fails += check(math.linspace(0.0, 1.0, 0), "[]", "math.linspace.empty");

    // ---------------------------------------------------------------- typing
    println("== typing ==");
    fails += check(typing.typeOf(1), "int", "typing.typeOf.int");
    fails += check(typing.typeOf(1.5), "float", "typing.typeOf.float");
    fails += check(typing.typeOf("x"), "str", "typing.typeOf.str");
    fails += check(typing.typeOf(true), "bool", "typing.typeOf.bool");
    fails += check(typing.toStr(42), "42", "typing.toStr");
    fails += check(typing.toInt("42"), "42", "typing.toInt");
    fails += check(typing.toFloat("1.5"), "1.5", "typing.toFloat");
    fails += check(typing.toBool(1), "true", "typing.toBool");
    fails += check(typing.isNumeric(3), "true", "typing.isNumeric.int");
    fails += check(typing.isNumeric("3"), "false", "typing.isNumeric.str");
    fails += check(typing.lenStr("abcd"), "4", "typing.lenStr");
    fails += check(typing.isByte(200), "true", "typing.isByte.true");
    fails += check(typing.isByte(300), "false", "typing.isByte.false");
    fails += check(typing.isInt8(200), "false", "typing.isInt8.false");
    fails += check(typing.isInt8(-5), "true", "typing.isInt8.true");
    fails += check(typing.isInt16(40000), "false", "typing.isInt16.false");
    fails += check(typing.isInt32(2147483647), "true", "typing.isInt32.true");
    fails += check(typing.isDigit("123"), "true", "typing.isDigit.true");
    fails += check(typing.isAlpha("a1"), "false", "typing.isAlpha.false");
    fails += check(typing.isSpace(" \t"), "true", "typing.isSpace.true");
    fails += check(typing.abs(-4), "4", "typing.abs");
    fails += check(typing.sign(-9), "-1", "typing.sign");
    fails += check(typing.maxOf(3, 7), "7", "typing.maxOf");
    fails += check(typing.clamp(15.0, 0.0, 10.0), "10", "typing.clamp");
    fails += check(typing.roundTo(3.14159, 2), "3.14", "typing.roundTo");
    fails += check(typing.charCodeOf("A"), "65", "typing.charCodeOf");
    fails += check(typing.charOf(66), "B", "typing.charOf");
    fails += check(typing.charAt("hello", 1), "e", "typing.charAt");
    fails += check(typing.charAt("hello", 9), "none", "typing.charAt.oob");
    fails += check(typing.indexOf("banana", "na"), "2", "typing.indexOf");
    fails += check(typing.zfill("42", 5), "00042", "typing.zfill");
    fails += check(typing.strReverse("abc"), "cba", "typing.strReverse");
    fails += check(typing.toByte(300), "255", "typing.toByte.clamp");
    fails += check(typing.listHead([int 1, int 2, int 3], 2), "[1, 2]", "typing.listHead");
    fails += check(typing.listFirst([int 7, int 8]), "7", "typing.listFirst");
    fails += check(typing.listLast([int 7, int 8]), "8", "typing.listLast");
    fails += check(typing.listChunk([int 1, int 2, int 3], 2), "[[1, 2], [3]]", "typing.listChunk");

    // ------------------------------------------------------------------ text
    println("== text ==");
    fails += check(text.reverse("abc"), "cba", "text.reverse");
    fails += check(text.repeat("ab", 3), "ababab", "text.repeat");
    fails += check(text.trim("  hi  "), "hi", "text.trim");
    fails += check(text.contains("hello", "ell"), "true", "text.contains.true");
    fails += check(text.contains("hello", ""), "true", "text.contains.empty");
    fails += check(text.contains("hello", "z"), "false", "text.contains.false");
    fails += check(text.startsWith("hello", "he"), "true", "text.startsWith.true");
    fails += check(text.startsWith("hello", "lo"), "false", "text.startsWith.false");
    fails += check(text.endsWith("hello", "lo"), "true", "text.endsWith.true");
    fails += check(text.count("banana", "na"), "2", "text.count");
    fails += check(text.count("banana", ""), "0", "text.count.empty");
    fails += check(text.replace("aaa", "a", "b"), "bbb", "text.replace");
    fails += check(text.upper("abc"), "ABC", "text.upper");
    fails += check(text.lower("ABC"), "abc", "text.lower");
    fails += check(text.isEmpty(""), "true", "text.isEmpty.true");
    fails += check(text.isEmpty("a"), "false", "text.isEmpty.false");
    fails += check(text.isBlank("  "), "true", "text.isBlank.true");
    fails += check(text.isBlank(" a "), "false", "text.isBlank.false");
    fails += check(text.indexOf("banana", "na"), "2", "text.indexOf");
    fails += check(text.spaces(3), "   ", "text.spaces");
    fails += check(text.zfill("42", 5), "00042", "text.zfill");
    fails += check(text.splitFirst("a=b", "="), "[a, b]", "text.splitFirst");
    fails += check(text.expandTabs("a\tb", 4), "a   b", "text.expandTabs");
    fails += check(text.wordWrap("the quick", 4), "the\nquick", "text.wordWrap");

    // -------------------------------------------------------------- colorlib
    println("== colorlib ==");
    fails += check(colorlib.red("x") is colorlib.ansi("x", "31"), "true", "colorlib.red");
    fails += check(colorlib.bgBlue("x") is colorlib.ansi("x", "44"), "true", "colorlib.bgBlue");
    fails += check(colorlib.bold("x") is colorlib.ansi("x", "1"), "true", "colorlib.bold");
    fails += check(colorlib.error("x") is colorlib.ansi("x", "1;31"), "true", "colorlib.error");
    fails += check(colorlib.success("x") is colorlib.ansi("x", "1;32"), "true", "colorlib.success");
    fails += check(returnLength(colorlib.reset()) > 0, "true", "colorlib.reset");
    fails += check(returnLength(colorlib.clearScreen()) > 0, "true", "colorlib.clearScreen");
    fails += check(returnLength(colorlib.cursorHome()) > 0, "true", "colorlib.cursorHome");
    fails += check(colorlib.ansi("x", "90") isnt colorlib.ansi("x", "30"), "true", "colorlib.brightDistinct");

    // ------------------------------------------------------------------ json
    println("== json ==");
    str object = "{\"name\": \"Ada\", \"age\": 36, \"active\": true}";
    fails += check(json.jsonValid(object), "true", "json.jsonValid.true");
    fails += check(json.jsonValid("{bad"), "false", "json.jsonValid.false");
    fails += check(json.jsonParse("{\"a\": 1, \"b\": [1, 2]}"), "{\n  \"a\": 1,\n  \"b\": [\n    1,\n    2\n  ]\n}", "json.jsonParse");
    fails += check(json.jsonPretty("{\"a\": 1}"), "{\n    \"a\": 1\n}", "json.jsonPretty");
    fails += check(json.jsonGet(object, "name"), "Ada", "json.jsonGet.str");
    fails += check(json.jsonGet(object, "age"), "36", "json.jsonGet.int");
    fails += check(json.jsonGetInt(object, "age"), "36", "json.jsonGetInt");
    fails += check(json.jsonGetFloat(object, "age"), "36", "json.jsonGetFloat");
    fails += check(json.jsonGetBool(object, "active"), "true", "json.jsonGetBool");
    fails += check(json.jsonGet(object, "missing"), "", "json.jsonGet.missing");
    fails += check(json.jsonKeys(object), "name,age,active", "json.jsonKeys");
    fails += check(json.jsonHas(object, "age"), "true", "json.jsonHas.true");
    fails += check(json.jsonHas(object, "nope"), "false", "json.jsonHas.false");
    fails += check(json.jsonLength(object), "3", "json.jsonLength.object");
    fails += check(json.jsonLength("[1, 2, 3]"), "3", "json.jsonLength.array");
    fails += check(json.jsonStringify("he\"llo"), "\"he\\\"llo\"", "json.jsonStringify");
    fails += check(json.jsonSet("{\"a\": 1}", "b", "2"), "{\"a\": 1, \"b\": 2}", "json.jsonSet.num");
    fails += check(json.jsonSet("{\"a\": 1}", "b", "hello"), "{\"a\": 1, \"b\": \"hello\"}", "json.jsonSet.str");
    fails += check(json.jsonSetInt("{\"a\": 1}", "b", 5), "{\"a\": 1, \"b\": 5}", "json.jsonSetInt");
    fails += check(json.jsonDelete("{\"a\": 1, \"b\": 2}", "a"), "{\"b\": 2}", "json.jsonDelete");
    fails += check(json.jsonMerge("{\"a\": 1, \"b\": 2}", "{\"b\": 3, \"c\": 4}"), "{\"a\": 1, \"b\": 3, \"c\": 4}", "json.jsonMerge");
    fails += check(json.jsonType(object, "name"), "string", "json.jsonType.str");
    fails += check(json.jsonType(object, "age"), "int", "json.jsonType.int");
    fails += check(json.jsonType(object, "active"), "bool", "json.jsonType.bool");
    fails += check(json.jsonType(object, "missing"), "null", "json.jsonType.null");
    fails += check(json.jsonBuild("name=Alice|age=30"), "{\"name\": \"Alice\", \"age\": \"30\"}", "json.jsonBuild");
    fails += check(json.jsonArray(listRepeat(7, 3)), "[7, 7, 7]", "json.jsonArray");
    list jsonPairs = listPush(listPush(listPush(listPush(listRepeat("", 0), "a"), 1), "b"), 2);
    fails += check(json.jsonObject(jsonPairs), "{\"a\": 1, \"b\": 2}", "json.jsonObject");
    fails += check(json.jsonValid("[1, 2, 3]"), "true", "json.jsonValid.array");
    fails += check(json.jsonValid("42"), "true", "json.jsonValid.scalar");
    fails += check(json.jsonParse("{bad"), "", "json.jsonParse.invalid");
    fails += check(json.jsonPretty("{\"a\": [1, 2]}"), "{\n    \"a\": [\n        1,\n        2\n    ]\n}", "json.jsonPretty.nested");
    fails += check(json.jsonLength("\"hello\""), "1", "json.jsonLength.string");
    fails += check(json.jsonLength("42"), "0", "json.jsonLength.scalar");
    fails += check(json.jsonLength("hello"), "0", "json.jsonLength.invalid");
    fails += check(json.jsonGetInt("{\"n\": \"42\"}", "n"), "42", "json.jsonGetInt.numericStr");
    fails += check(json.jsonGetInt("{\"n\": 3.9}", "n"), "3", "json.jsonGetInt.float");
    fails += check(json.jsonGetInt("{\"n\": \"3.9\"}", "n"), "0", "json.jsonGetInt.floatStr");
    fails += check(json.jsonGetInt("{\"n\": true}", "n"), "1", "json.jsonGetInt.bool");
    fails += check(json.jsonGetFloat("{\"n\": \"2.5\"}", "n"), "2.5", "json.jsonGetFloat.str");
    fails += check(json.jsonGetFloat("{\"n\": true}", "n"), "1", "json.jsonGetFloat.bool");
    fails += check(json.jsonGetBool("{\"n\": 0}", "n"), "false", "json.jsonGetBool.zero");
    fails += check(json.jsonGetBool("{\"n\": \"\"}", "n"), "false", "json.jsonGetBool.emptyStr");
    fails += check(json.jsonGetBool("{\"n\": []}", "n"), "false", "json.jsonGetBool.emptyArray");
    fails += check(json.jsonGetBool("{\"n\": [1]}", "n"), "true", "json.jsonGetBool.array");
    fails += check(json.jsonType("{\"n\": 3.5}", "n"), "float", "json.jsonType.float");
    fails += check(json.jsonType("{\"n\": [1]}", "n"), "array", "json.jsonType.array");
    fails += check(json.jsonType("{\"n\": {}}", "n"), "object", "json.jsonType.object");
    fails += check(json.jsonType("[1]", "n"), "unknown", "json.jsonType.unknown");
    fails += check(json.jsonHas("[1, \"two\", 3]", "two"), "true", "json.jsonHas.array.true");
    fails += check(json.jsonHas("[1, \"two\", 3]", "nope"), "false", "json.jsonHas.array.false");
    fails += check(json.jsonKeys("[1, 2]"), "", "json.jsonKeys.array");
    fails += check(json.jsonStringify("42"), "\"42\"", "json.jsonStringify.number");
    fails += check(json.jsonSet("[1, 2]", "a", "1"), "[1, 2]", "json.jsonSet.nonObject");
    fails += check(json.jsonSetInt("[1, 2]", "a", 1), "[1, 2]", "json.jsonSetInt.nonObject");
    fails += check(json.jsonDelete("[1, 2]", "a"), "[1, 2]", "json.jsonDelete.nonObject");
    fails += check(json.jsonMerge("[1]", "{\"a\": 1}"), "[1]", "json.jsonMerge.nonObject");
    fails += check(json.jsonBuild(""), "{}", "json.jsonBuild.empty");
    fails += check(json.jsonBuild("a=1|broken|b = 2"), "{\"a\": \"1\", \"b\": \"2\"}", "json.jsonBuild.skip");

    // ------------------------------------------------------------------- csv
    println("== csv ==");
    str csvData = "name,age,city\nalpha,30,London\nbeta,25,Paris\ngamma,30,London\n";
    fails += check(csv.parseRows(csvData), "[[\"name\", \"age\", \"city\"], [\"alpha\", \"30\", \"London\"], [\"beta\", \"25\", \"Paris\"], [\"gamma\", \"30\", \"London\"]]", "csv.parseRows");
    fails += check(csv.parseHeaders(csvData), "[\"name\", \"age\", \"city\"]", "csv.parseHeaders");
    fails += check(csv.parseToJson(csvData), "[{\"name\": \"alpha\", \"age\": \"30\", \"city\": \"London\"}, {\"name\": \"beta\", \"age\": \"25\", \"city\": \"Paris\"}, {\"name\": \"gamma\", \"age\": \"30\", \"city\": \"London\"}]", "csv.parseToJson");
    fails += check(csv.getColumn(csvData, "name"), "[\"alpha\", \"beta\", \"gamma\"]", "csv.getColumn");
    fails += check(csv.getRow(csvData, 1), "[\"beta\", \"25\", \"Paris\"]", "csv.getRow");
    fails += check(csv.getRow(csvData, 9), "[]", "csv.getRow.oob");
    fails += check(csv.rowCount(csvData), "3", "csv.rowCount");
    fails += check(csv.colCount(csvData), "3", "csv.colCount");
    fails += check(csv.hasColumn(csvData, "age"), "1", "csv.hasColumn.true");
    fails += check(csv.hasColumn(csvData, "nope"), "0", "csv.hasColumn.false");
    fails += check(csv.getColumn("a,b\n1,2\n", "missing"), "[\"\"]", "csv.getColumn.missing");
    fails += check(csv.buildCSV("[{\"name\": \"alpha\", \"age\": 30}, {\"name\": \"beta\", \"age\": 25}]", "name,age"), "name,age\r\nalpha,30\r\nbeta,25\r\n", "csv.buildCSV");
    fails += check(csv.appendRow("a,b\n1,2\n", "[\"x\", \"y\"]"), "a,b\n1,2\nx,y\r\n", "csv.appendRow");
    fails += check(csv.filterRows(csvData, "city", "London"), "name,age,city\r\nalpha,30,London\r\ngamma,30,London\r\n", "csv.filterRows");
    fails += check(csv.sortCSV(csvData, "name"), "name,age,city\r\nalpha,30,London\r\nbeta,25,Paris\r\ngamma,30,London\r\n", "csv.sortCSV");
    fails += check(csv.sortCSVDesc(csvData, "name"), "name,age,city\r\ngamma,30,London\r\nbeta,25,Paris\r\nalpha,30,London\r\n", "csv.sortCSVDesc");
    fails += check(csv.columnStats(csvData, "age"), "{\"count\": 3, \"min\": 25.0, \"max\": 30.0, \"sum\": 85.0, \"mean\": 28.333333333333332}", "csv.columnStats.numeric");
    fails += check(csv.columnStats(csvData, "name"), "{}", "csv.columnStats.nonNumeric");
    fails += check(csv.toTSV(csvData), "name\tage\tcity\r\nalpha\t30\tLondon\r\nbeta\t25\tParis\r\ngamma\t30\tLondon\r\n", "csv.toTSV");
    fails += check(csv.fromTSV("a\tb\n1\t2\n"), "a,b\r\n1,2\r\n", "csv.fromTSV");
    fails += check(csv.parseDelimited("a;b\n1;2\n", ";"), "[{\"a\": \"1\", \"b\": \"2\"}]", "csv.parseDelimited");
    str quoted = "name,note\nalpha,\"hello, world\"\nbeta,\"say \"\"hi\"\"\"\n";
    fails += check(csv.parseRows(quoted), "[[\"name\", \"note\"], [\"alpha\", \"hello, world\"], [\"beta\", \"say \\\"hi\\\"\"]]", "csv.parseRows.quoted");
    fails += check(csv.buildCSV("[{\"name\": \"alpha\", \"note\": \"a,b\"}]", "name,note"), "name,note\r\nalpha,\"a,b\"\r\n", "csv.buildCSV.quoted");
    fails += check(csv.parseCSV(csvData), csv.parseToJson(csvData), "csv.parseCSV");
    fails += check(csv.parseCSVRaw(csvData), csv.parseRows(csvData), "csv.parseCSVRaw");
    fails += check(csv.csvHeaders(csvData), "name,age,city", "csv.csvHeaders");
    fails += check(csv.csvRow(csvData, 1), "{\"name\": \"beta\", \"age\": \"25\", \"city\": \"Paris\"}", "csv.csvRow");
    fails += check(csv.csvColumn(csvData, "name"), "[\"alpha\", \"beta\", \"gamma\"]", "csv.csvColumn");
    fails += check(csv.csvRowCount(csvData), "3", "csv.csvRowCount");
    fails += check(csv.filterCSV(csvData, "city", "London"), "name,age,city\r\nalpha,30,London\r\ngamma,30,London\r\n", "csv.filterCSV");
    fails += check(csv.dedupCSV(csvData, "city"), "name,age,city\r\nalpha,30,London\r\nbeta,25,Paris\r\n", "csv.dedupCSV");
    fails += check(csv.readCSVRaw("/no/such/file"), "[]", "csv.readCSVRaw.missing");

    // ----------------------------------------------------------------- regex
    println("== regex ==");
    regex.compile("digits", "\\d+", "");
    fails += check(regex.testCompiled("digits", "abc123"), "1", "regex.testCompiled");
    fails += check(regex.matchCompiled("digits", "abc123def"), "123", "regex.matchCompiled");
    fails += check(regex.findallCompiled("digits", "a1 b22"), "[\"1\", \"22\"]", "regex.findallCompiled");
    fails += check(regex.subCompiled("digits", "#", "a1 b22"), "a# b#", "regex.subCompiled");
    regex.compile("shout", "abc", "I");
    fails += check(regex.testCompiled("shout", "ABC"), "1", "regex.testCompiled.ignoreCase");
    fails += check(regex.cacheKeys(), "[\"digits\", \"shout\"]", "regex.cacheKeys");
    fails += check(regex.isValid("\\d+"), "1", "regex.isValid.true");
    fails += check(regex.isValid("(unclosed"), "0", "regex.isValid.false");
    fails += check(regex.extract("(?P<user>\\w+)@(?P<host>\\w+)", "alice@example"), "{\"user\": \"alice\", \"host\": \"example\"}", "regex.extract");
    fails += check(regex.extractAll("(?P<k>\\w+)=(?P<v>\\d+)", "x=1 y=2"), "[{\"k\": \"x\", \"v\": \"1\"}, {\"k\": \"y\", \"v\": \"2\"}]", "regex.extractAll");
    fails += check(regex.unique("\\w", "aabbc"), "[\"a\", \"b\", \"c\"]", "regex.unique");
    fails += check(regex.lastMatch("\\d+", "a1 b22"), "22", "regex.lastMatch");
    fails += check(regex.findallOverlapping("aa", "aaaa"), "[\"aa\", \"aa\", \"aa\"]", "regex.findallOverlapping");
    fails += check(regex.replaceNth("\\d", "#", "a1b2c3", 2), "a1b#c3", "regex.replaceNth");
    fails += check(regex.replaceAllLiteral("\\d+", "\\1", "a1b22"), "a\\1b\\1", "regex.replaceAllLiteral");
    fails += check(regex.highlight("\\d+", "**", "**", "score: 42"), "score: **42**", "regex.highlight");
    fails += check(regex.splitKeep("[,;]", "a,b;c"), "[\"a\", \",\", \"b\", \";\", \"c\"]", "regex.splitKeep");
    fails += check(regex.findLetters("ab12cd"), "[\"ab\", \"cd\"]", "regex.findLetters");
    fails += check(regex.findDigits("ab12cd"), "[\"12\"]", "regex.findDigits");
    fails += check(regex.globToRegex("*.txt"), "^.*\\.txt$", "regex.globToRegex");
    fails += check(regex.countMatches("\\d+", "a1 b22 c333"), "3", "regex.countMatches");
    fails += check(regex.countWords("the quick brown fox"), "4", "regex.countWords");
    fails += check(regex.firstMatchPos("\\d+", "ab12"), "2", "regex.firstMatchPos");
    fails += check(regex.truncateMatch("\\d+", "abcdef123456ghij", 7), "def1234", "regex.truncateMatch");
    regex.clearCache();
    fails += check(regex.cacheKeys(), "[]", "regex.clearCache");

    // -------------------------------------------------------------------- re
    println("== re ==");
    fails += check(re.test("\\d+", "abc123"), "true", "re.test.true");
    fails += check(re.test("^\\d+$", "abc"), "false", "re.test.false");
    fails += check(re.match("\\d+", "42abc"), "42", "re.match");
    fails += check(re.matchFull("\\d+", "42abc"), "", "re.matchFull.false");
    fails += check(re.search("\\d+", "abc123def"), "123", "re.search");
    fails += check(re.findall("\\d+", "a1 b22 c333"), "[\"1\", \"22\", \"333\"]", "re.findall");
    fails += check(re.count("\\d+", "a1 b22 c333"), "3", "re.count");
    fails += check(re.groups("(\\w+)@(\\w+)", "user@host"), "[\"user\", \"host\"]", "re.groups");
    fails += check(re.groupsAll("(\\w+)=(\\d+)", "x=1 y=2"), "[[\"x\", \"1\"], [\"y\", \"2\"]]", "re.groupsAll");
    fails += check(re.named("(?P<user>\\w+)@(?P<host>\\w+)", "alice@example"), "{\"user\": \"alice\", \"host\": \"example\"}", "re.named");
    fails += check(re.sub("\\d+", "#", "a1b22"), "a#b#", "re.sub");
    fails += check(re.subN("\\d+", "#", "a1b22", 1), "a#b22", "re.subN");
    fails += check(re.subn("\\d+", "#", "a1b22"), "{\"result\": \"a#b#\", \"count\": 2}", "re.subn");
    fails += check(re.split("\\s+", "one  two   three"), "[\"one\", \"two\", \"three\"]", "re.split");
    fails += check(re.splitN("\\s+", "a b c d", 2), "[\"a\", \"b\", \"c d\"]", "re.splitN");
    fails += check(re.escape("a.b+c"), "a\\.b\\+c", "re.escape");
    fails += check(re.matchStart("\\d+", "ab12"), "2", "re.matchStart");
    fails += check(re.matchEnd("\\d+", "ab12"), "4", "re.matchEnd");
    fails += check(re.findSpans("\\d+", "a12b34"), "[{\"start\": 1, \"end\": 3, \"match\": \"12\"}, {\"start\": 4, \"end\": 6, \"match\": \"34\"}]", "re.findSpans");
    fails += check(re.testIgnoreCase("abc", "ABC"), "true", "re.testIgnoreCase");
    fails += check(re.searchIgnoreCase("abc", "xABCy"), "ABC", "re.searchIgnoreCase");
    fails += check(re.subIgnoreCase("abc", "-", "aBc"), "-", "re.subIgnoreCase");
    fails += check(re.findallMultiline("^\\w+", "ab\ncd"), "[\"ab\", \"cd\"]", "re.findallMultiline");
    fails += check(re.subMultiline("^", "> ", "a\nb"), "> a\n> b", "re.subMultiline");
    fails += check(re.searchDotall("a.b", "a\nb"), "a\nb", "re.searchDotall");
    fails += check(re.split("", "abc"), "[\"\", \"a\", \"b\", \"c\", \"\"]", "re.split.emptyPattern");
    fails += check(re.sub("(?P<w>\\w+)", "[\\g<w>]", "hi there"), "[hi] [there]", "re.sub.namedGroup");
    fails += check(re.matchFull("[a-z]+", "hello"), "hello", "re.matchFull.true");

    // ------------------------------------------------------------------ path
    println("== path ==");
    fails += check(path.name("/x/y.txt"), "y.txt", "path.name");
    fails += check(path.stem("/x/y.txt"), "y", "path.stem");
    fails += check(path.suffix("/x/y.txt"), ".txt", "path.suffix");
    fails += check(path.suffixes("archive.tar.gz"), "[.tar, .gz]", "path.suffixes.multi");
    fails += check(path.suffixes("notes.txt"), "[.txt]", "path.suffixes.one");
    fails += check(path.suffixes(".bashrc"), "[]", "path.suffixes.none");
    fails += check(path.parent("/x/y.txt"), "/x", "path.parent");
    fails += check(path.anchor("/x/y"), "/", "path.anchor");
    fails += check(path.anchor("x/y") is "", "true", "path.anchor.empty");
    fails += check(path.root("/x/y"), "/", "path.root");
    fails += check(path.drive("/x/y") is "", "true", "path.drive");
    fails += check(path.isAbsolute("/x"), "true", "path.isAbsolute.true");
    fails += check(path.isAbsolute("x"), "false", "path.isAbsolute.false");
    fails += check(path.parts("/a/b/c"), "[/, a, b, c]", "path.parts.absolute");
    fails += check(path.parts("a/b"), "[a, b]", "path.parts.relative");
    fails += check(path.join("a", "b"), "a/b", "path.join");
    fails += check(path.join3("a", "b", "c"), "a/b/c", "path.join3");
    fails += check(path.normalize("a/./b/../c"), "a/c", "path.normalize");
    fails += check(path.match("a/b.py", "*.py"), "true", "path.match.true");
    fails += check(path.match("/a/b/c.py", "b/*.py"), "true", "path.match.glob");
    fails += check(path.match("/a/b/c.py", "*.txt"), "false", "path.match.false");
    fails += check(path.relativeTo("/a/b/c", "/a/b"), "c", "path.relativeTo");
    fails += check(path.relativeTo("/a/b", "/x") is "", "true", "path.relativeTo.empty");
    fails += check(path.withName("/a/b.txt", "c.md"), "/a/c.md", "path.withName");
    fails += check(path.withSuffix("/a/b.txt", ".md"), "/a/b.md", "path.withSuffix");
    fails += check(path.withSuffix("/a/b.txt", ""), "/a/b", "path.withSuffix.none");
    fails += check(path.withName("b.txt", "c.md"), "c.md", "path.withName.relative");
    fails += check(path.withSuffix("noext", ".txt"), "noext.txt", "path.withSuffix.noext");
    fails += check(path.expandUser("~") is path.home(), "true", "path.expandUser");
    fails += check(returnLength(path.cwd()) > 0, "true", "path.cwd");
    fails += check(path.asUri("/tmp/a b"), "file:///tmp/a%20b", "path.asUri");

    str pathRoot = ".lynxer_scratch_path";
    if(os.exists(pathRoot)){ os.rmTree(pathRoot); }
    fails += check(path.mkdir(pathRoot), "true", "path.mkdir");
    fails += check(path.mkdir(pathRoot), "false", "path.mkdir.duplicate");
    fails += check(path.mkdirs(pathRoot + "/sub/deep"), "true", "path.mkdirs");
    fails += check(path.isDir(pathRoot + "/sub"), "true", "path.isDir");
    fails += check(path.isSymlink(pathRoot + "/sub"), "false", "path.isSymlink");
    fileIO.writeFile(pathRoot + "/a.txt", "alpha");
    fileIO.writeFile(pathRoot + "/b.log", "beta");
    fileIO.writeFile(pathRoot + "/sub/c.txt", "gamma");
    fails += check(sortList(path.iterDir(pathRoot)), "[.lynxer_scratch_path/a.txt, .lynxer_scratch_path/b.log, .lynxer_scratch_path/sub]", "path.iterDir");
    fails += check(path.glob(pathRoot, "*.txt"), "[.lynxer_scratch_path/a.txt]", "path.glob");
    fails += check(path.glob(pathRoot, "sub/*.txt"), "[.lynxer_scratch_path/sub/c.txt]", "path.glob.sub");
    fails += check(path.rglob(pathRoot, "*.txt"), "[.lynxer_scratch_path/a.txt, .lynxer_scratch_path/sub/c.txt]", "path.rglob");
    fails += check(path.readText(pathRoot + "/a.txt"), "alpha", "path.readText");
    fails += check(path.writeText(pathRoot + "/b.log", "BETA"), "true", "path.writeText");
    fails += check(path.appendText(pathRoot + "/b.log", "!"), "true", "path.appendText");
    fails += check(path.readText(pathRoot + "/b.log"), "BETA!", "path.readText.appended");
    fails += check(path.size(pathRoot + "/a.txt"), "5", "path.size");
    fails += check(path.isFile(pathRoot + "/a.txt"), "true", "path.isFile");
    fails += check(path.sameFile(pathRoot + "/a.txt", pathRoot + "/a.txt"), "true", "path.sameFile.true");
    fails += check(path.sameFile(pathRoot + "/a.txt", pathRoot + "/b.log"), "false", "path.sameFile.false");
    fails += check(path.modifiedTime(pathRoot + "/a.txt") > 0.0, "true", "path.modifiedTime");
    fails += check(path.unlink(pathRoot + "/a.txt"), "true", "path.unlink");
    fails += check(path.unlinkMissingOk(pathRoot + "/missing.txt"), "true", "path.unlinkMissingOk");
    fails += check(path.touch(pathRoot + "/touched.txt"), "true", "path.touch");
    fails += check(path.exists(pathRoot + "/touched.txt"), "true", "path.exists.touched");
    fails += check(path.rename(pathRoot + "/touched.txt", pathRoot + "/moved.txt"), ".lynxer_scratch_path/moved.txt", "path.rename");
    fails += check(path.exists(pathRoot + "/moved.txt"), "true", "path.exists.moved");
    fails += check(path.readText(pathRoot + "/missing") is "", "true", "path.readText.missing");
    fails += check(path.size(pathRoot + "/missing"), "-1", "path.size.missing");
    fails += check(path.modifiedTime(pathRoot + "/missing"), "-1", "path.modifiedTime.missing");
    fails += check(path.mkdirs(pathRoot + "/sub/deep"), "true", "path.mkdirs.existing");
    fails += check(os.rmTree(pathRoot), "true", "path.cleanup");
    fails += check(path.exists(pathRoot), "false", "path.cleanup.exists");

    // -------------------------------------------------------------------- os
    println("== os ==");
    str osRoot = ".lynxer_scratch_os";
    if(os.exists(osRoot)){ os.rmTree(osRoot); }
    fails += check(os.mkdir(osRoot), "true", "os.mkdir");
    fails += check(os.mkdir(osRoot), "false", "os.mkdir.duplicate");
    fails += check(os.isDir(osRoot), "true", "os.isDir");
    fails += check(os.makedirs(osRoot + "/a/b"), "true", "os.makedirs");
    fails += check(os.isDir(osRoot + "/a/b"), "true", "os.isDir.nested");
    fails += check(os.isFile(osRoot + "/a/b"), "false", "os.isFile.dir");
    fails += check(os.isDir(osRoot + "/missing"), "false", "os.isDir.missing");
    fileIO.writeFile(osRoot + "/one.txt", "1");
    fileIO.writeFile(osRoot + "/two.txt", "2");
    fileIO.writeFile(osRoot + "/three.log", "3");
    fails += check(sortList(os.listdir(osRoot)), "[a, one.txt, three.log, two.txt]", "os.listdir");
    fails += check(sortList(os.listdirExt(osRoot, ".txt")), "[one.txt, two.txt]", "os.listdirExt");
    fails += check(os.walkFiles(osRoot) is "", "false", "os.walkFiles");
    fails += check(os.isFile(osRoot + "/one.txt"), "true", "os.isFile");
    fails += check(os.joinPath("a", "b"), "a/b", "os.joinPath");
    fails += check(os.joinPath("a/", "b"), "a/b", "os.joinPath.trailing");
    fails += check(os.basename("/x/y.txt"), "y.txt", "os.basename");
    fails += check(os.basename("/x/"), "", "os.basename.dir");
    fails += check(os.dirname("/x/y.txt"), "/x", "os.dirname");
    fails += check(os.extname("/x/y.txt"), ".txt", "os.extname");
    fails += check(os.extname("/x/.bashrc"), "", "os.extname.dotfile");
    fails += check(os.normPath("a/./b/../c"), "a/c", "os.normPath");
    fails += check(os.normPath(""), ".", "os.normPath.empty");
    fails += check(os.sep(), "/", "os.sep");
    fails += check(os.getpid() > 0, "true", "os.getpid");
    fails += check(os.cpuCount() > 0, "true", "os.cpuCount");
    fails += check(os.diskTotal(osRoot) > 0, "true", "os.diskTotal");
    fails += check(os.diskFree(osRoot) > 0, "true", "os.diskFree");
    fails += check(os.setenv("LYNXER_OS_TEST", "hello"), "true", "os.setenv");
    fails += check(os.getenv("LYNXER_OS_TEST"), "hello", "os.getenv");
    fails += check(os.getenv("LYNXER_OS_MISSING") is "", "true", "os.getenv.missing");
    fails += check(os.expandUser("~") is os.homedir(), "true", "os.expandUser");
    fails += check(returnLength(os.homedir()) > 0, "true", "os.homedir");
    fails += check(returnLength(os.username()) > 0, "true", "os.username");
    fails += check(returnLength(os.hostname()) > 0, "true", "os.hostname");
    fails += check(returnLength(os.tempDir()) > 0, "true", "os.tempDir");
    fails += check(os.exists(osRoot), "true", "os.exists");
    fails += check(os.rename(osRoot + "/one.txt", osRoot + "/renamed.txt"), "true", "os.rename");
    fails += check(fileIO.fileExists(osRoot + "/renamed.txt"), "true", "os.rename.exists");
    fails += check(os.remove(osRoot + "/renamed.txt"), "true", "os.remove");
    fails += check(os.rmdir(osRoot + "/a/b"), "true", "os.rmdir.nested");
    fails += check(os.rmdir(osRoot + "/a"), "true", "os.rmdir");
    fails += check(os.rmTree(osRoot), "true", "os.rmTree");
    fails += check(os.exists(osRoot), "false", "os.rmTree.exists");
    fails += check(returnLength(os.getSystemName()) > 0, "true", "os.getSystemName");
    fails += check(os.getSystemArchitecture(), "64bit", "os.getSystemArchitecture");
    fails += check(os.getSystemUname() isnt "{}", "true", "os.getSystemUname");
    fails += check(returnLength(os.getSystemDistro()) > 2, "true", "os.getSystemDistro");
    fails += check(returnLength(os.getSystemInfo()) > 2, "true", "os.getSystemInfo");

    // ---------------------------------------------------------------- fileIO
    println("== fileIO ==");
