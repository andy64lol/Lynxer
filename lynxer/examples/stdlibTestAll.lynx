    fails += check(random.random() < 1.0, "true", "random.random");
    fails += check(random.randint(5, 5), "5", "random.randint.single");
    fails += check(random.choice(""), "", "random.choice.empty");
    random.seed(0);
    fails += check(random.randint(0, 100), "27", "random.seed");

    // ------------------------------------------------------- multiprocessing
    println("== multiprocessing ==");
    fails += check(multiprocessing.workerCount() > 0, "true", "multiprocessing.workerCount");
    list mpCommands = listPush(listPush(listPush(listRepeat("", 0), "printf a"), "printf b"), "printf c");
    fails += check(multiprocessing.runParallel(mpCommands), "[a, b, c]", "multiprocessing.runParallel");
    fails += check(multiprocessing.runParallelProcess(mpCommands), "[a, b, c]", "multiprocessing.runParallelProcess");
    list mpSilent = listPush(listPush(listRepeat("", 0), "true"), "false");
    fails += check(multiprocessing.runParallelSilent(mpSilent), "[0, 1]", "multiprocessing.runParallelSilent");
    list mpItems = listPush(listPush(listRepeat("", 0), "x"), "y");
    fails += check(multiprocessing.mapShell("printf {}", mpItems), "[x, y]", "multiprocessing.mapShell");
    fails += check(multiprocessing.threadMap("printf {}", mpItems), "[x, y]", "multiprocessing.threadMap");

    // ------------------------------------------------------------------- cli
    println("== cli ==");
    cli.clickInit();
    int cliCommand = cli.clickCommandCreate("greet", "Greet");
    fails += check(cliCommand > 0, "true", "cli.clickCommandCreate");
    fails += check(cli.clickAddArgument(cliCommand, "name", true, 1) is 1, "true", "cli.clickAddArgument");
    fails += check(cli.clickAddOption(cliCommand, "--shout,-s", "Uppercase", "", true, false, "bool") is 1, "true", "cli.clickAddOption");
    fails += check(cli.clickCommandSetShell(cliCommand, "printf 'Hello {name}'") is 1, "true", "cli.clickCommandSetShell");
    str cliInvoked = cli.clickInvoke(cliCommand, "[\"Ada\", \"--shout\"]");
    fails += check(json.jsonGet(cliInvoked, "output"), "Hello Ada", "cli.clickInvoke");
    fails += check(json.jsonGet(cli.clickLastParams(), "name"), "Ada", "cli.clickLastParams");
    fails += check(returnLength(json.jsonGet(cli.clickInvoke(cliCommand, "[\"--bad\"]"), "error")) > 0, "true", "cli.clickInvoke.error");
    cli.typerInit();
    int cliApp = cli.typerAppCreate("app", "App", true);
    int cliTyperCommand = cli.typerCommandCreate(cliApp, "greet", "Greet");
    fails += check(cliTyperCommand > 0, "true", "cli.typerCommandCreate");
    fails += check(cli.typerAddArgument(cliTyperCommand, "name", true, 1) is 1, "true", "cli.typerAddArgument");
    fails += check(cli.typerAddOption(cliTyperCommand, "--loud", "Loud", "", true, false, "bool") is 1, "true", "cli.typerAddOption");
    fails += check(cli.typerCommandSetShell(cliTyperCommand, "printf 'hi {name}'") is 1, "true", "cli.typerCommandSetShell");
    fails += check(json.jsonGet(cli.typerInvoke(cliApp, "[\"Ada\"]"), "output"), "hi Ada", "cli.typerInvoke");
    fails += check(json.jsonGet(cli.typerLastParams(), "name"), "Ada", "cli.typerLastParams");
    // A fresh command: typerInit()/clickInit() reset the builder registry.
    cli.clickInit();
    int helpCommand = cli.clickCommandCreate("greet", "Greet");
    cli.clickAddOption(helpCommand, "--shout,-s", "Uppercase", "", true, false, "bool");
    fails += check(text.contains(json.jsonGet(cli.clickInvoke(helpCommand, "[\"--help\"]"), "help"), "Usage: greet"), "true", "cli.help");
    cli.clickInvoke(helpCommand, "[\"--no-shout\"]");
    fails += check(json.jsonGetBool(cli.clickLastParams(), "shout"), "false", "cli.flag.negation");
    fails += check(cli.argCount() >= 2, "true", "cli.argCount");
    fails += check(cli.getArg(0) isnt "", "true", "cli.getArg");
    fails += check(cli.getArg(99) is "", "true", "cli.getArg.oob");
    os.setenv("LYNXER_CLI_TEST", "hello");
    fails += check(cli.envGet("LYNXER_CLI_TEST"), "hello", "cli.envGet");
    fails += check(cli.envHas("LYNXER_CLI_TEST"), "true", "cli.envHas.true");
    fails += check(cli.envHas("LYNXER_CLI_MISSING"), "false", "cli.envHas.false");
    fails += check(returnLength(cli.envAll()) > 10, "true", "cli.envAll");
    fails += check(returnLength(cli.cwd()) > 0, "true", "cli.cwd");
    fails += check(returnLength(cli.terminalSize()) > 2, "true", "cli.terminalSize");
    str cliScratch = ".lynxer_scratch_cli";
    if(os.exists(cliScratch)){ os.rmTree(cliScratch); }
    fails += check(os.mkdir(cliScratch), "true", "cli.scratch.mkdir");
    fails += check(fileIO.writeFile(cliScratch + "/probe.txt", "x"), "true", "cli.scratch.write");
    fails += check(cli.pathExists(cliScratch), "true", "cli.pathExists.true");
    fails += check(cli.pathExists("definitely-missing-file"), "false", "cli.pathExists.false");
    fails += check(cli.isFile(cliScratch + "/probe.txt"), "true", "cli.isFile");
    fails += check(cli.isFile(cliScratch), "false", "cli.isFile.dir");
    fails += check(cli.isDirectory(cliScratch), "true", "cli.isDirectory");
    fails += check(cli.isDirectory(cliScratch + "/probe.txt"), "false", "cli.isDirectory.file");
    fails += check(os.rmTree(cliScratch), "true", "cli.scratch.cleanup");
    fails += check(cli.which("sh") isnt "", "true", "cli.which.true");
    fails += check(cli.which("definitely-not-a-command") is "", "true", "cli.which.false");
    cli.writeStdout("written\n");
    fails += check(cli.run("printf cli-ok", true), "cli-ok", "cli.run.capture");
    fails += check(cli.run("true", false), "0", "cli.run.ok");
    fails += check(cli.run("false", false), "1", "cli.run.fail");
    fails += check(cli.runCode("true"), "0", "cli.runCode.ok");
    fails += check(cli.runCode("false"), "1", "cli.runCode.fail");

    // ----------------------------------------------------------------- debug
    println("== debug ==");
    fails += check(debug.typeOf(42), "int", "debug.typeOf.int");
    fails += check(debug.typeOf(3.5), "float", "debug.typeOf.float");
    fails += check(debug.typeOf("text"), "str", "debug.typeOf.str");
    fails += check(debug.typeOf(true), "bool", "debug.typeOf.bool");
    fails += check(debug.typeOf(none), "null", "debug.typeOf.none");
    fails += check(debug.typeOf(seqFromTo(1, 3, 1)), "list", "debug.typeOf.list");
    fails += check(debug.inspect(42), "{\"type\": \"int\", \"value\": \"42\"}", "debug.inspect.int");
    fails += check(debug.inspect("text"), "{\"type\": \"str\", \"value\": \"text\"}", "debug.inspect.str");
    debug.dump(7);
    debug.pp(seqFromTo(1, 4, 1));
    debug.assert(true, "should pass");
    debug.assertEq("a", "a", "equal");
    debug.assertNotEq("a", "b", "different");
    debug.assertGt(2.0, 1.0, "greater");
    debug.assertLt(1.0, 2.0, "lesser");
    debug.assertContains("hello world", "lo wo", "contains");
    fails += check(debug.stopTimer("missing"), "-1", "debug.stopTimer.missing");
    fails += check(debug.elapsed("missing"), "-1", "debug.elapsed.missing");
    fails += check(debug.clock() > 0.0, "true", "debug.clock");
    debug.startTimer("t");
    fails += check(debug.stopTimer("t") >= 0.0, "true", "debug.stopTimer");
    fails += check(debug.elapsed("t"), "-1", "debug.elapsed.stopped");
    fails += check(debug.envGet("LYNXER_DEBUG_TEST") is "", "true", "debug.envGet.missing");
    fails += check(debug.envAll() isnt "", "true", "debug.envAll");
    fails += check(debug.getMemory() > 0.0, "true", "debug.getMemory");

    // ------------------------------------------------------------------ time
    println("== time ==");
    fails += check(time.isLeapYear(2024), "true", "time.isLeapYear.true");
    fails += check(time.isLeapYear(2023), "false", "time.isLeapYear.false");
    fails += check(time.isLeapYear(2000), "true", "time.isLeapYear.century");
    fails += check(time.isLeapYear(1900), "false", "time.isLeapYear.centuryOdd");
    fails += check(time.daysInMonth(2024, 2), "29", "time.daysInMonth.leapFeb");
    fails += check(time.daysInMonth(2023, 2), "28", "time.daysInMonth.feb");
    fails += check(time.daysInMonth(2024, 4), "30", "time.daysInMonth.april");
    fails += check(time.addDays("2024-01-01", 31), "2024-02-01", "time.addDays");
    fails += check(time.diffDays("2024-03-01", "2024-01-01"), "-60", "time.diffDays");
    fails += check(returnLength(time.fromTimestamp(0.0)) > 0, "true", "time.fromTimestamp");
    fails += check(returnLength(time.now()) > 0, "true", "time.now");
    fails += check(returnLength(time.getTime()) > 0, "true", "time.getTime");
    fails += check(returnLength(time.getDate()) > 0, "true", "time.getDate");
    fails += check(returnLength(time.isoNow()) > 0, "true", "time.isoNow");
    fails += check(returnLength(time.format("%Y-%m-%d")) > 0, "true", "time.format");
    fails += check(time.getYear() > 2000, "true", "time.getYear");
    fails += check(time.getMonth() >= 1, "true", "time.getMonth");
    fails += check(time.getDay() >= 1, "true", "time.getDay");
    fails += check(time.getHour() >= 0, "true", "time.getHour");
    fails += check(time.getMinute() >= 0, "true", "time.getMinute");
    fails += check(time.getSecond() >= 0, "true", "time.getSecond");
    fails += check(time.getWeekdayNum() >= 0, "true", "time.getWeekdayNum");
    fails += check(returnLength(time.getWeekday()) > 0, "true", "time.getWeekday");
    if (time.toTimestamp("2024-01-01") is "1704067200") {
        fails += check(time.toTimestamp("2024-01-01"), "1704067200", "time.toTimestamp");
    } else if (time.toTimestamp("2024-01-01") is "1704063600") {
        fails += check(time.toTimestamp("2024-01-01"), "1704063600", "time.toTimestamp");
    }
    fails += check(time.timestamp() > 0, "true", "time.timestamp");

    // ----------------------------------------------------------------- shell
    println("== shell ==");
    fails += check(shell.commandExists("sh"), "true", "shell.commandExists.true");
    fails += check(shell.commandExists("definitely-not-a-command-xyz"), "false", "shell.commandExists.false");
    fails += check(shell.checkShell("sh"), "true", "shell.checkShell.true");
    fails += check(shell.checkShell("definitely-not-a-shell"), "false", "shell.checkShell.false");
    fails += check(returnLength(shell.currentShell()) > 0, "true", "shell.currentShell");
    fails += check(returnLength(shell.shellPath("sh")) > 0, "true", "shell.shellPath");
    fails += check(returnLength(shell.shellVersion("bash")) > 0, "true", "shell.shellVersion");
    fails += check(text.contains(shell.availableShells(), "\"sh\""), "true", "shell.availableShells");
    fails += check(shell.runShellCapture("printf shell-ok"), "shell-ok", "shell.runShellCapture");
    shell.runShell("echo ignored");
    fails += check(shell.runShellSilent("true"), "0", "shell.runShellSilent.ok");
    fails += check(shell.runShellSilent("false"), "256", "shell.runShellSilent.fail");
    fails += check(shell.runShellCode("true"), "0", "shell.runShellCode");
    shell.runShellAs("sh", "echo x");
    fails += check(shell.runShellCaptureAs("sh", "printf y"), "y", "shell.runShellCaptureAs");
    fails += check(shell.runShellErr("printf e 1>&2"), "", "shell.runShellErr");

    // ------------------------------------------------------------------- sys
    println("== sys ==");
    fails += check(sys.platform(), "linux", "sys.platform");
    fails += check(sys.implementation(), "Lynxer", "sys.implementation");
    fails += check(text.contains(sys.version(), "Lynxer"), "true", "sys.version");
    fails += check(text.contains(sys.versionInfo(), "major"), "true", "sys.versionInfo");
    fails += check(returnLength(sys.apiVersion()) > 0, "true", "sys.apiVersion");
    fails += check(sys.isFrozen(), "false", "sys.isFrozen");
    fails += check(sys.getpid() > 0, "true", "sys.getpid");
    fails += check(sys.getMaxSize() isnt 0, "true", "sys.getMaxSize");
    fails += check(sys.getByteOrder(), "little", "sys.getByteOrder");
    fails += check(sys.getDefaultEncoding(), "utf-8", "sys.getDefaultEncoding");
    fails += check(sys.getFilesystemEncoding(), "utf-8", "sys.getFilesystemEncoding");
    fails += check(sys.stdinName(), "<stdin>", "sys.stdinName");
    fails += check(sys.stdoutName(), "<stdout>", "sys.stdoutName");
    fails += check(returnLength(sys.executable()) > 0, "true", "sys.executable");
    fails += check(returnLength(sys.prefix()) > 0, "true", "sys.prefix");
    fails += check(returnLength(sys.execPrefix()) > 0, "true", "sys.execPrefix");
    fails += check(sys.argv() isnt "", "true", "sys.argv");
    // The program's own command line: at least the script itself.
    fails += check(sys.argCount() >= 1, "true", "sys.argCount");
    fails += check(returnLength(sys.getArg(0)) > 0, "true", "sys.getArg");
    fails += check(sys.architecture() isnt "", "true", "sys.architecture");
    fails += check(sys.cpuCount() > 0, "true", "sys.cpuCount");
    fails += check(sys.pageSize() > 0, "true", "sys.pageSize");
    fails += check(sys.memoryTotal() > 0, "true", "sys.memoryTotal");
    fails += check(sys.memoryAvailable() >= 0, "true", "sys.memoryAvailable");
    fails += check(sys.uptime() >= 0, "true", "sys.uptime");
    fails += check(sys.bootTime() > 0, "true", "sys.bootTime");
    fails += check(text.contains(sys.loadAverage(), ","), "true", "sys.loadAverage");

    // -------------------------------------------------------------------- js
    println("== js ==");
    fails += check(js.nodeExists(), "1", "js.nodeExists");
    fails += check(returnLength(js.nodeVersion()) > 0, "true", "js.nodeVersion");
    fails += check(js.evalJS("1 + 2"), "3", "js.evalJS.number");
    fails += check(js.evalJS("'a' + 'b'"), "ab", "js.evalJS.string");
    fails += check(js.runJS("console.log('hello from js');"), "hello from js\n", "js.runJS");

    // ------------------------------------------------------------------- lua
    println("== lua ==");
    fails += check(lua.luaVersion(), "Lua 5.4", "lua.luaVersion");
    fails += check(lua.luaExists(), "true", "lua.luaExists");
    fails += check(lua.evalLua("1 + 2 * 3"), "7", "lua.evalLua");
    fails += check(lua.runLua("print('hello', 42)"), "hello\t42\n", "lua.runLua");
    fails += check(lua.runLua("for i = 1, 3 do print(i) end"), "1\n2\n3\n", "lua.runLua.loop");
    fails += check(lua.runLua("print(string.upper('lynxer'))"), "LYNXER\n", "lua.runLua.stdlib");
    fails += check(lua.runLua("returnValue = 9"), "", "lua.runLua.silent");
    str luaFile = ".lynxer_scratch_lua.lua";
    fails += check(fileIO.writeFile(luaFile, "print('from file', 5)\nfor i=1,2 do print(i) end\n"), "true", "lua.runLuaFile.write");
    fails += check(lua.runLuaFile(luaFile), "from file\t5\n1\n2\n", "lua.runLuaFile");
    fails += check(fileIO.deleteFile(luaFile), "true", "lua.runLuaFile.cleanup");

    // ---------------------------------------------------------------- image
    println("== image ==");
    int img = image.create(2, 2, "RGBA", 10, 20, 30);
    fails += check(img >= 0, "true", "image.create");
    fails += check(strOf(image.getWidth(img)) + "x" + strOf(image.getHeight(img)), "2x2", "image.size");
    fails += check(image.getMode(img), "RGBA", "image.getMode");
    fails += check(image.getPixel(img, 0, 0), "[10,20,30,255]", "image.getPixel");
    fails += check(image.setPixel(img, 1, 1, 40, 50, 60), "true", "image.setPixel");
    fails += check(image.getPixel(img, 1, 1), "[40,50,60,255]", "image.getPixel.set");
    fails += check(image.setPixelA(img, 0, 1, 70, 80, 90, 128), "true", "image.setPixelA");
    fails += check(image.getPixel(img, 0, 1), "[70,80,90,128]", "image.getPixelA");
    fails += check(image.fill(img, 1, 2, 3), "true", "image.fill");
    fails += check(image.getPixel(img, 0, 0), "[1,2,3,255]", "image.getPixel.filled");
    int padded = image.pad(img, 1, 2, 3, 4, 5, 6, 7);
    fails += check(strOf(image.getWidth(padded)) + "x" + strOf(image.getHeight(padded)), "8x6", "image.pad.size");
    fails += check(image.getPixel(padded, 0, 0), "[5,6,7,255]", "image.pad.pixel");
    int resized = image.resize(img, 4, 3);
    fails += check(strOf(image.getWidth(resized)) + "x" + strOf(image.getHeight(resized)), "4x3", "image.resize");
    int gray = image.grayscale(img);
    fails += check(image.getMode(gray), "LA", "image.grayscale");
    int blended = image.blend(img, padded, 0.5);
    fails += check(strOf(image.getWidth(blended)) + "x" + strOf(image.getHeight(blended)), "2x2", "image.blend");
    str encoded = image.toBase64(img, "png");
    fails += check(returnLength(encoded) > 0, "true", "image.toBase64");
    fails += check(image.toDataUrl(img, "png") isnt "", "true", "image.toDataUrl");
    int decoded = image.fromBase64(encoded);
    fails += check(strOf(image.getWidth(decoded)) + "x" + strOf(image.getHeight(decoded)), "2x2", "image.fromBase64");
    fails += check(image.info(decoded), "{\"width\":2,\"height\":2,\"mode\":\"RGBA\",\"format\":\"PNG\"}", "image.info");
    fails += check(image.close(img), "true", "image.close");
    fails += check(image.close(padded), "true", "image.close.padded");
    fails += check(image.close(resized), "true", "image.close.resized");
    fails += check(image.close(gray), "true", "image.close.gray");
    fails += check(image.close(blended), "true", "image.close.blended");
    fails += check(image.close(decoded), "true", "image.close.decoded");

    // Rust-backed `image` crate: cloning, the transform family, alpha handling,
    // compositing, colour analysis and quality-aware encoding.
    int rustSrc = image.create(4, 4, "RGB", 0, 0, 0);
    image.setPixel(rustSrc, 0, 0, 255, 0, 0);
    image.setPixel(rustSrc, 1, 0, 0, 255, 0);
    image.setPixel(rustSrc, 0, 1, 0, 0, 255);
    image.setPixel(rustSrc, 3, 3, 255, 255, 255);
    int imgCopy = image.copy(rustSrc);
    fails += check(strOf(image.getWidth(imgCopy)) + "x" + strOf(image.getHeight(imgCopy)), "4x4", "image.copy.size");
    fails += check(image.getPixel(imgCopy, 0, 0), "[255,0,0,255]", "image.copy.pixel");
    int imgThumb = image.thumbnail(rustSrc, 2, 2);
    fails += check(strOf(image.getWidth(imgThumb)) + "x" + strOf(image.getHeight(imgThumb)), "2x2", "image.thumbnail");
    int imgScale = image.scale(rustSrc, 0.5);
    fails += check(strOf(image.getWidth(imgScale)) + "x" + strOf(image.getHeight(imgScale)), "2x2", "image.scale");
    int imgCrop = image.crop(rustSrc, 0, 0, 2, 2);
    fails += check(strOf(image.getWidth(imgCrop)) + "x" + strOf(image.getHeight(imgCrop)), "2x2", "image.crop");
    int imgRot = image.rotate(rustSrc, 90.0, false);
    fails += check(strOf(image.getWidth(imgRot)) + "x" + strOf(image.getHeight(imgRot)), "4x4", "image.rotate");
    fails += check(image.getPixel(imgRot, 0, 0), "[0,0,0,255]", "image.rotate.pixel");
    int imgFlipH = image.flipH(rustSrc);
    fails += check(image.getPixel(imgFlipH, 0, 0), "[0,0,0,255]", "image.flipH");
    int imgFlipV = image.flipV(rustSrc);
    fails += check(image.getPixel(imgFlipV, 0, 0), "[0,0,0,255]", "image.flipV");
    fails += check(image.getMode(image.convert(rustSrc, "L")), "L", "image.convert");
    fails += check(image.getMode(image.toRGB(rustSrc)), "RGB", "image.toRGB");
    fails += check(image.getMode(image.toRGBA(rustSrc)), "RGBA", "image.toRGBA");
    int imgBinary = image.toBinary(rustSrc, 128);
    fails += check(image.getMode(imgBinary), "L", "image.toBinary.mode");
    fails += check(image.getPixel(imgBinary, 0, 0), "[0,0,0,255]", "image.toBinary.dark");
    fails += check(image.getPixel(imgBinary, 1, 0), "[255,255,255,255]", "image.toBinary.light");
    fails += check(image.getPixel(image.brightness(rustSrc, 1.5), 0, 0), "[255,0,0,255]", "image.brightness");
    fails += check(image.getPixel(image.contrast(rustSrc, 1.5), 0, 0), "[255,0,0,255]", "image.contrast");
    fails += check(image.getPixel(image.invert(rustSrc), 0, 0), "[0,255,255,255]", "image.invert");
    int imgBlur = image.blur(rustSrc, 1.0);
    fails += check(image.getMode(imgBlur), "RGB", "image.blur");
    fails += check(strOf(image.getWidth(imgBlur)) + "x" + strOf(image.getHeight(imgBlur)), "4x4", "image.blur.size");
    int imgBoxBlur = image.boxBlur(rustSrc, 1.0);
    fails += check(image.getMode(imgBoxBlur), "RGB", "image.boxBlur");
    int imgUnsharp = image.unsharpMask(rustSrc, 1.0, 100, 0);
    fails += check(image.getMode(imgUnsharp), "RGB", "image.unsharpMask");
    int imgSharpen = image.sharpen(rustSrc);
    fails += check(image.getMode(imgSharpen), "RGB", "image.sharpen");
    int imgAlpha = image.addAlpha(rustSrc);
    fails += check(image.getMode(imgAlpha), "RGBA", "image.addAlpha");
    fails += check(image.getPixel(imgAlpha, 0, 0), "[255,0,0,255]", "image.addAlpha.pixel");
    int imgSetAlpha = image.setAlpha(imgAlpha, 128);
    fails += check(image.getMode(imgSetAlpha), "RGBA", "image.setAlpha.mode");
    fails += check(image.getPixel(imgSetAlpha, 0, 0), "[255,0,0,128]", "image.setAlpha.pixel");
    int imgNoAlpha = image.removeAlpha(imgAlpha);
    fails += check(image.getMode(imgNoAlpha), "RGB", "image.removeAlpha");
    int pasteDst = image.create(4, 4, "RGB", 1, 1, 1);
    fails += check(image.paste(pasteDst, rustSrc, 1, 1), "true", "image.paste");
    fails += check(image.getPixel(pasteDst, 1, 1), "[255,0,0,255]", "image.paste.pasted");
    fails += check(image.getPixel(pasteDst, 0, 0), "[1,1,1,255]", "image.paste.untouched");
    int pasteDstA = image.create(4, 4, "RGBA", 1, 1, 1);
    fails += check(image.pasteWithAlpha(pasteDstA, imgAlpha, 1, 1), "true", "image.pasteWithAlpha");
    fails += check(image.getPixel(pasteDstA, 1, 1), "[255,0,0,255]", "image.pasteWithAlpha.pixel");
    fails += check(image.getAverageColor(rustSrc), "[32,32,32,255]", "image.getAverageColor");
    fails += check(image.getDominantColor(rustSrc), "[0,0,0,255]", "image.getDominantColor");
    str histogram = image.getHistogram(rustSrc);
    fails += check(json.jsonValid(histogram), "true", "image.getHistogram.json");
    fails += check(text.contains(histogram, "\"r\""), "true", "image.getHistogram.r");
    fails += check(text.contains(histogram, "\"a\""), "true", "image.getHistogram.a");
    int imgTile = image.tile(rustSrc, 2, 2);
    fails += check(strOf(image.getWidth(imgTile)) + "x" + strOf(image.getHeight(imgTile)), "8x8", "image.tile");
    fails += check(image.getPixel(imgTile, 4, 0), "[255,0,0,255]", "image.tile.pixel");
    str qualityPath = ".lynxer_scratch_quality.jpg";
    fails += check(image.saveQuality(rustSrc, qualityPath, 80), "true", "image.saveQuality");
    fails += check(os.isFile(qualityPath), "true", "image.saveQuality.exists");
    fails += check(os.remove(qualityPath), "true", "image.saveQuality.cleanup");

    // --------------------------------------------------------- image codecs
    println("== image codecs ==");
    str codecRoot = ".lynxer_scratch_codecs";
    if(os.exists(codecRoot)){ os.rmTree(codecRoot); }
    os.mkdir(codecRoot);
    int codecSource = image.create(3, 2, "RGB", 128, 128, 128);

    str pngPath = codecRoot + "/roundtrip.png";
    fails += check(image.save(codecSource, pngPath), "true", "image.save.png");
    fails += check(os.isFile(pngPath), "true", "image.save.png.exists");
    int pngImage = image.open(pngPath);
    fails += check(pngImage >= 0, "true", "image.open.png");
    fails += check(image.getFormat(pngImage), "PNG", "image.getFormat.png");
    fails += check(strOf(image.getWidth(pngImage)) + "x" + strOf(image.getHeight(pngImage)), "3x2", "image.size.png");
    fails += check(image.getMode(pngImage), "RGB", "image.getMode.png");
    fails += check(image.getPixel(pngImage, 1, 1), "[128,128,128,255]", "image.getPixel.png");
    fails += check(image.close(pngImage), "true", "image.close.png");
    fails += check(os.remove(pngPath), "true", "image.remove.png");

    str jpegPath = codecRoot + "/roundtrip.jpeg";
    fails += check(image.save(codecSource, jpegPath), "true", "image.save.jpeg");
    int jpegImage = image.open(jpegPath);
    fails += check(image.getFormat(jpegImage), "JPEG", "image.getFormat.jpeg");
    fails += check(strOf(image.getWidth(jpegImage)) + "x" + strOf(image.getHeight(jpegImage)), "3x2", "image.size.jpeg");
    fails += check(image.getPixel(jpegImage, 1, 1), "[128,128,128,255]", "image.getPixel.jpeg");
    fails += check(image.close(jpegImage), "true", "image.close.jpeg");
    fails += check(os.remove(jpegPath), "true", "image.remove.jpeg");

    str gifPath = codecRoot + "/roundtrip.gif";
    fails += check(image.save(codecSource, gifPath), "true", "image.save.gif");
    int gifImage = image.open(gifPath);
    fails += check(image.getFormat(gifImage), "GIF", "image.getFormat.gif");
    fails += check(image.getMode(gifImage), "RGBA", "image.getMode.gif");
    fails += check(image.getPixel(gifImage, 1, 1), "[128,128,128,255]", "image.getPixel.gif");
    fails += check(image.close(gifImage), "true", "image.close.gif");
    fails += check(os.remove(gifPath), "true", "image.remove.gif");

    str bmpPath = codecRoot + "/roundtrip.bmp";
    fails += check(image.save(codecSource, bmpPath), "true", "image.save.bmp");
    int bmpImage = image.open(bmpPath);
    fails += check(image.getFormat(bmpImage), "BMP", "image.getFormat.bmp");
    fails += check(image.getPixel(bmpImage, 1, 1), "[128,128,128,255]", "image.getPixel.bmp");
    fails += check(image.close(bmpImage), "true", "image.close.bmp");
    fails += check(os.remove(bmpPath), "true", "image.remove.bmp");

    str tiffPath = codecRoot + "/roundtrip.tiff";
    fails += check(image.save(codecSource, tiffPath), "true", "image.save.tiff");
    int tiffImage = image.open(tiffPath);
    fails += check(image.getFormat(tiffImage), "TIFF", "image.getFormat.tiff");
    fails += check(image.getPixel(tiffImage, 1, 1), "[128,128,128,255]", "image.getPixel.tiff");
    fails += check(image.close(tiffImage), "true", "image.close.tiff");
    fails += check(os.remove(tiffPath), "true", "image.remove.tiff");

    str webpPath = codecRoot + "/roundtrip.webp";
    fails += check(image.save(codecSource, webpPath), "true", "image.save.webp");
    int webpImage = image.open(webpPath);
    fails += check(image.getFormat(webpImage), "WEBP", "image.getFormat.webp");
    fails += check(image.getPixel(webpImage, 1, 1), "[128,128,128,255]", "image.getPixel.webp");
    fails += check(image.close(webpImage), "true", "image.close.webp");
    fails += check(os.remove(webpPath), "true", "image.remove.webp");

    fails += check(image.close(codecSource), "true", "image.close.source");
    fails += check(os.rmTree(codecRoot), "true", "image.codecs.cleanup");
    fails += check(os.exists(codecRoot), "false", "image.codecs.cleanup.exists");

    // -------------------------------------------------------------- network
    println("== network ==");
    fails += check(network.urlScheme("https://example.com:8443/v1/x?q=1#top"), "https", "network.urlScheme");
    fails += check(network.urlHost("https://example.com:8443/v1/x"), "example.com:8443", "network.urlHost.port");
    fails += check(network.urlHost("https://example.com/v1/x"), "example.com", "network.urlHost.default");
    fails += check(network.urlPath("https://example.com:8443/v1/x"), "/v1/x", "network.urlPath");
    fails += check(network.urlPath("not a url"), "/", "network.urlPath.invalid");
    fails += check(network.urlScheme("not a url"), "", "network.urlScheme.invalid");
    fails += check(network.urlHost("not a url"), "", "network.urlHost.invalid");
    str parsed = network.urlParse("https://example.com:8443/v1/x?q=1#top");
    fails += check(json.jsonGet(parsed, "scheme"), "https", "network.urlParse.scheme");
    fails += check(json.jsonGet(parsed, "host"), "example.com", "network.urlParse.host");
    fails += check(json.jsonGet(parsed, "path"), "/v1/x", "network.urlParse.path");
    fails += check(json.jsonGet(parsed, "query"), "q=1", "network.urlParse.query");
    fails += check(json.jsonGet(parsed, "fragment"), "top", "network.urlParse.fragment");
    fails += check(network.urlencode("hello world"), "hello+world", "network.urlencode");
    fails += check(network.urlencode("a b&c=d"), "a+b%26c%3Dd", "network.urlencode.special");
    fails += check(json.jsonGet(network.urlParse("http://example.com/"), "port"), "80", "network.urlParse.defaultPort");
    fails += check(returnLength(network.getHostname()) > 0, "true", "network.getHostname");
    fails += check(network.resolveHost("localhost"), "127.0.0.1", "network.resolveHost");

    // --------------------------------------------------------------- server
    println("== server ==");
    fails += check(server.running(), "false", "server.running.idle");
    fails += check(server.port(), "0", "server.port.idle");
    fails += check(server.stop(), "ERROR: server is not running", "server.stop.idle");
    fails += check(server.routeGet("bad", "x"), "ERROR: path must start with '/'", "server.routeGet.badPath");
    fails += check(server.routePost("", "x"), "ERROR: path must start with '/'", "server.routePost.badPath");
    fails += check(server.routeEcho("echo"), "ERROR: path must start with '/'", "server.routeEcho.badPath");
    fails += check(server.wsEcho("ws"), "ERROR: path must start with '/'", "server.wsEcho.badPath");
    fails += check(server.clearRoutes(), "ok", "server.clearRoutes");
    fails += check(server.get("/hi", "hello-crow"), "ok", "server.get");
    fails += check(server.routeGet("/hi", "other"), "ERROR: GET route already registered", "server.routeGet.duplicate");
    fails += check(server.htmlPost("/fixed", "<p>posted</p>"), "ok", "server.htmlPost");
    fails += check(server.routePost("/fixed", "other"), "ERROR: POST route already registered", "server.routePost.duplicate");
    fails += check(server.post("/plain", "<p>plain</p>"), "ok", "server.post");
    fails += check(server.htmlGet("/alt", "<p>alt</p>"), "ok", "server.htmlGet");
    fails += check(server.routeEcho("/echo"), "ok", "server.routeEcho");
    fails += check(server.routeEcho("/echo"), "ERROR: POST route already registered", "server.routeEcho.duplicate");
    fails += check(server.wsEcho("/ws"), "ok", "server.wsEcho");
    fails += check(server.wsEcho("/ws"), "ERROR: WebSocket route already registered", "server.wsEcho.duplicate");
    fails += check(server.start(0), "ERROR: invalid port", "server.start.zero");
    fails += check(server.start(70000), "ERROR: invalid port", "server.start.big");
    fails += check(server.start(18140), "ok", "server.start");
    fails += check(server.running(), "true", "server.running");
    fails += check(server.port(), "18140", "server.port");
    fails += check(server.routeGet("/late", "x"), "ERROR: server already running", "server.routeWhileRunning");
    fails += check(server.clearRoutes(), "ERROR: server already running", "server.clearWhileRunning");
    fails += check(server.start(18141), "ERROR: server already running", "server.startWhileRunning");
    sleep(0.2);
    fails += check(network.get("http://127.0.0.1:18140/hi"), "hello-crow", "network.get");
    fails += check(network.getJson("http://127.0.0.1:18140/hi"), "hello-crow", "network.getJson");
    fails += check(network.getStatus("http://127.0.0.1:18140/hi"), "200", "network.getStatus");
    fails += check(network.httpHead("http://127.0.0.1:18140/hi"), "200", "network.httpHead");
    fails += check(text.contains(network.getHeaders("http://127.0.0.1:18140/hi"), "Content-Type: text/html; charset=utf-8"), "true", "network.getHeaders");
    fails += check(network.post("http://127.0.0.1:18140/fixed", "ignored", "text/plain"), "<p>posted</p>", "network.post");
    fails += check(network.post("http://127.0.0.1:18140/echo", "ping", "text/plain"), "ping", "network.post.echo");
    fails += check(network.postJson("http://127.0.0.1:18140/echo", "{\"k\": 1}"), "{\"k\": 1}", "network.postJson");
    fails += check(network.getStatus("http://127.0.0.1:18140/missing"), "404", "network.getStatus.404");
    fails += check(network.httpHead("http://127.0.0.1:18140/missing"), "404", "network.httpHead.404");
    fails += check(network.getHeaders("http://127.0.0.1:18140/missing"), "ERROR: HTTP 404", "network.getHeaders.404");
    fails += check(network.get("http://127.0.0.1:18140/missing"), "ERROR: HTTP 404 Not Found", "network.get.404");
    fails += check(network.put("http://127.0.0.1:18140/missing", "x", "text/plain"), "ERROR: HTTP 404 Not Found", "network.put.404");
    fails += check(network.delete("http://127.0.0.1:18140/missing"), "ERROR: HTTP 404 Not Found", "network.delete.404");
    fails += check(network.patch("http://127.0.0.1:18140/missing", "x", "text/plain"), "ERROR: HTTP 404 Not Found", "network.patch.404");
    fails += check(network.download("http://127.0.0.1:18140/missing", "/tmp/lynxer-missing.txt"), "ERROR: HTTP 404 Not Found", "network.download.404");
    fails += check(network.wsConnect("echo", "ws://127.0.0.1:18140/ws"), "ok", "network.wsConnect");
    fails += check(network.wsConnected("echo"), "true", "network.wsConnected");
    fails += check(network.wsSend("echo", "one"), "ok", "network.wsSend");
    fails += check(network.wsReceive("echo"), "one", "network.wsReceive");
    fails += check(network.wsSendReceive("echo", "Lynxer-ws"), "Lynxer-ws", "network.wsSendReceive");
    fails += check(network.wsConnected("nope"), "false", "network.wsConnected.nope");
    fails += check(network.wsReceive("nope"), "ERROR: no connection named 'nope'", "network.wsReceive.nope");
    fails += check(network.wsSend("nope", "x"), "ERROR: no connection named 'nope'", "network.wsSend.nope");
    fails += check(network.wsClose("nope"), "ERROR: no connection named 'nope'", "network.wsClose.nope");
    fails += check(network.wsClose("echo"), "ok", "network.wsClose");
    fails += check(network.wsConnected("echo"), "false", "network.wsConnected.closed");
    fails += check(server.stop(), "ok", "server.stop");
    fails += check(server.running(), "false", "server.running.stopped");
    fails += check(server.port(), "0", "server.port.stopped");

    // ----------------------------------------------------------------- game
    if(not skipDisplay){
    println("== game ==");
    // Force the game backend into headless mode so the run is deterministic and
    // needs no display, whether or not the caller exported the variable.
    os.setenv("LYNXER_GAME_HEADLESS", "1");
    game.init("stdlibTestAll", 320, 200);
    fails += check(strOf(game.getWidth()) + "x" + strOf(game.getHeight()), "320x200", "game.size");
    game.beginDraw();
    game.drawRect(10.0, 10.0, 20.0, 20.0, 255, 0, 0);
    game.drawCircle(50.0, 50.0, 5.0, 0, 255, 0);
    game.drawLine(0.0, 0.0, 100.0, 100.0, 0, 0, 255, 1.0);
    game.drawTriangle(0.0, 0.0, 10.0, 0.0, 5.0, 8.0, 255, 255, 0);
    game.drawText("hi", 5.0, 5.0, 255, 255, 255, 12);
    game.drawPolygon("0,0,10,0,5,8", 0, 255, 255);
    game.endDraw();
    int spriteA = game.makeSolidSprite(10, 20, 255, 0, 0, 0.0, 0.0);
    int spriteB = game.makeSolidSprite(10, 20, 0, 255, 0, 3.0, 4.0);
    fails += check(spriteA, "0", "game.makeSolidSprite.a");
    fails += check(spriteB, "1", "game.makeSolidSprite.b");
    fails += check(game.spriteExists(spriteA), "true", "game.spriteExists");
    fails += check(strOf(game.getSpriteWidth(spriteA)) + "x" + strOf(game.getSpriteHeight(spriteA)), "10x20", "game.spriteSize");
    fails += check(game.spriteDistance(spriteA, spriteB), "5", "game.spriteDistance");
    fails += check(game.spriteNear(spriteA, 3.0, 4.0, 5.0), "true", "game.spriteNear");
    game.setSpritePos(spriteB, 8.0, 0.0);
    fails += check(strOf(game.getSpriteX(spriteB)) + "," + strOf(game.getSpriteY(spriteB)), "8,0", "game.spritePos");
    fails += check(game.getSpritePosition(spriteB), "8,0", "game.getSpritePosition");
    fails += check(game.spriteCollides(spriteA, spriteB), "true", "game.spriteCollides");
    game.setSpriteVelocity(spriteB, 5.0, 0.0);
    fails += check(game.getSpriteVX(spriteB), "5", "game.spriteVX");
    game.stopSprite(spriteB);
    fails += check(game.getSpriteVX(spriteB), "0", "game.spriteVX.stopped");
    int spriteList = game.makeSpriteList();
    game.addToList(spriteList, spriteA);
    game.addToList(spriteList, spriteB);
    fails += check(game.getSpriteListCount(spriteList), "2", "game.spriteList.count");
    game.removeSpriteFromList(spriteList, spriteA);
    fails += check(game.getSpriteListCount(spriteList), "1", "game.spriteList.remove");
    int cam = game.makeCamera();
    game.setCameraPos(cam, 100.0, 50.0);
    game.zoomCamera(cam, 2.0);
    fails += check(game.getCameraX(cam), "100", "game.cameraX");
    fails += check(game.getCameraY(cam), "50", "game.cameraY");
    fails += check(game.getCameraZoom(cam), "2", "game.cameraZoom");
    game.resetCamera();
    fails += check(game.keyDown("SPACE"), "false", "game.keyDown");
    fails += check(game.mouseButtonDown("LEFT"), "false", "game.mouseButtonDown");
    fails += check(strOf(game.screenToTile(80.0, 40.0, 16)), "5,2", "game.screenToTile");
    fails += check(strOf(game.tileToScreen(1, 2, 16)), "24,40", "game.tileToScreen");
    game.setBackground(10, 20, 30);
    game.setFPSCap(60);
    game.setResizable(true);
    game.setFullscreen(false);
    game.setMouseVisible(true);
    game.setWindowSize(400, 300);
    fails += check(strOf(game.getWidth()) + "x" + strOf(game.getHeight()), "400x300", "game.windowSize");
    fails += check(game.getFPS(), "0", "game.getFPS");
    fails += check(game.isOpen(), "true", "game.isOpen");
    game.setSpriteAngle(spriteA, 90.0);
    game.setSpriteScale(spriteA, 2.0);
    game.setSpriteAlpha(spriteA, 128);
    game.setSpriteVisible(spriteA, false);
    fails += check(game.getSpriteAngle(spriteA), "90", "game.spriteAngle");
    fails += check(game.getSpriteScale(spriteA), "2", "game.spriteScale");
    fails += check(game.getSpriteAlpha(spriteA), "128", "game.spriteAlpha");
    fails += check(strOf(game.getSpriteWidth(spriteA)) + "x" + strOf(game.getSpriteHeight(spriteA)), "20x40", "game.spriteScaledSize");
    fails += check(game.getSpriteVisible(spriteA), "false", "game.spriteVisible");
    game.setSpriteVisible(spriteA, true);
    game.setSpriteAngularVelocity(spriteB, 45.0);
    fails += check(game.getSpriteAngularVelocity(spriteB), "45", "game.spriteAngularVelocity");
    game.moveSpriteToward(spriteB, 0.0, 0.0, 4.0);
    fails += check(strOf(game.getSpriteVX(spriteB)) + "," + strOf(game.getSpriteVY(spriteB)), "-4,0", "game.moveSpriteToward");
    game.faceSpriteTo(spriteB, 16.0, 0.0);
    fails += check(game.getSpriteAngle(spriteB), "0", "game.faceSpriteTo");
    fails += check(game.spriteNear(spriteA, 100.0, 100.0, 5.0), "false", "game.spriteNear.false");
    fails += check(game.spriteCollidesWithList(spriteA, spriteList), "true", "game.spriteCollidesWithList");
    fails += check(game.getCollidingSprites(spriteA, spriteList), "[1]", "game.getCollidingSprites");
    game.destroySprite(spriteB);
    fails += check(game.spriteExists(spriteB), "false", "game.destroySprite");
    fails += check(game.getSpriteListCount(spriteList), "0", "game.spriteList.afterDestroy");
    fails += check(game.loadTexture("missing.png"), "-1", "game.loadTexture");
    fails += check(game.loadSprite("missing.png", 1.0, 0.0, 0.0), "-1", "game.loadSprite");
    game.useCamera(cam);
    game.smoothScrollCamera(cam, 200.0, 50.0, 0.5);
    fails += check(game.getCameraX(cam), "150", "game.smoothScrollCamera.x");
    fails += check(game.getCameraY(cam), "50", "game.smoothScrollCamera.y");
    fails += check(game.getCameraZoom(cam), "2", "game.smoothScrollCamera.zoom");
    game.resetCamera();
    game.beginDraw();
    game.drawRectOutline(10.0, 10.0, 20.0, 20.0, 255, 0, 0, 1.0);
    game.drawCircleOutline(50.0, 50.0, 5.0, 0, 255, 0, 1.0);
    game.drawEllipse(20.0, 20.0, 30.0, 10.0, 1, 2, 3);
    game.drawEllipseOutline(20.0, 20.0, 30.0, 10.0, 1, 2, 3, 1.0);
    game.drawTriangleOutline(0.0, 0.0, 10.0, 0.0, 5.0, 8.0, 1, 2, 3, 1.0);
    game.drawPoint(1.0, 2.0, 1, 2, 3, 2.0);
    game.drawRectRoundedFilled(10.0, 10.0, 20.0, 20.0, 1, 2, 3, 4.0);
    game.drawRectRoundedOutline(10.0, 10.0, 20.0, 20.0, 1, 2, 3, 4.0, 1.0);
    game.drawStar(10.0, 10.0, 8.0, 4.0, 5, 1, 2, 3);
    game.drawDashedLine(0.0, 0.0, 10.0, 0.0, 1, 2, 3, 1.0, 2.0);
    game.drawCross(5.0, 5.0, 3.0, 1, 2, 3, 1.0);
    game.drawGradientRect(10.0, 10.0, 20.0, 20.0, 1, 2, 3, 4, 5, 6);
    game.drawArc(10.0, 10.0, 20.0, 20.0, 1, 2, 3, 0.0, 90.0, 1.0);
    game.drawArcFilled(10.0, 10.0, 20.0, 20.0, 1, 2, 3, 0.0, 90.0);
    game.drawPolygonOutline("0,0,10,0,5,8", 1, 2, 3, 1.0);
    game.drawPolyline("0,0,5,5,10,0", 1, 2, 3, 1.0);
    game.drawPoints("1,2 3,4", 1, 2, 3, 2.0);
    game.drawLines("0,0,10,10", 1, 2, 3, 1.0);
    game.drawTextStyled("styled", 5.0, 5.0, 255, 255, 255, 12, "sans", true, false, "center");
    game.drawTextAnchored("anchored", 50.0, 50.0, 255, 255, 255, 12, "center", "top");
    game.setSpriteTexture(spriteA, 0);
    game.drawSprite(spriteA);
    game.drawTexture(0, 10.0, 10.0, 4.0, 4.0, 0.0);
    game.drawTextureAt("missing.png", 10.0, 10.0, 1.0);
    game.drawTextureRect(0, 0.0, 0.0, 4.0, 4.0);
    game.endDraw();
    game.setTitle("renamed");
    game.hideCursor();
    game.showCursor();
    fails += check(game.deltaTime() > 0.0, "true", "game.deltaTime");
    fails += check(game.getTime(), "0", "game.getTime");
    fails += check(strOf(game.getSpriteX(spriteA)) + "," + strOf(game.getSpriteY(spriteA)), "0,0", "game.spriteXY");
    game.setSpritePosition(spriteA, 1.0, 2.0);
    fails += check(strOf(game.getSpriteX(spriteA)) + "," + strOf(game.getSpriteY(spriteA)), "1,2", "game.spritePosition");
    fails += check(game.getSpritePosition(spriteA), "1,2", "game.getSpritePosition.updated");
    game.setSpriteColor(spriteA, 1, 2, 3, 255);
    game.flipSpriteH(spriteA);
    game.flipSpriteV(spriteA);
    game.updateSprite(spriteA);
    fails += check(game.getSpriteX(spriteA), "1", "game.updateSprite");
    int bigList = game.makeSpriteList();
    game.addToList(bigList, spriteA);
    game.updateSpriteList(bigList);
    game.drawSpriteList(bigList);
    fails += check(game.getSpriteListCount(bigList), "1", "game.spriteList.update");
    game.clearSpriteList(bigList);
    fails += check(game.getSpriteListCount(bigList), "0", "game.spriteList.clear");
    fails += check(strOf(game.mouseX()) + "," + strOf(game.mouseY()), "0,0", "game.mouseXY");
    fails += check(strOf(game.mouseScrollX()) + "," + strOf(game.mouseScrollY()), "0,0", "game.mouseScroll");
    fails += check(strOf(game.mouseDeltaX()) + "," + strOf(game.mouseDeltaY()), "0,0", "game.mouseDelta");
    fails += check(game.keyPressed("A"), "false", "game.keyPressed");
    fails += check(game.keyReleased("A"), "false", "game.keyReleased");
    fails += check(game.keyUp("A"), "false", "game.keyUp");
    fails += check(game.mouseLeft(), "false", "game.mouseLeft");
    fails += check(game.mouseMiddle(), "false", "game.mouseMiddle");
    fails += check(game.mouseRight(), "false", "game.mouseRight");
    fails += check(game.mouseButtonPressed("LEFT"), "false", "game.mouseButtonPressed");
    fails += check(game.mouseButtonReleased("LEFT"), "false", "game.mouseButtonReleased");
    fails += check(game.mouseButtonCode("LEFT"), "0", "game.mouseButtonCode");
    fails += check(game.keyCode("SPACE"), "32", "game.keyCode");
    game.setUpdateCallback("onUpdate");
    game.setDrawCallback("onDraw");
    game.run();
    game.close();
    } else {
        println("== game (skipped: LYNXER_SKIP_DISPLAY=1) ==");
    }

    // ----------------------------------------------------------- graphics
    if(not skipDisplay){
    println("== graphics ==");
    // Force the graphics backend into headless mode so the run is deterministic
    // and needs no display, whether or not the caller exported the variable.
    os.setenv("LYNXER_GRAPHICS_HEADLESS", "1");
    graphics.init("stdlibTestAll", 320, 200);
    fails += check(graphics.screenWidth(), "320", "graphics.screenWidth");
    fails += check(graphics.screenHeight(), "200", "graphics.screenHeight");
    fails += check(graphics.isRunning(), "false", "graphics.isRunning");
    fails += check(graphics.dpiScale(), "1", "graphics.dpiScale");
    fails += check(graphics.quitRequested(), "false", "graphics.quitRequested");
    fails += check(graphics.loadTexture("nope.png"), "-1", "graphics.loadTexture");
    fails += check(graphics.loadFont("nope.ttf"), "-1", "graphics.loadFont");
    fails += check(graphics.renderTarget(8, 8), "0", "graphics.renderTarget");
    fails += check(graphics.screenshot("/tmp/lynxer_stdlib_test_all.png"), "-1", "graphics.screenshot");

    // An in-memory image needs no context, so its pixels round-trip even here.
    int image = graphics.genImage(4, 4, 10, 20, 30, 255);
    fails += check(image, "0", "graphics.genImage");
    fails += check(graphics.imageWidth(image), "4", "graphics.imageWidth");
    fails += check(graphics.imageSetPixel(image, 1, 1, 255, 0, 0, 255), "0", "graphics.imageSetPixel");
    fails += check(graphics.imageGetPixel(image, 1, 1), "[255,0,0,255]", "graphics.imageGetPixel");

    // Key names bridge to macroquad's numeric codes.
    fails += check(graphics.keyCode("space"), "32", "graphics.keyCode");
    fails += check(graphics.keyName(32), "space", "graphics.keyName");
    fails += check(graphics.keyName(graphics.keyCode("leftshift")), "leftshift", "graphics.keyCode.modifier");

    fails += check(graphics.rgbToHsl(255, 0, 0), "[0,1,0.5]", "graphics.rgbToHsl");
    fails += check(graphics.hslToRgb(0.0, 1.0, 0.5), "[255,0,0,255]", "graphics.hslToRgb");

    // The 2D camera is tracked in the module, so it round-trips without a GPU.
    graphics.setCamera2D(10.0, 20.0, 2.0, 0.0, 30.0, 40.0);
    fails += check(graphics.cameraTarget(), "[10,20,2,0,30,40]", "graphics.cameraTarget");
    fails += check(graphics.screenToWorld(5.0, 5.0), "[0,0]", "graphics.screenToWorld");
    graphics.setDefaultCamera();

    // The UI value registry is module state, independent of the GPU.
    graphics.uiSetInputText(9, "typed");
    fails += check(graphics.uiInputTextValue(9), "typed", "graphics.uiInputText");
    graphics.uiSetCheckboxValue(5, true);
    fails += check(graphics.uiCheckboxValue(5), "true", "graphics.uiCheckboxValue");
    graphics.uiSetSliderValue(6, 2.5);
    fails += check(graphics.uiSliderValue(6), "2.5", "graphics.uiSliderValue");
    graphics.uiComboBox(8, "Choice", "[\"alpha\",\"beta\"]");
    fails += check(graphics.uiComboBoxValue(8), "alpha", "graphics.uiComboBoxValue");

    // A window block buffers its widgets, then replays them into macroquad's
    // closure; headless it only buffers, but the block itself must open/close.
    fails += check(graphics.uiWindowBegin(1, "Panel", 0.0, 0.0, 10.0, 10.0), "0", "graphics.uiWindowBegin");
    graphics.uiLabel("inside");
    graphics.uiCheckbox(20, "Nested");
    fails += check(graphics.uiWindowEnd(), "0", "graphics.uiWindowEnd");
    fails += check(graphics.uiGroupBegin(2, 10.0, 10.0), "0", "graphics.uiGroupBegin");
    graphics.uiLabel("in group");
    fails += check(graphics.uiGroupEnd(), "0", "graphics.uiGroupEnd");

    // The frame loop drives the registered callbacks a fixed number of times.
    graphics.setUpdateCallback("graphicsUpdate");
    graphics.setDrawCallback("graphicsDraw");
    graphics.run();
    fails += check(graphics.isRunning(), "false", "graphics.running");
    fails += check(graphics.fps(), "60", "graphics.fps");
    } else {
        println("== graphics (skipped: LYNXER_SKIP_DISPLAY=1) ==");
    }

    // ===== END CHECKS =====

    println("=== stdlibTestAll: ", strOf(fails), " failure(s) ===");
    assert(fails is 0, "stdlibTestAll: " + strOf(fails) + " check(s) failed");
}
