////
Fixture for the cli stdlib. Interpreted only (module imports are not
bytecode-compilable). TTY-dependent helpers are not asserted because the test
harness redirects stdout.
////
global setup(){ import("cli"); import("os"); import("fileIO"); import("json"); }

global main(){
    println(global.cli.argCount() >= 2);
    println(global.cli.getArg(0) isnt "");
    println(global.cli.getArg(99) is "");

    global.os.setenv("LYNXER_CLI_TEST", "hello");
    println(global.cli.envGet("LYNXER_CLI_TEST"));
    println(global.cli.envHas("LYNXER_CLI_TEST"));
    println(global.cli.envHas("LYNXER_CLI_MISSING"));
    println(returnLength(global.cli.envAll()) > 10);

    println(returnLength(global.cli.cwd()) > 0);
    println(returnLength(global.cli.terminalSize()) > 2);
    // Scratch file, so this fixture does not depend on the working directory.
    str scratch = ".lynxer_scratch_cli";
    global.fileIO.writeFile(scratch, "x");
    println(global.cli.pathExists(scratch));
    println(global.cli.pathExists("definitely-missing-file"));
    println(global.cli.isFile(scratch));
    println(global.cli.isDirectory("."));
    global.fileIO.deleteFile(scratch);
    println(global.cli.which("sh") isnt "");
    println(global.cli.which("definitely-not-a-command") is "");

    global.cli.writeStdout("written\n");
    println(global.cli.run("printf cli-ok", true));
    println(global.cli.run("true", false));
    println(global.cli.run("false", false));
    println(global.cli.runCode("true"));
    println(global.cli.runCode("false"));

    // Click-style builders: command, argument, flag, shell template, invoke.
    global.cli.clickInit();
    int greet = global.cli.clickCommandCreate("greet", "Greet a person");
    println(greet > 0);
    println(global.cli.clickAddArgument(greet, "name", true, 1) is 1);
    println(global.cli.clickAddOption(greet, "--shout,-s", "Use uppercase", "", true, false, "bool") is 1);
    println(global.cli.clickCommandSetShell(greet, "printf 'Hello {name}'") is 1);
    str greetResult = global.cli.clickInvoke(greet, "[\"Ada\", \"--shout\"]");
    println(global.json.jsonGet(greetResult, "output") is "Hello Ada");
    println(global.json.jsonGetInt(greetResult, "exitCode") is 0);
    println(global.json.jsonGet(global.cli.clickLastParams(), "name") is "Ada");
    println(global.json.jsonGetBool(global.cli.clickLastParams(), "shout"));

    // A typed option and a group with a subcommand.
    int count = global.cli.clickCommandCreate("count", "Count");
    global.cli.clickAddOption(count, "--n", "How many", "1", false, false, "int");
    global.cli.clickInvoke(count, "[\"--n\", \"7\"]");
    println(global.json.jsonGetInt(global.cli.clickLastParams(), "n") is 7);
    int group = global.cli.clickGroupCreate("tool", "Tool");
    global.cli.clickGroupAddCommand(group, count, "count");
    global.cli.clickGroupInvoke(group, "[\"count\", \"--n\", \"3\"]");
    println(global.json.jsonGetInt(global.cli.clickLastParams(), "n") is 3);

    // The error path returns {"error": "..."} rather than failing the process.
    str bad = global.cli.clickInvoke(count, "[\"--nope\"]");
    println(returnLength(global.json.jsonGet(bad, "error")) > 0);

    // Typer-style builders: a single-command app is invoked without its name.
    global.cli.typerInit();
    int app = global.cli.typerAppCreate("app", "App", true);
    int tgreet = global.cli.typerCommandCreate(app, "greet", "Greet");
    global.cli.typerAddArgument(tgreet, "name", true, 1);
    global.cli.typerAddOption(tgreet, "--loud", "Loud", "", true, false, "bool");
    global.cli.typerCommandSetShell(tgreet, "printf 'hi {name}'");
    str typerResult = global.cli.typerInvoke(app, "[\"Ada\"]");
    println(global.json.jsonGet(typerResult, "output") is "hi Ada");
    println(global.json.jsonGet(global.cli.typerLastParams(), "name") is "Ada");
}
