////
Fixture for the cli stdlib. Interpreted only (module imports are not
bytecode-compilable). TTY-dependent helpers are not asserted because the test
harness redirects stdout.
////
fn setup(){ import("cli"); import("os"); import("fileIO"); import("json"); import("text"); }

fn main(){
    println(cli.argCount() >= 2);
    println(cli.getArg(0) isnt "");
    println(cli.getArg(99) is "");

    os.setenv("LYNXER_CLI_TEST", "hello");
    println(cli.envGet("LYNXER_CLI_TEST"));
    println(cli.envHas("LYNXER_CLI_TEST"));
    println(cli.envHas("LYNXER_CLI_MISSING"));
    println(returnLength(cli.envAll()) > 10);

    println(returnLength(cli.cwd()) > 0);
    println(returnLength(cli.terminalSize()) > 2);
    // Scratch file, so this fixture does not depend on the working directory.
    str scratch = ".lynxer_scratch_cli";
    fileIO.writeFile(scratch, "x");
    println(cli.pathExists(scratch));
    println(cli.pathExists("definitely-missing-file"));
    println(cli.isFile(scratch));
    println(cli.isDirectory("."));
    fileIO.deleteFile(scratch);
    println(cli.which("sh") isnt "");
    println(cli.which("definitely-not-a-command") is "");

    cli.writeStdout("written\n");
    println(cli.run("printf cli-ok", true));
    println(cli.run("true", false));
    println(cli.run("false", false));
    println(cli.runCode("true"));
    println(cli.runCode("false"));

    // Click-style builders: command, argument, flag, shell template, invoke.
    cli.clickInit();
    int greet = cli.clickCommandCreate("greet", "Greet a person");
    println(greet > 0);
    println(cli.clickAddArgument(greet, "name", true, 1) is 1);
    println(cli.clickAddOption(greet, "--shout,-s", "Use uppercase", "", true, false, "bool") is 1);
    println(cli.clickCommandSetShell(greet, "printf 'Hello {name}'") is 1);
    str greetResult = cli.clickInvoke(greet, "[\"Ada\", \"--shout\"]");
    println(json.jsonGet(greetResult, "output") is "Hello Ada");
    println(json.jsonGetInt(greetResult, "exitCode") is 0);
    println(json.jsonGet(cli.clickLastParams(), "name") is "Ada");
    println(json.jsonGetBool(cli.clickLastParams(), "shout"));

    // A typed option and a group with a subcommand.
    int count = cli.clickCommandCreate("count", "Count");
    cli.clickAddOption(count, "--n", "How many", "1", false, false, "int");
    cli.clickInvoke(count, "[\"--n\", \"7\"]");
    println(json.jsonGetInt(cli.clickLastParams(), "n") is 7);
    int group = cli.clickGroupCreate("tool", "Tool");
    cli.clickGroupAddCommand(group, count, "count");
    cli.clickGroupInvoke(group, "[\"count\", \"--n\", \"3\"]");
    println(json.jsonGetInt(cli.clickLastParams(), "n") is 3);

    // The error path returns {"error": "..."} rather than failing the process.
    str bad = cli.clickInvoke(count, "[\"--nope\"]");
    println(returnLength(json.jsonGet(bad, "error")) > 0);

    // Typer-style builders: a single-command app is invoked without its name.
    cli.typerInit();
    int app = cli.typerAppCreate("app", "App", true);
    int tgreet = cli.typerCommandCreate(app, "greet", "Greet");
    cli.typerAddArgument(tgreet, "name", true, 1);
    cli.typerAddOption(tgreet, "--loud", "Loud", "", true, false, "bool");
    cli.typerCommandSetShell(tgreet, "printf 'hi {name}'");
    str typerResult = cli.typerInvoke(app, "[\"Ada\"]");
    println(json.jsonGet(typerResult, "output") is "hi Ada");
    println(json.jsonGet(cli.typerLastParams(), "name") is "Ada");

    // Help, flag negation, repeated options and environment defaults.
    cli.clickInit();
    int helpCommand = cli.clickCommandCreate("greet", "Greet a person");
    cli.clickAddArgument(helpCommand, "name", true, 1, "Who to greet");
    cli.clickAddOption(helpCommand, "--shout,-s", "Uppercase", "", true, false, "bool");
    cli.clickAddOption(helpCommand, "--tag", "Tag", "", false, false, "text", "", true);
    cli.clickAddOption(helpCommand, "--port", "Port", "0", false, false, "int", "LYNXER_CLI_PORT");
    cli.clickCommandSetShell(helpCommand, "printf 'Hello {name} tags={tag}'");
    str help = json.jsonGet(cli.clickInvoke(helpCommand, "[\"--help\"]"), "help");
    println(text.contains(help, "Usage: greet"));
    println(text.contains(help, "Who to greet"));
    println(text.contains(help, "--shout, -s"));
    cli.clickInvoke(helpCommand, "[\"Ada\", \"--no-shout\"]");
    println(json.jsonGetBool(cli.clickLastParams(), "shout"));
    cli.clickInvoke(helpCommand, "[\"Ada\", \"--tag\", \"a\", \"--tag\", \"b\"]");
    println(json.jsonGet(cli.clickLastParams(), "tag") is "[\"a\", \"b\"]");
    println(json.jsonGet(cli.clickInvoke(helpCommand, "[\"Ada\", \"--tag\", \"a\", \"--tag\", \"b\"]"), "output") is "Hello Ada tags=a b");
    os.setenv("LYNXER_CLI_PORT", "9");
    cli.clickInvoke(helpCommand, "[\"Ada\"]");
    println(json.jsonGetInt(cli.clickLastParams(), "port") is 9);
    cli.clickInvoke(helpCommand, "[\"Ada\", \"--port\", \"5\"]");
    println(json.jsonGetInt(cli.clickLastParams(), "port") is 5);
    int noArgsApp = cli.typerAppCreate("tool", "Tool app", true);
    println(text.contains(json.jsonGet(cli.typerInvoke(noArgsApp, "[]"), "help"), "Usage: tool"));
}
