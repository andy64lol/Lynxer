////
Named-pipe regression fixture for the `winapi` standard-library module.

Windows-only: it starts the server and client helpers through
`multiprocessing`. The client retries while the server is still creating the
pipe, so the order the two commands start in does not matter.
////

fn setup(){
    import("os");
    import("text");
    import("multiprocessing");
    importAs("winAPI-amd64", "winApiAmd64");
    importAs("winAPI-arm64", "winApiArm64");
}

fn moduleFileName() -> str {
    if (winApiAmd64.architecture() is "amd64") {
        return winApiAmd64.getModuleFileName();
    }
    return winApiArm64.getModuleFileName();
}

fn main(){
    str exe = moduleFileName();
    str directory = os.absPath("lynxer/examples");
    str server = os.joinPath(directory, "winapi_pipe_server.lynx");
    str client = os.joinPath(directory, "winapi_pipe_client.lynx");
    list commands = listPush(
        listPush(listRepeat("", 0), "\"" + exe + "\" \"" + server + "\""),
        "\"" + exe + "\" \"" + client + "\"");
    list outputs = multiprocessing.runParallel(commands);
    list serverLines = text.splitLines(listGet(outputs, 0));
    list clientLines = text.splitLines(listGet(outputs, 1));
    println(listGet(serverLines, 0));
    println(listGet(serverLines, 1));
    println(listGet(serverLines, 2));
    println(listGet(serverLines, 3));
    println(listGet(clientLines, 0));
    println(listGet(clientLines, 1));
    println(listGet(clientLines, 2));
}
