////
Failure-path fixture for the yaml input cap: a document larger than 1 MiB is
refused, and a small document still parses. Deterministic.
////
fn setup(){ import("yaml"); }

// Build a string of exactly `size` bytes without O(n^2) concatenation.
fn big(int size) -> str {
    str seed = "a";
    while(returnLength(seed) < size){ seed = seed + seed; }
    return substring(seed, 0, size);
}

fn main(){
    // One byte over the 1 MiB input cap.
    str oversized = big(1048577);
    println(yaml.yamlParse(oversized) is "");
    println(yaml.yamlValid(oversized));

    // A small document still parses.
    println(yaml.yamlParse("a: 1") is "{\"a\":1}");
}
