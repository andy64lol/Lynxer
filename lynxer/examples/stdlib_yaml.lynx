////
Fixture for the yaml stdlib. Documents cross as JSON strings and every assertion
is fixed, so the output is deterministic. Part of the import-parity gate.
////
fn setup(){ import("yaml"); }

fn main(){
    str text = "name: lynxer\nitems:\n  - 1\n  - 2\n";
    println(yaml.yamlParse(text));
    println(yaml.yamlGet(text, "name"));
    println(yaml.yamlGet(text, "items"));
    println(yaml.yamlGet(text, "nope"));
    println(yaml.yamlValid(text));
    println(yaml.yamlValid("a: [1, 2"));
    println(yaml.yamlSerialize("{\"name\":\"lynxer\"}"));
    println(yaml.yamlValid("1: numeric\n"));
    println(yaml.yamlParse("1: numeric\n") is "");
}
