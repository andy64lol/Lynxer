////
Fixture for the extended game API: scenes, text labels, tilemaps, platformer
physics, animated sprites, sound and the window helpers.

The runner sets LYNXER_GAME_HEADLESS=1, so no window opens: scene/label/physics
and tilemap work is pure data and runs for real, while the texture-backed
(`makeAnimatedSprite`, `loadSound`) and GPU-backed (`screenshot`) calls return
their headless sentinel. The tilemap is written to a scratch file under the cwd
so the fixture works from any directory.
////
fn setup(){ import("game"); import("fileIO"); }

fn main(){
    game.init("game-api", 320, 200);

    // --- scenes ---------------------------------------------------------
    int list = game.makeSpriteList();
    int first = game.makeSolidSprite(10, 10, 255, 0, 0, 4.0, 4.0);
    int second = game.makeSolidSprite(10, 10, 0, 255, 0, 20.0, 4.0);
    game.addToList(list, first);
    game.addToList(list, second);
    int scene = game.makeScene();
    println("scene=", scene, " addList=", game.addListToScene(scene, list, "main"));
    // Re-adding the same name replaces the entry rather than duplicating it.
    println("addAgain=", game.addListToScene(scene, list, "main"));
    println("addBad=", game.addListToScene(999, list, "x"));
    println("addBadList=", game.addListToScene(scene, 999, "x"));
    println("drawScene=", game.drawScene(scene), " updateScene=", game.updateScene(scene));
    println("drawSceneBad=", game.drawScene(999), " updateSceneBad=", game.updateScene(999));
    println("layerMissing=", game.getTilemapLayer(scene, "nope"));

    // Updating a scene applies its sprites' velocities.
    game.setSpriteVelocity(second, 60.0, 0.0);
    println("updateScene2=", game.updateScene(scene), " x=", game.getSpriteX(second));
    game.stopSprite(second);

    // --- text labels ----------------------------------------------------
    int label = game.makeTextLabel("hi", 5.0, 6.0, 255, 255, 255, 12, "center");
    println("label=", label);
    println("setText=", game.setTextLabel(label, "bye"));
    println("setPos=", game.setTextLabelPos(label, 1.0, 2.0));
    println("setColor=", game.setTextLabelColor(label, 1, 2, 3, 4));
    println("drawLabel=", game.drawTextLabel(label));
    println("setTextBad=", game.setTextLabel(999, "x"));
    println("setPosBad=", game.setTextLabelPos(999, 0.0, 0.0));
    println("setColorBad=", game.setTextLabelColor(999, 0, 0, 0, 0));
    println("destroy=", game.destroyTextLabel(label));
    println("destroyAgain=", game.destroyTextLabel(label));

    // --- tilemap --------------------------------------------------------
    str tmx = "<?xml version=\"1.0\"?><map tilewidth=\"16\" tileheight=\"16\"><tileset firstgid=\"1\" name=\"t\" tilewidth=\"16\" tileheight=\"16\" columns=\"2\" tilecount=\"4\"><image source=\"t.png\" width=\"32\" height=\"32\"/></tileset><tileset firstgid=\"10\" name=\"small\" tilewidth=\"8\" tileheight=\"8\" columns=\"1\" tilecount=\"1\"><image source=\"small.png\" width=\"8\" height=\"8\"/></tileset><layer name=\"Walls\" width=\"3\" height=\"2\"><data encoding=\"csv\">1,1,1,0,1,0</data></layer><layer name=\"Other\" width=\"1\"><data><tile gid=\"10\"/></data></layer><layer name=\"Base64\" width=\"1\"><data encoding=\"base64\">CgAAAA==</data></layer></map>";
    fileIO.writeFile("lynxer_scratch_map.tmx", tmx);
    int mapScene = game.loadTilemap("lynxer_scratch_map.tmx", 1.0);
    println("tilemap=", mapScene > 0);
    int walls = game.getTilemapLayer(mapScene, "Walls");
    println("walls=", walls > 0, " count=", game.getSpriteListCount(walls));
    int otherTiles = game.getTilemapLayer(mapScene, "Other");
    int base64Tiles = game.getTilemapLayer(mapScene, "Base64");
    println("tilesets-and-encodings=", game.getSpriteListCount(otherTiles), ",", game.getSpriteListCount(base64Tiles));
    // The geometry is pinned through the player's resting height below: a
    // two-row map puts the top wall face at y = 32, so a 10-high player rests
    // at y = 37.
    println("missingMap=", game.loadTilemap("lynxer_scratch_missing.tmx", 1.0));
    println("badLayer=", game.getTilemapLayer(mapScene, "Nope"));

    // --- physics --------------------------------------------------------
    // A player dropped above the wall column lands on it.
    int player = game.makeSolidSprite(10, 10, 0, 0, 255, 24.0, 40.0);
    int engine = game.makePhysicsEngine(100.0, walls);
    println("engine=", engine, " setPlayer=", game.setPhysicsPlayer(engine, player));
    println("setPlayerBad=", game.setPhysicsPlayer(engine, -1));
    println("canJump0=", game.canJump(engine));
    for (int step = 0; step < 60; step += 1) {
        game.updatePhysics(engine);
    }
    println("canJump1=", game.canJump(engine));
    println("vy=", game.getPlayerVY(engine));
    println("restY=", game.getSpriteY(player));
    println("jump=", game.jumpPlayer(engine, 60.0), " vyJump=", game.getPlayerVY(engine));
    println("canJumpAfterJump=", game.canJump(engine));
    game.updatePhysics(engine);
    println("vyRising=", game.getPlayerVY(engine) > 50.0);
    println("updateBad=", game.updatePhysics(999), " canJumpBad=", game.canJump(999));
    println("jumpBad=", game.jumpPlayer(999, 10.0), " vyBad=", game.getPlayerVY(999));

    // A grounded player is carried with a platform moved between physics steps.
    int platform = game.makeSolidSprite(80, 10, 80, 80, 80, 0.0, 0.0);
    int platforms = game.makeSpriteList();
    game.addToList(platforms, platform);
    int rider = game.makeSolidSprite(10, 10, 255, 255, 255, 5.0, 10.0);
    int platformEngine = game.makePhysicsEngine(0.0, platforms);
    game.setPhysicsPlayer(platformEngine, rider);
    game.updatePhysics(platformEngine);
    println("platform-grounded=", game.canJump(platformEngine));
    game.setSpritePos(platform, 10.0, 0.0);
    game.updatePhysics(platformEngine);
    println("platform-carry=", game.getSpriteX(rider));

    // --- animation and sound (headless sentinels) -----------------------
    println("anim=", game.makeAnimatedSprite("[\"a.png\",\"b.png\"]", 8.0, 0.0, 0.0));
    println("animBad=", game.makeAnimatedSprite("[]", 8.0, 0.0, 0.0));
    println("updateAnimBad=", game.updateAnimation(-1, 0.1));
    println("sound=", game.loadSound("x.wav"));
    println("playBad=", game.playSound(-1));
    println("loopBad=", game.loopSound(-1));
    println("stopBad=", game.stopSound(-1));
    println("volumeBad=", game.setSoundVolume(-1, 0.5) , " playingBad=", game.isSoundPlaying(-1));

    // --- window ---------------------------------------------------------
    println("windowPos=", game.setWindowPos(10, 20));
    println("screenshot=", game.screenshot("lynxer_scratch_shot.png"));

    println(fileIO.deleteFile("lynxer_scratch_map.tmx"));
}
