////
`sys.argv` is the program's own command line, not the interpreter's. The suite
runs this with extra arguments and diffs the result, so entry 0 is the script
path and the rest are the arguments passed after it.
////
fn setup(){ import("sys"); }

fn main(){
    println(sys.argCount());
    println(sys.argv());
    println(sys.getArg(1));
    println(sys.getArg(2));
    println(sys.getArg(3) is "");
}
