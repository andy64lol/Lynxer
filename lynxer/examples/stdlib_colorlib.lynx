////
Fixture for the colorlib stdlib (pure Lynxer, no shared library). Raw escape
sequences are not printed; the assertions compare styled output against the
low-level ansi() helper instead.
////
fn setup(){ import("colorlib"); }

fn main(){
    println(colorlib.red("x") is colorlib.ansi("x", "31"));
    println(colorlib.bgBlue("x") is colorlib.ansi("x", "44"));
    println(colorlib.bold("x") is colorlib.ansi("x", "1"));
    println(colorlib.error("x") is colorlib.ansi("x", "1;31"));
    println(colorlib.success("x") is colorlib.ansi("x", "1;32"));
    println(returnLength(colorlib.reset()) > 0);
    println(returnLength(colorlib.clearScreen()) > 0);
    println(returnLength(colorlib.cursorHome()) > 0);
    println(colorlib.ansi("x", "90") isnt colorlib.ansi("x", "30"));
}
