////
Fixture for the regex stdlib. Interpreted only (module imports are not
bytecode-compilable).
////
fn setup(){ import("regex"); }

fn main(){
    regex.compile("digits", "\\d+", "");
    println(regex.testCompiled("digits", "abc123"));
    println(regex.matchCompiled("digits", "abc123def"));
    println(regex.findallCompiled("digits", "a1 b22"));
    println(regex.subCompiled("digits", "#", "a1 b22"));
    regex.compile("shout", "abc", "I");
    println(regex.testCompiled("shout", "ABC"));
    println(regex.cacheKeys());
    println(regex.isValid("\\d+"));
    println(regex.isValid("(unclosed"));
    println(regex.extract("(?P<user>\\w+)@(?P<host>\\w+)", "alice@example"));
    println(regex.extractAll("(?P<k>\\w+)=(?P<v>\\d+)", "x=1 y=2"));
    println(regex.unique("\\w", "aabbc"));
    println(regex.lastMatch("\\d+", "a1 b22"));
    println(regex.findallOverlapping("aa", "aaaa"));
    println(regex.replaceNth("\\d", "#", "a1b2c3", 2));
    println(regex.replaceAllLiteral("\\d+", "\\1", "a1b22"));
    println(regex.highlight("\\d+", "**", "**", "score: 42"));
    println(regex.splitKeep("[,;]", "a,b;c"));
    println(regex.findLetters("ab12cd"));
    println(regex.findDigits("ab12cd"));
    println(regex.globToRegex("*.txt"));
    println(regex.countMatches("\\d+", "a1 b22 c333"));
    println(regex.firstMatchPos("\\d+", "ab12"));
    println(regex.firstMatchPos("\\p{L}+", "🙂éx"));
    println(regex.firstMatchCharPos("\\p{L}+", "🙂éx"));
    println(regex.extract("(?P<letters>\\p{L}+)", "🙂éx"));
    println(regex.replaceAllLiteral("\\p{L}+", "[$&]", "🙂éx"));
    println(regex.isValid("("));
    println(regex.truncateMatch("\\d+", "abcdef123456ghij", 7));
    println(regex.countWords("the quick brown fox"));
    // The engine now runs what std::regex could not, and the X flag is honoured.
    regex.compile("after", "(?<==)\\d+", "");
    println(regex.findallCompiled("after", "a=1 b=22"));
    regex.compile("verbose", "a  b", "X");
    println(regex.testCompiled("verbose", "ab"));
    println(regex.extract("(?<year>\\d{4})-(?<month>\\d{2})", "2026-09"));
    regex.clearCache();
    println(regex.cacheKeys());
}
