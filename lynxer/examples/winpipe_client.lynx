////
Client half of winpipe.lynx. Launched by the parent; not a standalone fixture.
////
fn setup(){ import("winpipe"); }

fn main(){
    str name = "lynxer-winpipe-fixture";
    int client = winpipe.open(name);
    println("client-open=" + strOf(client > 0));
    println("client-write=" + strOf(winpipe.write(client, "ping") is 4));
    println("client-read=" + winpipe.read(client, 16));
    winpipe.close(client);
}
