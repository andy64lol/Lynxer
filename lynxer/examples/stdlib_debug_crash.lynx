////
Fixture for the debug crash-trace path. It redirects the log to the temporary
directory so it does not touch the user's state.
////
fn setup(){ import("debug"); import("os"); import("fileIO"); }

fn main(){
    str path = os.joinPath(os.tempDir(), "lynxer-crash-test.log");
    if(os.exists(path)){ os.remove(path); }
    println(os.setenv("LYNXER_CRASH_LOG", path));
    println(debug.crashLogPath() is path);
    println(debug.recordCrash("boom"));
    println(returnLength(fileIO.readFile(path)) > 0);
    println(os.remove(path));
}
