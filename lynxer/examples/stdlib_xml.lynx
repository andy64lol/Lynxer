////
Fixture for the xml stdlib. A document maps onto a JSON element tree and every
assertion is fixed, so the output is deterministic. Part of the import-parity
gate.
////
fn setup(){ import("xml"); }

fn main(){
    str text = "<a x=\"1\">hi<b/></a>";
    println(xml.xmlParse(text));
    println(xml.xmlValid(text));
    println(xml.xmlValid("<a><b></a>"));
    println(xml.xmlEscape("a<b&c>d"));
    println(xml.xmlUnescape("a&lt;b&amp;c&gt;d"));
    println(xml.xmlUnescape("a&nope;"));
    println(xml.xmlSerialize(xml.xmlParse(text)));
    println(xml.xmlParse("<a><b></a>"));
    str document = "<root a=\"x&amp;y\"><item>one</item></root>";
    println(xml.xmlSerialize(xml.xmlParse(document)));
    println(xml.xmlParse(xml.xmlSerialize(xml.xmlParse(document))));
}
