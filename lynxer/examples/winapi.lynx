////
Regression fixture for the `winAPI` surface.

Windows-only. It asserts shape (`> 0`, lengths) rather than exact values, so
the expected output is stable across machines.
////

fn setup(){ importAs("winAPI-__ARCH__", "windowsApi"); }

fn main(){
    println(windowsApi.getProcessId() > 0);
    println(returnLength(windowsApi.getCurrentDirectory()) > 0);
    println(returnLength(windowsApi.getComputerName()) > 0);
    println(returnLength(windowsApi.getTempPath()) > 0);
    println(returnLength(windowsApi.getSystemDirectory()) > 0);
    println(returnLength(windowsApi.getWindowsDirectory()) > 0);
    println(returnLength(windowsApi.getModuleFileName()) > 0);
    println(windowsApi.getTickCount() > 0);
    println(windowsApi.setEnvironmentVariable("LYNXER_WINAPI_TEST", "ok"));
    println(windowsApi.getEnvironmentVariable("LYNXER_WINAPI_TEST"));
    println(returnLength(windowsApi.getEnvironmentVariable("LYNXER_WINAPI_ABSENT")) is 0);
    println(returnLength(windowsApi.expandEnvironmentStrings("%TEMP%")) > 0);
    println(windowsApi.getDiskFreeBytes(windowsApi.getTempPath()) > 0);

    // Files and handles: write, size, seek, close, read back, delete.
    str root = windowsApi.getTempPath();
    str path = root + "lynxer-winapi-fixture.txt";
    int file = windowsApi.createFile(path, "write");
    println(file > 0);
    println(windowsApi.writeFile(file, "hello") is 5);
    println(windowsApi.fileSize(file) is 5);
    println(windowsApi.seekFile(file, 1) is 1);
    println(windowsApi.closeHandle(file));
    int reader = windowsApi.createFile(path, "read");
    println(windowsApi.readFile(reader, 5));
    println(windowsApi.closeHandle(reader));
    println(windowsApi.deleteFile(path));

    // Directories: the first removal is best-effort and not asserted.
    str directory = root + "lynxer-winapi-dir";
    windowsApi.removeDirectory(directory);
    println(windowsApi.createDirectory(directory));
    println(windowsApi.removeDirectory(directory));

    // Process control and the current thread.
    println(windowsApi.getCurrentThreadId() > 0);
    int self = windowsApi.openProcess(windowsApi.getProcessId());
    println(self > 0);
    println(windowsApi.getExitCodeProcess(self) >= 0);
    println(windowsApi.closeHandle(self));

    // Spawn a child, wait for it, read its exit code.
    int child = windowsApi.createProcess("cmd /c exit 0");
    println(child > 0);
    println(windowsApi.waitForSingleObject(child, 10000) is 0);
    println(windowsApi.getExitCodeProcess(child) is 0);
    println(windowsApi.closeHandle(child));

    // Console session calls. A CI runner has no interactive console, so these
    // assert shape (`>= 0` / `>= -1`) rather than success.
    println(windowsApi.getStdHandle("output") >= -1);
    println(windowsApi.getConsoleMode(windowsApi.getStdHandle("output")) >= -1);
    println(windowsApi.getConsoleOutputCP() >= 0);

    // Files by name, flushing, and the high-resolution timer.
    println(windowsApi.getFileAttributes(windowsApi.getModuleFileName()) >= 0);
    println(returnLength(windowsApi.getFullPathName(".")) > 0);
    int flushTarget = windowsApi.createFile(root + "lynxer-winapi-flush.txt", "write");
    println(windowsApi.flushFileBuffers(flushTarget));
    println(windowsApi.closeHandle(flushTarget));
    println(windowsApi.deleteFile(root + "lynxer-winapi-flush.txt"));
    println(windowsApi.queryPerformanceCounter() > 0);
    println(windowsApi.queryPerformanceFrequency() > 0);

    // Known Folders from shell32.
    println(returnLength(windowsApi.getKnownFolderPath("localAppData")) > 0);
    println(returnLength(windowsApi.getKnownFolderPath("documents")) > 0);
    println(windowsApi.getKnownFolderPath("notAFolder") is "");

    // Shell-adjacent system information, formatting and named-pipe helpers.
    println(returnLength(windowsApi.getUserName()) > 0);
    println(returnType(windowsApi.isUserAnAdmin()) is "bool");
    println(windowsApi.getSystemMetrics(0) > 0);
    println(windowsApi.getLogicalDrives() > 0);
    println(windowsApi.getDriveType("C:\\") >= 0);
    println(returnLength(windowsApi.getOSVersion()) > 0);
    println(returnLength(windowsApi.getLocaleName()) > 0);
    println(returnLength(windowsApi.getTimeZoneName()) > 0);
    println(returnLength(windowsApi.formatMessage(2)) > 0);

    // Additional system information.
    println(windowsApi.getSystemTime() > 0);
    println(returnLength(windowsApi.getSystemInfo()) > 0);
    println(returnLength(windowsApi.getMemoryStatus()) > 0);
    println(returnLength(windowsApi.getPowerStatus()) > 0 or windowsApi.getPowerStatus() is "");
    println(returnLength(windowsApi.getVolumeInfo(windowsApi.getTempPath())) > 0);
    println(returnLength(windowsApi.getDiskSpace(windowsApi.getTempPath())) > 0);
    println(windowsApi.getACP() > 0);
    println(windowsApi.getOEMCP() > 0);
    println(returnLength(windowsApi.getCommandLine()) > 0);
    int current = windowsApi.getCurrentProcess();
    println(current > 0);
    println(windowsApi.getPriorityClass(current) > 0);
    println(windowsApi.setPriorityClass(current, windowsApi.getPriorityClass(current)));
    println(windowsApi.closeHandle(current));
    println(windowsApi.getModuleHandle("kernel32.dll") > 0);
    println(windowsApi.getActiveProcessorCount(0) > 0);

    // Directory, temporary files and handle/file metadata.
    str cwd = windowsApi.getCurrentDirectory();
    println(windowsApi.setCurrentDirectory(cwd));
    str temp = windowsApi.getTempFileName("lyn");
    println(returnLength(temp) > 0);
    println(windowsApi.getFileTime(temp) isnt "");
    println(windowsApi.deleteFile(temp));
    int out = windowsApi.getStdHandle("output");
    println(windowsApi.getFileType(out) > 0);
    println(windowsApi.getConsoleWindow() >= -1);
    println(returnType(windowsApi.getConsoleScreenBufferInfo()) is "str");
}
