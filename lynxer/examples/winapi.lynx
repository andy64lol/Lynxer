////
Regression fixture for the `winAPI` surface.

Windows-only: it selects the Windows target, which only a Windows host accepts.
It asserts shape (`> 0`, lengths) rather than exact values, so the expected
output is stable across machines.
////

global setup(){ syscalls("winAPI", "__ARCH__"); }

global main(){
    println(winAPI.getProcessId() > 0);
    println(returnLength(winAPI.getCurrentDirectory()) > 0);
    println(returnLength(winAPI.getComputerName()) > 0);
    println(returnLength(winAPI.getTempPath()) > 0);
    println(returnLength(winAPI.getSystemDirectory()) > 0);
    println(returnLength(winAPI.getWindowsDirectory()) > 0);
    println(returnLength(winAPI.getModuleFileName()) > 0);
    println(winAPI.getTickCount() > 0);
    println(winAPI.setEnvironmentVariable("LYNXER_WINAPI_TEST", "ok"));
    println(winAPI.getEnvironmentVariable("LYNXER_WINAPI_TEST"));
    println(returnLength(winAPI.getEnvironmentVariable("LYNXER_WINAPI_ABSENT")) is 0);
    println(returnLength(winAPI.expandEnvironmentStrings("%TEMP%")) > 0);
    println(winAPI.getDiskFreeBytes(winAPI.getTempPath()) > 0);

    // Files and handles: write, size, seek, close, read back, delete.
    str root = winAPI.getTempPath();
    str path = root + "lynxer-winapi-fixture.txt";
    int file = winAPI.createFile(path, "write");
    println(file > 0);
    println(winAPI.writeFile(file, "hello") is 5);
    println(winAPI.fileSize(file) is 5);
    println(winAPI.seekFile(file, 1) is 1);
    println(winAPI.closeHandle(file));
    int reader = winAPI.createFile(path, "read");
    println(winAPI.readFile(reader, 5));
    println(winAPI.closeHandle(reader));
    println(winAPI.deleteFile(path));

    // Directories: the first removal is best-effort and not asserted.
    str directory = root + "lynxer-winapi-dir";
    winAPI.removeDirectory(directory);
    println(winAPI.createDirectory(directory));
    println(winAPI.removeDirectory(directory));
}
