////
Fixture for the typing stdlib (pure Lynxer, no shared library).
////
fn setup(){ import("typing"); }

fn main(){
    // Basic type inspection and conversion.
    println(typing.typeOf(1));
    println(typing.typeOf(1.5));
    println(typing.typeOf("x"));
    println(typing.typeOf(true));
    println(typing.toStr(42));
    println(typing.toInt("42"));
    println(typing.toFloat("1.5"));
    println(typing.toBool(1));
    println(typing.isNumeric(3));
    println(typing.isNumeric("3"));
    println(typing.lenStr("abcd"));
    println(typing.isByte(200));
    println(typing.isByte(300));
    println(typing.isInt8(200));
    println(typing.isInt8(-5));
    println(typing.isInt16(40000));
    println(typing.isInt32(2147483647));

    // String-content predicates and numeric range checks.
    println(typing.isAlpha("abc"), " ", typing.isAlpha("a1c"), " ", typing.isAlpha(""));
    println(typing.isDigit("123"), " ", typing.isDigit("12a"));
    println(typing.isAlphaNum("a1"), " ", typing.isAlphaNum("a-1"));
    println(typing.isSpace(" \t"), " ", typing.isSpace(" x"));
    println(typing.isNumBool(1), " ", typing.isNumBool(2), " ", typing.isBit(0));
    println(typing.isInt64(3), " ", typing.isUInt8(255), " ", typing.isUInt8(256));
    println(typing.isUInt16(65535), " ", typing.isUInt16(65536), " ", typing.isUInt32(4294967295));
    println(typing.isUInt64(1), " ", typing.isUInt64(-1));
    println(typing.isFloat32(1.5), " ", typing.isFloat64(1.5), " ", typing.isFloat32("x"));
    println(typing.toFloat32(2), " ", typing.toFloat64(3));

    // Char helpers.
    println(typing.charCodeOf("A"), " ", typing.charCodeOf(""), " ", typing.charCodeOf(1));
    println(typing.charCode("Z"));
    println(typing.charOf(66));
    println(typing.charAt("hello", 1), " ", typing.charAt("hello", 9));
    println(typing.toChar(67), " ", typing.toChar("D"));

    // String helpers.
    println(typing.trim("  hi  "), "|", typing.stripLeft("  hi  "), "|", typing.stripRight("  hi  "), "|");
    println(typing.upper("abc"), " ", typing.lower("ABC"));
    println(typing.titleCase("hello world"), " ", typing.swapCase("AbC"));
    println(typing.repeat("ab", 3), " ", typing.repeatStr("x", 2));
    println(typing.contains("hello", "ell"), " ", typing.contains("hello", "zz"));
    println(typing.startsWith("hello", "he"), " ", typing.endsWith("hello", "lo"));
    println(typing.replace("a-b-c", "-", "+"));
    println(typing.indexOf("banana", "na"), " ", typing.indexOf("abc", "z"), " ", typing.countOccurrences("banana", "na"));
    println(typing.substr("hello", 1, 4), " ", typing.substr("hello", -3, -1));
    println(typing.padLeft("7", 3, "0"), " ", typing.padRight("7", 3, "."), " ", typing.center("7", 5, "-"));
    println(typing.zfill("42", 5), " ", typing.zfill("-42", 5));
    println(typing.strReverse("abc"), " ", typing.spaces(3), "|");
    println(typing.wordWrap("the quick brown fox", 9));
    println(typing.expandTabs("a\tb", 4), "|");
    println(typing.splitFirst("a=b=c", "="), " ", typing.splitFirst("abc", "="));
    println(typing.splitToList("a,b,c", ","));
    println(typing.linesOf("a\nb\nc"), " ", typing.linesOf(""));

    // Number helpers.
    println(typing.abs(-4), " ", typing.abs(-4.5), " ", typing.sign(-9), " ", typing.sign(0));
    println(typing.maxOf(3, 7), " ", typing.minOf(3, 7));
    println(typing.clamp(15.0, 0.0, 10.0), " ", typing.between(5, 1, 10));
    println(typing.roundTo(3.14159, 2));

    // List and tuple helpers, plus the previously broken paths.
    println(typing.toByte(300), " ", typing.toByte(12));
    println(typing.listFirst([int 7, int 8]), " ", typing.listLast([int 7, int 8]));
    println(typing.listHead([int 1, int 2, int 3], 2), " ", typing.listTail([int 1, int 2, int 3], 2));
    println(typing.listChunk([int 1, int 2, int 3, int 4, int 5], 2));
    println(typing.listZip([int 1, int 2], [int 3, int 4]));
    println(typing.tupleZip((int 1, int 2), (int 3, int 4)));
    println(typing.unique([int 1, int 1, int 2]));

    // Characters are code points, up to the Unicode maximum.
    println(typing.charCode("€"), " ", typing.charCodeOf("€"));
    println(typing.charOf(233), " ", typing.charOf(8364));
    println(typing.charAt("café", 3), " ", typing.charAt("café", 9));
    println(typing.isAlpha("café"), " ", typing.isAlpha("cafe"));
    // A code outside the valid range falls back to a NUL char.
    println(typing.charCodeOf(typing.charOf(1114112)) is 0, " ",
            typing.charCodeOf(typing.charOf(55296)) is 0);
}
