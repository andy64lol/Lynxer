////
Fixture for the text stdlib, including the native Unicode backend.
////
fn setup(){ import("text"); }

fn main(){
    println(text.reverse("abc"));
    println(text.repeat("ab", 3));
    println(text.trim("  hi  "));
    println(text.contains("hello", "ell"));
    println(text.contains("hello", ""));
    println(text.contains("hello", "z"));
    println(text.startsWith("hello", "he"));
    println(text.startsWith("hello", "lo"));
    println(text.endsWith("hello", "lo"));
    println(text.count("banana", "na"));
    println(text.count("banana", ""));
    println(text.replace("aaa", "a", "b"));
    println(text.upper("abc"));
    println(text.lower("ABC"));
    println(text.upper("Straße"));
    println(text.lower("İΣ"));
    println(text.upperAscii("café"));
    println(text.lowerAscii("ABC"));
    println(text.isAlpha("café"));
    println(text.isAlpha("é"));
    println(text.isAlphaAscii("café"));
    println(text.isNumeric("１２٣"));
    println(text.isDigit("١"));
    println(text.isNumericAscii("１２٣"));
    println(text.isAlphaNumeric("café١"));
    println(text.isAlphaNumericAscii("café١"));
    println(text.isEmpty(""));
    println(text.isEmpty("a"));
    println(text.isBlank("  "));
    println(text.isBlank(" a "));

    // Search, padding and splitting helpers.
    println(text.indexOf("banana", "na"));
    println(text.indexOf("abc", "z"));
    println(text.spaces(3), "|");
    println(text.zfill("42", 5), " ", text.zfill("-42", 5));
    println(text.wordWrap("the quick brown fox", 9));
    println(text.expandTabs("a\tb\tc", 4), "|");
    println(text.splitFirst("a=b=c", "="), " ", text.splitFirst("abc", "="));

    // Strings count code points, not bytes: one character is one code point,
    // so a non-ASCII string is handled as text rather than as its bytes.
    str accented = "café";
    println(returnLength(accented), " ", returnLength("plain"));
    println(charAt(accented, 3), " ", charCode(charAt(accented, 3)));
    println(substring(accented, 0, 3), " ", substring(accented, 3, 4));
    println(text.reverse(accented));
    println(text.repeat(accented, 2));
    println(text.padLeft(accented, 6, "."));
    println(text.indexOf(accented, "f"), " ", text.contains(accented, "é"));
}
