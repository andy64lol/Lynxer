fn setup(){
    import("milestone6_lib.lynx");
    import("milestone6_lib.lynx");
    importAs("milestone6_lib.lynx", "lib");
    import("math");
    import("colorlib");
    import("typing");
    import("random");
    import("text");
}

fn main(){
    println(milestone6_lib.VERSION);
    println(milestone6_lib.double(21));
    println(lib.double(3));
    println(math.gcd(84, 30));
    println(typing.toStr(7));
    println(colorlib.red("ok"));
    println(math.isPrime(97));
    println(text.reverse("abc"));
    println(random.randint(4, 4));
}
