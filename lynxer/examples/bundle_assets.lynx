////
Program used by the `--include` data-file check in `make test`. It reads a data
file that is not a module: the file only exists inside the compiled executable,
and `bundledFile()` hands back the path it was materialized to.
////
fn setup(){ import("fileIO"); }

fn main(){
    println(bundledFiles());
    // The file ends with a newline, so print it without adding another.
    print(fileIO.readFile(bundledFile("message.txt")));
}
