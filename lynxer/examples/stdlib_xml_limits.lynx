////
Failure-path fixture for the xml guards: a document larger than the 16 MiB input
cap is refused, and an external entity is never resolved (no XXE). The secret
file's content never reaches the parsed tree, whatever the entity reference
becomes, so the assertion is stable across parser versions. Deterministic.
////
fn setup(){ import("xml"); import("fileIO"); import("os"); import("text"); }

// Build a string of exactly `size` bytes without O(n^2) concatenation.
fn big(int size) -> str {
    str seed = "a";
    while(returnLength(seed) < size){ seed = seed + seed; }
    return substring(seed, 0, size);
}

fn main(){
    str root = ".lynxer_scratch_xml_limits";
    if(os.exists(root)){ os.rmTree(root); }
    os.mkdir(root);

    // One byte over the 16 MiB input cap.
    str oversized = big(16777217);
    println(xml.xmlParse(oversized) is "");
    println(xml.xmlValid(oversized));

    // An external entity is never resolved: the secret's content is absent.
    str secret = "TOP_SECRET_XML_ENTITY";
    fileIO.writeFile(root + "/secret.txt", secret);
    str doc = "<!DOCTYPE a [<!ENTITY xxe SYSTEM \"file://" + root + "/secret.txt\">]><a>&xxe;</a>";
    str parsed = xml.xmlParse(doc);
    println(text.contains(parsed, secret) is false);

    os.rmTree(root);
}
