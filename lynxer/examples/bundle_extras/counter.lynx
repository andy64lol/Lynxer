////
Second extra module for the multi-file bundling check.
////
fn setup(){}

fn countTo(int limit) -> str {
    str result = "";
    int index = 1;
    while(index <= limit){
        if(index > 1){ result = result + ","; }
        result = result + strOf(index);
        index = index + 1;
    }
    return result;
}

fn main(){}
