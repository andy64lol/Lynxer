////
Fixture for the toml stdlib. Documents cross as JSON strings and every assertion
is fixed, so the output is deterministic. Part of the import-parity gate.
////
fn setup(){ import("toml"); }

fn main(){
    str text = "answer = 42\nname = \"lynxer\"\n[server]\nhost = \"localhost\"\n";
    println(toml.tomlParse(text));
    println(toml.tomlGet(text, "answer"));
    println(toml.tomlGet(text, "server.host"));
    println(toml.tomlGet(text, "nope"));
    println(toml.tomlValid(text));
    println(toml.tomlValid("= = ="));
    println(toml.tomlSerialize("{\"answer\":42,\"name\":\"lynxer\"}"));
    println(toml.tomlParse("= = ="));
    str datetime = "date = 1979-05-27\nlocal_time = 07:32:00\nstamp = 1979-05-27T07:32:00Z\n";
    str tagged = toml.tomlParse(datetime);
    println(tagged);
    str datetimeOutput = toml.tomlSerialize(tagged);
    println(datetimeOutput);
    println(toml.tomlParse(datetimeOutput));
}
