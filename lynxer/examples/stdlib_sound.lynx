////
Fixture for the Rust-backed sound stdlib. Loading, duration, handle bookkeeping
and every error path are device-independent; playback, stop and per-handle
volume are not, and only hold on a host with a real ALSA card. `make testLynxer`
skips this fixture (with a message) when there is no `/dev/snd/controlC*`.
////

fn setup(){ import("sound"); import("fileIO"); }

fn main(){
    // Scratch names under the cwd, so the fixture works from any directory.
    str missing = ".lynxer_scratch_missing.wav";

    // `make test` runs fixtures from `lynxer/`, but they are also expected to
    // run from the repository root, so resolve the asset against both layouts.
    str toneFile = "examples/assets/tone.wav";
    if(not fileIO.fileExists(toneFile)){
        toneFile = "lynxer/examples/assets/tone.wav";
    }

    // A missing file is a sentinel, not an exception.
    println(sound.loadSound(missing));
    println(sound.loadSoundStreaming(missing));

    // Loading a real file yields a handle and reports its decoded duration.
    int tone = sound.loadSound(toneFile);
    println(tone >= 0);
    println(sound.soundCount());
    println(sound.getSoundLength(tone));
    println(sound.isSoundPlaying(tone));

    // Invalid handles are rejected without failing the process.
    println(sound.playSound(-1));
    println(sound.playSoundOnce(-1));
    println(sound.loopSound(-1));
    println(sound.stopSound(-1));
    println(sound.pauseSound(-1));
    println(sound.resumeSound(-1));
    println(sound.setSoundVolume(-1, 0.5));
    println(sound.isSoundPlaying(9999));
    println(sound.getSoundLength(9999));
    println(sound.releaseSound(-1));

    // A second load gets its own handle.
    int second = sound.loadSoundStreaming(toneFile);
    println(second >= 0);
    println(sound.soundCount());

    // Volume is stored per handle, clamped to [0, 1].
    println(sound.setSoundVolume(tone, 0.5));
    println(sound.setSoundVolume(tone, 2.0));

    // Starting playback must not be fatal. Its result depends on the audio
    // device, so it is not asserted; stopping a live handle is deterministic.
    sound.playSound(tone);
    println(sound.stopSound(tone));
    println(sound.isSoundPlaying(tone));

    // Releasing is idempotent-safe: the second call reports failure.
    println(sound.releaseSound(tone));
    println(sound.releaseSound(tone));
    println(sound.soundCount());
    println(sound.releaseSound(second));
    println(sound.soundCount());
}
