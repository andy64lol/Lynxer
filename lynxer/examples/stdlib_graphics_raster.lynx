////
Headless render fixture: with no window the `graphics` module rasterizes into a
CPU framebuffer, `screenshot` writes it as a PNG, and the pixels are read back
through the `image` module. This is the render path CI can actually check.
////
fn setup(){ import("graphics"); import("image"); import("fileIO"); }

fn main(){
    graphics.init("raster", 32, 16);

    // Red field, a blue rectangle on the left, a yellow triangle inside it, a
    // green circle on the right and a white line along the bottom.
    graphics.clearBackground(255, 0, 0);
    graphics.drawRectangle(0.0, 0.0, 16.0, 16.0, 0, 0, 255);
    graphics.drawTriangle(2.0, 2.0, 6.0, 2.0, 4.0, 6.0, 255, 255, 0);
    graphics.drawCircle(24.0, 8.0, 4.0, 0, 255, 0);
    graphics.drawLine(0.0, 15.0, 31.0, 15.0, 1.0, 255, 255, 255);

    println(graphics.screenshot("/tmp/lynxer_graphics_raster.png"));

    int shot = image.open("/tmp/lynxer_graphics_raster.png");
    println(image.getWidth(shot), "x", image.getHeight(shot));
    // The PNG is in the same top-left origin the drawing ops use.
    println(image.getPixel(shot, 30, 2));
    println(image.getPixel(shot, 14, 12));
    println(image.getPixel(shot, 4, 3));
    println(image.getPixel(shot, 24, 8));
    println(image.getPixel(shot, 20, 15));

    // Nested windows and groups are replayed into the CPU layout tree too.
    graphics.init("nested-ui", 128, 96);
    graphics.clearBackground(0, 0, 0);
    graphics.uiSetCheckboxValue(77, true);
    graphics.uiWindowBegin(10, "outer", 4.0, 4.0, 100.0, 80.0);
    graphics.uiGroupBegin(11, 60.0, 32.0);
    graphics.uiLabel("child");
    graphics.uiCheckbox(77, "checked child");
    graphics.uiGroupEnd();
    graphics.uiWindowEnd();
    println("nested-ui-value ", graphics.uiCheckboxValue(77));
    graphics.screenshot("/tmp/lynxer_graphics_nested_ui.png");
    int nested = image.open("/tmp/lynxer_graphics_nested_ui.png");
    println("nested-window-pixel ", image.getPixel(nested, 4, 4));
    println("nested-group-pixel ", image.getPixel(nested, 13, 39));
    fileIO.deleteFile("/tmp/lynxer_graphics_nested_ui.png");

    fileIO.deleteFile("/tmp/lynxer_graphics_raster.png");
}
