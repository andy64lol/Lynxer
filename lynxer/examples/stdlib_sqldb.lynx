////
Fixture for the sqldb stdlib. Interpreted only (module imports are not
bytecode-compilable). Uses a repo-local scratch database and removes it
afterwards.
////

global setup(){ import("sqldb"); import("fileIO"); }

global main(){
    str db = ".clynxer_scratch_sqldb.db";

    // Start from a clean database even if an earlier run was interrupted.
    global.fileIO.deleteFile(db);
    global.fileIO.deleteFile(db + "-journal");

    println(global.sqldb.execute(db, "CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, score REAL)"));

    println(global.sqldb.executeArgs(db, "INSERT INTO users (name, score) VALUES (?, ?)", "[\"Ada\", 36.5]"));
    println(global.sqldb.executeArgs(db, "INSERT INTO users (name, score) VALUES (?, ?)", "[\"Bob\", 41]"));

    // Rows come back as a JSON array of objects, in column order.
    println(global.sqldb.query(db, "SELECT id, name, score FROM users ORDER BY id"));
    println(global.sqldb.queryArgs(db, "SELECT name FROM users WHERE score > ? ORDER BY name", "[40]"));

    // scalar() returns the first column of the first row, or "" when absent.
    println(global.sqldb.scalar(db, "SELECT COUNT(*) FROM users"));
    println(global.sqldb.scalar(db, "SELECT name FROM users WHERE name = 'nobody'"));

    println(global.sqldb.tables(db));
    println(global.sqldb.tableExists(db, "users"));
    println(global.sqldb.tableExists(db, "missing"));

    println(global.sqldb.lastInsertId(db, "INSERT INTO users (name, score) VALUES (?, ?)", "[\"Cy\", 7]"));

    // script() runs several statements as one transaction.
    println(global.sqldb.script(db, "CREATE TABLE t2 (a INTEGER); INSERT INTO t2 VALUES (7);"));
    println(global.sqldb.tables(db));

    // Failures are reported in-band as "ERROR: <message>" rather than raised.
    println(global.sqldb.query(db, "SELECT * FROM missing_table"));

    global.fileIO.deleteFile(db);
}
