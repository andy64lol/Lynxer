////
Fixture for the compress stdlib. Compression output is not pinned — only
round-trips, lengths, status strings and archive entry names are, so the output
is deterministic across builds and is part of the import-parity gate.
////
global setup(){ import("compress"); import("fileIO"); import("os"); }

global main(){
    str root = ".lynxer_scratch_compress";
    if(global.os.exists(root)){ global.os.rmTree(root); }
    global.os.mkdir(root);

    str text = "the quick brown fox jumps over the lazy dog, the quick brown fox jumps over the lazy dog, the quick brown fox jumps over the lazy dog, the quick brown fox jumps over the lazy dog";
    bytes payload = bytesOf(text);

    // --- in-memory round trips ---
    println(bytesToStr(global.compress.gzipDecompress(global.compress.gzipCompress(payload))) is text);
    println(bytesToStr(global.compress.zlibDecompress(global.compress.zlibCompress(payload))) is text);
    println(bytesToStr(global.compress.zstdDecompress(global.compress.zstdCompress(payload))) is text);
    println(bytesToStr(global.compress.brotliDecompress(global.compress.brotliCompress(payload))) is text);
    println(bytesToStr(global.compress.lz4Decompress(global.compress.lz4Compress(payload))) is text);
    // A repetitive payload compresses to fewer bytes.
    println(bytesLength(global.compress.gzipCompress(payload)) < returnLength(text));

    // --- malformed inputs answer empty bytes ---
    println(bytesLength(global.compress.gzipDecompress(bytesOf("not a stream"))) is 0);
    // "abc" is not a stream in any of these codecs.
    println(bytesLength(global.compress.gzipDecompress(bytesOf("abc"))) is 0);
    println(bytesLength(global.compress.zlibDecompress(bytesOf("abc"))) is 0);
    println(bytesLength(global.compress.zstdDecompress(bytesOf("abc"))) is 0);
    println(bytesLength(global.compress.brotliDecompress(bytesOf("abc"))) is 0);
    println(bytesLength(global.compress.lz4Decompress(bytesOf("abc"))) is 0);

    // --- file round trips ---
    global.fileIO.writeFile(root + "/data.txt", text);
    println(global.compress.gzipCompressFile(root + "/data.txt", root + "/data.gz"));
    println(global.compress.gzipDecompressFile(root + "/data.gz", root + "/data.out"));
    println(global.fileIO.readFile(root + "/data.out") is text);
    println(global.compress.zstdCompressFile(root + "/data.txt", root + "/data.zst"));
    println(global.compress.zstdDecompressFile(root + "/data.zst", root + "/data.zout"));
    println(global.fileIO.readFile(root + "/data.zout") is text);
    println(global.compress.gzipDecompressFile(root + "/missing.gz", root + "/x"));

    // --- ZIP ---
    str manifest = "[{\"name\":\"a.txt\",\"path\":\"" + root + "/data.txt\"},{\"name\":\"dir/b.txt\",\"base64\":\"aGVsbG8=\"}]";
    println(global.compress.zipCreate(root + "/archive.zip", manifest));
    println(global.compress.zipList(root + "/archive.zip"));
    println(bytesToStr(global.compress.zipRead(root + "/archive.zip", "dir/b.txt")));
    println(bytesLength(global.compress.zipRead(root + "/archive.zip", "nope.txt")) is 0);
    println(global.compress.zipExtract(root + "/archive.zip", root + "/unzip"));
    println(global.fileIO.readFile(root + "/unzip/dir/b.txt") is "hello");
    // An entry that would escape the destination is refused at creation.
    println(global.compress.zipCreate(root + "/bad.zip", "[{\"name\":\"../evil\",\"base64\":\"aGk=\"}]"));

    // --- TAR and TAR.GZ ---
    println(global.compress.tarCreate(root + "/archive.tar", manifest));
    println(global.compress.tarList(root + "/archive.tar"));
    println(global.compress.tarExtract(root + "/archive.tar", root + "/untar"));
    println(global.fileIO.readFile(root + "/untar/dir/b.txt") is "hello");
    println(global.compress.tarGzCreate(root + "/archive.tgz", manifest));
    println(global.compress.tarGzExtract(root + "/archive.tgz", root + "/untgz"));
    println(global.fileIO.readFile(root + "/untgz/a.txt") is text);
    println(global.compress.tarCreate(root + "/bad.tar", "[{\"name\":\"/abs\",\"base64\":\"aGk=\"}]"));

    global.os.rmTree(root);
}
