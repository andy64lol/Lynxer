fn setup(){
    import("math");
    import("time");
    import("shell");
    import("sys");
}

fn main(){
    println(math.pi());
    println(math.degrees(math.pi()));
    println(math.isPrime(97));
    println(time.isLeapYear(2024));
    println(shell.commandExists("sh"));
    println(sys.platform());
}
