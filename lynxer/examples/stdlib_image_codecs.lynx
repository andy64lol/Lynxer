////
Fixture for filesystem image codec round trips. It generates one deterministic
RGB image, saves and reopens it through each enabled filesystem codec, and
removes the repo-local scratch files.
////
fn setup(){ import("image"); import("os"); }

fn main(){
    str root = ".lynxer_image_codecs";
    if(os.exists(root)){ os.rmTree(root); }
    println(os.mkdir(root));

    int source = image.create(3, 2, "RGB", 128, 128, 128);

    str png = root + "/roundtrip.png";
    println(image.save(source, png));
    println(os.isFile(png));
    int pngImage = image.open(png);
    println(pngImage >= 0);
    println(image.getFormat(pngImage));
    println(image.getWidth(pngImage), "x", image.getHeight(pngImage));
    println(image.getMode(pngImage));
    println(image.getPixel(pngImage, 1, 1));
    println(image.close(pngImage));
    println(os.remove(png));

    str jpeg = root + "/roundtrip.jpeg";
    println(image.save(source, jpeg));
    println(os.isFile(jpeg));
    int jpegImage = image.open(jpeg);
    println(jpegImage >= 0);
    println(image.getFormat(jpegImage));
    println(image.getWidth(jpegImage), "x", image.getHeight(jpegImage));
    println(image.getMode(jpegImage));
    println(image.getPixel(jpegImage, 1, 1));
    println(image.close(jpegImage));
    println(os.remove(jpeg));

    str gif = root + "/roundtrip.gif";
    println(image.save(source, gif));
    println(os.isFile(gif));
    int gifImage = image.open(gif);
    println(gifImage >= 0);
    println(image.getFormat(gifImage));
    println(image.getWidth(gifImage), "x", image.getHeight(gifImage));
    println(image.getMode(gifImage));
    println(image.getPixel(gifImage, 1, 1));
    println(image.close(gifImage));
    println(os.remove(gif));

    str bmp = root + "/roundtrip.bmp";
    println(image.save(source, bmp));
    println(os.isFile(bmp));
    int bmpImage = image.open(bmp);
    println(bmpImage >= 0);
    println(image.getFormat(bmpImage));
    println(image.getWidth(bmpImage), "x", image.getHeight(bmpImage));
    println(image.getMode(bmpImage));
    println(image.getPixel(bmpImage, 1, 1));
    println(image.close(bmpImage));
    println(os.remove(bmp));

    str tiff = root + "/roundtrip.tiff";
    println(image.save(source, tiff));
    println(os.isFile(tiff));
    int tiffImage = image.open(tiff);
    println(tiffImage >= 0);
    println(image.getFormat(tiffImage));
    println(image.getWidth(tiffImage), "x", image.getHeight(tiffImage));
    println(image.getMode(tiffImage));
    println(image.getPixel(tiffImage, 1, 1));
    println(image.close(tiffImage));
    println(os.remove(tiff));

    str webp = root + "/roundtrip.webp";
    println(image.save(source, webp));
    println(os.isFile(webp));
    int webpImage = image.open(webp);
    println(webpImage >= 0);
    println(image.getFormat(webpImage));
    println(image.getWidth(webpImage), "x", image.getHeight(webpImage));
    println(image.getMode(webpImage));
    println(image.getPixel(webpImage, 1, 1));
    println(image.close(webpImage));
    println(os.remove(webp));

    println(image.close(source));
    println(os.rmTree(root));
    println(os.exists(root));
}