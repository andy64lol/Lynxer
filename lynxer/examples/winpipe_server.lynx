////
Server half of winpipe.lynx. Launched by the parent; not a standalone fixture.
////
fn setup(){ import("winpipe"); }

fn main(){
    str name = "lynxer-winpipe-fixture";
    int server = winpipe.create(name);
    println("server-create=" + strOf(server > 0));
    println("server-connect=" + strOf(winpipe.connect(server)));
    println("server-read=" + winpipe.read(server, 16));
    println("server-write=" + strOf(winpipe.write(server, "pong") is 4));
    winpipe.disconnect(server);
    winpipe.close(server);
}
