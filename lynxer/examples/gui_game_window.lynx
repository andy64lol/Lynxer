////
Windowed game smoke test for virtual-display CI.
Requires an X11 display and OpenGL context; requests closure after three update callbacks.
////
fn setup(){
    import("game");
    int updates = 0;
    int draws = 0;
    bool windowReady = false;
}

fn onUpdate(float dt){
    updates += 1;
    windowReady = game.isOpen()
        and game.getWidth() >= 64
        and game.getHeight() >= 48;
    if(updates is 3){
        game.close();
    }
}

fn onDraw(){
    draws += 1;
    game.setBackground(0, 0, 0);
    game.drawRect(20.0, 20.0, 24.0, 24.0, 0, 255, 0);
}

fn main(){
    game.init("Lynxer game GUI CI", 64, 48);
    game.setUpdateCallback("onUpdate");
    game.setDrawCallback("onDraw");
    game.run();

    println("window-ready ", windowReady);
    println("updates ", updates);
    println("draws ", draws);
}
