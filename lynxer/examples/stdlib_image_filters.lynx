////
Fixture for the extended image operations: geometry, the fixed 3x3 filters,
rank filters, compositing, the special histogram operations, channel
split/merge, and the drawing primitives.

Every image is generated in memory, so the output is deterministic and needs no
assets. Text rendering is only pinned by its return shape: the glyph pixels
depend on which system font the host provides, and `show` is only exercised
through its failure path so no viewer is launched.
////
fn setup(){ import("image"); }

// A 4x4 black image with a white 2x2 square in the middle.
fn pattern() -> int {
    int image = image.create(4, 4, "RGB", 0, 0, 0);
    image.setPixel(image, 1, 1, 200, 200, 200);
    image.setPixel(image, 2, 1, 200, 200, 200);
    image.setPixel(image, 1, 2, 200, 200, 200);
    image.setPixel(image, 2, 2, 200, 200, 200);
    return image;
}

// A 2x2 image whose first pixel is a saturated colour, so colour and sharpness
// enhancement have something to act on.
fn vivid() -> int {
    int image = image.create(2, 2, "RGB", 0, 0, 0);
    image.setPixel(image, 0, 0, 200, 100, 50);
    return image;
}

// A 4x1 ramp: black, then three progressively lighter greys.
fn ramp() -> int {
    int image = image.create(4, 1, "RGB", 0, 0, 0);
    image.setPixel(image, 1, 0, 100, 110, 120);
    image.setPixel(image, 2, 0, 140, 150, 160);
    image.setPixel(image, 3, 0, 200, 210, 220);
    return image;
}

fn main(){
    int base = pattern();
    println("base ", image.getPixel(base, 1, 1), " ", image.getPixel(base, 0, 0));

    // The fixed 3x3 filters. `smooth` divides by 13, so the square's corner
    // averages its five-black/four-white neighbourhood.
    println("smooth ", image.getPixel(image.smooth(base), 1, 1));
    println("detail ", image.getPixel(image.detail(base), 1, 1));
    println("edgeEnhance ", image.getPixel(image.edgeEnhance(base), 1, 1));
    println("emboss ", image.getPixel(image.emboss(base), 1, 1));
    println("findEdges ", image.getPixel(image.findEdges(base), 1, 1));
    println("contour ", image.getPixel(image.contour(base), 1, 1));

    // Rank filters over a 3x3 window. The corner of the square has five black
    // and four white neighbours, so min, median and max all differ.
    println("median ", image.getPixel(image.medianFilter(base, 3), 1, 1));
    println("min ", image.getPixel(image.minFilter(base, 3), 1, 1));
    println("max ", image.getPixel(image.maxFilter(base, 3), 1, 1));
    // An even size is accepted and forced odd.
    println("median4 ", image.medianFilter(base, 4) > 0);

    // Enhancements on a saturated colour: `color` at 0 is the grey version and
    // at 2 extrapolates past the original.
    int vivid = vivid();
    println("color0 ", image.getPixel(image.color(vivid, 0.0), 0, 0));
    println("color2 ", image.getPixel(image.color(vivid, 2.0), 0, 0));
    println("sharpness ", image.getPixel(image.sharpness(vivid, 2.0), 0, 0));

    // Geometry: `fit` fills the box (centre-crop), `contain` letterboxes it.
    int fitted = image.fit(base, 2, 4);
    println("fit ", image.getWidth(fitted), "x", image.getHeight(fitted));
    int contained = image.contain(base, 4, 4, 255, 0, 255);
    println("contain ", image.getWidth(contained), "x", image.getHeight(contained));

    // The histogram operations on the ramp.
    int ramp = ramp();
    println("autoContrast ", image.getPixel(image.autoContrast(ramp), 3, 0));
    println("equalize ", image.getPixel(image.equalize(ramp), 0, 0));
    println("solarize ", image.getPixel(image.solarize(ramp, 150), 3, 0));
    println("posterize ", image.getPixel(image.posterize(ramp, 4), 3, 0));
    println("quantize ", image.getPixel(image.quantize(ramp, 2), 0, 0));

    // Channel split and merge.
    str bands = image.splitChannels(base);
    println("split ", returnLength(splitStr(bands, ",")) is 4);
    int merged = image.mergeChannels(base, base, base, -1);
    println("merge ", image.getPixel(merged, 1, 1), " ", image.getMode(merged));

    // Compositing: a white mask takes the overlay, a black mask keeps the base.
    int whiteMask = image.create(4, 4, "L", 255, 255, 255);
    int blackMask = image.create(4, 4, "L", 0, 0, 0);
    int overlay = image.create(4, 4, "RGB", 9, 8, 7);
    println("composite white ", image.getPixel(image.composite(base, overlay, whiteMask), 1, 1));
    println("composite black ", image.getPixel(image.composite(base, overlay, blackMask), 1, 1));

    // Drawing. Each primitive gets its own canvas so the asserted pixel is not
    // overwritten by a later call.
    int line = image.create(9, 9, "RGB", 255, 255, 255);
    println("drawLine ", image.drawLine(line, 0, 0, 8, 8, 0, 0, 0, 1), " ",
            image.getPixel(line, 4, 4), " ", image.getPixel(line, 4, 0));

    int filled = image.create(9, 9, "RGB", 255, 255, 255);
    println("drawRect filled ", image.drawRect(filled, 1, 1, 3, 3, 255, 0, 0, true), " ",
            image.getPixel(filled, 2, 2), " ", image.getPixel(filled, 5, 5));

    int outlined = image.create(9, 9, "RGB", 255, 255, 255);
    println("drawRect outline ", image.drawRect(outlined, 5, 5, 7, 7, 0, 0, 255, false), " ",
            image.getPixel(outlined, 5, 6), " ", image.getPixel(outlined, 6, 6));

    int circle = image.create(9, 9, "RGB", 255, 255, 255);
    println("drawCircle ", image.drawCircle(circle, 4, 4, 2, 0, 255, 0, true), " ",
            image.getPixel(circle, 4, 4), " ", image.getPixel(circle, 0, 0));

    int ellipse = image.create(9, 9, "RGB", 255, 255, 255);
    println("drawEllipse ", image.drawEllipse(ellipse, 0, 2, 8, 6, 0, 255, 255, true), " ",
            image.getPixel(ellipse, 4, 4), " ", image.getPixel(ellipse, 0, 4));

    int rounded = image.create(9, 9, "RGB", 255, 255, 255);
    println("drawRoundedRect ", image.drawRoundedRect(rounded, 0, 0, 8, 8, 0, 0, 0, false, 2), " ",
            image.getPixel(rounded, 4, 0), " ", image.getPixel(rounded, 0, 0));

    int polygons = image.create(8, 8, "RGB", 255, 255, 255);
    println("drawPolygon ", image.drawPolygon(polygons, "[1,1, 6,1, 3,6]", 10, 20, 30), " ",
            image.getPixel(polygons, 3, 2), " ", image.getPixel(polygons, 0, 0));

    int flooded = image.create(4, 4, "RGB", 200, 200, 200);
    println("floodFill ", image.floodFill(flooded, 0, 0, 7, 8, 9), " ",
            image.getPixel(flooded, 3, 3));

    // Text depends on a system font, so only the call shape is pinned; a font
    // path that does not exist is a plain failure.
    println("drawText ", returnType(image.drawText(rounded, 0, 0, "Hi", 0, 0, 0, 8)) is "bool");
    println("drawTextFont missing ",
            image.drawTextFont(rounded, 0, 0, "Hi", 0, 0, 0, 8, "/no/such/font.ttf"));

    // Invalid handles return the module sentinels.
    println("smooth invalid ", image.smooth(-1));
    println("fit invalid ", image.fit(-1, 2, 2));
    println("split invalid ", image.splitChannels(-1));
    println("merge invalid ", image.mergeChannels(-1, -1, -1, -1));
    println("drawRect invalid ", image.drawRect(-1, 0, 0, 1, 1, 0, 0, 0, true));
    println("floodFill invalid ", image.floodFill(-1, 0, 0, 0, 0, 0));
    println("show invalid ", image.show(-1));
}
