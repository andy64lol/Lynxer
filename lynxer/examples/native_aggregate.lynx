////
Nested aggregate round-trip through the versioned native value ABI.
////
fn setup(){
    importAs("native_signatures.so", "sigs");
}

struct Person {
    str name;
    list scores;
}

enum Outcome = [Ok(int code), Err(str message)]{}

fn main(){
    list input = [1, "two", 1.5, true, 'A', none, uint64 9000000000,
                  [3, false], (4, 5)];
    Person person = new Person("Ada", [6, 7]);
    println(sigs.typed(input));
    println(bytesToStr(sigs.typed(bytesOf("typed bytes"))));
    Person result = sigs.typed(person);
    println(result.name, " ", result.scores);
    any original = Outcome.Ok(200);
    any copied = sigs.typed(original);
    switch(copied){
        case(Outcome.Ok(code)){ println("enum ", code); }
        default(){ println("enum mismatch"); }
    }
}
