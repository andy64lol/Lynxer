////
Fixture for the Rust-backed image stdlib. It uses generated RGBA images so the
test is deterministic and does not need external image assets.
////
fn setup(){ import("image"); import("fileIO"); }

fn main(){
    int image = image.create(2, 2, "RGBA", 10, 20, 30);
    println(image >= 0);
    println(image.getWidth(image), "x", image.getHeight(image));
    println(image.getMode(image));
    println(image.getPixel(image, 0, 0));

    println(image.setPixel(image, 1, 1, 40, 50, 60));
    println(image.getPixel(image, 1, 1));
    println(image.setPixelA(image, 0, 1, 70, 80, 90, 128));
    println(image.getPixel(image, 0, 1));
    println(image.fill(image, 1, 2, 3));
    println(image.getPixel(image, 0, 0));

    int padded = image.pad(image, 1, 2, 3, 4, 5, 6, 7);
    println(image.getWidth(padded), "x", image.getHeight(padded));
    println(image.getPixel(padded, 0, 0));

    int resized = image.resize(image, 4, 3);
    println(image.getWidth(resized), "x", image.getHeight(resized));
    int gray = image.grayscale(image);
    println(image.getMode(gray));
    int blended = image.blend(image, padded, 0.5);
    println(image.getWidth(blended), "x", image.getHeight(blended));

    str encoded = image.toBase64(image, "png");
    println(returnLength(encoded) > 0);
    println(image.toDataUrl(image, "png") isnt "");
    int decoded = image.fromBase64(encoded);
    println(image.getWidth(decoded), "x", image.getHeight(decoded));
    println(image.getFormat(decoded));
    println(image.info(decoded));

    println(image.close(image));
    println(image.close(padded));
    println(image.close(resized));
    println(image.close(gray));
    println(image.close(blended));
    println(image.close(decoded));

    // Failure paths return a sentinel rather than raising: a missing file, a
    // file that is not an image, malformed base64, and invalid handles. Scratch
    // names under the cwd, so the fixture works from any directory.
    str notAnImage = ".lynxer_scratch_not_an_image.txt";
    fileIO.writeFile(notAnImage, "this is text, not an image\n");
    println(image.open(".lynxer_scratch_missing.png"));
    println(image.open(notAnImage));
    println(image.fromBase64("not base64 !!"));
    println(image.getWidth(-1));
    println(image.getMode(-1));
    println(image.info(-1));
    println(image.copy(-1));
    println(image.close(-1));
    println(image.save(-1, ".lynxer_scratch_unused.png"));
    println(image.resize(-1, 2, 2));
    println(fileIO.deleteFile(notAnImage));
}