////
Static-analysis fixture. `--lint` must report the unused variable, the
incompatible initializer, the lossy float-to-int conversion and the statement
after `return` without executing the program.
////
fn setup(){}

fn main(){
    int unused = 4;
    int count = "many";
    int rounded = 3.5;
    println(count, rounded);
    return;
    println("unreachable");
}
