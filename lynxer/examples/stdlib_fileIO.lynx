////
Fixture for the fileIO stdlib. Interpreted only (module imports are not
bytecode-compilable). Uses a repo-local scratch file and removes it afterwards.
////
global setup(){ import("fileIO"); import("os"); }

global main(){
    str path = ".clynxer_scratch_fileio.txt";
    println(global.fileIO.writeFile(path, "line1\nline2\nline3\n"));
    println(global.fileIO.fileExists(path));
    println(global.fileIO.readFile(path));
    println(global.fileIO.readLines(path));
    println(global.fileIO.countLines(path));
    println(global.fileIO.readLine(path, 1));
    println(global.fileIO.readLine(path, 99));
    println(global.fileIO.fileSize(path));
    println(global.fileIO.fileExtension(path));
    println(global.fileIO.stemName(path));
    println(global.fileIO.fileIsEmpty(path));
    println(global.fileIO.appendFile(path, "line4\n"));
    println(global.fileIO.countLines(path));
    println(global.fileIO.readFileLines(path, "|"));
    println(global.fileIO.copyFile(path, path + ".bak"));
    println(global.fileIO.fileExists(path + ".bak"));
    println(global.fileIO.moveFile(path + ".bak", path + ".mov"));
    println(global.fileIO.fileExists(path + ".bak"));
    println(global.fileIO.fileExists(path + ".mov"));
    println(global.fileIO.deleteFile(path + ".mov"));
    println(global.fileIO.fileExists(path + ".mov"));
    println(global.fileIO.deleteFile(path));
    println(global.fileIO.readFile(path) is "");
    println(returnLength(global.fileIO.readLines(path)));
    println(global.fileIO.fileModTime(path) is "");
    println(global.fileIO.countLines(path));

    str temp = global.fileIO.tempFile(".tmp");
    println(returnLength(temp) > 0);
    println(global.fileIO.writeFile(temp, "x"));
    println(global.fileIO.fileSize(temp));
    println(global.fileIO.deleteFile(temp));

    str directory = global.fileIO.tempDir();
    println(returnLength(directory) > 0);
    println(global.os.rmdir(directory));
}
