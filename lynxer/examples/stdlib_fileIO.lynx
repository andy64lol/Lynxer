////
Fixture for the fileIO stdlib. Interpreted only (module imports are not
bytecode-compilable). Uses a repo-local scratch file and removes it afterwards.
////
fn setup(){ import("fileIO"); import("os"); }

fn main(){
    str path = ".lynxer_scratch_fileio.txt";
    println(fileIO.writeFile(path, "line1\nline2\nline3\n"));
    println(fileIO.fileExists(path));
    println(fileIO.readFile(path));
    println(fileIO.readLines(path));
    println(fileIO.countLines(path));
    println(fileIO.readLine(path, 1));
    println(fileIO.readLine(path, 99));
    println(fileIO.fileSize(path));
    println(fileIO.fileExtension(path));
    println(fileIO.stemName(path));
    println(fileIO.fileIsEmpty(path));
    println(fileIO.appendFile(path, "line4\n"));
    println(fileIO.countLines(path));
    println(fileIO.readFileLines(path, "|"));
    println(fileIO.copyFile(path, path + ".bak"));
    println(fileIO.fileExists(path + ".bak"));
    println(fileIO.moveFile(path + ".bak", path + ".mov"));
    println(fileIO.fileExists(path + ".bak"));
    println(fileIO.fileExists(path + ".mov"));
    println(fileIO.deleteFile(path + ".mov"));
    println(fileIO.fileExists(path + ".mov"));
    println(fileIO.deleteFile(path));
    println(fileIO.readFile(path) is "");
    println(returnLength(fileIO.readLines(path)));
    println(fileIO.fileModTime(path) is "");
    println(fileIO.countLines(path));

    str temp = fileIO.tempFile(".tmp");
    println(returnLength(temp) > 0);
    println(fileIO.writeFile(temp, "x"));
    println(fileIO.fileSize(temp));
    println(fileIO.deleteFile(temp));

    str directory = fileIO.tempDir();
    println(returnLength(directory) > 0);
    println(os.rmdir(directory));
}
