////
First-class function values: top-level functions, nested functions, named
lambdas, higher-order parameters and return values. Closures keep their captured variables and
each returned closure owns an independent copy of them.
////
fn setup(){}

fn addOne(int value) -> int {
    return value + 1;
}

fn apply(function operation, int value) -> int {
    return operation(value);
}

fn applyTwice(function operation, int value) -> int {
    return operation(operation(value));
}

fn makeAdder(int base) -> function {
    fn add(int value) -> int {
        return base + value;
    }
    return add;
}

fn makeCounter() -> function {
    int count = 0;
    fn next() -> int {
        count = count + 1;
        return count;
    }
    return next;
}

fn main(){
    function increment = addOne;
    println(increment(4));
    println(apply(increment, 4));

    function addTen = makeAdder(10);
    println(addTen(3));
    println(applyTwice(addTen, 3));

    function counter = makeCounter();
    println(counter());
    println(counter());
    function otherCounter = makeCounter();
    println(otherCounter());

    lambda doubleIt(int value) -> int {
        return value * 2;
    }
    function doubler = doubleIt;
    println(doubler(6));
    println(apply(doubleIt, 5));
}
