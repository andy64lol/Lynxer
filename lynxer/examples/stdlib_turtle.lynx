////
Turtle fixture: the classic API over `graphics`, run headless so the drawn
lines can be read back from the framebuffer. The turtle's position, heading and
pen state are asserted directly.
////
fn setup(){ import("turtle"); import("graphics"); import("image"); import("fileIO"); }

fn main(){
    graphics.init("turtle", 32, 32);
    graphics.clearBackground(0, 0, 0);

    // Forward draws along y = 0 with the pen down.
    turtle.setColor(255, 0, 0);
    println(turtle.forward(10.0));
    println(turtle.x(), ",", turtle.y(), ",", turtle.heading());

    // A clockwise turn then another step draws a vertical segment.
    turtle.turn(90.0);
    println(turtle.forward(10.0));
    println(turtle.x(), ",", turtle.y(), ",", turtle.heading());

    // With the pen up, moving does not draw.
    println(turtle.penUp());
    println(turtle.penIsDown());
    turtle.forward(5.0);
    println(turtle.x(), ",", turtle.y());

    // `goto` with the pen down draws; `home` returns to the origin, facing east.
    turtle.penDown();
    turtle.goto(2.0, 2.0);
    turtle.home();
    println(turtle.x(), ",", turtle.y(), ",", turtle.heading());

    println(graphics.screenshot("/tmp/lynxer_turtle.png"));
    int shot = image.open("/tmp/lynxer_turtle.png");
    println(image.getPixel(shot, 5, 0));
    println(image.getPixel(shot, 10, 5));
    println(image.getPixel(shot, 12, 0));

    fileIO.deleteFile("/tmp/lynxer_turtle.png");
}
