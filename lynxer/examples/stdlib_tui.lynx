////
Real-backend `tui` fixture. Rendering is offscreen ratatui: with stdout not a
TTY (as here) every widget becomes plain text, so the output is deterministic.
The width is pinned and soft wrap disabled so the box-drawing is stable.

`enter()`/`exit()` are deliberately not exercised: they put the controlling
terminal into raw mode, which a fixture must not do. The prompts at the end read
the piped stdin the Makefile supplies, and the last two fall back to defaults.
////
fn setup(){ import("tui"); import("fileIO"); }

fn main(){
    tui.setWidth(40);
    tui.setSoftWrap(false);
    tui.init("none");

    // Existence, version, markup escape and style validation.
    println(tui.tuiExists());
    println(tui.tuiVersion());
    println(tui.markupEscape("[bold]hi[/bold]"));
    println(tui.styleValid("bold green"));
    println(tui.styleValid("not-a-style"));

    // Rendering.
    tui.printText("[bold]bold[/bold] plain");
    tui.printStyled("styled", "bold green");
    tui.rule("Section");
    tui.panel("body", "Title");
    tui.markdown("# Heading\n\nSome **bold**, *italic* and `code`.\n\n- one\n- two\n\n1. first\n2. second\n\n```python\nprint(1)\n```\n\n> quoted");
    tui.printSyntax("fn main() {\n    // hi\n    println!(\"x\");\n}", "rust", true);
    tui.jsonPretty("{\"a\": 1}");
    tui.table("T", "[\"a\",\"b\"]", "[[1,2],[3,4]]");
    tui.printTextPlain("raw");
    tui.printPretty("[1, 2]");
    tui.printColumns("[\"a\",\"bb\",\"ccc\"]", true, false);
    tui.printAligned("mid", "right", true);
    tui.printPadded("pad", 1, 2, 1, 2);
    try { raise("fixture exception"); } catch(str error) {
        tui.printException();
    }
    tui.installTraceback(true);
    // The clear sequence has no trailing newline, so it joins the next value.
    tui.clear();

    // Console configuration.
    println(tui.setWidth(40));
    tui.setMarkup(false);
    tui.setEmoji(false);
    tui.setHighlight(false);
    tui.setSoftWrap(false);
    tui.consoleLog("logged");
    println(tui.consoleSaveText(".lynxer_scratch_tui.txt"));
    println(tui.consoleSaveHtml(".lynxer_scratch_tui.html"));

    // Stateful table: real state behind handle 0.
    println(tui.tableCreate("t"));
    tui.tableAddColumn(0, "name", "bold");
    tui.tableAddColumn(0, "n", "");
    tui.tableAddRow(0, "[\"a\", 1]");
    tui.tableAddRow(0, "[\"b\", 2]");
    tui.tableSetCaption(0, "caption");
    tui.tableSetHeader(0, true);
    tui.tableSetLines(0, false);
    tui.tableSetBox(0, "square");
    tui.tableSetExpand(0, false);
    tui.tablePrint(0);

    // `tableSetLines` draws real inner rules: one under the header and one
    // between rows, with `┼` where a rule crosses a column boundary.
    tui.tableSetLines(0, true);
    tui.tablePrint(0);
    tui.tableSetBox(0, "none");
    tui.tablePrint(0);
    tui.tableSetBox(0, "square");
    tui.tableSetLines(0, false);

    // Tree: nested nodes behind handles.
    println(tui.treeCreate("root"));
    println(tui.treeAdd(0, "child"));
    tui.treeAdd(0, "sibling");
    tui.treePrint(0);

    // Layout: a split with a plain section and a bordered panel.
    println(tui.layoutCreate("l"));
    tui.layoutSplitRows(0, "[\"top\",\"bottom\"]");
    tui.layoutUpdate(0, "top", "top text");
    tui.layoutPanel(0, "bottom", "body", "box");
    tui.layoutPrint(0);

    // Progress and live displays redraw in place on terminals; tests capture
    // deterministic snapshots because their output is redirected.
    println(tui.progressStart());
    println(tui.progressAddTask(0, "task", 10.0));
    tui.progressAdvance(0, 0, 5.0);
    tui.progressStop(0);
    println(tui.statusStart("s"));
    tui.statusUpdate(0, "working");
    tui.statusStop(0);
    println(tui.liveStart("live", 4.0));
    tui.liveUpdate(0, "text");
    tui.livePanel(0, "text", "title");
    tui.liveStop(0);

    // Extended widgets.
    tui.list("[\"alpha\",\"beta\"]", "List", false);
    tui.list("[\"alpha\",\"beta\"]", "Numbered", true);
    tui.tabs("[\"one\",\"two\",\"three\"]", 1);
    tui.barChart("Bars", "[3,7,5,9]", 24, 8);
    tui.sparkline("[1,2,3,4,5,4,3,2]");
    tui.calendar(2026, 7);
    tui.jsonTree("{\"a\":1,\"b\":[2,3],\"c\":{\"d\":true}}");
    tui.gauge("done", 0.5, 24);
    tui.lineGauge("half", 0.5, 24);
    tui.tableFromCsv("CSV", "name,n\nalpha,1\nbeta,2\n");

    // Terminal queries and control (control is inert without a TTY).
    println(tui.terminalWidth());
    println(tui.terminalHeight());
    tui.setCursor(1, 1);
    tui.moveCursor(1, -1);
    tui.hideCursor();
    tui.showCursor();
    tui.bell();
    println(tui.pollInput(0));
    println(tui.input(0));

    // Themes: the default is switchable, unknown names are rejected.
    println(tui.theme("base16-ocean.dark"));
    println(tui.theme("definitely-not-a-theme"));
    println(tui.themeName());
    println(charAt(tui.themeNames(), 0));

    // Full-screen display prints a snapshot per update.
    tui.screenStart("first screen");
    tui.screenUpdate("second screen");
    tui.screenStop();

    // SVG capture and image rendering (placeholder without a color terminal).
    println(tui.consoleSaveSvg(".lynxer_scratch_tui.svg"));
    tui.image(".lynxer_scratch_tui_missing.png", 8, 4);

    // Prompts read the piped stdin supplied by the Makefile.
    println(tui.ask("name> "));
    println(tui.askPassword("pw> "));
    println(tui.askInt("n> "));
    println(tui.askFloat("f> "));
    println(tui.askDefault("d> ", "fallback"));
    println(tui.confirm("ok? "));
    println(tui.confirmDefault("ok? ", true));
    println(tui.select("pick> ", "[\"a\",\"bb\",\"ccc\"]"));
    println(tui.multiselect("many> ", "[\"x\",\"y\",\"z\"]"));
    println(tui.menu("menu> ", "[\"alpha\",\"beta\",\"gamma\"]"));
    println(tui.editor("edit> ", "fallback"));

    fileIO.deleteFile(".lynxer_scratch_tui.txt");
    fileIO.deleteFile(".lynxer_scratch_tui.html");
    fileIO.deleteFile(".lynxer_scratch_tui.svg");
}
