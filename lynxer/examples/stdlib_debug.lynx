////
Fixture for the debug stdlib. Interpreted only (module imports are not
bytecode-compilable). Logging helpers are omitted because they embed wall-clock
timestamps.
////
fn setup(){ import("debug"); import("os"); }

fn main(){
    // The native clock hooks make logger/timer assertions independent of wall
    // time and scheduler timing.
    os.setenv("LYNXER_DEBUG_TEST_EPOCH", "946782245");
    os.setenv("LYNXER_DEBUG_TEST_CLOCK_MS", "10");
    debug.log("trace", "clocked");
    debug.info("ready");
    debug.warn("careful");
    debug.error("failed");
    debug.debug("detail");
    debug.startTimer("fixed");
    os.setenv("LYNXER_DEBUG_TEST_CLOCK_MS", "16");
    println(debug.elapsed("fixed"));
    println(debug.stopTimer("fixed"));

    println(debug.typeOf(42));
    println(debug.typeOf(3.5));
    println(debug.typeOf("text"));
    println(debug.typeOf(true));
    println(debug.typeOf(none));
    println(debug.typeOf(seqFromTo(1, 3, 1)));
    println(debug.inspect(42));
    println(debug.inspect("text"));
    debug.dump(7);
    debug.pp(seqFromTo(1, 4, 1));

    debug.assert(true, "should pass");
    debug.assertEq("a", "a", "equal");
    debug.assertNotEq("a", "b", "different");
    debug.assertGt(2.0, 1.0, "greater");
    debug.assertLt(1.0, 2.0, "lesser");
    debug.assertContains("hello world", "lo wo", "contains");
    println("assertions ok");

    println(debug.stopTimer("missing"));
    println(debug.elapsed("missing"));
    println(debug.clock() > 0.0);
    debug.startTimer("t");
    println(debug.stopTimer("t") >= 0.0);
    println(debug.elapsed("t"));

    println(debug.envGet("LYNXER_DEBUG_TEST") is "");
    println(debug.envAll() isnt "");
    println(debug.getMemory() > 0.0);
}
