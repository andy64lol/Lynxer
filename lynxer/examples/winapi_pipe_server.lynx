////
Server half of winapi_pipe.lynx. Launched by the parent; not a standalone
fixture.
////
global setup(){
    import("os");
    str arch = "amd64";
    if(global.os.getSystemMachine() is "aarch64"){ arch = "arm64"; }
    syscalls("winAPI", arch);
}

global main(){
    str name = "lynxer-winapi-fixture-pipe";
    int server = winAPI.createNamedPipe(name);
    println("server-create=" + strOf(server > 0));
    println("server-connect=" + strOf(winAPI.connectNamedPipe(server)));
    println("server-read=" + winAPI.readNamedPipe(server, 16));
    println("server-write=" + strOf(winAPI.writeNamedPipe(server, "pong") is 4));
    winAPI.disconnectNamedPipe(server);
    winAPI.closeHandle(server);
}
