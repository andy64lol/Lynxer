////
Fixture for the watch stdlib. The handle and the absolute event paths are not
pinned — only shapes, predicates and the JSON prefix are, so the output is
deterministic. Part of the import-parity gate.
////
fn setup(){ import("watch"); import("fileIO"); import("os"); }

fn main(){
    str root = ".lynxer_scratch_watch";
    if(os.exists(root)){ os.rmTree(root); }
    os.mkdir(root);

    int handle = watch.watchAdd(root, false);
    println(handle > 0);
    println(watch.watchFd(handle) >= 0);
    println(watch.watchSetDebounce(handle, 0));

    // Create a file inside the watched directory. `watchWait` blocks (with the
    // interpreter lock released) until the descriptor is readable.
    fileIO.writeFile(root + "/a.txt", "hi");
    println(watch.watchWait(handle, 2000));

    // The event paths carry the absolute watched directory, so only the shape
    // is asserted.
    str events = watch.watchDrain(handle);
    println(substring(events, 0, 1) is "[");
    println(returnLength(events) > 2);

    // Nothing left to read, so a zero timeout reports the timeout.
    println(watch.watchWait(handle, 0));
    println(watch.watchWait(9999, 0));

    println(watch.watchRemove(handle));
    println(watch.watchFd(handle));
    println(watch.watchDrain(9999) is "");
    println(watch.watchRemove(9999));
    println(watch.watchAdd(root + "/missing", false));

    os.rmTree(root);
}
