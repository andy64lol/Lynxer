////
Fixture for the managed `networking*` built-ins. Servers bind to an ephemeral
port and the fixture asks the kernel for it, so no fixed port can collide with
another run or another service. The only file it creates is a Unix socket under
the working directory, which it removes again.
////
global setup(){ import("json"); import("fileIO"); }

// Reads the port out of an address document like ["127.0.0.1",41234].
global portOf(str address){
    str tail = listGet(splitStr(address, ","), 1);
    return intOf(listGet(splitStr(tail, "]"), 0));
}

global main(){
    int server = networkingOpen("tcp");
    println(networkingOption(server, "reuseAddr", 1));
    println(networkingBind(server, "127.0.0.1", 0));
    println(networkingListen(server, 4));
    int port = global.portOf(networkingAddress(server));
    println(port > 0);

    int client = networkingOpen("tcp");
    println(networkingConnect(client, "127.0.0.1", port));
    int accepted = networkingAccept(server);
    println(accepted > 0);

    println(networkingSend(client, "ping"));
    println(networkingReceive(accepted, 64));
    println(networkingSend(accepted, "pong"));
    println(networkingReceive(client, 64));

    println(networkingShutdown(client, "write"));
    println(networkingBlocking(client, false));
    println(networkingBlocking(client, true));
    println(networkingClose(client));
    println(networkingClose(accepted));
    println(networkingClose(server));

    int udpServer = networkingOpen("udp");
    println(networkingBind(udpServer, "127.0.0.1", 0));
    int udpPort = global.portOf(networkingAddress(udpServer));
    int udpClient = networkingOpen("udp");
    println(networkingConnect(udpClient, "127.0.0.1", udpPort));
    println(networkingSend(udpClient, "datagram"));
    println(networkingReceive(udpServer, 64));
    println(networkingClose(udpClient));
    println(networkingClose(udpServer));

    str path = ".lynxer_scratch_net.sock";
    global.fileIO.deleteFile(path);
    int unixServer = networkingOpen("unix");
    println(networkingBind(unixServer, path));
    println(networkingListen(unixServer, 1));
    println(networkingAddress(unixServer));
    int unixClient = networkingOpen("unix");
    println(networkingConnect(unixClient, path));
    int unixAccepted = networkingAccept(unixServer);
    println(networkingSend(unixClient, "local"));
    println(networkingReceive(unixAccepted, 64));
    println(networkingClose(unixAccepted));
    println(networkingClose(unixClient));
    println(networkingClose(unixServer));
    println(filesystemRemove(path));

    println(networkingResolve("127.0.0.1", 80));

    try { networkingOpen("sctp"); } catch(str e) { println("kind: ", e); }
    try { networkingBind(9999, "127.0.0.1", 0); } catch(str e) { println("handle: ", e); }
    try { networkingOption(9999, "reuseAddr", 1); } catch(str e) { println("opt-handle: ", e); }
    try { networkingShutdown(9999, "read"); } catch(str e) { println("shutdown: ", e); }
    int sock = networkingOpen("tcp");
    try { networkingOption(sock, "nope", 1); } catch(str e) { println("opt: ", e); }
    try { networkingShutdown(sock, "nope"); } catch(str e) { println("how: ", e); }
    try { networkingBind(sock); } catch(str e) { println("bind-args: ", e); }
    try { networkingReceive(sock, -1); } catch(str e) { println("recv: ", e); }
    println(networkingClose(sock));
    try { networkingClose(sock); } catch(str e) { println("reclose: ", e); }

    int lonely = networkingOpen("udp");
    try { networkingSend(lonely, "x"); } catch(str e) { println("udp-send: ", e); }
    println(networkingClose(lonely));

    int refused = networkingOpen("tcp");
    int closing = networkingOpen("tcp");
    println(networkingBind(closing, "127.0.0.1", 0));
    int closedPort = global.portOf(networkingAddress(closing));
    println(networkingClose(closing));
    try { networkingConnect(refused, "127.0.0.1", closedPort); } catch(str e) { println("refused: ", e); }
    println(networkingClose(refused));
}
