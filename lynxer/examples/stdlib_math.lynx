////
Fixture for the math stdlib, including the statistics and vector helpers that
used to live in a separate `mathPlus` module. Interpreted only (module imports
are not bytecode-compilable).
////
fn setup(){ import("math"); }

fn main(){
    println(math.abs(-5));
    println(math.absFloat(-2.5));
    println(math.max(3, 9));
    println(math.min(3, 9));
    println(math.clamp(11, 0, 10));
    println(math.pow(2, 10));
    println(math.sqrt(16.0));
    println(math.sign(-4));
    println(math.isEven(8));
    println(math.isOdd(8));
    println(math.factorial(5));
    println(math.gcd(12, 18));
    println(math.lcm(4, 6));
    println(math.isPrime(97));
    println(math.nextPrime(100));
    println(math.binomial(5, 2));
    println(math.sumRange(1, 4));
    println(math.isqrt(50));
    println(math.floor(2.7));
    println(math.ceil(2.1));
    println(math.round(2.5));
    println(math.truncate(-2.7));
    println(math.roundTo(3.14159, 2));
    println(math.fmod(7.5, 2.0));
    println(math.pi());
    println(math.tau());
    println(math.gcd(0, 0));
    println(math.maxInt() > 0);
    println(math.minInt() < 0);

    // List helpers.
    println(math.mean(seqFromTo(1, 5, 1)));
    println(math.prod(seqFromTo(1, 4, 1)));
    println(math.norm(seqFromTo(3, 5, 1)));
    println(math.argmax(seqFromTo(1, 5, 1)));
    println(math.argmin(seqFromTo(5, 1, -1)));
    println(math.median(seqFromTo(1, 5, 1)));
    println(math.median(seqFromTo(1, 4, 1)));
    println(math.std(seqFromTo(1, 5, 1)));
    println(math.variance(seqFromTo(1, 5, 1)));
    println(math.percentile(seqFromTo(1, 5, 1), 50.0));
    println(math.dot(seqFromTo(1, 3, 1), seqFromTo(4, 6, 1)));
    println(math.corrcoef(seqFromTo(1, 3, 1), seqFromTo(2, 6, 2)));
    println(math.linspace(0.0, 1.0, 5));
    println(math.cumsum(seqFromTo(1, 4, 1)));
    println(math.diff(seqFromTo(1, 4, 1)));
    println(math.clip(seqFromTo(1, 5, 1), 2.0, 4.0));

    list pair = listPush(listPush(listRepeat(0, 0), 3), 4);
    println(math.normalize(pair));
    println(math.dot(pair, pair));
    println(math.median(pair));
    println(math.percentile(pair, 25.0));

    list empty = listRepeat(0, 0);
    println(math.median(empty));
    println(math.median(empty) is 0.0);
    println(math.linspace(0.0, 1.0, 0));
}
