////
Fixture for the per-user configuration, data and cache roots. Portable: the
paths differ per host, so only shape and distinctness are asserted.
////
fn setup(){ import("os"); }

fn main(){
    println(returnLength(os.configDir()) > 0);
    println(returnLength(os.dataDir()) > 0);
    println(returnLength(os.cacheDir()) > 0);
    println(os.configDir() isnt os.dataDir());
}
