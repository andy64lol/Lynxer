////
Fixture for the js stdlib. Interpreted only (module imports are not
bytecode-compilable). Requires Node.js on PATH; the version string itself is not
asserted because it varies by host.
////
fn setup(){ import("js"); import("os"); }

fn main(){
    println(js.nodeExists());
    println(returnLength(js.nodeVersion()) > 0);
    println(js.evalJS("1 + 2"));
    println(js.evalJS("'a' + 'b'"));
    println(js.runJS("console.log('hello from js');"));
    // A runaway program is killed after the timeout, and a program's stderr is
    // captured into the result instead of leaking. The env var shortens the
    // limit for the test.
    os.setenv("LYNXER_JS_TIMEOUT","1");
    println(js.runJS("while(true){}"));
    println(js.runJS("console.error('boom')"));
    println(js.runJS("process.exit(7)"));
    str path = os.getenv("PATH");
    os.setenv("PATH", "");
    println(js.runJS("console.log('unreachable')"));
    os.setenv("PATH", path);
}
