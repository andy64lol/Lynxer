////
Fixture for the extended named-syscall surface.

The names added on top of the original set are exercised so a missing table
entry fails loudly. Every syscall here either succeeds with a deterministic
predicate or fails with a source-located error whose message starts with
`syscall '`; a name that was not wired up would instead fail with
`unknown function`, which `recognized` rejects. The output is identical on
amd64 and aarch64.

The `__ARCH__` token is replaced with the host's syscall architecture (`amd64`
or `arm64`) before the fixture runs, so one source serves both targets.
////
fn setup(){
    importAs("linux-__ARCH__", "linuxSyscalls");
}

fn recognized(str message) -> bool {
    return substring(message, 0, 9) is "syscall '";
}

fn main(){
    // A real dispatch: `times(NULL)` returns clock ticks since boot.
    println("system times ", linuxSyscalls.syscallGetSystemTimes(0) >= 0);

    // A real dispatch that allocates a descriptor: `eventfd2(0, 0)`.
    int event = linuxSyscalls.syscallCreateEventFileDescriptor(0, 0);
    println("event descriptor ", event > 0);
    println("event closed ", linuxSyscalls.syscallClose(event) is 0);

    // Each of these is rejected by the kernel with a pointer/argument error,
    // so they prove the name is wired to the right per-architecture number.
    try { linuxSyscalls.syscallOpenAt2(0, 0, 0, 0); println("openat2 NO ERROR"); } catch(str e) { println("openat2 ", recognized(e)); }
    try { linuxSyscalls.syscallCopyFileRange(-1, 0, -1, 0, 1, 0); println("copyFileRange NO ERROR"); } catch(str e) { println("copyFileRange ", recognized(e)); }
    try { linuxSyscalls.syscallSynchronizeFilesystem(-1); println("syncfs NO ERROR"); } catch(str e) { println("syncfs ", recognized(e)); }
    try { linuxSyscalls.syscallCreateThread3(0, 0); println("clone3 NO ERROR"); } catch(str e) { println("clone3 ", recognized(e)); }
    try { linuxSyscalls.syscallOpenProcessFileDescriptor(0, 0); println("pidfdOpen NO ERROR"); } catch(str e) { println("pidfdOpen ", recognized(e)); }
    try { linuxSyscalls.syscallWaitForProcessId(0, 0, 0, 0, 0); println("waitid NO ERROR"); } catch(str e) { println("waitid ", recognized(e)); }
    try { linuxSyscalls.syscallLockMemory(0, 1); println("mlock NO ERROR"); } catch(str e) { println("mlock ", recognized(e)); }
    try { linuxSyscalls.syscallCreateMemoryFileDescriptor(0, 0); println("memfdCreate NO ERROR"); } catch(str e) { println("memfdCreate ", recognized(e)); }
    try { linuxSyscalls.syscallGetTimeOfDay(-1, 0); println("gettimeofday NO ERROR"); } catch(str e) { println("gettimeofday ", recognized(e)); }
    try { linuxSyscalls.syscallSleepClock(0, 0, 0, 0); println("clockNanosleep NO ERROR"); } catch(str e) { println("clockNanosleep ", recognized(e)); }
    try { linuxSyscalls.syscallCreateTimerFileDescriptor(-1, 0); println("timerfdCreate NO ERROR"); } catch(str e) { println("timerfdCreate ", recognized(e)); }
    try { linuxSyscalls.syscallControlSignalMask(0, 0, 0, 0); println("sigprocmask NO ERROR"); } catch(str e) { println("sigprocmask ", recognized(e)); }
    try { linuxSyscalls.syscallCreateSignalFileDescriptor(0, 0, 0, 9999); println("signalfd NO ERROR"); } catch(str e) { println("signalfd ", recognized(e)); }
    try { linuxSyscalls.syscallSendMessages(0, 0, 0, 0); println("sendmmsg NO ERROR"); } catch(str e) { println("sendmmsg ", recognized(e)); }
    try { linuxSyscalls.syscallAcceptConnection4(0, 0, 0, 0); println("accept4 NO ERROR"); } catch(str e) { println("accept4 ", recognized(e)); }
    try { linuxSyscalls.syscallWaitForEvents2(0, 0, 0, 0, 0, 0); println("epollPwait2 NO ERROR"); } catch(str e) { println("epollPwait2 ", recognized(e)); }
    try { linuxSyscalls.syscallCreateEventFileDescriptor(0, 9999); println("eventfd bad flags NO ERROR"); } catch(str e) { println("eventfd bad flags ", recognized(e)); }
    try { linuxSyscalls.syscallGetCapabilities(0, 0); println("capget NO ERROR"); } catch(str e) { println("capget ", recognized(e)); }

    // Sandboxing entry points. seccomp is probed with an invalid operation:
    // operation 0 installs SECCOMP_MODE_STRICT, which would kill this process.
    try { linuxSyscalls.syscallCreateLandlockRuleset(0, 0, 0); println("landlockCreate NO ERROR"); } catch(str e) { println("landlockCreate ", recognized(e)); }
    try { linuxSyscalls.syscallAddLandlockRule(-1, 0, 0, 0); println("landlockAddRule NO ERROR"); } catch(str e) { println("landlockAddRule ", recognized(e)); }
    try { linuxSyscalls.syscallRestrictLandlockSelf(-1, 0); println("landlockRestrict NO ERROR"); } catch(str e) { println("landlockRestrict ", recognized(e)); }
    try { linuxSyscalls.syscallControlSeccomp(9999, 0, 0); println("seccomp NO ERROR"); } catch(str e) { println("seccomp ", recognized(e)); }

    // The six-argument ceiling still applies to the new names.
    try {
        linuxSyscalls.syscallGetSystemTimes(0, 0, 0, 0, 0, 0, 0);
        println("too many arguments NO ERROR");
    } catch(str e) {
        println("argument ceiling ",
                contains(splitStr(e, " "), "six") or
                contains(splitStr(e, " "), "6"));
    }
}
