////
Fixture for the extended named-syscall surface.

The names added on top of the original set are exercised so a missing table
entry fails loudly. Every syscall here either succeeds with a deterministic
predicate or fails with a source-located error whose message starts with
`syscall '`; a name that was not wired up would instead fail with
`unknown function`, which `recognized` rejects. The output is identical on
amd64 and aarch64.

The `__ARCH__` token is replaced with the host's syscall architecture (`amd64`
or `arm64`) before the fixture runs, so one source serves both targets.
////
global setup(){ syscalls("__OS__", "__ARCH__"); }

global recognized(str message) -> bool {
    return substring(message, 0, 9) is "syscall '";
}

global main(){
    // A real dispatch: `times(NULL)` returns clock ticks since boot.
    println("system times ", __ARCH__.syscallGetSystemTimes(0) >= 0);

    // A real dispatch that allocates a descriptor: `eventfd2(0, 0)`.
    int event = __ARCH__.syscallCreateEventFileDescriptor(0, 0);
    println("event descriptor ", event > 0);
    println("event closed ", __ARCH__.syscallClose(event) is 0);

    // Each of these is rejected by the kernel with a pointer/argument error,
    // so they prove the name is wired to the right per-architecture number.
    try { __ARCH__.syscallOpenAt2(0, 0, 0, 0); println("openat2 NO ERROR"); } catch(str e) { println("openat2 ", global.recognized(e)); }
    try { __ARCH__.syscallCopyFileRange(-1, 0, -1, 0, 1); println("copyFileRange NO ERROR"); } catch(str e) { println("copyFileRange ", global.recognized(e)); }
    try { __ARCH__.syscallSynchronizeFilesystem(-1); println("syncfs NO ERROR"); } catch(str e) { println("syncfs ", global.recognized(e)); }
    try { __ARCH__.syscallCreateThread3(0, 0); println("clone3 NO ERROR"); } catch(str e) { println("clone3 ", global.recognized(e)); }
    try { __ARCH__.syscallOpenProcessFileDescriptor(0, 0); println("pidfdOpen NO ERROR"); } catch(str e) { println("pidfdOpen ", global.recognized(e)); }
    try { __ARCH__.syscallWaitForProcessId(0, 0, 0, 0, 0); println("waitid NO ERROR"); } catch(str e) { println("waitid ", global.recognized(e)); }
    try { __ARCH__.syscallLockMemory(0, 1); println("mlock NO ERROR"); } catch(str e) { println("mlock ", global.recognized(e)); }
    try { __ARCH__.syscallCreateMemoryFileDescriptor(0, 0); println("memfdCreate NO ERROR"); } catch(str e) { println("memfdCreate ", global.recognized(e)); }
    try { __ARCH__.syscallGetTimeOfDay(-1, 0); println("gettimeofday NO ERROR"); } catch(str e) { println("gettimeofday ", global.recognized(e)); }
    try { __ARCH__.syscallSleepClock(0, 0, 0, 0); println("clockNanosleep NO ERROR"); } catch(str e) { println("clockNanosleep ", global.recognized(e)); }
    try { __ARCH__.syscallCreateTimerFileDescriptor(-1, 0); println("timerfdCreate NO ERROR"); } catch(str e) { println("timerfdCreate ", global.recognized(e)); }
    try { __ARCH__.syscallControlSignalMask(0, 0, 0, 0); println("sigprocmask NO ERROR"); } catch(str e) { println("sigprocmask ", global.recognized(e)); }
    try { __ARCH__.syscallCreateSignalFileDescriptor(0, 0, 0); println("signalfd NO ERROR"); } catch(str e) { println("signalfd ", global.recognized(e)); }
    try { __ARCH__.syscallSendMessages(0, 0, 0, 0); println("sendmmsg NO ERROR"); } catch(str e) { println("sendmmsg ", global.recognized(e)); }
    try { __ARCH__.syscallAcceptConnection4(0, 0, 0, 0); println("accept4 NO ERROR"); } catch(str e) { println("accept4 ", global.recognized(e)); }
    try { __ARCH__.syscallWaitForEvents2(0, 0, 0, 0, 0, 0); println("epollPwait2 NO ERROR"); } catch(str e) { println("epollPwait2 ", global.recognized(e)); }
    try { __ARCH__.syscallCreateEventFileDescriptor(0, 9999); println("eventfd bad flags NO ERROR"); } catch(str e) { println("eventfd bad flags ", global.recognized(e)); }
    try { __ARCH__.syscallGetCapabilities(0, 0); println("capget NO ERROR"); } catch(str e) { println("capget ", global.recognized(e)); }

    // Sandboxing entry points. seccomp is probed with an invalid operation:
    // operation 0 installs SECCOMP_MODE_STRICT, which would kill this process.
    try { __ARCH__.syscallCreateLandlockRuleset(0, 0, 0); println("landlockCreate NO ERROR"); } catch(str e) { println("landlockCreate ", global.recognized(e)); }
    try { __ARCH__.syscallAddLandlockRule(-1, 0, 0, 0); println("landlockAddRule NO ERROR"); } catch(str e) { println("landlockAddRule ", global.recognized(e)); }
    try { __ARCH__.syscallRestrictLandlockSelf(-1, 0); println("landlockRestrict NO ERROR"); } catch(str e) { println("landlockRestrict ", global.recognized(e)); }
    try { __ARCH__.syscallControlSeccomp(9999, 0, 0); println("seccomp NO ERROR"); } catch(str e) { println("seccomp ", global.recognized(e)); }

    // The six-argument ceiling still applies to the new names.
    try {
        __ARCH__.syscallGetSystemTimes(0, 0, 0, 0, 0, 0, 0);
        println("too many arguments NO ERROR");
    } catch(str e) { println("argument ceiling ", contains(splitStr(e, " "), "six")); }
}
