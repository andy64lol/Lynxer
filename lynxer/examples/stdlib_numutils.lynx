fn setup(){ import("numutils"); }

fn main(){
    println(numutils.decimal(0.1));
    println(numutils.decimalAdd(0.1, 0.2));
    println(numutils.decimalMul("0.1", "0.2"));
    println(numutils.decimalDiv(1, 3));
    println(numutils.decimalRound(numutils.decimalDiv(1, 3), 4));
    println(numutils.decimalPow("2", 10));
    println(numutils.decimalNeg("5"));
    println(numutils.decimalAbs("-5"));
    println(numutils.decimalCmp("1", "2"));
    println(numutils.decimalEq("0.3", "0.30"));
    println(numutils.decimal("0.30"));
    println(numutils.decimalToFloat("1.5"));
    println(numutils.decimalToInt("3.7"));
    println(numutils.fraction(1, 3));
    println(numutils.fraction(0.1, 0.2));
    println(numutils.fractionParse("2/4"));
    println(numutils.fractionParse("1.5"));
    println(numutils.fractionAdd(0.1, 0.2));
    println(numutils.fractionAdd("1/3", "1/6"));
    println(numutils.fractionSub("1/2", "1/3"));
    println(numutils.fractionMul("2/3", "3/4"));
    println(numutils.fractionDiv("1/2", "1/4"));
    println(numutils.fractionNeg("1/3"));
    println(numutils.fractionAbs("-1/3"));
    println(numutils.fractionCmp("1/2", "1/3"));
    println(numutils.fractionEq("1/2", "2/4"));
    println(numutils.fractionNumerator("3/4"));
    println(numutils.fractionDenominator("3/4"));
    println(numutils.fractionToFloat("1/3"));
    println(numutils.fractionToDecimal("1/3", 6));
    println(numutils.cleanFloat(0.1));
}
