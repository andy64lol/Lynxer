global setup(){ import("numutils"); }

global main(){
    println(global.numutils.decimal(0.1));
    println(global.numutils.decimalAdd(0.1, 0.2));
    println(global.numutils.decimalMul("0.1", "0.2"));
    println(global.numutils.decimalDiv(1, 3));
    println(global.numutils.decimalRound(global.numutils.decimalDiv(1, 3), 4));
    println(global.numutils.decimalPow("2", 10));
    println(global.numutils.decimalNeg("5"));
    println(global.numutils.decimalAbs("-5"));
    println(global.numutils.decimalCmp("1", "2"));
    println(global.numutils.decimalEq("0.3", "0.30"));
    println(global.numutils.decimal("0.30"));
    println(global.numutils.decimalToFloat("1.5"));
    println(global.numutils.decimalToInt("3.7"));
    println(global.numutils.fraction(1, 3));
    println(global.numutils.fraction(0.1, 0.2));
    println(global.numutils.fractionParse("2/4"));
    println(global.numutils.fractionParse("1.5"));
    println(global.numutils.fractionAdd(0.1, 0.2));
    println(global.numutils.fractionAdd("1/3", "1/6"));
    println(global.numutils.fractionSub("1/2", "1/3"));
    println(global.numutils.fractionMul("2/3", "3/4"));
    println(global.numutils.fractionDiv("1/2", "1/4"));
    println(global.numutils.fractionNeg("1/3"));
    println(global.numutils.fractionAbs("-1/3"));
    println(global.numutils.fractionCmp("1/2", "1/3"));
    println(global.numutils.fractionEq("1/2", "2/4"));
    println(global.numutils.fractionNumerator("3/4"));
    println(global.numutils.fractionDenominator("3/4"));
    println(global.numutils.fractionToFloat("1/3"));
    println(global.numutils.fractionToDecimal("1/3", 6));
    println(global.numutils.cleanFloat(0.1));
}
