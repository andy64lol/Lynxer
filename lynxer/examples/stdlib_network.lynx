////
Fixture for the network + server stdlibs. Spins a local server and exercises
the HTTP, WebSocket and raw-TCP clients against it. Offline helpers are checked
without touching the public internet.
////
global setup(){
    import("network");
    import("server");
    import("json");
}

global main(){
    // Offline URL helpers.
    println(global.network.urlScheme("https://example.com:8443/v1/x?q=1#top"));
    println(global.network.urlHost("https://example.com:8443/v1/x"));
    // Default ports are omitted from urlHost.
    println(global.network.urlHost("https://example.com/v1/x"));
    println(global.network.urlPath("https://example.com:8443/v1/x"));
    // An unparseable URL keeps the default path but has no scheme or host.
    println(global.network.urlPath("not a url"));
    println(global.network.urlScheme("not a url"));
    println(global.network.urlHost("not a url"));
    str parsed = global.network.urlParse("https://example.com:8443/v1/x?q=1#top");
    println(global.json.jsonGet(parsed, "scheme"));
    println(global.json.jsonGet(parsed, "host"));
    println(global.json.jsonGet(parsed, "port"));
    println(global.json.jsonGet(parsed, "path"));
    println(global.json.jsonGet(parsed, "query"));
    println(global.json.jsonGet(parsed, "fragment"));
    println(global.network.urlencode("hello world"));
    println(global.network.urlencode("a b&c=d"));
    // The parsed port defaults to the scheme's default.
    println(global.json.jsonGet(global.network.urlParse("http://example.com/"), "port"));
    println(returnLength(global.network.getHostname()) > 0);
    println(global.network.resolveHost("localhost"));
    // A public name resolves to a live address, so only assert that the lookup
    // succeeded: the address itself is host- and time-dependent and would make
    // the .expected file stale.
    println(substring(global.network.resolveHost("example.com"), 0, 7) isnt "ERROR: ");
    println(global.network.resolveHost("nonexistent.example"));
    // Test edge cases for URL parsing.
    println(global.network.urlScheme("ftp://example.com"));
    println(global.network.urlHost("ws://localhost:8080"));
    println(global.network.urlPath("file:///path/to/file"));
    
    // Additional edge cases for URL helpers.
    println(global.network.urlScheme("[2001:db8::1]:8080/path")); // IPv6
    println(global.network.urlHost("[2001:db8::1]:8080/path")); // IPv6
    println(global.network.urlPath("[2001:db8::1]:8080/path")); // IPv6
    
    // Test URLs with special characters.
    println(global.network.urlencode("hello world!@#$%"));
    println(global.network.urlencode("日本語"));
    
    // Test empty or malformed URLs.
    println(global.network.urlScheme(""));
    println(global.network.urlHost(""));
    println(global.network.urlPath(""));
    
    // Test URLs with fragments and queries.
    str parsedWithQuery = global.network.urlParse("http://example.com/path?query=value#frag");
    println(global.json.jsonGet(parsedWithQuery, "query"));
    println(global.json.jsonGet(parsedWithQuery, "fragment"));
    
    // Test IPv6 URL parsing.
    str parsedIPv6 = global.network.urlParse("https://[2001:db8::1]:8080/path");
    println(global.json.jsonGet(parsedIPv6, "host"));
    println(global.json.jsonGet(parsedIPv6, "port"));
    println(global.json.jsonGet(parsedIPv6, "path"));

    // --- RFC 3986 URL operations ---
    println(global.network.urlIsValid("https://example.com/a?b=c#d"));
    println(global.network.urlIsValid("not a url"));
    println(global.network.urlJoin("https://example.com/a/b", "../c"));
    println(global.network.urlJoin("https://example.com/a/", "?x=1"));
    println(global.network.urlJoin("not a url", "c"));
    println(global.network.urlNormalize("HTTP://Example.COM:80/a/./b/../c"));
    println(global.network.urlGet("https://example.com:8443/v1/x?q=1#top", "scheme"));
    println(global.network.urlGet("https://example.com:8443/v1/x?q=1#top", "host"));
    println(global.network.urlGet("https://example.com:8443/v1/x?q=1#top", "port"));
    println(global.network.urlGet("https://example.com/", "port"));
    println(global.network.urlGet("https://u:p@example.com/", "username"));
    println(global.network.urlGet("https://u:p@example.com/", "password"));
    println(global.network.urlGet("https://example.com/", "nope"));
    println(global.network.urlSetScheme("http://example.com/a", "https"));
    println(global.network.urlSetHost("https://example.com/a", "other.test"));
    println(global.network.urlSetPort("https://example.com/a", 8443));
    println(global.network.urlSetPort("https://example.com:8443/a", 0));
    println(global.network.urlSetPath("https://example.com/a", "/b/c"));
    println(global.network.urlQueryGet("https://example.com/?a=1&b=2", "b"));
    println(global.network.urlQueryGet("https://example.com/?a=1", "z"));
    println(global.network.urlQuerySet("https://example.com/?a=1&b=2", "a", "9"));
    println(global.network.urlQueryAppend("https://example.com/?a=1", "b", "2"));
    println(global.network.urlQueryRemove("https://example.com/?a=1&b=2", "a"));
    println(global.network.urlQueryRemove("https://example.com/?a=1", "a"));
    println(global.network.urlEncodeComponent("a b/c?d=e&f"));
    println(global.network.urlEncodeComponent("日本語"));
    println(global.network.urlDecodeComponent("a%20b%2Fc"));
    println(global.network.urlDecodeComponent("%E6%97%A5%E6%9C%AC%E8%AA%9E"));
    println(global.network.urlDecodeComponent("%2")); // malformed escape
    println(global.network.urlDecodeComponent("100% sure"));
    // urlParse escapes every value, so a quote stays valid JSON.
    println(global.json.jsonGet(global.network.urlParse("https://example.com/?q=a\"b"), "query"));

    // Local server for the HTTP and WebSocket round-trips.
    println(global.server.clearRoutes());
    println(global.server.routeGet("/hi", "hello-crow"));
    println(global.server.routeEcho("/echo"));
    println(global.server.wsEcho("/ws"));
    println(global.server.start(18123));
    println(global.server.running());
    println(global.server.port());

    sleep(0.2);

    // HTTP.
    println(global.network.get("http://127.0.0.1:18123/hi"));
    println(global.network.getJson("http://127.0.0.1:18123/hi"));
    println(global.network.getStatus("http://127.0.0.1:18123/hi"));
    println(global.network.httpHead("http://127.0.0.1:18123/hi"));
    println(global.network.post("http://127.0.0.1:18123/echo", "ping", "text/plain"));
    println(global.network.postJson("http://127.0.0.1:18123/echo", "{\"k\": 1}"));
    // Unknown paths and unsupported methods surface the HTTP status.
    println(global.network.getStatus("http://127.0.0.1:18123/missing"));
    println(global.network.httpHead("http://127.0.0.1:18123/missing"));
    println(global.network.getHeaders("http://127.0.0.1:18123/missing"));
    println(global.network.get("http://127.0.0.1:18123/missing"));
    println(global.network.put("http://127.0.0.1:18123/missing", "x", "text/plain"));
    println(global.network.delete("http://127.0.0.1:18123/missing"));
    println(global.network.patch("http://127.0.0.1:18123/missing", "x", "text/plain"));
    println(global.network.download("http://127.0.0.1:18123/missing", "/tmp/lynxer-missing.txt"));

    // WebSocket.
    println(global.network.wsConnect("echo", "ws://127.0.0.1:18123/ws"));
    println(global.network.wsConnected("echo"));
    println(global.network.wsSend("echo", "one"));
    println(global.network.wsReceive("echo"));
    println(global.network.wsSendReceive("echo", "Lynxer-ws"));
    // Unknown connection names are errors, and closing removes the entry.
    println(global.network.wsConnected("nope"));
    println(global.network.wsReceive("nope"));
    println(global.network.wsSend("nope", "x"));
    println(global.network.wsClose("nope"));
    println(global.network.wsClose("echo"));
    println(global.network.wsConnected("echo"));

    // Raw TCP client against the same local server.
    println(returnLength(splitStr(global.network.getLocalIP(), ".")) is 4);
    println(global.network.tcpConnect("raw", "127.0.0.1", global.server.port()));
    str request = "GET /hi HTTP/1.0\r\nHost: 127.0.0.1\r\n\r\n";
    println(global.network.tcpSend("raw", request));
    str rawResponse = global.network.tcpReceive("raw", 4096);
    println(returnLength(rawResponse) >= 5 and substring(rawResponse, 0, 5) is "HTTP/");
    println(global.network.tcpClose("raw"));

    // Send-and-receive needs its own connection: the server closes an HTTP/1.0
    // response once it has written it.
    println(global.network.tcpConnect("raw2", "127.0.0.1", global.server.port()));
    str roundTrip = global.network.tcpSendReceive("raw2", request, 4096);
    println(returnLength(roundTrip) >= 5 and substring(roundTrip, 0, 5) is "HTTP/");
    println(global.network.tcpClose("raw2"));

    // Unknown names are errors, not silent no-ops, and the probe helpers agree
    // about the live listener.
    println(substring(global.network.tcpSend("missing", "x"), 0, 7) is "ERROR: ");
    println(substring(global.network.tcpReceive("missing", 8), 0, 7) is "ERROR: ");
    println(substring(global.network.tcpClose("missing"), 0, 7) is "ERROR: ");
    println(global.network.isPortOpen("127.0.0.1", global.server.port(), 1));
    println(returnType(global.network.ping("127.0.0.1")) is "bool");

    println(global.server.stop());
    println(global.server.running());
    // With the server stopped the port is closed.
    println(global.network.isPortOpen("127.0.0.1", 18123, 1));
}
