////
`sys` fixture. `argv`/`getArg`/`argCount` describe the program's own command
line, so entry 0 is this script and there is nothing after it when the suite
runs the fixture directly. Only invocation-independent facts are asserted.
////
fn setup(){ import("sys"); }

fn main(){
    // The program's own command line always has at least the script itself.
    println(sys.argCount() > 0);
    println(sys.getArg(0) isnt "");
    println(sys.getArg(-1) is "");
    println(sys.getArg(999) is "");

    println(sys.platform() isnt "");
    println(sys.architecture() isnt "");
    println(sys.implementation());
    println(sys.versionInfo());
    println(sys.cpuCount() > 0);
    println(sys.pageSize() > 0);
    println(sys.memoryTotal() > 0);
    println(sys.memoryAvailable() >= 0);
    println(sys.uptime() >= 0);
    println(sys.bootTime() >= 0);
    println(sys.loadAverage() isnt "");
}
