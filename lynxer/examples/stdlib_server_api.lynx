////
Fixture for the extended server API: every HTTP verb, JSON routes, redirects,
Jinja-style template routes, single-file and static-tree serving, custom error
bodies, CORS and global headers, and the request-context readers.

It only prints scalars and booleans. Raw HTTP responses carry a `date` header
and lowercase header names, so the raw-TCP checks assert `contains` rather than
echoing the response.
////
fn setup(){
    import("server");
    import("network");
    import("fileIO");
    import("text");
}

fn requestGet(){
    str body = server.getMethod() + "|" + server.getArg("id") +
               "|" + server.getHeader("x-request") +
               "|" + server.getPath();
    server.respond(200, "text/plain", body);
}

fn requestPost(){
    str body = server.getMethod() + "|" + server.getBody() +
               "|" + server.getHeader("x-request");
    server.respond(200, "text/plain", body);
}

fn main(){
    fileIO.writeFile("lynxer_scratch_tpl.html", "<h1>{{ title }} / {{ user.name }}</h1>");
    fileIO.writeFile("lynxer_scratch_static.txt", "static-body");

    println(server.clearRoutes());
    println(server.setTemplateFolder("."));
    println(server.setDebug(false));

    // Every verb, plus a custom status, an any-verb route and a form route.
    println(server.get("/g", "get-body"));
    println(server.put("/v", "put-body"));
    println(server.delete("/d", "del-body"));
    println(server.patch("/p", "patch-body"));
    println(server.anyHttp("/any", "any-body"));
    println(server.getStatus("/teapot", "teapot", 418));
    println(server.post("/form", "form-ok"));
    // Duplicates key on the verb, so a second PUT is rejected and a GET of the
    // same path is not.
    println(server.put("/v", "again"));
    println(server.get("/v", "get-on-v"));

    // JSON routes.
    println(server.jsonGet("/j", "{\"ok\":true}"));
    println(server.jsonPost("/jp", "{\"n\":1}"));
    println(server.jsonRoute("/jr", "{\"r\":true}"));
    println(server.jsonStatus("/je", "{\"e\":1}", 404));

    // Redirects.
    println(server.redirect("/old", "/g"));
    println(server.redirect301("/perm", "/g"));

    // Templates and files.
    println(server.template("/tpl", "lynxer_scratch_tpl.html",
                                   "{\"title\":\"Home\",\"user\":{\"name\":\"Ada\"}}"));
    println(server.templatePost("/tplp", "lynxer_scratch_tpl.html",
                                       "{\"title\":\"Post\",\"user\":{\"name\":\"Bob\"}}"));
    println(server.templateString("/inline", "<p>{{ greeting }}, {{ name }}!</p>",
                                         "{\"greeting\":\"Hi\",\"name\":\"World\"}"));
    println(server.templateString("/empty", "<i>{{ missing }}</i>", "{}"));
    println(server.routeGetCallback("/callback", "requestGet"));
    println(server.routePostCallback("/callback", "requestPost"));
    println(server.serveFile("/one", "lynxer_scratch_static.txt"));
    println(server.staticFiles("/assets", "."));
    println(server.staticSite("."));

    // Registration validation.
    println(server.staticFiles("assets", "."));
    println(server.corsOrigin(""));
    println(server.addGlobalHeader("bad name", "x"));
    println(server.addGlobalHeader("x-lynxer", "yes"));
    println(server.corsOrigin("https://example.test"));

    // Custom error bodies.
    println(server.notFound("<h1>gone</h1>"));
    println(server.serverError("<h1>boom</h1>"));
    println(server.forbidden("<h1>denied</h1>"));
    println(server.methodNotAllowed("<h1>method-nope</h1>"));

    // TLS is built, but it needs a port: `runSSLAdhoc()` reports that in band
    // rather than serving. The handshake itself is covered by
    // stdlib_server_tls.lynx.
    println(server.runSSLAdhoc());
    println(server.start(70000));

    println(server.start(18130));
    sleep(0.3);
    str base = "http://127.0.0.1:18130";

    println(network.get(base + "/g"));
    println(network.put(base + "/v", "ignored", "text/plain"));
    println(network.delete(base + "/d"));
    println(network.patch(base + "/p", "ignored", "text/plain"));
    println(network.get(base + "/any"));
    println(network.post(base + "/any", "x", "text/plain"));
    println(network.get(base + "/v"));
    println(network.getStatus(base + "/teapot"));
    println(network.httpHead(base + "/g"));

    println(network.get(base + "/j"));
    println(text.contains(network.getHeaders(base + "/j"),
                                 "Content-Type: application/json"));
    println(network.postJson(base + "/jr", "{}"));
    println(network.getStatus(base + "/je"));

    println(network.get(base + "/tpl"));
    println(network.post(base + "/tplp", "x", "text/plain"));
    println(network.get(base + "/inline"));
    println(network.getStatus(base + "/empty"));
    println(network.get(base + "/callback?id=first"));
    println(network.post(base + "/callback?id=second", "posted", "text/plain"));

    println(network.get(base + "/one"));
    println(network.get(base + "/assets/lynxer_scratch_static.txt"));
    // The site root serves /index.html, which does not exist here, so this is a
    // 404 rather than the tree's file.
    println(network.getStatus(base + "/"));
    println(network.get(base + "/lynxer_scratch_static.txt"));
    // Traversal is refused.
    println(network.getStatus(base + "/assets/../lynxer_scratch_static.txt"));

    // Redirects are followed by the HTTP client, so the body of the target is
    // what comes back.
    println(network.get(base + "/old"));
    println(network.get(base + "/perm"));

    println(network.getStatus(base + "/missing"));
    println(network.getStatus(base + "/v"));

    // Raw requests reveal the custom bodies, the redirect status/location and
    // the CORS and global headers.
    str rawStatus = network.tcpConnect("raw", "127.0.0.1", 18130);
    println(rawStatus);
    println(network.tcpSend("raw", "GET /missing HTTP/1.0\r\nHost: x\r\n\r\n"));
    str missing = network.tcpReceive("raw", 8192);
    println(text.contains(missing, "gone"));
    println(network.tcpClose("raw"));

    str raw2Status = network.tcpConnect("raw2", "127.0.0.1", 18130);
    println(raw2Status);
    println(network.tcpSend("raw2", "GET /old HTTP/1.0\r\nHost: x\r\n\r\n"));
    str redirected = network.tcpReceive("raw2", 8192);
    println(text.contains(redirected, "302"));
    println(text.contains(redirected, "location: /g"));
    println(network.tcpClose("raw2"));

    str raw3Status = network.tcpConnect("raw3", "127.0.0.1", 18130);
    println(raw3Status);
    println(network.tcpSend("raw3", "GET /g HTTP/1.0\r\nHost: x\r\n\r\n"));
    str decorated = network.tcpReceive("raw3", 8192);
    println(text.contains(decorated, "x-lynxer: yes"));
    println(text.contains(decorated,
                                 "access-control-allow-origin: https://example.test"));
    println(network.tcpClose("raw3"));

    str raw4Status = network.tcpConnect("raw4", "127.0.0.1", 18130);
    println(raw4Status);
    println(network.tcpSend("raw4",
        "POST /form?q=hello HTTP/1.0\r\nHost: raw-host\r\nCookie: session=abc123\r\nContent-Type: application/x-www-form-urlencoded\r\nContent-Length: 9\r\n\r\nname=ada!"));
    str form = network.tcpReceive("raw4", 8192);
    println(text.contains(form, "form-ok"));
    println(network.tcpClose("raw4"));

    // The request-context readers describe that last POST.
    println(server.getMethod());
    println(server.getPath());
    println(server.getUrl());
    println(server.getArg("q"));
    println(server.getArg("absent"));
    println(server.getForm("name"));
    println(server.getCookie("session"));
    println(server.getCookie("absent"));
    println(server.getHeader("cookie"));
    println(server.getContentType());
    println(server.getBody());
    println(returnLength(server.getRemoteAddr()) > 0);

    // Request logging is enabled last, followed by exactly one blocking
    // request: the server logs before it responds, so the line lands in a fixed
    // place. Enabling it earlier would race with `tcpSend`, which returns before
    // the server has processed the request.
    println(server.enableRequestLog());
    println(network.get(base + "/g"));

    println(server.stop());
    println(server.running());

    println(fileIO.deleteFile("lynxer_scratch_tpl.html"));
    println(fileIO.deleteFile("lynxer_scratch_static.txt"));
}
