////
Regression fixture for the `winreg` module.

Windows-only. It writes under HKCU and removes the test tree, so it needs no
elevation and leaves the registry as it found it.
////

fn setup(){ import("winreg"); }

fn main(){
    str root = "HKCU";
    str key = "Software\\Lynxer\\Fixture";

    winreg.deleteTree(root, key);
    println(winreg.keyExists(root, key));

    println(winreg.createKey(root, key));
    println(winreg.keyExists(root, key));
    println(winreg.createKey(root, key + "\\Child"));
    println(returnLength(winreg.listKeys(root, key)) > 0);

    println(winreg.writeString(root, key, "name", "value"));
    println(winreg.readString(root, key, "name"));
    println(winreg.valueExists(root, key, "name"));
    println(winreg.writeExpandString(root, key, "expand", "%TEMP%"));
    println(winreg.readString(root, key, "expand"));
    println(winreg.writeInt(root, key, "count", 42));
    println(winreg.readInt(root, key, "count"));
    println(winreg.writeInt(root, key, "big", 5000000000));
    println(winreg.readInt(root, key, "big"));
    println(winreg.writeDefault(root, key, "default"));
    println(winreg.readDefault(root, key));
    println(returnLength(winreg.listValues(root, key)) > 0);

    println(winreg.deleteValue(root, key, "name"));
    println(winreg.valueExists(root, key, "name"));
    println(winreg.deleteKey(root, key + "\\Child"));
    println(winreg.keyExists(root, key + "\\Child"));
    println(winreg.deleteTree(root, key));
    println(winreg.keyExists(root, key));
}
