fn setup(){}

class Counter {
    int value = 0;

    fn init(int initial){
        this.value = initial;
    }

    fn increment(){
        this.value = this.value + 1;
    }

    fn get(){
        return this.value;
    }
}

fn readCounter(Counter counter){
    return counter.get();
}

fn main(){
    Counter first = new Counter(2);
    Counter second = new Counter(10);

    first.increment();
    second.increment();

    assert(first.get() is 3);
    assert(second.get() is 11);
    assert(readCounter(first) is 3);
    assert(returnType(first) is "Counter");
    println(readCounter(first));
    println(readCounter(second));
}
