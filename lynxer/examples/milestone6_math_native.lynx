fn setup(){
    import("math");
    import("typing");
    const int number = 42;
}

fn main(){
    println(math.sqrt(9.0));
    println(math.sin(0.0));
    println(math.isPrime(97));
    println(math.isFinite(1.0));
    println(typing.toStr(not false), " is now a string.");
    println(number, " is a integer.");
    println(typing.typeOf(number), " is the type of number.");
}
