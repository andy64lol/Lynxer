global setup(){
    import("math");
    import("typing");
    const int number = 42;
}

global main(){
    println(global.math.sqrt(9.0));
    println(global.math.sin(0.0));
    println(global.math.isPrime(97));
    println(global.math.isFinite(1.0));
    println(global.typing.toStr(not false), " is now a string.");
    println(number, " is a integer.");
    println(global.typing.typeOf(number), " is the type of number.");
}
