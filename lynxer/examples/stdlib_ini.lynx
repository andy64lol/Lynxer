////
Fixture for the ini stdlib. Documents cross as JSON strings and every assertion
is fixed, so the output is deterministic. Part of the import-parity gate.
////
global setup(){ import("ini"); }

global main(){
    str text = "; comment\n[server]\nhost = localhost\nport = 8080\n[db]\nuser = root\n";
    println(global.ini.iniParse(text));
    println(global.ini.iniGet(text, "server", "host"));
    println(global.ini.iniGet(text, "db", "user"));
    println(global.ini.iniGet(text, "server", "nope"));
    println(global.ini.iniValid(text));
    println(global.ini.iniSerialize("{\"server\":{\"host\":\"localhost\"}}"));
    str roundTrip = global.ini.iniSerialize(global.ini.iniParse(text));
    println(global.ini.iniParse(roundTrip));
}
