////
Smoke test for the `game` stdlib module. It runs in headless mode (the test
runner sets LYNXER_GAME_HEADLESS=1), so no window is opened and drawing calls
are no-ops, but the whole API surface and the frame-callback bridge are
exercised deterministically.
////
fn setup(){ import("game"); }

fn onUpdate(float dt){
    println("update ", dt);
}

fn onDraw(){
    println("draw");
}

fn main(){
    game.init("smoke", 320, 200);
    println(game.getWidth(), "x", game.getHeight());

    // Drawing is a no-op headless but must not fail.
    game.beginDraw();
    game.drawRect(10.0, 10.0, 20.0, 20.0, 255, 0, 0);
    game.drawCircle(50.0, 50.0, 5.0, 0, 255, 0);
    game.drawLine(0.0, 0.0, 100.0, 100.0, 0, 0, 255, 1.0);
    game.drawTriangle(0.0, 0.0, 10.0, 0.0, 5.0, 8.0, 255, 255, 0);
    game.drawText("hi", 5.0, 5.0, 255, 255, 255, 12);
    game.drawPolygon("0,0,10,0,5,8", 0, 255, 255);
    game.endDraw();

    int a = game.makeSolidSprite(10, 20, 255, 0, 0, 0.0, 0.0);
    int b = game.makeSolidSprite(10, 20, 0, 255, 0, 3.0, 4.0);
    println("a=", a, " b=", b, " exists=", game.spriteExists(a));
    println("size=", game.getSpriteWidth(a), "x", game.getSpriteHeight(a));
    println("dist=", game.spriteDistance(a, b));
    println("near=", game.spriteNear(a, 3.0, 4.0, 5.0));

    game.setSpritePos(b, 8.0, 0.0);
    println("pos=", game.getSpritePosition(b));
    println("collide=", game.spriteCollides(a, b));

    game.setSpriteVelocity(b, 5.0, 0.0);
    println("vx=", game.getSpriteVX(b));
    game.stopSprite(b);
    println("vx2=", game.getSpriteVX(b));

    int list = game.makeSpriteList();
    game.addToList(list, a);
    game.addToList(list, b);
    println("count=", game.getSpriteListCount(list));
    game.removeSpriteFromList(list, a);
    println("count2=", game.getSpriteListCount(list));

    int cam = game.makeCamera();
    game.setCameraPos(cam, 100.0, 50.0);
    game.zoomCamera(cam, 2.0);
    println("cam=", game.getCameraX(cam), ",", game.getCameraY(cam), " zoom=", game.getCameraZoom(cam));
    game.resetCamera();

    println("key=", game.keyDown("SPACE"), " mouse=", game.mouseButtonDown("LEFT"));

    println(game.screenToTile(80.0, 40.0, 16));
    println(game.tileToScreen(1, 2, 16));

    // --- extended coverage --------------------------------------------------

    // Window helpers.
    game.setBackground(10, 20, 30);
    game.setFPSCap(60);
    game.setResizable(true);
    game.setFullscreen(false);
    game.setMouseVisible(true);
    game.setWindowSize(400, 300);
    println("resized=", game.getWidth(), "x", game.getHeight());
    println("fps=", game.getFPS(), " open=", game.isOpen());

    // Sprite transforms and state.
    game.setSpriteAngle(a, 90.0);
    game.setSpriteScale(a, 2.0);
    game.setSpriteAlpha(a, 128);
    game.setSpriteVisible(a, false);
    println("angle=", game.getSpriteAngle(a), " scale=", game.getSpriteScale(a), " alpha=", game.getSpriteAlpha(a));
    println("scaled=", game.getSpriteWidth(a), "x", game.getSpriteHeight(a), " visible=", game.getSpriteVisible(a));
    game.setSpriteVisible(a, true);
    game.setSpriteAngularVelocity(b, 45.0);
    println("angVel=", game.getSpriteAngularVelocity(b));
    game.moveSpriteToward(b, 0.0, 0.0, 4.0);
    println("toward=", game.getSpriteVX(b), ",", game.getSpriteVY(b));
    game.faceSpriteTo(b, 16.0, 0.0);
    println("facing=", game.getSpriteAngle(b));
    println("near2=", game.spriteNear(a, 100.0, 100.0, 5.0));

    // Collision queries against a sprite list.
    println("listHit=", game.spriteCollidesWithList(a, list));
    println(game.getCollidingSprites(a, list));

    // Removing a sprite also drops it from the lists.
    game.destroySprite(b);
    println("gone=", game.spriteExists(b), " count3=", game.getSpriteListCount(list));

    // A missing image cannot be loaded (headless mode never touches the GPU).
    println("tex=", game.loadTexture("missing.png"), " spr=", game.loadSprite("missing.png", 1.0, 0.0, 0.0));

    // Camera activation and smoothing.
    game.useCamera(cam);
    game.smoothScrollCamera(cam, 200.0, 50.0, 0.5);
    println("smooth=", game.getCameraX(cam), ",", game.getCameraY(cam), " zoom=", game.getCameraZoom(cam));
    game.resetCamera();

    // Every remaining draw primitive. Headless no-ops, but they exercise the
    // packed-argument ABI, including the long argument lists and the
    // coordinate/text forms.
    game.beginDraw();
    game.drawRectOutline(10.0, 10.0, 20.0, 20.0, 255, 0, 0, 1.0);
    game.drawCircleOutline(50.0, 50.0, 5.0, 0, 255, 0, 1.0);
    game.drawEllipse(20.0, 20.0, 30.0, 10.0, 1, 2, 3);
    game.drawEllipseOutline(20.0, 20.0, 30.0, 10.0, 1, 2, 3, 1.0);
    game.drawTriangleOutline(0.0, 0.0, 10.0, 0.0, 5.0, 8.0, 1, 2, 3, 1.0);
    game.drawPoint(1.0, 2.0, 1, 2, 3, 2.0);
    game.drawRectRoundedFilled(10.0, 10.0, 20.0, 20.0, 1, 2, 3, 4.0);
    game.drawRectRoundedOutline(10.0, 10.0, 20.0, 20.0, 1, 2, 3, 4.0, 1.0);
    game.drawStar(10.0, 10.0, 8.0, 4.0, 5, 1, 2, 3);
    game.drawDashedLine(0.0, 0.0, 10.0, 0.0, 1, 2, 3, 1.0, 2.0);
    game.drawCross(5.0, 5.0, 3.0, 1, 2, 3, 1.0);
    game.drawGradientRect(10.0, 10.0, 20.0, 20.0, 1, 2, 3, 4, 5, 6);
    game.drawArc(10.0, 10.0, 20.0, 20.0, 1, 2, 3, 0.0, 90.0, 1.0);
    game.drawArcFilled(10.0, 10.0, 20.0, 20.0, 1, 2, 3, 0.0, 90.0);
    game.drawPolygonOutline("0,0,10,0,5,8", 1, 2, 3, 1.0);
    game.drawPolyline("0,0,5,5,10,0", 1, 2, 3, 1.0);
    game.drawPoints("1,2 3,4", 1, 2, 3, 2.0);
    game.drawLines("0,0,10,10", 1, 2, 3, 1.0);
    game.drawTextStyled("styled", 5.0, 5.0, 255, 255, 255, 12, "sans", true, false, "center");
    game.drawTextAnchored("anchored", 50.0, 50.0, 255, 255, 255, 12, "center", "top");
    game.setSpriteTexture(a, 0);
    game.drawSprite(a);
    game.drawTexture(0, 10.0, 10.0, 4.0, 4.0, 0.0);
    game.drawTextureAt("missing.png", 10.0, 10.0, 1.0);
    game.drawTextureRect(0, 0.0, 0.0, 4.0, 4.0);
    game.endDraw();

    // Title/cursor helpers and timing.
    game.setTitle("renamed");
    game.hideCursor();
    game.showCursor();
    println("dt>0=", game.deltaTime() > 0.0, " t=", game.getTime());

    // Sprite reads, aliases and mutation.
    println("xy=", game.getSpriteX(a), ",", game.getSpriteY(a));
    game.setSpritePosition(a, 1.0, 2.0);
    println("moved=", game.getSpritePosition(a));
    game.setSpriteColor(a, 1, 2, 3, 255);
    game.flipSpriteH(a);
    game.flipSpriteV(a);
    game.updateSprite(a);
    println("after=", game.getSpriteX(a), ",", game.getSpriteY(a));

    // Sprite lists: update, draw and clear.
    int big = game.makeSpriteList();
    game.addToList(big, a);
    game.updateSpriteList(big);
    game.drawSpriteList(big);
    println("bigCount=", game.getSpriteListCount(big));
    game.clearSpriteList(big);
    println("cleared=", game.getSpriteListCount(big));

    // Input reads are deterministic in headless mode.
    println("mouse=", game.mouseX(), ",", game.mouseY(), " scroll=", game.mouseScrollX(), ",", game.mouseScrollY());
    println("deltas=", game.mouseDeltaX(), ",", game.mouseDeltaY());
    println("keys=", game.keyPressed("A"), " ", game.keyReleased("A"), " ", game.keyUp("A"));
    println("buttons=", game.mouseLeft(), " ", game.mouseMiddle(), " ", game.mouseRight(), " ", game.mouseButtonPressed("LEFT"), " ", game.mouseButtonReleased("LEFT"), " ", game.mouseButtonCode("LEFT"));
    println("keyCode=", game.keyCode("SPACE"));

    // --- Physics: horizontal collision, slopes and one-way platforms --------
    // A floor, a wall to walk into, a ramp and a one-way platform.
    int floor = game.makeSolidSprite(200, 20, 255, 255, 255, 100.0, 0.0);
    int brick = game.makeSolidSprite(20, 40, 255, 255, 255, 80.0, 30.0);
    int ramp = game.makeSolidSprite(20, 40, 255, 255, 255, 30.0, 40.0);
    game.setSpriteAngle(ramp, 30.0);
    int ledge = game.makeSolidSprite(60, 10, 255, 255, 255, 150.0, 40.0);

    int walls = game.makeSpriteList();
    game.addToList(walls, floor);
    game.addToList(walls, brick);
    game.addToList(walls, ramp);
    int platforms = game.makeSpriteList();
    game.addToList(platforms, ledge);

    // Walking right: the player stops against the wall instead of passing
    // through it, and settles on the floor.
    int walker = game.makeSolidSprite(10, 20, 0, 0, 255, 50.0, 30.0);
    int engine = game.makePhysicsEngine(100.0, walls, platforms);
    game.setPhysicsPlayer(engine, walker);
    game.setSpriteVelocity(walker, 100.0, 0.0);
    int i = 0;
    while(i < 120){ game.updatePhysics(engine); i = i + 1; }
    println("walkX=", game.getSpriteX(walker), " walkY=", game.getSpriteY(walker));
    println("grounded=", game.canJump(engine), " vx=", game.getSpriteVX(walker));

    // Jumping up through the one-way platform: it is solid only from above.
    int jumper = game.makeSolidSprite(10, 20, 0, 255, 0, 150.0, 20.0);
    int jumpEngine = game.makePhysicsEngine(100.0, walls, platforms);
    game.setPhysicsPlayer(jumpEngine, jumper);
    game.setSpriteVelocity(jumper, 0.0, 200.0);
    i = 0;
    while(i < 20){ game.updatePhysics(jumpEngine); i = i + 1; }
    println("through=", game.getSpriteY(jumper) > 45.0, " vy=", game.getPlayerVY(jumpEngine) > 0.0);
    // ...and it catches the player once they fall back from above.
    game.setSpriteVelocity(jumper, 0.0, 0.0);
    i = 0;
    while(i < 120){ game.updatePhysics(jumpEngine); i = i + 1; }
    println("landedOn=", game.getSpriteY(jumper), " grounded=", game.canJump(jumpEngine));

    // Falling onto the 30-degree ramp: the surface under x=30 is 25.77, so the
    // player's centre rests one half-height above it.
    int slider = game.makeSolidSprite(10, 20, 255, 0, 255, 30.0, 70.0);
    int slopeEngine = game.makePhysicsEngine(100.0, walls, -1);
    game.setPhysicsPlayer(slopeEngine, slider);
    i = 0;
    while(i < 180){ game.updatePhysics(slopeEngine); i = i + 1; }
    println("slopeY=", game.getSpriteY(slider), " grounded=", game.canJump(slopeEngine));

    game.setUpdateCallback("onUpdate");
    game.setDrawCallback("onDraw");
    game.run();
    game.close();
    println("done");
}
