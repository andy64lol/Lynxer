////
Fixture for the re stdlib. Interpreted only (module imports are not
bytecode-compilable).
////
fn setup(){ import("re"); }

fn main(){
    println(re.test("\\d+", "abc123"));
    println(re.test("^\\d+$", "abc"));
    println(re.match("\\d+", "42abc"));
    println(re.matchFull("\\d+", "42abc"));
    println(re.search("\\d+", "abc123def"));
    println(re.findall("\\d+", "a1 b22 c333"));
    println(re.count("\\d+", "a1 b22 c333"));
    println(re.groups("(\\w+)@(\\w+)", "user@host"));
    println(re.groupsAll("(\\w+)=(\\d+)", "x=1 y=2"));
    println(re.named("(?P<user>\\w+)@(?P<host>\\w+)", "alice@example"));
    println(re.sub("\\d+", "#", "a1b22"));
    println(re.subN("\\d+", "#", "a1b22", 1));
    println(re.subn("\\d+", "#", "a1b22"));
    println(re.split("\\s+", "one  two   three"));
    println(re.splitN("\\s+", "a b c d", 2));
    println(re.escape("a.b+c"));
    println(re.matchStart("\\d+", "ab12"));
    println(re.matchEnd("\\d+", "ab12"));
    println(re.findSpans("\\d+", "a12b34"));
    println(re.testIgnoreCase("abc", "ABC"));
    println(re.searchIgnoreCase("abc", "xABCy"));
    println(re.subIgnoreCase("abc", "-", "aBc"));
    println(re.findallMultiline("^\\w+", "ab\ncd"));
    println(re.subMultiline("^", "> ", "a\nb"));
    println(re.searchDotall("a.b", "a\nb"));
    println(re.split("", "abc"));
    println(re.sub("(?P<w>\\w+)", "[\\g<w>]", "hi there"));
    println(re.matchFull("[a-z]+", "hello"));
    println(re.matchStart("x", "🙂éx"));
    println(re.matchStartChar("x", "🙂éx"));
    println(re.matchEnd("x", "🙂éx"));
    println(re.matchEndChar("x", "🙂éx"));
    println(re.findSpans("\\p{L}+", "🙂éx"));
    println(re.findSpansChar("\\p{L}+", "🙂éx"));
    println(re.groups("(\\p{L}+)", "🙂éx"));
    println(re.sub("(\\p{L}+)", "[\\1]", "🙂éx"));
    println(re.test("(", "abc"));
    println(re.findall("(", "abc"));
    println(re.matchStart("(", "abc"));

    // Constructs the previous engine (std::regex / ECMAScript) could not run.
    println(re.test("(?<=a)b", "ab"));
    println(re.search("(?<=ab+)c", "abbc"));
    println(re.test("(?>a+)b", "aab"));
    println(re.findall("(?<=\\$)\\d+", "$1 and $22"));
    println(re.test("\\p{Greek}+", "αβγ"));
    println(re.test("a(?i)bc", "aBC"));
    println(re.test("(?P<w>\\w)(?P=w)", "aa"));
}
