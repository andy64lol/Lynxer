////
Fixture for SVG rasterisation through the `image` module. It loads a committed
SVG asset at its intrinsic and scaled sizes, checks the quadrant colours, mode
and format metadata, re-saves the rasterised handle as PNG, and confirms there
is no SVG encoder.
////
fn setup(){ import("image"); import("os"); }

fn main(){
    // The fixture runs from `lynxer/` under `make test` and from the
    // repository root by hand, so resolve the asset against both layouts.
    str asset = "examples/assets/shapes.svg";
    if(not os.exists(asset)){ asset = "lynxer/examples/assets/shapes.svg"; }

    int svg = image.openSvg(asset);
    println(svg >= 0);
    println(image.getFormat(svg));
    println(image.getMode(svg));
    println(image.getWidth(svg), "x", image.getHeight(svg));
    println(image.getPixel(svg, 0, 0));
    println(image.getPixel(svg, 3, 0));
    println(image.getPixel(svg, 0, 3));
    println(image.getPixel(svg, 3, 3));

    int scaled = image.openSvgSize(asset, 8, 8);
    println(scaled >= 0);
    println(image.getWidth(scaled), "x", image.getHeight(scaled));
    println(image.getPixel(scaled, 1, 1));
    println(image.getPixel(scaled, 6, 1));
    println(image.getPixel(scaled, 1, 6));
    println(image.getPixel(scaled, 6, 6));

    int viaOpen = image.open(asset);
    println(image.getFormat(viaOpen));

    str root = ".lynxer_image_svg";
    if(os.exists(root)){ os.rmTree(root); }
    os.mkdir(root);
    println(image.save(svg, root + "/shapes.png"));
    int encoded = image.open(root + "/shapes.png");
    println(image.getFormat(encoded));
    println(image.getPixel(encoded, 3, 3));
    println(image.save(svg, root + "/shapes.svg"));
    println(os.rmTree(root));

    println(image.close(svg));
    println(image.close(scaled));
    println(image.close(viaOpen));
    println(image.close(encoded));
}
