////
Fixture for the uuid stdlib. The name-based, nil, namespace and formatting
values are fixed; the random (v4) and time-ordered (v7) ones are only checked
for their properties, so the output is deterministic. Part of the import-parity
gate.
////
fn setup(){ import("uuid"); }

fn main(){
    // --- generation ---------------------------------------------------------
    // v4 and v7 cannot be pinned, so only their shape is asserted.
    str v4 = uuid.uuidV4();
    println(uuid.uuidValid(v4));
    println(uuid.uuidVersion(v4));
    println(uuid.uuidVariant(v4));
    str v7 = uuid.uuidV7();
    println(uuid.uuidValid(v7));
    println(uuid.uuidVersion(v7));
    println(uuid.uuidTimestamp(v7) > 0);

    // Name-based UUIDs are reproducible: the RFC examples for www.example.com.
    println(uuid.uuidV3(uuid.uuidNamespace("dns"), "www.example.com"));
    println(uuid.uuidV5(uuid.uuidNamespace("dns"), "www.example.com"));
    println(uuid.uuidV3("not-a-uuid", "www.example.com"));
    println(uuid.uuidV5("not-a-uuid", "www.example.com"));

    println(uuid.uuidNil());

    // --- namespaces ---------------------------------------------------------
    println(uuid.uuidNamespace("dns"));
    println(uuid.uuidNamespace("url"));
    println(uuid.uuidNamespace("oid"));
    println(uuid.uuidNamespace("x500"));
    println(uuid.uuidNamespace("DNS")); // names are case-insensitive
    println(uuid.uuidNamespace("nope"));

    // --- parsing and formatting --------------------------------------------
    // Hyphenated, simple, urn:uuid: and braced all parse; the URN and braced
    // forms wrap the hyphenated one.
    println(uuid.uuidParse("A1A2A3A4-B1B2-C1C2-D1D2-D3D4D5D6D7D8"));
    println(uuid.uuidParse("a1a2a3a4b1b2c1c2d1d2d3d4d5d6d7d8"));
    println(uuid.uuidParse("urn:uuid:a1a2a3a4-b1b2-c1c2-d1d2-d3d4d5d6d7d8"));
    println(uuid.uuidParse("{a1a2a3a4-b1b2-c1c2-d1d2-d3d4d5d6d7d8}"));
    println(uuid.uuidParse("  a1a2a3a4b1b2c1c2d1d2d3d4d5d6d7d8  "));
    println(uuid.uuidParse("urn:uuid:a1a2a3a4b1b2c1c2d1d2d3d4d5d6d7d8"));
    println(uuid.uuidParse("nope"));

    println(uuid.uuidFormat("a1a2a3a4b1b2c1c2d1d2d3d4d5d6d7d8", true));
    println(uuid.uuidFormat("{a1a2a3a4-b1b2-c1c2-d1d2-d3d4d5d6d7d8}", false));
    println(uuid.uuidFormat("nope", true));

    println(uuid.uuidValid("a1a2a3a4-b1b2-c1c2-d1d2-d3d4d5d6d7d8"));
    println(uuid.uuidValid("a1a2a3a4b1b2c1c2d1d2d3d4d5d6d7d8"));
    println(uuid.uuidValid("a1a2a3a4b1b2c1c2d1d2d3d4d5d6d7d8 ")); // trailing space is fine
    println(uuid.uuidValid("nope"));
    println(uuid.uuidValid("a1a2a3a4-b1b2-c1c2-d1d2-d3d4d5d6d7d")); // one digit short

    // The version nibble is reported as-is, even for a UUID that is not a
    // well-formed RFC variant.
    println(uuid.uuidVersion("a1a2a3a4-b1b2-c1c2-d1d2-d3d4d5d6d7d8"));
    println(uuid.uuidVersion("01a0e934-e825-7553-8afc-80071d56499b"));
    println(uuid.uuidVersion(uuid.uuidNil()));
    println(uuid.uuidVersion("nope"));

    println(uuid.uuidVariant("a1a2a3a4-b1b2-c1c2-d1d2-d3d4d5d6d7d8"));
    println(uuid.uuidVariant("01a0e934-e825-7553-8afc-80071d56499b"));
    println(uuid.uuidVariant(uuid.uuidNil()));
    println(uuid.uuidVariant("nope"));

    // A time-based UUID carries a timestamp; v3, v4, v5 and nil do not.
    println(uuid.uuidTimestamp("01a0e934-e825-7553-8afc-80071d56499b"));
    println(uuid.uuidTimestamp("a1a2a3a4-b1b2-c1c2-d1d2-d3d4d5d6d7d8"));
    println(uuid.uuidTimestamp(uuid.uuidV5(uuid.uuidNamespace("dns"), "www.example.com")));
    println(uuid.uuidTimestamp("nope"));

    // --- the hex view of the 16 bytes --------------------------------------
    println(uuid.uuidToHex("a1a2a3a4-b1b2-c1c2-d1d2-d3d4d5d6d7d8"));
    println(uuid.uuidToHex("nope"));
    println(uuid.uuidFromHex("a1a2a3a4b1b2c1c2d1d2d3d4d5d6d7d8"));
    println(uuid.uuidFromHex("A1A2A3A4B1B2C1C2D1D2D3D4D5D6D7D8"));
    println(uuid.uuidFromHex("a1a2a3a4-b1b2-c1c2-d1d2-d3d4d5d6d7d8")); // hyphens are not hex
    println(uuid.uuidFromHex("a1a2a3a4b1b2c1c2d1d2d3d4d5d6d7d"));
    println(uuid.uuidFromHex("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz"));

    // --- the raw 16 bytes --------------------------------------------------
    println(bytesToHex(uuid.uuidToBytes("a1a2a3a4-b1b2-c1c2-d1d2-d3d4d5d6d7d8")));
    println(bytesLength(uuid.uuidToBytes("nope")));
    println(uuid.uuidFromBytes(bytesFromHex("a1a2a3a4b1b2c1c2d1d2d3d4d5d6d7d8")));
    println(uuid.uuidFromBytes(bytesFromHex("a1a2a3a4"))); // wrong length
}
