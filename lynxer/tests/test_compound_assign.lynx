///
  test_compound_assign.lynx — regression test for *=, /=, %=
  (+=  and -= are already covered by test.lynx)
///

global setup(){}

global check(str label, bool ok){
    if(ok){
        println("PASS: " + label);
    } else {
        println("FAIL: " + label);
    }
}

global main(){
    println("=== compound assignment tests ===");

    // *=
    int a = 6;
    a *= 7;
    global.check("6 *= 7 == 42",  a is 42);

    // /=
    float b = 10.0;
    b /= 4.0;
    global.check("10.0 /= 4.0 == 2.5",  b is 2.5);

    // %= 
    int c = 17;
    c %= 5;
    global.check("17 %= 5 == 2",  c is 2);

    // chained compound assignment
    int d = 2;
    d *= 3;    // 6
    d += 4;    // 10
    d -= 1;    // 9
    d %= 4;    // 1
    global.check("chained compound ops == 1",  d is 1);

    // inside a loop
    int sum = 1;
    for(int i = 1; i <= 4; i = i + 1){
        sum *= i;
    }
    global.check("product 1*1*2*3*4 == 24",  sum is 24);

    println("=== compound assignment tests done ===");
}
