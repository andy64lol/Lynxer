////
Fixture for the Rust-backed image stdlib. It uses generated RGBA images so the
test is deterministic and does not need external image assets.
////
global setup(){ import("image"); import("fileIO"); }

global main(){
    int image = global.image.create(2, 2, "RGBA", 10, 20, 30);
    println(image >= 0);
    println(global.image.getWidth(image), "x", global.image.getHeight(image));
    println(global.image.getMode(image));
    println(global.image.getPixel(image, 0, 0));

    println(global.image.setPixel(image, 1, 1, 40, 50, 60));
    println(global.image.getPixel(image, 1, 1));
    println(global.image.setPixelA(image, 0, 1, 70, 80, 90, 128));
    println(global.image.getPixel(image, 0, 1));
    println(global.image.fill(image, 1, 2, 3));
    println(global.image.getPixel(image, 0, 0));

    int padded = global.image.pad(image, 1, 2, 3, 4, 5, 6, 7);
    println(global.image.getWidth(padded), "x", global.image.getHeight(padded));
    println(global.image.getPixel(padded, 0, 0));

    int resized = global.image.resize(image, 4, 3);
    println(global.image.getWidth(resized), "x", global.image.getHeight(resized));
    int gray = global.image.grayscale(image);
    println(global.image.getMode(gray));
    int blended = global.image.blend(image, padded, 0.5);
    println(global.image.getWidth(blended), "x", global.image.getHeight(blended));

    str encoded = global.image.toBase64(image, "png");
    println(returnLength(encoded) > 0);
    println(global.image.toDataUrl(image, "png") isnt "");
    int decoded = global.image.fromBase64(encoded);
    println(global.image.getWidth(decoded), "x", global.image.getHeight(decoded));
    println(global.image.info(decoded));

    println(global.image.close(image));
    println(global.image.close(padded));
    println(global.image.close(resized));
    println(global.image.close(gray));
    println(global.image.close(blended));
    println(global.image.close(decoded));

    // Failure paths return a sentinel rather than raising: a missing file, a
    // file that is not an image, malformed base64, and invalid handles. Scratch
    // names under the cwd, so the fixture works from any directory.
    str notAnImage = ".clynxer_scratch_not_an_image.txt";
    global.fileIO.writeFile(notAnImage, "this is text, not an image\n");
    println(global.image.open(".clynxer_scratch_missing.png"));
    println(global.image.open(notAnImage));
    println(global.image.fromBase64("not base64 !!"));
    println(global.image.getWidth(-1));
    println(global.image.getMode(-1));
    println(global.image.info(-1));
    println(global.image.copy(-1));
    println(global.image.close(-1));
    println(global.image.save(-1, ".clynxer_scratch_unused.png"));
    println(global.image.resize(-1, 2, 2));
    println(global.fileIO.deleteFile(notAnImage));
}