////
Fixture for the Rust-backed sound stdlib. It needs no audio device: loading,
duration, handle bookkeeping and every error path are device-independent.
Playback itself depends on the device, so `playSound` is exercised but its result
is not asserted.
////

global setup(){ import("sound"); import("fileIO"); }

global main(){
    // Scratch names under the cwd, so the fixture works from any directory.
    str missing = ".clynxer_scratch_missing.wav";

    // `make test` runs fixtures from `clynxer/`, but they are also expected to
    // run from the repository root, so resolve the asset against both layouts.
    str toneFile = "examples/assets/tone.wav";
    if(not global.fileIO.fileExists(toneFile)){
        toneFile = "clynxer/examples/assets/tone.wav";
    }

    // A missing file is a sentinel, not an exception.
    println(global.sound.loadSound(missing));
    println(global.sound.loadSoundStreaming(missing));

    // Loading a real file yields a handle and reports its decoded duration.
    int tone = global.sound.loadSound(toneFile);
    println(tone >= 0);
    println(global.sound.soundCount());
    println(global.sound.getSoundLength(tone));
    println(global.sound.isSoundPlaying(tone));

    // Invalid handles are rejected without failing the process.
    println(global.sound.playSound(-1));
    println(global.sound.playSoundOnce(-1));
    println(global.sound.loopSound(-1));
    println(global.sound.stopSound(-1));
    println(global.sound.pauseSound(-1));
    println(global.sound.resumeSound(-1));
    println(global.sound.setSoundVolume(-1, 0.5));
    println(global.sound.isSoundPlaying(9999));
    println(global.sound.getSoundLength(9999));
    println(global.sound.releaseSound(-1));

    // A second load gets its own handle.
    int second = global.sound.loadSoundStreaming(toneFile);
    println(second >= 0);
    println(global.sound.soundCount());

    // Volume is stored per handle, clamped to [0, 1].
    println(global.sound.setSoundVolume(tone, 0.5));
    println(global.sound.setSoundVolume(tone, 2.0));

    // Starting playback must not be fatal. Its result depends on the audio
    // device, so it is not asserted; stopping a live handle is deterministic.
    global.sound.playSound(tone);
    println(global.sound.stopSound(tone));
    println(global.sound.isSoundPlaying(tone));

    // Releasing is idempotent-safe: the second call reports failure.
    println(global.sound.releaseSound(tone));
    println(global.sound.releaseSound(tone));
    println(global.sound.soundCount());
    println(global.sound.releaseSound(second));
    println(global.sound.soundCount());
}
