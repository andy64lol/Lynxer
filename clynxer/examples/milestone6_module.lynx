global setup(){
    import("milestone6_lib.lynx");
    import("milestone6_lib.lynx");
    importAs("milestone6_lib.lynx", "lib");
    import("math");
    import("colorlib");
    import("typing");
    import("random");
    import("text");
}

global main(){
    println(global.milestone6_lib.VERSION);
    println(global.milestone6_lib.double(21));
    println(global.lib.double(3));
    println(global.math.gcd(84, 30));
    println(global.typing.toStr(7));
    println(global.colorlib.red("ok"));
    println(global.math.isPrime(97));
    println(global.text.reverse("abc"));
    println(global.random.randint(4, 4));
}
