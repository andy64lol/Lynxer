////
arm64 (aarch64) syscall fixture.

Runs only in the ARM64 CI job. On this architecture the portable wrappers use
ppoll(2) and epoll_pwait(2), and the ARM64-only wrappers (ppoll with a timespec,
epoll_pwait with an explicit signal mask) are also called directly. Every
printed value is a property, so the expected output in arm64Syscalls.expected
is stable.
////

global setup() {}

global main() {
    println("== pipe ==");
    int buffer = memoryAllocate(64);
    int pipeFds = memoryAllocate(16);
    println("pipe created ", syscallCreatePipe(pipeFds, 0) is 0);
    int readFd = memoryReadInt32(pipeFds, 0);
    int writeFd = memoryReadInt32(pipeFds, 4);
    println("descriptors valid ", readFd >= 0 and writeFd >= 0);

    memoryWriteByte(buffer, 0, 65);   // 'A'
    println("write 1 byte ", syscallWrite(writeFd, buffer, 1) is 1);

    // struct pollfd { int fd; short events; short revents; } -- 8 bytes, the
    // same layout on amd64 and arm64. POLLIN is 1. The portable wrapper routes
    // to ppoll(2) on arm64.
    int pollFds = memoryAllocate(8);
    memoryWriteInt32(pollFds, 0, readFd);
    memoryWriteInt16(pollFds, 4, 1);
    memoryWriteInt16(pollFds, 6, 0);
    println("poll ready ", syscallPollFileDescriptors(pollFds, 1, 0) is 1);
    println("poll POLLIN ", memoryReadInt16(pollFds, 6) is 1);

    // ARM64-only: raw ppoll(2) with a zero timespec and a null signal mask
    // (sigsetsize is sizeof(sigset_t) on arm64, 8).
    int timespec = memoryAllocate(16);
    memoryWriteInt64(timespec, 0, 0);   // tv_sec
    memoryWriteInt64(timespec, 8, 0);   // tv_nsec
    println("ppoll ready ",
            syscallPpollFileDescriptors(pollFds, 1, timespec, 0, 8) is 1);

    println("== event poll ==");
    int epoll = syscallCreateEventPoll(0);
    println("epoll created ", epoll > 0);
    int events = memoryAllocate(64);
    println("epoll wait empty ", syscallWaitForEvents(epoll, events, 1, 0, 0) is 0);
    println("epoll_pwait empty ",
            syscallWaitForEventsWithSignalMask(epoll, events, 1, 0, 0) is 0);

    syscallClose(epoll);
    syscallClose(readFd);
    syscallClose(writeFd);
    memoryFree(events);
    memoryFree(timespec);
    memoryFree(pollFds);
    memoryFree(pipeFds);
    memoryFree(buffer);
    println("done");
}
