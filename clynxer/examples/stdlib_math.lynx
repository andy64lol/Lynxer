////
Fixture for the math stdlib, including the statistics and vector helpers that
used to live in a separate `mathPlus` module. Interpreted only (module imports
are not bytecode-compilable).
////
global setup(){ import("math"); }

global main(){
    println(global.math.abs(-5));
    println(global.math.absFloat(-2.5));
    println(global.math.max(3, 9));
    println(global.math.min(3, 9));
    println(global.math.clamp(11, 0, 10));
    println(global.math.pow(2, 10));
    println(global.math.sqrt(16.0));
    println(global.math.sign(-4));
    println(global.math.isEven(8));
    println(global.math.isOdd(8));
    println(global.math.factorial(5));
    println(global.math.gcd(12, 18));
    println(global.math.lcm(4, 6));
    println(global.math.isPrime(97));
    println(global.math.nextPrime(100));
    println(global.math.binomial(5, 2));
    println(global.math.sumRange(1, 4));
    println(global.math.isqrt(50));
    println(global.math.floor(2.7));
    println(global.math.ceil(2.1));
    println(global.math.round(2.5));
    println(global.math.truncate(-2.7));
    println(global.math.roundTo(3.14159, 2));
    println(global.math.fmod(7.5, 2.0));
    println(global.math.pi());
    println(global.math.tau());
    println(global.math.gcd(0, 0));
    println(global.math.maxInt() > 0);
    println(global.math.minInt() < 0);

    // List helpers.
    println(global.math.mean(seqFromTo(1, 5, 1)));
    println(global.math.prod(seqFromTo(1, 4, 1)));
    println(global.math.norm(seqFromTo(3, 5, 1)));
    println(global.math.argmax(seqFromTo(1, 5, 1)));
    println(global.math.argmin(seqFromTo(5, 1, -1)));
    println(global.math.median(seqFromTo(1, 5, 1)));
    println(global.math.median(seqFromTo(1, 4, 1)));
    println(global.math.std(seqFromTo(1, 5, 1)));
    println(global.math.variance(seqFromTo(1, 5, 1)));
    println(global.math.percentile(seqFromTo(1, 5, 1), 50.0));
    println(global.math.dot(seqFromTo(1, 3, 1), seqFromTo(4, 6, 1)));
    println(global.math.corrcoef(seqFromTo(1, 3, 1), seqFromTo(2, 6, 2)));
    println(global.math.linspace(0.0, 1.0, 5));
    println(global.math.cumsum(seqFromTo(1, 4, 1)));
    println(global.math.diff(seqFromTo(1, 4, 1)));
    println(global.math.clip(seqFromTo(1, 5, 1), 2.0, 4.0));

    list pair = listPush(listPush(listRepeat(0, 0), 3), 4);
    println(global.math.normalize(pair));
    println(global.math.dot(pair, pair));
    println(global.math.median(pair));
    println(global.math.percentile(pair, 25.0));

    list empty = listRepeat(0, 0);
    println(global.math.median(empty));
    println(global.math.median(empty) == 0.0);
    println(global.math.linspace(0.0, 1.0, 0));
}
