////
stdlibTestAll.lynx — one self-checking test for every clynxer stdlib module.

It imports every stdlib module in `setup()` and then asserts the behaviour of
each one against the values pinned by the per-module `stdlib_*.lynx` fixtures.
All modules are covered, including the Rust-backed `game`, `image`, `json`,
`lua`, `network` and `server` crates.
`check(actual, expected, label)` renders the actual value with `strOf` and
compares it to the expected text, so a mismatch prints both values and the run
continues; at the end the program exits with status 1 if any check failed.

The test is location-independent: it works from any working directory (all
filesystem checks use scratch files it creates and removes) and forces the game
module into headless mode itself, so no environment variable is required:

    ./clynxer examples/stdlibTestAll.lynx
////

global setup(){
    import("math");
    import("time");
    import("shell");
    import("sys");
    import("typing");
    import("text");
    import("colorlib");
    import("random");
    import("multiprocessing");
    import("js");
    import("lua");
    import("csv");
    import("regex");
    import("re");
    import("cli");
    import("debug");
    import("image");
    import("fileIO");
    import("os");
    import("server");
    import("path");
    import("json");
    import("network");
    // Graphics needs a display, which a CI runner does not have. When the suite
    // sets CLYNXER_SKIP_DISPLAY=1 the game module is not imported and the game
    // section below is skipped; every other module still runs.
    str skipDisplayValue = global.os.getenv("CLYNXER_SKIP_DISPLAY");
    bool skipDisplay = skipDisplayValue is "1";
    if(not skipDisplay){
        import("game");
    }
}

// Compare the rendered form of `actual` to `expected`, reporting mismatches
// without aborting so a single run lists every failing check.
global check(any actual, str expected, str label){
    str rendered = strOf(actual);
    if(rendered is expected){
        println("ok   ", label);
        return 0;
    }
    println("FAIL ", label, "  expected=[", expected, "]  actual=[", rendered, "]");
    return 1;
}

// Frame callbacks registered with the game module; headless `run()` drives them
// for a few deterministic frames.
global onUpdate(float dt){
    println("game.update ", dt);
}

global onDraw(){
    println("game.draw");
}

global main(){
    int fails = 0;

    // ------------------------------------------------------------------ math
    println("== math ==");
    fails += global.check(global.math.abs(-5), "5", "math.abs");
    fails += global.check(global.math.absFloat(-2.5), "2.5", "math.absFloat");
    fails += global.check(global.math.max(3, 9), "9", "math.max");
    fails += global.check(global.math.min(3, 9), "3", "math.min");
    fails += global.check(global.math.clamp(11, 0, 10), "10", "math.clamp");
    fails += global.check(global.math.pow(2, 10), "1024", "math.pow");
    fails += global.check(global.math.sqrt(16.0), "4", "math.sqrt");
    fails += global.check(global.math.sign(-4), "-1", "math.sign");
    fails += global.check(global.math.isEven(8), "true", "math.isEven");
    fails += global.check(global.math.isOdd(8), "false", "math.isOdd");
    fails += global.check(global.math.factorial(5), "120", "math.factorial");
    fails += global.check(global.math.gcd(12, 18), "6", "math.gcd");
    fails += global.check(global.math.lcm(4, 6), "12", "math.lcm");
    fails += global.check(global.math.isPrime(97), "true", "math.isPrime");
    fails += global.check(global.math.nextPrime(100), "101", "math.nextPrime");
    fails += global.check(global.math.binomial(5, 2), "10", "math.binomial");
    fails += global.check(global.math.sumRange(1, 4), "10", "math.sumRange");
    fails += global.check(global.math.isqrt(50), "7", "math.isqrt");
    fails += global.check(global.math.floor(2.7), "2", "math.floor");
    fails += global.check(global.math.ceil(2.1), "3", "math.ceil");
    fails += global.check(global.math.round(2.5), "3", "math.round");
    fails += global.check(global.math.truncate(-2.7), "-2", "math.truncate");
    fails += global.check(global.math.roundTo(3.14159, 2), "3.14", "math.roundTo");
    fails += global.check(global.math.fmod(7.5, 2.0), "1.5", "math.fmod");
    fails += global.check(global.math.pi(), "3.141592653589793", "math.pi");
    fails += global.check(global.math.tau(), "6.283185307179586", "math.tau");
    fails += global.check(global.math.gcd(0, 0), "0", "math.gcd.zero");
    fails += global.check(global.math.maxInt() > 0, "true", "math.maxInt");
    fails += global.check(global.math.minInt() < 0, "true", "math.minInt");
    fails += global.check(global.math.mean(seqFromTo(1, 5, 1)), "2.5", "math.mean");
    fails += global.check(global.math.prod(seqFromTo(1, 4, 1)), "6", "math.prod");
    fails += global.check(global.math.norm(seqFromTo(3, 5, 1)), "5", "math.norm");
    fails += global.check(global.math.argmax(seqFromTo(1, 5, 1)), "3", "math.argmax");
    fails += global.check(global.math.argmin(seqFromTo(5, 1, -1)), "3", "math.argmin");
    fails += global.check(global.math.median(seqFromTo(1, 5, 1)), "2.5", "math.median.odd");
    fails += global.check(global.math.median(seqFromTo(1, 4, 1)), "2", "math.median.even");
    fails += global.check(global.math.std(seqFromTo(1, 5, 1)), "1.118033988749895", "math.std");
    fails += global.check(global.math.variance(seqFromTo(1, 5, 1)), "1.25", "math.variance");
    fails += global.check(global.math.percentile(seqFromTo(1, 5, 1), 50.0), "2.5", "math.percentile");
    fails += global.check(global.math.dot(seqFromTo(1, 3, 1), seqFromTo(4, 6, 1)), "14", "math.dot");
    fails += global.check(global.math.corrcoef(seqFromTo(1, 3, 1), seqFromTo(2, 6, 2)), "1", "math.corrcoef");
    fails += global.check(global.math.linspace(0.0, 1.0, 5), "[0.0, 0.25, 0.5, 0.75, 1.0]", "math.linspace");
    fails += global.check(global.math.cumsum(seqFromTo(1, 4, 1)), "[1.0, 3.0, 6.0]", "math.cumsum");
    fails += global.check(global.math.diff(seqFromTo(1, 4, 1)), "[1.0, 1.0]", "math.diff");
    fails += global.check(global.math.clip(seqFromTo(1, 5, 1), 2.0, 4.0), "[2.0, 2.0, 3.0, 4.0]", "math.clip");
    list pair = listPush(listPush(listRepeat(0, 0), 3), 4);
    fails += global.check(global.math.normalize(pair), "[0.6, 0.8]", "math.normalize");
    fails += global.check(global.math.dot(pair, pair), "25", "math.dot.pair");
    fails += global.check(global.math.median(pair), "3.5", "math.median.pair");
    fails += global.check(global.math.percentile(pair, 25.0), "3.25", "math.percentile.pair");
    list noneList = listRepeat(0, 0);
    fails += global.check(global.math.median(noneList), "0", "math.median.empty");
    fails += global.check(global.math.median(noneList) is 0.0, "true", "math.median.empty.eq");
    fails += global.check(global.math.linspace(0.0, 1.0, 0), "[]", "math.linspace.empty");

    // ---------------------------------------------------------------- typing
    println("== typing ==");
    fails += global.check(global.typing.typeOf(1), "int", "typing.typeOf.int");
    fails += global.check(global.typing.typeOf(1.5), "float", "typing.typeOf.float");
    fails += global.check(global.typing.typeOf("x"), "str", "typing.typeOf.str");
    fails += global.check(global.typing.typeOf(true), "bool", "typing.typeOf.bool");
    fails += global.check(global.typing.toStr(42), "42", "typing.toStr");
    fails += global.check(global.typing.toInt("42"), "42", "typing.toInt");
    fails += global.check(global.typing.toFloat("1.5"), "1.5", "typing.toFloat");
    fails += global.check(global.typing.toBool(1), "true", "typing.toBool");
    fails += global.check(global.typing.isNumeric(3), "true", "typing.isNumeric.int");
    fails += global.check(global.typing.isNumeric("3"), "false", "typing.isNumeric.str");
    fails += global.check(global.typing.lenStr("abcd"), "4", "typing.lenStr");
    fails += global.check(global.typing.isByte(200), "true", "typing.isByte.true");
    fails += global.check(global.typing.isByte(300), "false", "typing.isByte.false");
    fails += global.check(global.typing.isInt8(200), "false", "typing.isInt8.false");
    fails += global.check(global.typing.isInt8(-5), "true", "typing.isInt8.true");
    fails += global.check(global.typing.isInt16(40000), "false", "typing.isInt16.false");
    fails += global.check(global.typing.isInt32(2147483647), "true", "typing.isInt32.true");

    // ------------------------------------------------------------------ text
    println("== text ==");
    fails += global.check(global.text.reverse("abc"), "cba", "text.reverse");
    fails += global.check(global.text.repeat("ab", 3), "ababab", "text.repeat");
    fails += global.check(global.text.trim("  hi  "), "hi", "text.trim");
    fails += global.check(global.text.contains("hello", "ell"), "true", "text.contains.true");
    fails += global.check(global.text.contains("hello", ""), "true", "text.contains.empty");
    fails += global.check(global.text.contains("hello", "z"), "false", "text.contains.false");
    fails += global.check(global.text.startsWith("hello", "he"), "true", "text.startsWith.true");
    fails += global.check(global.text.startsWith("hello", "lo"), "false", "text.startsWith.false");
    fails += global.check(global.text.endsWith("hello", "lo"), "true", "text.endsWith.true");
    fails += global.check(global.text.count("banana", "na"), "2", "text.count");
    fails += global.check(global.text.count("banana", ""), "0", "text.count.empty");
    fails += global.check(global.text.replace("aaa", "a", "b"), "bbb", "text.replace");
    fails += global.check(global.text.upper("abc"), "ABC", "text.upper");
    fails += global.check(global.text.lower("ABC"), "abc", "text.lower");
    fails += global.check(global.text.isEmpty(""), "true", "text.isEmpty.true");
    fails += global.check(global.text.isEmpty("a"), "false", "text.isEmpty.false");
    fails += global.check(global.text.isBlank("  "), "true", "text.isBlank.true");
    fails += global.check(global.text.isBlank(" a "), "false", "text.isBlank.false");

    // -------------------------------------------------------------- colorlib
    println("== colorlib ==");
    fails += global.check(global.colorlib.red("x") is global.colorlib.ansi("x", "31"), "true", "colorlib.red");
    fails += global.check(global.colorlib.bgBlue("x") is global.colorlib.ansi("x", "44"), "true", "colorlib.bgBlue");
    fails += global.check(global.colorlib.bold("x") is global.colorlib.ansi("x", "1"), "true", "colorlib.bold");
    fails += global.check(global.colorlib.error("x") is global.colorlib.ansi("x", "1;31"), "true", "colorlib.error");
    fails += global.check(global.colorlib.success("x") is global.colorlib.ansi("x", "1;32"), "true", "colorlib.success");
    fails += global.check(returnLength(global.colorlib.reset()) > 0, "true", "colorlib.reset");
    fails += global.check(returnLength(global.colorlib.clearScreen()) > 0, "true", "colorlib.clearScreen");
    fails += global.check(returnLength(global.colorlib.cursorHome()) > 0, "true", "colorlib.cursorHome");
    fails += global.check(global.colorlib.ansi("x", "90") isnt global.colorlib.ansi("x", "30"), "true", "colorlib.brightDistinct");

    // ------------------------------------------------------------------ json
    println("== json ==");
    str object = "{\"name\": \"Ada\", \"age\": 36, \"active\": true}";
    fails += global.check(global.json.jsonValid(object), "true", "json.jsonValid.true");
    fails += global.check(global.json.jsonValid("{bad"), "false", "json.jsonValid.false");
    fails += global.check(global.json.jsonParse("{\"a\": 1, \"b\": [1, 2]}"), "{\n  \"a\": 1,\n  \"b\": [\n    1,\n    2\n  ]\n}", "json.jsonParse");
    fails += global.check(global.json.jsonPretty("{\"a\": 1}"), "{\n    \"a\": 1\n}", "json.jsonPretty");
    fails += global.check(global.json.jsonGet(object, "name"), "Ada", "json.jsonGet.str");
    fails += global.check(global.json.jsonGet(object, "age"), "36", "json.jsonGet.int");
    fails += global.check(global.json.jsonGetInt(object, "age"), "36", "json.jsonGetInt");
    fails += global.check(global.json.jsonGetFloat(object, "age"), "36", "json.jsonGetFloat");
    fails += global.check(global.json.jsonGetBool(object, "active"), "true", "json.jsonGetBool");
    fails += global.check(global.json.jsonGet(object, "missing"), "", "json.jsonGet.missing");
    fails += global.check(global.json.jsonKeys(object), "name,age,active", "json.jsonKeys");
    fails += global.check(global.json.jsonHas(object, "age"), "true", "json.jsonHas.true");
    fails += global.check(global.json.jsonHas(object, "nope"), "false", "json.jsonHas.false");
    fails += global.check(global.json.jsonLength(object), "3", "json.jsonLength.object");
    fails += global.check(global.json.jsonLength("[1, 2, 3]"), "3", "json.jsonLength.array");
    fails += global.check(global.json.jsonStringify("he\"llo"), "\"he\\\"llo\"", "json.jsonStringify");
    fails += global.check(global.json.jsonSet("{\"a\": 1}", "b", "2"), "{\"a\": 1, \"b\": 2}", "json.jsonSet.num");
    fails += global.check(global.json.jsonSet("{\"a\": 1}", "b", "hello"), "{\"a\": 1, \"b\": \"hello\"}", "json.jsonSet.str");
    fails += global.check(global.json.jsonSetInt("{\"a\": 1}", "b", 5), "{\"a\": 1, \"b\": 5}", "json.jsonSetInt");
    fails += global.check(global.json.jsonDelete("{\"a\": 1, \"b\": 2}", "a"), "{\"b\": 2}", "json.jsonDelete");
    fails += global.check(global.json.jsonMerge("{\"a\": 1, \"b\": 2}", "{\"b\": 3, \"c\": 4}"), "{\"a\": 1, \"b\": 3, \"c\": 4}", "json.jsonMerge");
    fails += global.check(global.json.jsonType(object, "name"), "string", "json.jsonType.str");
    fails += global.check(global.json.jsonType(object, "age"), "int", "json.jsonType.int");
    fails += global.check(global.json.jsonType(object, "active"), "bool", "json.jsonType.bool");
    fails += global.check(global.json.jsonType(object, "missing"), "null", "json.jsonType.null");
    fails += global.check(global.json.jsonBuild("name=Alice|age=30"), "{\"name\": \"Alice\", \"age\": \"30\"}", "json.jsonBuild");
    fails += global.check(global.json.jsonArray(listRepeat(7, 3)), "[7, 7, 7]", "json.jsonArray");
    list jsonPairs = listPush(listPush(listPush(listPush(listRepeat("", 0), "a"), 1), "b"), 2);
    fails += global.check(global.json.jsonObject(jsonPairs), "{\"a\": 1, \"b\": 2}", "json.jsonObject");
    fails += global.check(global.json.jsonValid("[1, 2, 3]"), "true", "json.jsonValid.array");
    fails += global.check(global.json.jsonValid("42"), "true", "json.jsonValid.scalar");
    fails += global.check(global.json.jsonParse("{bad"), "", "json.jsonParse.invalid");
    fails += global.check(global.json.jsonPretty("{\"a\": [1, 2]}"), "{\n    \"a\": [\n        1,\n        2\n    ]\n}", "json.jsonPretty.nested");
    fails += global.check(global.json.jsonLength("\"hello\""), "1", "json.jsonLength.string");
    fails += global.check(global.json.jsonLength("42"), "0", "json.jsonLength.scalar");
    fails += global.check(global.json.jsonLength("hello"), "0", "json.jsonLength.invalid");
    fails += global.check(global.json.jsonGetInt("{\"n\": \"42\"}", "n"), "42", "json.jsonGetInt.numericStr");
    fails += global.check(global.json.jsonGetInt("{\"n\": 3.9}", "n"), "3", "json.jsonGetInt.float");
    fails += global.check(global.json.jsonGetInt("{\"n\": \"3.9\"}", "n"), "0", "json.jsonGetInt.floatStr");
    fails += global.check(global.json.jsonGetInt("{\"n\": true}", "n"), "1", "json.jsonGetInt.bool");
    fails += global.check(global.json.jsonGetFloat("{\"n\": \"2.5\"}", "n"), "2.5", "json.jsonGetFloat.str");
    fails += global.check(global.json.jsonGetFloat("{\"n\": true}", "n"), "1", "json.jsonGetFloat.bool");
    fails += global.check(global.json.jsonGetBool("{\"n\": 0}", "n"), "false", "json.jsonGetBool.zero");
    fails += global.check(global.json.jsonGetBool("{\"n\": \"\"}", "n"), "false", "json.jsonGetBool.emptyStr");
    fails += global.check(global.json.jsonGetBool("{\"n\": []}", "n"), "false", "json.jsonGetBool.emptyArray");
    fails += global.check(global.json.jsonGetBool("{\"n\": [1]}", "n"), "true", "json.jsonGetBool.array");
    fails += global.check(global.json.jsonType("{\"n\": 3.5}", "n"), "float", "json.jsonType.float");
    fails += global.check(global.json.jsonType("{\"n\": [1]}", "n"), "array", "json.jsonType.array");
    fails += global.check(global.json.jsonType("{\"n\": {}}", "n"), "object", "json.jsonType.object");
    fails += global.check(global.json.jsonType("[1]", "n"), "unknown", "json.jsonType.unknown");
    fails += global.check(global.json.jsonHas("[1, \"two\", 3]", "two"), "true", "json.jsonHas.array.true");
    fails += global.check(global.json.jsonHas("[1, \"two\", 3]", "nope"), "false", "json.jsonHas.array.false");
    fails += global.check(global.json.jsonKeys("[1, 2]"), "", "json.jsonKeys.array");
    fails += global.check(global.json.jsonStringify("42"), "\"42\"", "json.jsonStringify.number");
    fails += global.check(global.json.jsonSet("[1, 2]", "a", "1"), "[1, 2]", "json.jsonSet.nonObject");
    fails += global.check(global.json.jsonSetInt("[1, 2]", "a", 1), "[1, 2]", "json.jsonSetInt.nonObject");
    fails += global.check(global.json.jsonDelete("[1, 2]", "a"), "[1, 2]", "json.jsonDelete.nonObject");
    fails += global.check(global.json.jsonMerge("[1]", "{\"a\": 1}"), "[1]", "json.jsonMerge.nonObject");
    fails += global.check(global.json.jsonBuild(""), "{}", "json.jsonBuild.empty");
    fails += global.check(global.json.jsonBuild("a=1|broken|b = 2"), "{\"a\": \"1\", \"b\": \"2\"}", "json.jsonBuild.skip");

    // ------------------------------------------------------------------- csv
    println("== csv ==");
    str csvData = "name,age,city\nalpha,30,London\nbeta,25,Paris\ngamma,30,London\n";
    fails += global.check(global.csv.parseRows(csvData), "[[\"name\", \"age\", \"city\"], [\"alpha\", \"30\", \"London\"], [\"beta\", \"25\", \"Paris\"], [\"gamma\", \"30\", \"London\"]]", "csv.parseRows");
    fails += global.check(global.csv.parseHeaders(csvData), "[\"name\", \"age\", \"city\"]", "csv.parseHeaders");
    fails += global.check(global.csv.parseToJson(csvData), "[{\"name\": \"alpha\", \"age\": \"30\", \"city\": \"London\"}, {\"name\": \"beta\", \"age\": \"25\", \"city\": \"Paris\"}, {\"name\": \"gamma\", \"age\": \"30\", \"city\": \"London\"}]", "csv.parseToJson");
    fails += global.check(global.csv.getColumn(csvData, "name"), "[\"alpha\", \"beta\", \"gamma\"]", "csv.getColumn");
    fails += global.check(global.csv.getRow(csvData, 1), "[\"beta\", \"25\", \"Paris\"]", "csv.getRow");
    fails += global.check(global.csv.getRow(csvData, 9), "[]", "csv.getRow.oob");
    fails += global.check(global.csv.rowCount(csvData), "3", "csv.rowCount");
    fails += global.check(global.csv.colCount(csvData), "3", "csv.colCount");
    fails += global.check(global.csv.hasColumn(csvData, "age"), "1", "csv.hasColumn.true");
    fails += global.check(global.csv.hasColumn(csvData, "nope"), "0", "csv.hasColumn.false");
    fails += global.check(global.csv.getColumn("a,b\n1,2\n", "missing"), "[\"\"]", "csv.getColumn.missing");
    fails += global.check(global.csv.buildCSV("[{\"name\": \"alpha\", \"age\": 30}, {\"name\": \"beta\", \"age\": 25}]", "name,age"), "name,age\r\nalpha,30\r\nbeta,25\r\n", "csv.buildCSV");
    fails += global.check(global.csv.appendRow("a,b\n1,2\n", "[\"x\", \"y\"]"), "a,b\n1,2\nx,y\r\n", "csv.appendRow");
    fails += global.check(global.csv.filterRows(csvData, "city", "London"), "name,age,city\r\nalpha,30,London\r\ngamma,30,London\r\n", "csv.filterRows");
    fails += global.check(global.csv.sortCSV(csvData, "name"), "name,age,city\r\nalpha,30,London\r\nbeta,25,Paris\r\ngamma,30,London\r\n", "csv.sortCSV");
    fails += global.check(global.csv.sortCSVDesc(csvData, "name"), "name,age,city\r\ngamma,30,London\r\nbeta,25,Paris\r\nalpha,30,London\r\n", "csv.sortCSVDesc");
    fails += global.check(global.csv.columnStats(csvData, "age"), "{\"count\": 3, \"min\": 25.0, \"max\": 30.0, \"sum\": 85.0, \"mean\": 28.333333333333332}", "csv.columnStats.numeric");
    fails += global.check(global.csv.columnStats(csvData, "name"), "{}", "csv.columnStats.nonNumeric");
    fails += global.check(global.csv.toTSV(csvData), "name\tage\tcity\r\nalpha\t30\tLondon\r\nbeta\t25\tParis\r\ngamma\t30\tLondon\r\n", "csv.toTSV");
    fails += global.check(global.csv.fromTSV("a\tb\n1\t2\n"), "a,b\r\n1,2\r\n", "csv.fromTSV");
    fails += global.check(global.csv.parseDelimited("a;b\n1;2\n", ";"), "[{\"a\": \"1\", \"b\": \"2\"}]", "csv.parseDelimited");
    str quoted = "name,note\nalpha,\"hello, world\"\nbeta,\"say \"\"hi\"\"\"\n";
    fails += global.check(global.csv.parseRows(quoted), "[[\"name\", \"note\"], [\"alpha\", \"hello, world\"], [\"beta\", \"say \\\"hi\\\"\"]]", "csv.parseRows.quoted");
    fails += global.check(global.csv.buildCSV("[{\"name\": \"alpha\", \"note\": \"a,b\"}]", "name,note"), "name,note\r\nalpha,\"a,b\"\r\n", "csv.buildCSV.quoted");

    // ----------------------------------------------------------------- regex
    println("== regex ==");
    global.regex.compile("digits", "\\d+", "");
    fails += global.check(global.regex.testCompiled("digits", "abc123"), "1", "regex.testCompiled");
    fails += global.check(global.regex.matchCompiled("digits", "abc123def"), "123", "regex.matchCompiled");
    fails += global.check(global.regex.findallCompiled("digits", "a1 b22"), "[\"1\", \"22\"]", "regex.findallCompiled");
    fails += global.check(global.regex.subCompiled("digits", "#", "a1 b22"), "a# b#", "regex.subCompiled");
    global.regex.compile("shout", "abc", "I");
    fails += global.check(global.regex.testCompiled("shout", "ABC"), "1", "regex.testCompiled.ignoreCase");
    fails += global.check(global.regex.cacheKeys(), "[\"digits\", \"shout\"]", "regex.cacheKeys");
    fails += global.check(global.regex.isValid("\\d+"), "1", "regex.isValid.true");
    fails += global.check(global.regex.isValid("(unclosed"), "0", "regex.isValid.false");
    fails += global.check(global.regex.extract("(?P<user>\\w+)@(?P<host>\\w+)", "alice@example"), "{\"user\": \"alice\", \"host\": \"example\"}", "regex.extract");
