    fails += global.check(global.game.mouseRight(), "false", "game.mouseRight");
    fails += global.check(global.game.mouseButtonPressed("LEFT"), "false", "game.mouseButtonPressed");
    fails += global.check(global.game.mouseButtonReleased("LEFT"), "false", "game.mouseButtonReleased");
    fails += global.check(global.game.mouseButtonCode("LEFT"), "0", "game.mouseButtonCode");
    fails += global.check(global.game.keyCode("SPACE"), "32", "game.keyCode");
    global.game.setUpdateCallback("onUpdate");
    global.game.setDrawCallback("onDraw");
    global.game.run();
    global.game.close();
    } else {
        println("== game (skipped: CLYNXER_SKIP_DISPLAY=1) ==");
    }

    // ===== END CHECKS =====

    println("=== stdlibTestAll: ", strOf(fails), " failure(s) ===");
    assert(fails is 0, "stdlibTestAll: " + strOf(fails) + " check(s) failed");
}
