////
Lynxer standard library: network.
HTTP and WebSocket client backed by cpp-httplib (`stdlib/network.so`).
Replaces the older `http` and `net` modules for Clynxer.
////
global setup(){ importAs("network.so", "nativeNetwork"); }

global get(str url) -> str { return global.nativeNetwork.get(url); }
global getStatus(str url) -> int { return global.nativeNetwork.getStatus(url); }
global getHeaders(str url) -> str { return global.nativeNetwork.getHeaders(url); }
global post(str url, str body, str contentType) -> str {
    return global.nativeNetwork.post(url, body, contentType);
}
global put(str url, str body, str contentType) -> str {
    return global.nativeNetwork.put(url, body, contentType);
}
global delete(str url) -> str { return global.nativeNetwork.delete(url); }
global patch(str url, str body, str contentType) -> str {
    return global.nativeNetwork.patch(url, body, contentType);
}
global getJson(str url) -> str { return global.nativeNetwork.getJson(url); }
global postJson(str url, str jsonBody) -> str {
    return global.nativeNetwork.postJson(url, jsonBody);
}
global download(str url, str filepath) -> str {
    return global.nativeNetwork.download(url, filepath);
}
global urlencode(str text) -> str { return global.nativeNetwork.urlencode(text); }
global httpHead(str url) -> int { return global.nativeNetwork.httpHead(url); }
global urlScheme(str url) -> str { return global.nativeNetwork.urlScheme(url); }
global urlHost(str url) -> str { return global.nativeNetwork.urlHost(url); }
global urlPath(str url) -> str { return global.nativeNetwork.urlPath(url); }
global urlParse(str url) -> str { return global.nativeNetwork.urlParse(url); }
global getHostname() -> str { return global.nativeNetwork.getHostname(); }
global resolveHost(str hostname) -> str {
    return global.nativeNetwork.resolveHost(hostname);
}
global wsConnect(str name, str uri) -> str {
    return global.nativeNetwork.wsConnect(name, uri);
}
global wsSend(str name, str message) -> str {
    return global.nativeNetwork.wsSend(name, message);
}
global wsReceive(str name) -> str { return global.nativeNetwork.wsReceive(name); }
global wsSendReceive(str name, str message) -> str {
    return global.nativeNetwork.wsSendReceive(name, message);
}
global wsClose(str name) -> str { return global.nativeNetwork.wsClose(name); }
global wsConnected(str name) -> bool {
    return global.nativeNetwork.wsConnected(name) != 0;
}

global main(){}
