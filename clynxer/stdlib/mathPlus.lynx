////
Lynxer standard library: mathPlus.
Extended math and statistics helpers backed by the native C++ modules
`stdlib/mathPlus.so` (statistics/vector) and `stdlib/math.so` (scalar math).

The Python reference implemented the statistics helpers with NumPy; Clynxer
reimplements them natively with the same results (population variance and
standard deviation, NumPy's linear percentile interpolation).
////
global setup(){
    import("math");
    importAs("mathPlus.so", "nativeMathPlus");
}

// ── Re-exported from math ──
global abs(int n) -> int { return global.math.abs(n); }
global max(int a, int b) -> int { return global.math.max(a, b); }
global min(int a, int b) -> int { return global.math.min(a, b); }
global clamp(int val, int lo, int hi) -> int {
    return global.math.clamp(val, lo, hi);
}
global pow(int base, int exp) -> int { return global.math.pow(base, exp); }
global floor(float n) -> float { return global.math.floor(n); }
global ceil(float n) -> float { return global.math.ceil(n); }
global sqrt(float n) -> float { return global.math.sqrt(n); }
global round(float n) -> float { return global.math.round(n); }
global roundNum(float n) -> float { return global.math.roundNum(n); }
global pi() -> float { return global.math.pi(); }
global PI() -> float { return global.math.PI(); }
global Pi() -> float { return global.math.Pi(); }
global e() -> float { return global.math.e(); }
global tau() -> float { return global.math.tau(); }
global log(float n) -> float { return global.math.log(n); }
global log2(float n) -> float { return global.math.log2(n); }
global log10(float n) -> float { return global.math.log10(n); }
global exp(float n) -> float { return global.math.exp(n); }
global sin(float n) -> float { return global.math.sin(n); }
global cos(float n) -> float { return global.math.cos(n); }
global tan(float n) -> float { return global.math.tan(n); }
global arcsin(float n) -> float { return global.math.arcsin(n); }
global arccos(float n) -> float { return global.math.arccos(n); }
global arctan(float n) -> float { return global.math.arctan(n); }
global arctan2(float y, float x) -> float { return global.math.arctan2(y, x); }
global sinh(float n) -> float { return global.math.sinh(n); }
global cosh(float n) -> float { return global.math.cosh(n); }
global tanh(float n) -> float { return global.math.tanh(n); }
global degrees(float n) -> float { return global.math.degrees(n); }
global radians(float n) -> float { return global.math.radians(n); }
global sign(float n) -> int {
    if(n < 0.0){ return -1; }
    if(n > 0.0){ return 1; }
    return 0;
}
global isEven(int n) -> bool { return global.math.isEven(n); }
global isOdd(int n) -> bool { return global.math.isOdd(n); }
global factorial(int n) -> int { return global.math.factorial(n); }
global gcd(int a, int b) -> int { return global.math.gcd(a, b); }
global lcm(int a, int b) -> int { return global.math.lcm(a, b); }
global isPrime(int n) -> bool { return global.math.isPrime(n); }
global nextPrime(int n) -> int { return global.math.nextPrime(n); }
global binomial(int n, int k) -> int { return global.math.binomial(n, k); }
global isqrt(int n) -> int { return global.math.isqrt(n); }
global sumRange(int lo, int hi) -> int { return global.math.sumRange(lo, hi); }
global hypot(float a, float b) -> float { return global.math.hypot(a, b); }
global truncate(float n) -> int { return global.math.truncate(n); }
global roundTo(float n, int decimals) -> float {
    return global.math.roundTo(n, decimals);
}
global lerp(float lo, float hi, float t) -> float {
    return global.math.lerp(lo, hi, t);
}
global clampFloat(float val, float lo, float hi) -> float {
    return global.math.clampFloat(val, lo, hi);
}
global mapRange(float value, float inLo, float inHi,
                float outLo, float outHi) -> float {
    return global.math.mapRange(value, inLo, inHi, outLo, outHi);
}
global randInt(int lo, int hi) -> int { return global.math.randInt(lo, hi); }
global randFloat(float lo, float hi) -> float {
    return global.math.randFloat(lo, hi);
}
global mean(list values) -> float { return global.math.mean(values); }
global prod(list values) -> float { return global.math.prod(values); }
global norm(list values) -> float { return global.math.norm(values); }
global argmax(list values) -> int { return global.math.argmax(values); }
global argmin(list values) -> int { return global.math.argmin(values); }

// ── Native statistics and vector helpers ──
global median(list values) -> float {
    return global.nativeMathPlus.median(listJoin(values, "\t"));
}
global std(list values) -> float {
    return global.nativeMathPlus.std(listJoin(values, "\t"));
}
global variance(list values) -> float {
    return global.nativeMathPlus.variance(listJoin(values, "\t"));
}
global percentile(list values, float p) -> float {
    return global.nativeMathPlus.percentile(listJoin(values, "\t"), p);
}
global corrcoef(list a, list b) -> float {
    return global.nativeMathPlus.corrcoef(listJoin(a, "\t"), listJoin(b, "\t"));
}
global dot(list a, list b) -> float {
    return global.nativeMathPlus.dot(listJoin(a, "\t"), listJoin(b, "\t"));
}
global linspace(float start, float stop, int n) -> list {
    str raw = global.nativeMathPlus.linspace(start, stop, n);
    if(raw == ""){ return seqFromTo(0, 0, 1); }
    return splitStr(raw, "\t");
}
global cumsum(list values) -> list {
    str raw = global.nativeMathPlus.cumsum(listJoin(values, "\t"));
    if(raw == ""){ return seqFromTo(0, 0, 1); }
    return splitStr(raw, "\t");
}
global diff(list values) -> list {
    str raw = global.nativeMathPlus.diff(listJoin(values, "\t"));
    if(raw == ""){ return seqFromTo(0, 0, 1); }
    return splitStr(raw, "\t");
}
global clip(list values, float lo, float hi) -> list {
    str raw = global.nativeMathPlus.clip(listJoin(values, "\t"), lo, hi);
    if(raw == ""){ return seqFromTo(0, 0, 1); }
    return splitStr(raw, "\t");
}
global normalize(list values) -> list {
    str raw = global.nativeMathPlus.normalize(listJoin(values, "\t"));
    if(raw == ""){ return seqFromTo(0, 0, 1); }
    return splitStr(raw, "\t");
}

global main(){}
