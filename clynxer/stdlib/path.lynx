////
Lynxer standard library: path.
pathlib-style path manipulation backed by the native C++ module
`stdlib/path.so`.

Paths are plain strings. Functions return "" / an empty list / false / -1 when
the underlying operation fails. `readTextEncoding`/`writeTextEncoding` accept an
encoding argument for API compatibility but always use UTF-8.
////
global setup(){ importAs("path.so", "nativePath"); }

global cwd() -> str { return global.nativePath.cwd(); }
global home() -> str { return global.nativePath.home(); }
global absolute(str path) -> str { return global.nativePath.absolute(path); }
global resolve(str path) -> str { return global.nativePath.resolve(path); }
global expandUser(str path) -> str { return global.nativePath.expandUser(path); }
global join(str base, str child) -> str {
    return global.nativePath.join(base, child);
}
global join3(str first, str second, str third) -> str {
    return global.nativePath.join3(first, second, third);
}
global normalize(str path) -> str { return global.nativePath.normalize(path); }
global name(str path) -> str { return global.nativePath.name(path); }
global stem(str path) -> str { return global.nativePath.stem(path); }
global suffix(str path) -> str { return global.nativePath.suffix(path); }
global suffixes(str path) -> list {
    str raw = global.nativePath.suffixes(path);
    if(raw == ""){ return seqFromTo(0, 0, 1); }
    return splitStr(raw, "\n");
}
global parent(str path) -> str { return global.nativePath.parent(path); }
global anchor(str path) -> str { return global.nativePath.anchor(path); }
global root(str path) -> str { return global.nativePath.root(path); }
global drive(str path) -> str { return global.nativePath.drive(path); }
global isAbsolute(str path) -> bool {
    return global.nativePath.isAbsolute(path) != 0;
}
global parts(str path) -> list {
    str raw = global.nativePath.parts(path);
    if(raw == ""){ return seqFromTo(0, 0, 1); }
    return splitStr(raw, "\n");
}
global match(str path, str pattern) -> bool {
    return global.nativePath.match(path, pattern) != 0;
}
global relativeTo(str path, str base) -> str {
    return global.nativePath.relativeTo(path, base);
}
global withName(str path, str newName) -> str {
    return global.nativePath.withName(path, newName);
}
global withSuffix(str path, str newSuffix) -> str {
    return global.nativePath.withSuffix(path, newSuffix);
}
global exists(str path) -> bool { return global.nativePath.exists(path) != 0; }
global isFile(str path) -> bool { return global.nativePath.isFile(path) != 0; }
global isDir(str path) -> bool { return global.nativePath.isDir(path) != 0; }
global isSymlink(str path) -> bool {
    return global.nativePath.isSymlink(path) != 0;
}
global isMount(str path) -> bool { return global.nativePath.isMount(path) != 0; }
global sameFile(str first, str second) -> bool {
    return global.nativePath.sameFile(first, second) != 0;
}
global iterDir(str path) -> list {
    str raw = global.nativePath.iterDir(path);
    if(raw == ""){ return seqFromTo(0, 0, 1); }
    return splitStr(raw, "\n");
}
global glob(str path, str pattern) -> list {
    str raw = global.nativePath.glob(path, pattern);
    if(raw == ""){ return seqFromTo(0, 0, 1); }
    return splitStr(raw, "\n");
}
global rglob(str path, str pattern) -> list {
    str raw = global.nativePath.rglob(path, pattern);
    if(raw == ""){ return seqFromTo(0, 0, 1); }
    return splitStr(raw, "\n");
}
global mkdir(str path) -> bool { return global.nativePath.mkdir(path) != 0; }
global mkdirs(str path) -> bool { return global.nativePath.mkdirs(path) != 0; }
global rmdir(str path) -> bool { return global.nativePath.rmdir(path) != 0; }
global unlink(str path) -> bool { return global.nativePath.unlink(path) != 0; }
global unlinkMissingOk(str path) -> bool {
    return global.nativePath.unlinkMissingOk(path) != 0;
}
global touch(str path) -> bool { return global.nativePath.touch(path) != 0; }
global rename(str path, str target) -> str {
    return global.nativePath.rename(path, target);
}
global replace(str path, str target) -> str {
    return global.nativePath.replace(path, target);
}
global readText(str path) -> str { return global.nativePath.readText(path); }
global readTextEncoding(str path, str encoding) -> str {
    return global.nativePath.readTextEncoding(path, encoding);
}
global writeText(str path, str content) -> bool {
    return global.nativePath.writeText(path, content) != 0;
}
global writeTextEncoding(str path, str content, str encoding) -> bool {
    return global.nativePath.writeTextEncoding(path, content, encoding) != 0;
}
global appendText(str path, str content) -> bool {
    return global.nativePath.appendText(path, content) != 0;
}
global size(str path) -> int { return global.nativePath.size(path); }
global modifiedTime(str path) -> float {
    return global.nativePath.modifiedTime(path);
}
global asUri(str path) -> str { return global.nativePath.asUri(path); }

global main(){}
