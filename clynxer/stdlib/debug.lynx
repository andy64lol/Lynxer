////
Lynxer standard library: debug.
Debugging, logging, and inspection helpers backed by the native C++ module
`stdlib/debug.so` (timers, timestamps, environment, memory).

Divergence: `typeOf` reports Lynxer's own type names ("none" is mapped to
"null" for parity with the Python reference), and `dump`/`pp` print Lynxer's
`strOf` rendering instead of Python's `repr`.
////
global setup(){
    import("json");
    importAs("debug.so", "nativeDebug");
}

// ── Assertions ──
// Raise a runtime error with msg if condition is false.
global assert(bool cond, str msg) {
    global.assert(cond, msg);
}
// Raise a runtime error if a and b are not equal.
global assertEq(str a, str b, str msg) {
    if(a isnt b){ global.assert(false, msg); }
}
// Raise a runtime error if a and b are equal.
global assertNotEq(str a, str b, str msg) {
    if(a is b){ global.assert(false, msg); }
}
// Raise a runtime error if a is not greater than b.
global assertGt(float a, float b, str msg) {
    if(a <= b){ global.assert(false, msg); }
}
// Raise a runtime error if a is not less than b.
global assertLt(float a, float b, str msg) {
    if(a >= b){ global.assert(false, msg); }
}
// Raise a runtime error if needle is not a substring of haystack.
global assertContains(str haystack, str needle, str msg) {
    bool found = false;
    if(needle is ""){
        found = true;
    } else {
        int index = 0;
        while(index <= returnLength(haystack) - returnLength(needle)){
            if(substring(haystack, index, index + returnLength(needle)) is needle){
                found = true;
                break;
            }
            index = index + 1;
        }
    }
    if(found is false){ global.assert(false, msg); }
}

// ── Type inspection ──
// Return the type name of a value: int, float, str, bool, list, tuple or null.
global typeOf(any val) -> str {
    str name = returnType(val);
    if(name is "none"){ return "null"; }
    return name;
}
// Print the type and value of val to stdout.
global dump(any val) {
    println("[debug.dump] type=" + typeOf(val) + "  value=" + strOf(val));
}
// Return a JSON string describing val: {"type": "...", "value": "..."}.
global inspect(any val) -> str {
    list pairs = listRepeat("", 0);
    pairs = listPush(pairs, "type");
    pairs = listPush(pairs, typeOf(val));
    pairs = listPush(pairs, "value");
    pairs = listPush(pairs, strOf(val));
    return listJsonObject(pairs);
}
// Pretty-print val to stdout (indented JSON for lists).
global pp(any val) {
    if(returnType(val) is "list"){
        println(global.json.jsonPretty(listJsonArray(val)));
        return;
    }
    println(strOf(val));
}

// ── Structured logging ──
// Emit a timestamped log line: [LEVEL timestamp] message.
global log(str level, str msg) {
    println("[" + upper(level) + " " + global.nativeDebug.timestamp() + "] " + msg);
}
global info(str msg) {
    println("[INFO  " + global.nativeDebug.timestamp() + "] " + msg);
}
global warn(str msg) {
    println("[WARN  " + global.nativeDebug.timestamp() + "] " + msg);
}
global error(str msg) {
    println("[ERROR " + global.nativeDebug.timestamp() + "] " + msg);
}
global debug(str msg) {
    println("[DEBUG " + global.nativeDebug.timestamp() + "] " + msg);
}

// ── Timers ──
// Start a named timer.
global startTimer(str label) { global.nativeDebug.startTimer(label); }
// Stop the named timer and return elapsed milliseconds (-1 if unknown).
global stopTimer(str label) -> float { return global.nativeDebug.stopTimer(label); }
// Read elapsed milliseconds without stopping the timer (-1 if unknown).
global elapsed(str label) -> float { return global.nativeDebug.elapsed(label); }
// Return the current high-resolution timestamp in milliseconds.
global clock() -> float { return global.nativeDebug.clock(); }

// ── Environment ──
// Get the value of an environment variable, or "" if not set.
global envGet(str key) -> str { return global.nativeDebug.envGet(key); }
// Return all environment variables as a JSON object.
global envAll() -> str { return global.nativeDebug.envAll(); }

// ── Memory ──
// Return the process peak resident set size in megabytes, or -1.0.
global getMemory() -> float { return global.nativeDebug.getMemory(); }

global main(){}
