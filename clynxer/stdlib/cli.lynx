////
Lynxer standard library: cli.
Extended command-line helpers powered by Click, Typer, and Python's standard library.

Click and Typer objects use integer handles, following the indexed-resource
pattern used by the tkinter and tui modules. JSON strings are used for
structured arguments and results across the Lynxer/Python bridge.
////

global setup(){}

// ── Availability and runtime information ─────────────────────────────────────

global clickExists(){
    bool result = false;
    rawPy(){
        try:
            import click
            result = true
        except Exception:
            result = false
    }
    return result;
}

global typerExists(){
    bool result = false;
    rawPy(){
        try:
            import typer
            result = true
        except Exception:
            result = false
    }
    return result;
}

global clickVersion(){
    str result = "";
    rawPy(){
        try:
            from importlib.metadata import version
            result = version("click")
        except Exception:
            result = ""
    }
    return result;
}

global typerVersion(){
    str result = "";
    rawPy(){
        try:
            from importlib.metadata import version
            result = version("typer")
        except Exception:
            result = ""
    }
