        w = _ctk.CTkButton(builtins._lx_ctk_root, text=text)
        w.pack(pady=6, padx=10, anchor="w")
        builtins._lx_ctk_widgets.append(w)
        idx = len(builtins._lx_ctk_widgets) - 1
    }
    return idx;
}

// Create a CTkButton with custom fill and hover colours.
global ctkButtonStyled(str text, str fg, str hover){
