    }
}

// ── Widget interactions ─────────────────────────────────────────────────────

// Return the string value of Entry, Text, Spinbox, or Combobox widgets.
global getValue(int idx){
    str result = "";
    rawPy(){
        import builtins
        try:
            w = builtins._lx_widgets[idx]
            import tkinter as _tk
            if isinstance(w, _tk.Text):
                result = w.get("1.0", "end-1c")
            else:
                result = w.get()
        except Exception:
            result = ""
    }
    return result;
}

// Set the display text of Label, Button, Checkbutton, or Radiobutton.
global setText(int idx, str text){
    rawPy(){
        import builtins
        try:
            builtins._lx_widgets[idx].configure(text=text)
        except Exception:
            pass
    }
}

// Replace the content of an Entry widget with text.
global setEntryText(int idx, str text){
    rawPy(){
        import builtins, tkinter as _tk
        try:
            w = builtins._lx_widgets[idx]
            w.delete(0, "end")
            w.insert(0, text)
        except Exception:
            pass
    }
}

// Replace the entire content of a Text widget with text.
global setTextBoxContent(int idx, str text){
    rawPy(){
        import builtins, tkinter as _tk
        try:
            w = builtins._lx_widgets[idx]
            w.delete("1.0", "end")
            w.insert("1.0", text)
        except Exception:
            pass
    }
}

// Return true if a Checkbutton at idx is checked.
global isChecked(int idx){
    bool result = false;
    rawPy(){
        import builtins
        try:
            result = bool(builtins._lx_widgets[idx]._lx_var.get())
        except Exception:
            result = False
    }
    return result;
}

// Programmatically check or uncheck a Checkbutton.
global setChecked(int idx, bool checked){
    rawPy(){
        import builtins
        try:
            builtins._lx_widgets[idx]._lx_var.set(bool(checked))
        except Exception:
            pass
    }
}

// Clear the content of an Entry, Text, or Listbox widget.
global clearWidget(int idx){
    rawPy(){
        import builtins, tkinter as _tk
        try:
            w = builtins._lx_widgets[idx]
            if isinstance(w, _tk.Text):
                w.delete("1.0", "end")
            else:
                w.delete(0, "end")
        except Exception:
            pass
    }
}

// Disable a widget (greyed out, non-interactive).
global disableWidget(int idx){
    rawPy(){
        import builtins
        try:
            builtins._lx_widgets[idx].configure(state="disabled")
        except Exception:
            pass
    }
}

// Re-enable a previously disabled widget.
global enableWidget(int idx){
    rawPy(){
        import builtins
        try:
            builtins._lx_widgets[idx].configure(state="normal")
        except Exception:
            pass
    }
}

// Hide a widget (removes from layout without destroying).
global hideWidget(int idx){
    rawPy(){
        import builtins
        try:
            builtins._lx_widgets[idx].pack_forget()
        except Exception:
            pass
    }
}

// Show a previously hidden widget (re-packs it).
global showWidget(int idx){
    rawPy(){
        import builtins
        try:
            builtins._lx_widgets[idx].pack(pady=4, padx=8, anchor="w")
        except Exception:
            pass
    }
}

// Permanently destroy a widget and remove it from the window.
global destroyWidget(int idx){
    rawPy(){
        import builtins
        try:
            builtins._lx_widgets[idx].destroy()
        except Exception:
            pass
    }
}

// Focus (keyboard focus) the widget at idx.
global focusWidget(int idx){
    rawPy(){
        import builtins
        try:
            builtins._lx_widgets[idx].focus_set()
        except Exception:
            pass
    }
