// ── SegmentedButton ────────────────────────────────────────────────────────

// Create a CTkSegmentedButton.  valuesJson is a JSON array of strings.
// Returns widget index.  Read selection with ctkGetValue(idx).
global ctkSegmented(str valuesJson){
    int idx = 0;
    rawPy(){
        import customtkinter as _ctk, builtins, json as _json
        vals = _json.loads(valuesJson) if valuesJson.strip() else []
        w = _ctk.CTkSegmentedButton(builtins._lx_ctk_root, values=vals)
        if vals:
            w.set(vals[0])
        w.pack(pady=6, padx=10, anchor="w")
        builtins._lx_ctk_widgets.append(w)
        idx = len(builtins._lx_ctk_widgets) - 1
    }
    return idx;
}

// ── Slider ─────────────────────────────────────────────────────────────────

// Create a CTkSlider from lo to hi.
// Returns widget index.  Read value with ctkGetSlider(idx).
global ctkSlider(float lo, float hi){
    int idx = 0;
    rawPy(){
        import customtkinter as _ctk, builtins
        w = _ctk.CTkSlider(builtins._lx_ctk_root, from_=lo, to=hi, width=200)
        w.set((lo + hi) / 2)
        w.pack(pady=6, padx=10, anchor="w")
        builtins._lx_ctk_widgets.append(w)
        idx = len(builtins._lx_ctk_widgets) - 1
    }
    return idx;
}

// Return the current float value of a CTkSlider.
global ctkGetSlider(int idx){
    float result = 0.0;
    rawPy(){
        import builtins
        try:
            result = float(builtins._lx_ctk_widgets[idx].get())
        except Exception:
            result = 0.0
    }
    return result;
}

// Set the value of a CTkSlider.
global ctkSetSlider(int idx, float val){
    rawPy(){
        import builtins
        try:
            builtins._lx_ctk_widgets[idx].set(val)
        except Exception:
            pass
    }
}

// ── ProgressBar ────────────────────────────────────────────────────────────

// Create a CTkProgressBar (value 0.0–1.0).
// Returns widget index.  Set with ctkSetProgress(idx, val).
global ctkProgressBar(){
    int idx = 0;
    rawPy(){
        import customtkinter as _ctk, builtins
        w = _ctk.CTkProgressBar(builtins._lx_ctk_root, width=200)
        w.set(0)
        w.pack(pady=6, padx=10, fill="x")
        builtins._lx_ctk_widgets.append(w)
        idx = len(builtins._lx_ctk_widgets) - 1
    }
    return idx;
}

// Set the current value of a CTkProgressBar (0.0 … 1.0).
global ctkSetProgress(int idx, float val){
    rawPy(){
        import builtins
        try:
            builtins._lx_ctk_widgets[idx].set(val)
            builtins._lx_ctk_root.update_idletasks()
        except Exception:
            pass
    }
}

// Return the current value of a CTkProgressBar.
global ctkGetProgress(int idx){
    float result = 0.0;
    rawPy(){
        import builtins
        try:
            result = float(builtins._lx_ctk_widgets[idx].get())
        except Exception:
            result = 0.0
    }
    return result;
}

// ── Frame ──────────────────────────────────────────────────────────────────

// Create a CTkFrame container.  Returns widget index.
global ctkFrame(){
    int idx = 0;
    rawPy(){
        import customtkinter as _ctk, builtins
        w = _ctk.CTkFrame(builtins._lx_ctk_root)
        w.pack(pady=6, padx=10, fill="x")
        builtins._lx_ctk_widgets.append(w)
        idx = len(builtins._lx_ctk_widgets) - 1
    }
    return idx;
}

// Create a CTkScrollableFrame.  Returns widget index.
global ctkScrollFrame(int width, int height){
    int idx = 0;
    rawPy(){
        import customtkinter as _ctk, builtins
        w = _ctk.CTkScrollableFrame(builtins._lx_ctk_root,
                                    width=width, height=height)
        w.pack(pady=6, padx=10, fill="both", expand=True)
        builtins._lx_ctk_widgets.append(w)
        idx = len(builtins._lx_ctk_widgets) - 1
    }
    return idx;
}

// ── TabView ────────────────────────────────────────────────────────────────

// Create a CTkTabview (tabbed container).
// Returns widget index.  Add tabs with ctkAddTab(tvIdx, text).
global ctkTabView(){
    int idx = 0;
    rawPy(){
        import customtkinter as _ctk, builtins
        w = _ctk.CTkTabview(builtins._lx_ctk_root)
        w.pack(pady=6, padx=10, fill="both", expand=True)
        builtins._lx_ctk_widgets.append(w)
        idx = len(builtins._lx_ctk_widgets) - 1
    }
    return idx;
}

// Add a named tab to a CTkTabview.
// tvIdx: tabview widget index.  text: tab label.
global ctkAddTab(int tvIdx, str text){
    rawPy(){
        import builtins
        try:
            builtins._lx_ctk_widgets[tvIdx].add(text)
        except Exception:
            pass
    }
}

// ── Image ──────────────────────────────────────────────────────────────────

// Display an image in a CTk window.  Requires Pillow (pip install Pillow).
// Returns widget index.
global ctkImage(str imagePath, int width, int height){
    int idx = 0;
    rawPy(){
        import customtkinter as _ctk, builtins
        try:
            from PIL import Image as _PILImage
            pil_img = _PILImage.open(imagePath)
            ctk_img = _ctk.CTkImage(pil_img, size=(width, height))
            w = _ctk.CTkLabel(builtins._lx_ctk_root, image=ctk_img, text="")
            w._lx_image = ctk_img
            w.pack(pady=6, padx=10)
            builtins._lx_ctk_widgets.append(w)
            idx = len(builtins._lx_ctk_widgets) - 1
        except Exception:
            idx = -1
    }
    return idx;
}

// ── Layout ─────────────────────────────────────────────────────────────────

// Place a CTk widget at grid position (row, col).
global ctkGrid(int idx, int row, int col){
    rawPy(){
        import builtins
        try:
            w = builtins._lx_ctk_widgets[idx]
            w.pack_forget()
            w.grid(row=row, column=col, padx=6, pady=4, sticky="w")
        except Exception:
            pass
    }
}

// Place a CTk widget at grid position with column span.
global ctkGridSpan(int idx, int row, int col, int colspan){
    rawPy(){
        import builtins
        try:
            w = builtins._lx_ctk_widgets[idx]
            w.pack_forget()
            w.grid(row=row, column=col, columnspan=colspan,
                   padx=6, pady=4, sticky="ew")
        except Exception:
            pass
    }
}

// Place a CTk widget at an absolute pixel position.
global ctkPlace(int idx, int x, int y){
    rawPy(){
        import builtins
        try:
            w = builtins._lx_ctk_widgets[idx]
            w.pack_forget()
            w.place(x=x, y=y)
        except Exception:
            pass
    }
}

// Re-pack a CTk widget with anchor.
global ctkPack(int idx, str anchor){
    rawPy(){
        import builtins
        try:
            builtins._lx_ctk_widgets[idx].pack(anchor=anchor, padx=10, pady=6)
        except Exception:
            pass
    }
}

// ── Styling ────────────────────────────────────────────────────────────────

// Set the font of a CTk widget.
global ctkSetFont(int idx, str family, int size, str style){
    rawPy(){
        import customtkinter as _ctk, builtins
        try:
            weight = "bold"   if "bold"   in style else "normal"
            slant  = "italic" if "italic" in style else "roman"
            f = _ctk.CTkFont(family=family, size=size, weight=weight, slant=slant)
            builtins._lx_ctk_widgets[idx].configure(font=f)
        except Exception:
            pass
    }
}

// Set the text colour of a CTk widget.
global ctkSetForeground(int idx, str color){
    rawPy(){
        import builtins
        try:
            builtins._lx_ctk_widgets[idx].configure(text_color=color)
        except Exception:
            pass
    }
}

// Set the fg_color (background) of a CTk widget.
global ctkSetBackgroundWidget(int idx, str color){
    rawPy(){
        import builtins
        try:
            builtins._lx_ctk_widgets[idx].configure(fg_color=color)
        except Exception:
            pass
    }
}

// Set the corner radius (pixels) of a CTk widget.
global ctkSetCornerRadius(int idx, int radius){
    rawPy(){
        import builtins
