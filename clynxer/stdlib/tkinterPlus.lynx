        import builtins
        try:
            builtins._lx_widgets[idx].configure(bg=color)
        except Exception:
            pass
    }
}

// Set internal padding (pixels) of a widget.
global setPadding(int idx, int px, int py){
    rawPy(){
        import builtins
        try:
            builtins._lx_widgets[idx].configure(padx=px, pady=py)
        except Exception:
            pass
    }
}

// Set the mouse cursor for a widget.
// Common cursors: "arrow", "hand2", "watch", "crosshair", "fleur", "sizing".
global setCursor(int idx, str cursor){
