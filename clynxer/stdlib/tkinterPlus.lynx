        items = _json.loads(itemsJson) if itemsJson.strip() else [""]
        w = _ctk.CTkOptionMenu(builtins._lx_ctk_root, values=items)
        w.pack(pady=6, padx=10, anchor="w")
        builtins._lx_ctk_widgets.append(w)
        idx = len(builtins._lx_ctk_widgets) - 1
    }
    return idx;
}

// Return the currently selected CTkOptionMenu value.
global ctkGetOption(int idx){
