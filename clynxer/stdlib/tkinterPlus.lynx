// ── Dialogs ────────────────────────────────────────────────────────────────

// Show an info message box.
global messageBox(str title, str message){
    rawPy(){
        import tkinter.messagebox as _mb
        _mb.showinfo(title, message)
    }
}

// Show a warning message box.
global warningBox(str title, str message){
    rawPy(){
        import tkinter.messagebox as _mb
        _mb.showwarning(title, message)
    }
}

// Show an error message box.
global errorBox(str title, str message){
    rawPy(){
        import tkinter.messagebox as _mb
        _mb.showerror(title, message)
    }
}

// Show a Yes/No dialog.  Returns true if the user clicked Yes.
global askYesNo(str title, str question){
    bool result = false;
    rawPy(){
        import tkinter.messagebox as _mb
        result = bool(_mb.askyesno(title, question))
    }
    return result;
}

// Show an OK/Cancel dialog.  Returns true if the user clicked OK.
global askOkCancel(str title, str message){
    bool result = false;
    rawPy(){
        import tkinter.messagebox as _mb
        result = bool(_mb.askokcancel(title, message))
    }
    return result;
}

// Open an "Open file" dialog.  Returns the selected file path, or "".
global openFileDialog(str title){
    str result = "";
    rawPy(){
        import tkinter.filedialog as _fd
        result = _fd.askopenfilename(title=title) or ""
    }
    return result;
}

// Open an "Open file" dialog filtered by extension (e.g. ".txt").  Returns path or "".
global openFileDialogFilter(str title, str ext){
    str result = "";
    rawPy(){
        import tkinter.filedialog as _fd
        _ext = ext if ext.startswith(".") else "." + ext
        result = _fd.askopenfilename(
            title=title,
            filetypes=[(ext + " files", "*" + _ext), ("All files", "*.*")]
        ) or ""
    }
    return result;
}

// Open a "Save file" dialog.  Returns the chosen path, or "".
global saveFileDialog(str title){
    str result = "";
    rawPy(){
        import tkinter.filedialog as _fd
        result = _fd.asksaveasfilename(title=title) or ""
    }
    return result;
}

// Open a "Choose directory" dialog.  Returns the chosen directory path, or "".
global openDirDialog(str title){
    str result = "";
    rawPy(){
        import tkinter.filedialog as _fd
        result = _fd.askdirectory(title=title) or ""
    }
    return result;
}

// Open a colour-picker dialog.  Returns the hex colour string, e.g. "#ff0000", or "".
global askColor(str title){
    str result = "";
    rawPy(){
        import tkinter.colorchooser as _cc
        _, hex_color = _cc.askcolor(title=title)
        result = hex_color or ""
    }
    return result;
}

// Show a simple text-input dialog.  Returns the entered string, or "".
global askString(str title, str prompt){
    str result = "";
    rawPy(){
        import tkinter.simpledialog as _sd
        r = _sd.askstring(title, prompt)
        result = r if r is not None else ""
    }
    return result;
}

// Show a simple integer-input dialog.  Returns the entered integer, or 0 on cancel.
global askInteger(str title, str prompt){
    int result = 0;
    rawPy(){
        import tkinter.simpledialog as _sd
        r = _sd.askinteger(title, prompt)
        result = r if r is not None else 0
    }
    return result;
}

// Show a simple float-input dialog.  Returns the entered float, or 0.0 on cancel.
global askFloat(str title, str prompt){
    float result = 0.0;
    rawPy(){
        import tkinter.simpledialog as _sd
        r = _sd.askfloat(title, prompt)
        result = r if r is not None else 0.0
    }
    return result;
}

// ── App lifecycle ───────────────────────────────────────────────────────────

// Start the Tk main event loop (blocking).
global run(){
    rawPy(){
        import builtins
        builtins._lx_root.mainloop()
    }
}

// Destroy the window and exit the event loop.
global close(){
    rawPy(){
        import builtins
        try:
            builtins._lx_root.destroy()
        except Exception:
            pass
    }
}

// ════════════════════════════════════════════════════════════════════════════
// ── CustomTkinter (CTk) extension ─────────────────────────────────────────
// All functions below require:  pip install customtkinter
// They use a separate widget list (builtins._lx_ctk_widgets) so they do NOT
// share indexes with the standard tkinter widgets above.
// Do NOT call ctkInit and init in the same program.
// ════════════════════════════════════════════════════════════════════════════

// ── Theme ──────────────────────────────────────────────────────────────────

// Set CTk appearance mode: "dark", "light", or "system". Call before ctkInit.
global ctkSetAppearance(str mode){
    rawPy(){
        import customtkinter as _ctk
        _ctk.set_appearance_mode(mode)
    }
}

// Set CTk color theme: "blue" (default), "green", or "dark-blue". Call before ctkInit.
global ctkSetTheme(str theme){
    rawPy(){
        import customtkinter as _ctk
        _ctk.set_default_color_theme(theme)
    }
}

// ── Window ─────────────────────────────────────────────────────────────────

// Create the CTk root window. Must be called first (CTk side).
global ctkInit(str title, int width, int height){
    rawPy(){
        import customtkinter as _ctk, builtins
        _root = _ctk.CTk()
        _root.title(title)
        _root.geometry(str(width) + "x" + str(height))
        builtins._lx_ctk_root    = _root
        builtins._lx_ctk_widgets = []
        builtins._lx_ctk_rgroups = {}
    }
}

// Change the CTk window title.
global ctkSetTitle(str title){
    rawPy(){
        import builtins
        builtins._lx_ctk_root.title(title)
    }
}

// Resize the CTk window.
global ctkResize(int width, int height){
    rawPy(){
        import builtins
        builtins._lx_ctk_root.geometry(str(width) + "x" + str(height))
    }
}

// Set the CTk window background colour.
global ctkSetBackground(str color){
    rawPy(){
        import builtins
        builtins._lx_ctk_root.configure(bg_color=color)
    }
}

// Prevent the user from resizing the CTk window.
global ctkDisableResize(){
    rawPy(){
        import builtins
        builtins._lx_ctk_root.resizable(False, False)
    }
}

// Set minimum CTk window dimensions.
global ctkSetMinSize(int width, int height){
    rawPy(){
        import builtins
        builtins._lx_ctk_root.minsize(width, height)
    }
}

// Set maximum CTk window dimensions.
global ctkSetMaxSize(int width, int height){
    rawPy(){
        import builtins
        builtins._lx_ctk_root.maxsize(width, height)
    }
}

// Set CTk window opacity (0.0 transparent … 1.0 opaque).
global ctkSetOpacity(float alpha){
    rawPy(){
        import builtins
        builtins._lx_ctk_root.attributes("-alpha", alpha)
    }
}

// Center the CTk window on screen.
global ctkCenter(){
    rawPy(){
        import builtins
        root = builtins._lx_ctk_root
        root.update_idletasks()
        w  = root.winfo_width()
        h  = root.winfo_height()
        sw = root.winfo_screenwidth()
        sh = root.winfo_screenheight()
        root.geometry(f"{w}x{h}+{(sw-w)//2}+{(sh-h)//2}")
    }
}

// Keep CTk window always on top when enabled is true.
global ctkTopmost(bool enabled){
    rawPy(){
        import builtins
        builtins._lx_ctk_root.attributes("-topmost", bool(enabled))
    }
}

// Minimize the CTk window.
global ctkIconify(){
    rawPy(){
        import builtins
        builtins._lx_ctk_root.iconify()
    }
}

// Restore a minimized CTk window.
global ctkDeiconify(){
    rawPy(){
        import builtins
        builtins._lx_ctk_root.deiconify()
    }
}

// Process all pending CTk events (force UI refresh).
global ctkUpdate(){
    rawPy(){
        import builtins
        builtins._lx_ctk_root.update()
    }
}

// Block for delayMs milliseconds (CTk window).
global ctkAfter(int delayMs){
    rawPy(){
        import builtins
        builtins._lx_ctk_root.after(delayMs)
    }
}

// Bind an event to close the CTk window.
// event: "<Escape>", "<Control-q>", "WM_DELETE_WINDOW", etc.
global ctkBindClose(str event){
    rawPy(){
        import builtins
        _ev = event
        if _ev == "WM_DELETE_WINDOW":
            builtins._lx_ctk_root.protocol("WM_DELETE_WINDOW", builtins._lx_ctk_root.destroy)
        else:
            builtins._lx_ctk_root.bind(_ev, lambda e: builtins._lx_ctk_root.destroy())
    }
}

// ── Label ──────────────────────────────────────────────────────────────────

// Create a CTkLabel.  Returns widget index.
global ctkLabel(str text){
    int idx = 0;
    rawPy(){
        import customtkinter as _ctk, builtins
        w = _ctk.CTkLabel(builtins._lx_ctk_root, text=text)
        w.pack(pady=6, padx=10, anchor="w")
        builtins._lx_ctk_widgets.append(w)
        idx = len(builtins._lx_ctk_widgets) - 1
    }
    return idx;
}

// Create a CTkLabel with custom text colour and font size.
global ctkLabelStyled(str text, str color, int size){
    int idx = 0;
    rawPy(){
        import customtkinter as _ctk, builtins
        w = _ctk.CTkLabel(builtins._lx_ctk_root, text=text,
                          text_color=color,
                          font=_ctk.CTkFont(size=size))
        w.pack(pady=6, padx=10, anchor="w")
        builtins._lx_ctk_widgets.append(w)
        idx = len(builtins._lx_ctk_widgets) - 1
    }
    return idx;
}

// ── Button ─────────────────────────────────────────────────────────────────

// Create a CTkButton.  Returns widget index.
global ctkButton(str text){
