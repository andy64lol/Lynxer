            pass
    }
}

// ── Widget interactions ─────────────────────────────────────────────────────

// Return the string value of a CTkEntry, CTkTextbox, CTkComboBox,
// CTkOptionMenu, or CTkSegmentedButton.
global ctkGetValue(int idx){
    str result = "";
    rawPy(){
        import builtins, customtkinter as _ctk
        try:
            w = builtins._lx_ctk_widgets[idx]
            if isinstance(w, _ctk.CTkTextbox):
                result = w.get("1.0", "end-1c")
            else:
                result = w.get()
        except Exception:
            result = ""
    }
    return result;
}

// Return the display text of a CTkLabel or CTkButton.
global ctkGetText(int idx){
    str result = "";
    rawPy(){
        import builtins
        try:
            result = str(builtins._lx_ctk_widgets[idx].cget("text"))
        except Exception:
            result = ""
    }
    return result;
}

// Set the display text of a CTkLabel, CTkButton, CTkCheckBox, etc.
global ctkSetText(int idx, str text){
    rawPy(){
        import builtins
        try:
            builtins._lx_ctk_widgets[idx].configure(text=text)
        except Exception:
            pass
    }
}

// Replace the content of a CTkEntry.
global ctkSetEntryText(int idx, str text){
    rawPy(){
        import builtins
        try:
            w = builtins._lx_ctk_widgets[idx]
            w.delete(0, "end")
            w.insert(0, text)
        except Exception:
            pass
    }
}

// Replace the content of a CTkTextbox.
global ctkSetTextBoxContent(int idx, str text){
    rawPy(){
        import builtins
        try:
            w = builtins._lx_ctk_widgets[idx]
            w.delete("1.0", "end")
            w.insert("1.0", text)
        except Exception:
            pass
    }
}

// Return true if a CTkCheckBox is checked.
global ctkIsChecked(int idx){
    bool result = false;
    rawPy(){
        import builtins
        try:
            result = bool(builtins._lx_ctk_widgets[idx]._lx_var.get())
        except Exception:
            result = False
    }
    return result;
}

// Programmatically check or uncheck a CTkCheckBox.
global ctkSetChecked(int idx, bool checked){
    rawPy(){
        import builtins
        try:
            builtins._lx_ctk_widgets[idx]._lx_var.set(bool(checked))
        except Exception:
            pass
    }
}

// Clear the content of a CTkEntry or CTkTextbox.
global ctkClearWidget(int idx){
    rawPy(){
        import builtins, customtkinter as _ctk
        try:
            w = builtins._lx_ctk_widgets[idx]
            if isinstance(w, _ctk.CTkTextbox):
                w.delete("1.0", "end")
            else:
                w.delete(0, "end")
        except Exception:
            pass
    }
}

// Disable a CTk widget (greyed out, non-interactive).
global ctkDisableWidget(int idx){
    rawPy(){
        import builtins
        try:
            builtins._lx_ctk_widgets[idx].configure(state="disabled")
        except Exception:
            pass
    }
}

// Re-enable a previously disabled CTk widget.
global ctkEnableWidget(int idx){
    rawPy(){
        import builtins
        try:
            builtins._lx_ctk_widgets[idx].configure(state="normal")
        except Exception:
            pass
    }
}

// Hide a CTk widget (removes from layout without destroying).
global ctkHideWidget(int idx){
    rawPy(){
        import builtins
        try:
            builtins._lx_ctk_widgets[idx].pack_forget()
        except Exception:
            pass
    }
}

// Show a previously hidden CTk widget.
global ctkShowWidget(int idx){
    rawPy(){
        import builtins
        try:
            builtins._lx_ctk_widgets[idx].pack(pady=6, padx=10, anchor="w")
        except Exception:
            pass
    }
}

// Permanently destroy a CTk widget.
global ctkDestroyWidget(int idx){
    rawPy(){
        import builtins
        try:
            builtins._lx_ctk_widgets[idx].destroy()
        except Exception:
            pass
    }
}

// Give keyboard focus to the CTk widget at idx.
global ctkFocusWidget(int idx){
    rawPy(){
        import builtins
        try:
            builtins._lx_ctk_widgets[idx].focus_set()
        except Exception:
            pass
    }
}

// ── App lifecycle ───────────────────────────────────────────────────────────

// Start the CTk main event loop (blocking).
global ctkRun(){
    rawPy(){
        import builtins
        builtins._lx_ctk_root.mainloop()
    }
}

// Destroy the CTk window and exit the event loop.
global ctkClose(){
    rawPy(){
        import builtins
        try:
            builtins._lx_ctk_root.destroy()
        except Exception:
            pass
    }
}

global main(){}
