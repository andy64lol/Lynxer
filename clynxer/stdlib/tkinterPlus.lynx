                           fg_color=fg, hover_color=hover)
        w.pack(pady=6, padx=10, anchor="w")
        builtins._lx_ctk_widgets.append(w)
        idx = len(builtins._lx_ctk_widgets) - 1
    }
    return idx;
}

// ── Entry ──────────────────────────────────────────────────────────────────

// Create a CTkEntry (single-line text input).  Returns widget index.
global ctkEntry(){
