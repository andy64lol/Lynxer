// ── TextBox ────────────────────────────────────────────────────────────────

// Create a CTkTextbox (multi-line).  Returns widget index.
global ctkTextBox(int width, int height){
    int idx = 0;
    rawPy(){
        import customtkinter as _ctk, builtins
        w = _ctk.CTkTextbox(builtins._lx_ctk_root, width=width, height=height)
        w.pack(pady=6, padx=10)
        builtins._lx_ctk_widgets.append(w)
        idx = len(builtins._lx_ctk_widgets) - 1
    }
    return idx;
}

// ── Checkbox ───────────────────────────────────────────────────────────────

// Create a CTkCheckBox.  Returns widget index.  Read state with ctkIsChecked(idx).
global ctkCheckbox(str text){
    int idx = 0;
    rawPy(){
        import customtkinter as _ctk, builtins, tkinter as _tk
        var = _tk.BooleanVar()
        w = _ctk.CTkCheckBox(builtins._lx_ctk_root, text=text, variable=var)
        w._lx_var = var
        w.pack(pady=6, padx=10, anchor="w")
        builtins._lx_ctk_widgets.append(w)
        idx = len(builtins._lx_ctk_widgets) - 1
    }
    return idx;
}

// ── Switch ─────────────────────────────────────────────────────────────────

// Create a CTkSwitch toggle.  Returns widget index.  Read state with ctkIsOn(idx).
global ctkSwitch(str text){
    int idx = 0;
    rawPy(){
        import customtkinter as _ctk, builtins, tkinter as _tk
        var = _tk.BooleanVar(value=False)
        w = _ctk.CTkSwitch(builtins._lx_ctk_root, text=text, variable=var)
        w._lx_var = var
        w.pack(pady=6, padx=10, anchor="w")
        builtins._lx_ctk_widgets.append(w)
        idx = len(builtins._lx_ctk_widgets) - 1
    }
    return idx;
}

// Return true if the CTkSwitch at idx is on.
global ctkIsOn(int idx){
    bool result = false;
    rawPy(){
        import builtins
        try:
            result = bool(builtins._lx_ctk_widgets[idx]._lx_var.get())
        except Exception:
            result = False
    }
    return result;
}

// Programmatically turn a CTkSwitch on (true) or off (false).
global ctkSetSwitch(int idx, bool on){
    rawPy(){
        import builtins
        try:
            builtins._lx_ctk_widgets[idx]._lx_var.set(bool(on))
        except Exception:
            pass
    }
}

// ── Radio button ───────────────────────────────────────────────────────────

// Create a CTkRadioButton belonging to groupId.  Returns widget index.
global ctkRadioButton(str text, str groupId){
    int idx = 0;
    rawPy(){
        import customtkinter as _ctk, builtins, tkinter as _tk
        if groupId not in builtins._lx_ctk_rgroups:
            builtins._lx_ctk_rgroups[groupId] = _tk.StringVar(value="")
        var = builtins._lx_ctk_rgroups[groupId]
        w = _ctk.CTkRadioButton(builtins._lx_ctk_root, text=text,
                                variable=var, value=text)
        w.pack(pady=4, padx=10, anchor="w")
        builtins._lx_ctk_widgets.append(w)
        idx = len(builtins._lx_ctk_widgets) - 1
    }
    return idx;
}

// Return the value (text) of the selected CTk radio button in groupId.
global ctkGetRadio(str groupId){
    str result = "";
    rawPy(){
        import builtins
        try:
            result = builtins._lx_ctk_rgroups[groupId].get()
        except Exception:
            result = ""
    }
    return result;
}

// ── Combobox ───────────────────────────────────────────────────────────────

// Create a CTkComboBox.  itemsJson is a JSON array of strings.
// Returns widget index.  Read selection with ctkGetCombo(idx).
global ctkCombobox(str itemsJson){
    int idx = 0;
    rawPy(){
        import customtkinter as _ctk, builtins, json as _json
        items = _json.loads(itemsJson) if itemsJson.strip() else []
        w = _ctk.CTkComboBox(builtins._lx_ctk_root, values=items)
        if items:
            w.set(items[0])
        w.pack(pady=6, padx=10, anchor="w")
        builtins._lx_ctk_widgets.append(w)
        idx = len(builtins._lx_ctk_widgets) - 1
    }
    return idx;
}

// Return the currently selected CTkComboBox value.
global ctkGetCombo(int idx){
    str result = "";
    rawPy(){
        import builtins
        try:
            result = builtins._lx_ctk_widgets[idx].get()
        except Exception:
            result = ""
    }
    return result;
}

// Set the CTkComboBox value by text.
global ctkSetCombo(int idx, str text){
    rawPy(){
        import builtins
        try:
            builtins._lx_ctk_widgets[idx].set(text)
        except Exception:
            pass
    }
}

