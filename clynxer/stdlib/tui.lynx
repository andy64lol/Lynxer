// ── Prompt variants ──────────────────────────────────────────────────────────

global askPassword(str prompt){
    str result = "";
    rawPy(){
        try:
            from rich.prompt import Prompt
            result = Prompt.ask(prompt, password=true)
        except Exception as e:
            result = "Error: " + str(e)
    }
    return result;
}

global askInt(str prompt){
    int result = 0;
    rawPy(){
        try:
            from rich.prompt import IntPrompt
            result = IntPrompt.ask(prompt)
        except Exception:
            result = 0
    }
    return result;
}

global askFloat(str prompt){
    float result = 0.0;
    rawPy(){
        try:
            from rich.prompt import FloatPrompt
            result = FloatPrompt.ask(prompt)
        except Exception:
            result = 0.0
    }
    return result;
}

global askDefault(str prompt, str defaultValue){
    str result = "";
    rawPy(){
        try:
            from rich.prompt import Prompt
            result = Prompt.ask(prompt, default=defaultValue)
        except Exception as e:
            result = "Error: " + str(e)
    }
    return result;
}

global confirmDefault(str prompt, bool defaultValue){
    bool result = false;
    rawPy(){
        try:
            from rich.prompt import Confirm
            result = Confirm.ask(prompt, default=defaultValue)
        except Exception:
            result = defaultValue
    }
    return result;
}

global main(){}