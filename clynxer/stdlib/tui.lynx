////
Lynxer standard library — tui
Terminal UI helpers powered by the rich Python package.
////

global setup(){}

// Returns 1 if rich is installed and importable, 0 otherwise.
global tuiExists(){
    int result = 0;
    rawPy(){
        try:
            import rich
            result = 1
        except Exception:
            result = 0
    }
    return result;
}

// Returns the installed Rich version, or "" if rich is unavailable.
global tuiVersion(){
    str result = "";
    rawPy(){
        try:
            from importlib.metadata import version
            result = version("rich")
        except Exception:
            result = ""
    }
    return result;
}

// Prints text with Rich markup support.
global printText(str text){
    rawPy(){
        try:
            from rich.console import Console
            Console().print(text)
        except Exception as e:
            print("Error: " + str(e))
    }
}

// Prints text with a Rich style such as "bold green" or "white on blue".
// Markup is disabled so the text is displayed literally.
global printStyled(str text, str style){
    rawPy(){
        try:
            from rich.console import Console
            Console().print(text, style=style, markup=False)
        except Exception as e:
            print("Error: " + str(e))
    }
}

// Renders Markdown to the terminal.
global markdown(str text){
    rawPy(){
        try:
            from rich.console import Console
            from rich.markdown import Markdown
            Console().print(Markdown(text))
        except Exception as e:
            print("Error: " + str(e))
    }
}

// Renders a bordered panel. An empty title omits the panel title.
global panel(str text, str title){
    rawPy(){
        try:
            from rich.console import Console
            from rich.panel import Panel
            if title:
                Console().print(Panel(text, title=title))
            else:
                Console().print(Panel(text))
        except Exception as e:
            print("Error: " + str(e))
    }
}

// Renders a panel with explicit border and content styles.
global panelStyled(str text, str title, str borderStyle, str contentStyle){
    rawPy(){
        try:
            from rich.console import Console
            from rich.panel import Panel
            Console().print(Panel(
                text,
                title=title if title else None,
                border_style=borderStyle if borderStyle else None,
                style=contentStyle if contentStyle else None,
            ))
        except Exception as e:
            print("Error: " + str(e))
    }
}

// Prints a horizontal rule with an optional title.
global rule(str title){
    rawPy(){
        try:
            from rich.console import Console
            from rich.rule import Rule
            Console().print(Rule(title))
        except Exception as e:
            print("Error: " + str(e))
    }
}

global ruleStyled(str title, str style){
    rawPy(){
        try:
            from rich.console import Console
            from rich.rule import Rule
            Console().print(Rule(title, style=style))
        except Exception as e:
            print("Error: " + str(e))
    }
}

// Pretty-prints a JSON document with Rich syntax highlighting.
global jsonPretty(str jsonText){
    rawPy(){
        try:
            from rich.console import Console
            Console().print_json(json=jsonText)
        except Exception as e:
            print("Error: " + str(e))
    }
}

// Syntax-highlight source code using any lexer supported by Pygments.
global printSyntax(str code, str lexer, bool lineNumbers){
    rawPy(){
        try:
            from rich.console import Console
            from rich.syntax import Syntax
            Console().print(Syntax(code, lexer, line_numbers=lineNumbers))
        except Exception as e:
            print("Error: " + str(e))
    }
}

// Renders a table.
// columnsJson is a JSON array of column names.
// rowsJson is a JSON array of arrays, for example:
// table("Users", "[\"Name\", \"Role\"]", "[[\"Ada\", \"admin\"]]")
global table(str title, str columnsJson, str rowsJson){
    rawPy(){
        try:
            import json as _json
            from rich.console import Console
            from rich.table import Table

            columns = _json.loads(columnsJson)
            rows = _json.loads(rowsJson)
            if not isinstance(columns, list) or not isinstance(rows, list):
                raise ValueError("columnsJson and rowsJson must contain JSON arrays")

            rendered = Table(title=title if title else None)
            for column in columns:
                rendered.add_column(str(column))
            for row in rows:
                if isinstance(row, list):
                    values = [str(value) for value in row]
                else:
                    values = [str(row)]
                rendered.add_row(*values)
            Console().print(rendered)
        except Exception as e:
            print("Error: " + str(e))
    }
}

// Clears the terminal using Rich's console-aware clear operation.
global clear(){
    rawPy(){
        try:
            from rich.console import Console
            Console().clear()
        except Exception as e:
            print("Error: " + str(e))
    }
}

// Reads a line using Rich's styled console input.
global ask(str prompt){
    str result = "";
    rawPy(){
        try:
            from rich.console import Console
            result = Console().input(prompt + " ")
        except Exception as e:
            result = "Error: " + str(e)
    }
    return result;
}

// Reads a yes/no answer. Returns 1 for yes and 0 for no.
global confirm(str prompt){
    bool result = false;
    rawPy(){
        try:
            from rich.prompt import Confirm
            result = Confirm.ask(prompt)
        except Exception:
            result = False
    }
    return result;
}

// ── Console configuration ───────────────────────────────────────────────────

// Create or replace the shared Rich Console. colorSystem may be "", "standard",
// "256", or "truecolor".
global init(str colorSystem){
    rawPy(){
        import builtins
        from rich.console import Console
        kwargs = {"record": True}
        if colorSystem:
            kwargs["color_system"] = colorSystem
        builtins._lx_tui_console = Console(**kwargs)
        builtins._lx_tui_tables = []
        builtins._lx_tui_trees = []
        builtins._lx_tui_layouts = []
        builtins._lx_tui_progress = []
        builtins._lx_tui_status = []
        builtins._lx_tui_live = []
    }
}

// Configure the shared console width. Returns the applied width.
global setWidth(int width){
    int result = 0;
    rawPy(){
        import builtins
        from rich.console import Console
        if not hasattr(builtins, "_lx_tui_console"):
            builtins._lx_tui_console = Console(record=True)
        builtins._lx_tui_console.width = width
        result = builtins._lx_tui_console.width
    }
    return result;
}

global setMarkup(bool enabled){
    rawPy(){
        import builtins
        from rich.console import Console
        if not hasattr(builtins, "_lx_tui_console"):
            builtins._lx_tui_console = Console(record=True)
        builtins._lx_tui_console._markup = enabled
    }
}

