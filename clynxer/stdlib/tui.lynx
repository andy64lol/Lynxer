}

global liveStart(str text, float refreshPerSecond){
    int idx = -1;
    rawPy(){
        import builtins
        from rich.console import Console
        from rich.live import Live
        if not hasattr(builtins, "_lx_tui_console"):
            builtins._lx_tui_console = Console(record=True)
        if not hasattr(builtins, "_lx_tui_live"):
            builtins._lx_tui_live = []
        live = Live(
            text,
            console=builtins._lx_tui_console,
            refresh_per_second=refreshPerSecond,
        )
        live.start()
        builtins._lx_tui_live.append(live)
        idx = len(builtins._lx_tui_live) - 1
    }
    return idx;
}

global liveUpdate(int idx, str text){
    rawPy(){
        import builtins
        try:
            builtins._lx_tui_live[idx].update(text, refresh=True)
        except Exception:
            pass
    }
}

