global treeCreate(str label){
    int idx = -1;
    rawPy(){
        import builtins
        from rich.tree import Tree
        if not hasattr(builtins, "_lx_tui_trees"):
            builtins._lx_tui_trees = []
        tree = Tree(label)
        builtins._lx_tui_trees.append(tree)
        idx = len(builtins._lx_tui_trees) - 1
    }
    return idx;
}

global treeAdd(int parentIdx, str label){
    int idx = -1;
    rawPy(){
        import builtins
        try:
            child = builtins._lx_tui_trees[parentIdx].add(label)
            builtins._lx_tui_trees.append(child)
            idx = len(builtins._lx_tui_trees) - 1
        except Exception:
            idx = -1
    }
    return idx;
}

global treePrint(int idx){
    rawPy(){
        import builtins
        from rich.console import Console
