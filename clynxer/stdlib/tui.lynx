// Render an exception traceback with Rich's traceback formatter.
global printException(){
    rawPy(){
        import builtins
        from rich.console import Console
        if not hasattr(builtins, "_lx_tui_console"):
            builtins._lx_tui_console = Console(record=True)
        builtins._lx_tui_console.print_exception()
