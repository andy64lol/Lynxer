        install(show_locals=showLocals)
    }
}

// ── Stateful tables ─────────────────────────────────────────────────────────

// Create a Table and return its integer handle.
global tableCreate(str title){
    int idx = -1;
    rawPy(){
        import builtins
        from rich.table import Table
        if not hasattr(builtins, "_lx_tui_tables"):
            builtins._lx_tui_tables = []
        table = Table(title=title if title else None)
        builtins._lx_tui_tables.append(table)
        idx = len(builtins._lx_tui_tables) - 1
    }
    return idx;
}

global tableAddColumn(int idx, str header, str style){
    rawPy(){
        import builtins
        try:
            table = builtins._lx_tui_tables[idx]
            if style:
                table.add_column(header, style=style)
            else:
                table.add_column(header)
        except Exception:
            pass
    }
}

global tableAddRow(int idx, str valuesJson){
    rawPy(){
        import builtins, json as _json
        try:
            values = _json.loads(valuesJson)
            if not isinstance(values, list):
                raise ValueError("valuesJson must contain a JSON array")
            builtins._lx_tui_tables[idx].add_row(
                *[str(value) for value in values]
            )
        except Exception:
            pass
    }
}

global tableSetCaption(int idx, str caption){
    rawPy(){
        import builtins
        try:
            builtins._lx_tui_tables[idx].caption = caption
        except Exception:
            pass
    }
}

global tableSetHeader(int idx, bool showHeader){
    rawPy(){
        import builtins
        try:
            builtins._lx_tui_tables[idx].show_header = showHeader
        except Exception:
            pass
    }
}

global tableSetLines(int idx, bool showLines){
    rawPy(){
        import builtins
        try:
            builtins._lx_tui_tables[idx].show_lines = showLines
        except Exception:
            pass
    }
}

// Select a Rich table box by name, e.g. "ROUNDED", "SIMPLE", "DOUBLE",
// "MARKDOWN", "ASCII", "HEAVY_HEAD", or "MINIMAL_DOUBLE_HEAD".
global tableSetBox(int idx, str boxName){
    rawPy(){
        import builtins
        from rich import box as _box
        try:
            boxType = getattr(_box, boxName.upper())
            builtins._lx_tui_tables[idx].box = boxType
        except Exception:
            pass
    }
}

global tableSetExpand(int idx, bool expand){
    rawPy(){
        import builtins
        try:
            builtins._lx_tui_tables[idx].expand = expand
        except Exception:
            pass
    }
}

global tablePrint(int idx){
    rawPy(){
        import builtins
        from rich.console import Console
        if not hasattr(builtins, "_lx_tui_console"):
            builtins._lx_tui_console = Console(record=True)
        try:
            builtins._lx_tui_console.print(builtins._lx_tui_tables[idx])
        except Exception as e:
            builtins._lx_tui_console.print("Error: " + str(e))
    }
}

