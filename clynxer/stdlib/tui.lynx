global printColumns(str itemsJson, bool equal, bool expand){
    rawPy(){
        import builtins, json as _json
        from rich.columns import Columns
        from rich.console import Console
        if not hasattr(builtins, "_lx_tui_console"):
            builtins._lx_tui_console = Console(record=True)
        try:
            items = _json.loads(itemsJson)
            if not isinstance(items, list):
                raise ValueError("itemsJson must contain a JSON array")
            builtins._lx_tui_console.print(
                Columns([str(item) for item in items], equal=equal, expand=expand)
            )
        except Exception as e:
            builtins._lx_tui_console.print("Error: " + str(e))
    }
}

