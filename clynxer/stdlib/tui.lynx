// ── Progress, status, and live displays ──────────────────────────────────────

global progressStart(){
    int idx = -1;
    rawPy(){
        import builtins
        from rich.console import Console
        from rich.progress import (
            BarColumn, Progress, SpinnerColumn, TaskProgressColumn,
            TextColumn, TimeRemainingColumn
        )
        if not hasattr(builtins, "_lx_tui_console"):
            builtins._lx_tui_console = Console(record=True)
        if not hasattr(builtins, "_lx_tui_progress"):
            builtins._lx_tui_progress = []
        progress = Progress(
            SpinnerColumn(),
            TextColumn("[progress.description]{task.description}"),
            BarColumn(),
            TaskProgressColumn(),
            TimeRemainingColumn(),
            console=builtins._lx_tui_console,
        )
        progress.start()
        builtins._lx_tui_progress.append(progress)
        idx = len(builtins._lx_tui_progress) - 1
    }
    return idx;
}

global progressAddTask(int idx, str description, float total){
    int taskId = -1;
    rawPy(){
        import builtins
        try:
            taskId = builtins._lx_tui_progress[idx].add_task(
                description, total=total
            )
        except Exception:
            taskId = -1
    }
    return taskId;
}

global progressAdvance(int idx, int taskId, float amount){
    rawPy(){
        import builtins
        try:
            builtins._lx_tui_progress[idx].advance(taskId, amount)
        except Exception:
            pass
    }
}

global progressUpdate(int idx, int taskId, float completed, float total){
    rawPy(){
        import builtins
        try:
            builtins._lx_tui_progress[idx].update(
                taskId, completed=completed, total=total
            )
        except Exception:
            pass
    }
}

global progressStop(int idx){
    rawPy(){
        import builtins
        try:
            builtins._lx_tui_progress[idx].stop()
        except Exception:
            pass
    }
}

global statusStart(str text){
    int idx = -1;
    rawPy(){
        import builtins
        from rich.console import Console
        from rich.status import Status
        if not hasattr(builtins, "_lx_tui_console"):
            builtins._lx_tui_console = Console(record=True)
        if not hasattr(builtins, "_lx_tui_status"):
            builtins._lx_tui_status = []
        status = Status(text, console=builtins._lx_tui_console)
        status.start()
        builtins._lx_tui_status.append(status)
        idx = len(builtins._lx_tui_status) - 1
    }
    return idx;
}

global statusUpdate(int idx, str text){
    rawPy(){
        import builtins
        try:
            builtins._lx_tui_status[idx].update(text)
