}

global consoleSaveText(str path){
    str result = "";
    rawPy(){
        import builtins
        from rich.console import Console
        try:
            if not hasattr(builtins, "_lx_tui_console"):
                builtins._lx_tui_console = Console(record=True)
            with open(path, "w", encoding="utf-8") as f:
                f.write(builtins._lx_tui_console.export_text(styles=True))
            result = "ok"
        except Exception as e:
            result = "error:" + str(e)
    }
    return result;
}

global consoleSaveHtml(str path){
    str result = "";
    rawPy(){
        import builtins
        from rich.console import Console
        try:
            if not hasattr(builtins, "_lx_tui_console"):
                builtins._lx_tui_console = Console(record=True)
            builtins._lx_tui_console.save_html(path)
            result = "ok"
        except Exception as e:
            result = "error:" + str(e)
    }
    return result;
}

// ── Markup, styles, text, and renderables ────────────────────────────────────

global markupEscape(str text){
    str result = "";
    rawPy(){
        from rich.markup import escape
        result = escape(text)
    }
    return result;
}

global styleValid(str style){
    bool result = false;
    rawPy(){
        try:
            from rich.style import Style
            Style.parse(style)
            result = true
        except Exception:
            result = false
    }
    return result;
}

global printTextStyle(str text, str style){
