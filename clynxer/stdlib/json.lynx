////
Lynxer standard library: json.
JSON encoding and decoding helpers backed by Rust (`serde_json`), exposed
through the native module `stdlib/json.so`.

Objects keep their key insertion order. Non-finite numbers are encoded as
`null` so that every emitted document is valid JSON.

Requires a Rust toolchain to build (see `rust/json`); the module is skipped
when `cargo` is unavailable.
////
global setup(){ importAs("json.so", "nativeJson"); }

// Returns true if s is valid JSON, false otherwise.
global jsonValid(str s) -> bool { return global.nativeJson.valid(s) != 0; }
// Pretty-prints a JSON string with 2-space indent. Returns "" on parse error.
global jsonParse(str s) -> str { return global.nativeJson.parse(s); }
// Gets the value at key as text. Returns "" if missing.
global jsonGet(str s, str key) -> str { return global.nativeJson.get(s, key); }
// Gets an integer value at key. Returns 0 on error.
global jsonGetInt(str s, str key) -> int {
    return global.nativeJson.getInt(s, key);
}
// Gets a float value at key. Returns 0.0 on error.
global jsonGetFloat(str s, str key) -> float {
    return global.nativeJson.getFloat(s, key);
}
// Gets a bool value at key. Returns false on error.
global jsonGetBool(str s, str key) -> bool {
    return global.nativeJson.getBool(s, key) != 0;
}
// Returns the top-level keys of a JSON object as a comma-separated string.
global jsonKeys(str s) -> str { return global.nativeJson.keys(s); }
// JSON-encodes a Lynxer string (adds quotes and escapes).
global jsonStringify(str s) -> str {
    return global.nativeJson.stringify(s);
}
// Builds a JSON array from a Lynxer list of values.
global jsonArray(list lst) -> str { return listJsonArray(lst); }
// Builds a JSON object from a flat list of key, value, key, value, ...
global jsonObject(list lst) -> str { return listJsonObject(lst); }
// Returns true if key exists in the JSON object (or as an array element).
global jsonHas(str s, str key) -> bool {
    return global.nativeJson.has(s, key) != 0;
}
// Returns the number of top-level keys or elements. Returns 0 on error.
global jsonLength(str s) -> int { return global.nativeJson.length(s); }
// Sets key to the JSON-encoded value val. Returns the new JSON string.
global jsonSet(str s, str key, str val) -> str {
    return global.nativeJson.set(s, key, val);
}
// Sets key to an integer value. Returns the updated JSON string.
global jsonSetInt(str s, str key, int value) -> str {
    return global.nativeJson.setInt(s, key, value);
}
// Removes key from the JSON object. Returns the new JSON string.
global jsonDelete(str s, str key) -> str {
    return global.nativeJson.delete(s, key);
}
// Merges two JSON objects; keys from b overwrite keys from a.
global jsonMerge(str a, str b) -> str { return global.nativeJson.merge(a, b); }
// Pretty-prints a JSON string with 4-space indent. Returns "" on parse error.
global jsonPretty(str s) -> str { return global.nativeJson.pretty(s); }
// Returns the JSON type at key: string, int, float, bool, null, object, array
// or unknown.
global jsonType(str s, str key) -> str { return global.nativeJson.type(s, key); }
// Builds a JSON object from "key=value|key=value" pairs (values are strings).
global jsonBuild(str pairs) -> str { return global.nativeJson.build(pairs); }

global main(){}
