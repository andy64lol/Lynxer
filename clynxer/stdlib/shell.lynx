////
Shell command helpers backed by the native C++ process API.
////
global setup(){ importAs("shell.so", "nativeShell"); }
global runShell(str command) -> int {
    return global.nativeShell.runShell(command);
}
global runShellCapture(str command) -> str {
    return global.nativeShell.runShellCapture(command);
}
global runShellSilent(str command) -> int {
    return global.nativeShell.runShellSilent(command);
}
global commandExists(str command) -> bool {
    return global.nativeShell.commandExists(command) != 0;
}
global checkShell(str shell) -> bool {
    return global.nativeShell.checkShell(shell) != 0;
}
global runShellCode(str command) -> int {
    return global.nativeShell.runShellCode(command);
}
global runShellAs(str shell, str command) -> int {
    return global.nativeShell.runShellAs(shell, command);
}
global runShellCaptureAs(str shell, str command) -> str {
    return global.nativeShell.runShellCaptureAs(shell, command);
}
global currentShell() -> str { return global.nativeShell.currentShell(); }
global shellPath(str command) -> str {
    return global.nativeShell.shellPath(command);
}
global main(){}
