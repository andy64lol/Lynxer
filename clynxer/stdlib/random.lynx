////
Lynxer standard library: random.
Random number and character helpers backed by the native C++ module
`stdlib/random.so`.

The generator is a seeded linear congruential sequence, so a given seed always
produces the same sequence. `seed(0)` restores the default seed.
////
global setup(){ importAs("random.so", "nativeRandom"); }

// Reseed the generator; 0 restores the default seed.
global seed(int value) { global.nativeRandom.seed(value); }
// Uniform integer in [low, high]. Returns low when high <= low.
global randint(int low, int high) -> int {
    return global.nativeRandom.randint(low, high);
}
// Uniform integer in [start, stop). Returns start when stop <= start.
global randrange(int start, int stop) -> int {
    return global.nativeRandom.randrange(start, stop);
}
// Float in [0.0, 1.0).
global random() -> float { return global.nativeRandom.random(); }
// Float in [low, high].
global uniform(float low, float high) -> float {
    return global.nativeRandom.uniform(low, high);
}
// Equal-probability boolean.
global coinflip() -> bool { return global.nativeRandom.coinflip() != 0; }
// Alias of coinflip.
global randBool() -> bool { return global.nativeRandom.coinflip() != 0; }
// Pick one character of the input string, or "" when it is empty.
global choice(str items) -> str { return global.nativeRandom.choice(items); }

global main(){}
