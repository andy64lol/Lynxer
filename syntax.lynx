////
syntax.lynx — Lynxer language syntax showcase.

A single runnable tour of the language: declarations, operators, strings,
bytes, lists and tuples, control flow, functions, ownership, aggregates,
codeblocks, async and the essential standard-library modules.

Run it with:

    lynxer syntax.lynx
////

// Comments:
//   //  a single-line comment
//   /// opened and closed by the same triple slash run ///
//   //// a file docstring (the opening line above) ////
//
// Macros expand tokens before parsing; *args forwards every argument.
macro show!(*args){println("macro: ", *args)}


// setup() must be the first global declaration. Imports are statements, so
// they run here and bind the modules under `global.<name>` (or the alias).
global setup(){
    importAs("math", "m");
    importAs("typing", "types");
    import("text");
    import("json");
    import("os");
    import("path");
    import("fileIO");
    import("time");
    import("random");
    import("sys");
    import("raylib");

    // The empty-forever delay can only be set from setup().
    foreverDelay(0);
}

// Named aggregate types are declared between setup() and main().
struct Point {
    int x;
    int y;
}

class Counter {
    int value = 0;
    const int step = 1;

    local init(int initial) {
        this.value = initial;
    }

    local increment() {
        this.value += this.step;
    }

    local get() {
        return this.value;
    }
}

class Animal {
    str name;

    local init(str name) {
        this.name = name;
    }

    local speak() {
        return "...";
    }
}

class Dog extends Animal {
    local init(str name) {
        super(name);
    }

    local speak() {
        return "woof";
    }
}

enum status = [
    Ready,
    Failed(str reason)
]{}

// Global functions are exported; `func` is file-scoped.
global add(int a, int b = 1) -> int {
    return a + b;
}

func doubleIt(int value) -> int {
    return value * 2;
}

// `type T of value` infers a generic type per call.
global firstOf(type T of value) -> T {
    return value;
}

global apply(function operation, int value) -> int {
    return operation(value);
}

global makeAdder(int base) -> function {
    local addBase(int value) -> int {
        return base + value;
    }
    return addBase;
}

// A caller-supplied codeblock parameter, invoked with exec().
global runBlock(){body}{
    exec(){{body}}
}

global describeStatus(status value) -> str {
    switch (value) {
        case(status.Ready){ return "ready"; }
        case(status.Failed(reason)){ return "failed: " + reason; }
    }
    return "unknown";
}


global main(){
    println("=== Lynxer syntax showcase ===");

    // ---------------------------------------------------------------- macros
    show!("macros expand before parsing");

    // ------------------------------------------------- primitive types / const
    int number = 42;
    float decimal = 3.14;
    str greeting = "hello";
    bool enabled = true;
    char letter = 'A';
    byte mask = 255;
    int8 tiny = -8;
    uint16 port = 8080;
    float32 ratio = 0.25;
    num measure = 7;
    bit flag = 1;
    numBool yes = 1;
    any anything = none;
    const int MAX = 100;
    println("types: ", number, ", ", decimal, ", ", greeting, ", ",
            enabled, ", ", anything, ", const=", MAX);
    println("scalars: ", letter, ", ", mask, ", ", tiny, ", ", port, ", ",
            ratio, ", ", measure, ", ", flag, ", ", yes);

    // -------------------------------------- string interpolation and builtins
    str message = inter"number={number}, greeting={greeting}";
    println("inter: ", message);
    println("strings: ", trim("  padded  "), ", ", upper(greeting), ", ",
            lower("LOUD"), ", ", replace(greeting, "l", "L"));
    println("substring: ", substring(greeting, 1, 4), ", charAt: ",
            charAt(greeting, 1), ", charCode: ", charCode("A"), ", charOf: ",
            charOf(66));
    list words = splitStr("alpha,beta,gamma", ",");
    println("splitStr: ", words, ", length: ", returnLength(greeting));

    // ----------------------------------------------------------------- bytes
    bytes data = bytesOf("AB");
    println("bytes: ", data, ", length=", bytesLength(data), ", at=",
            bytesAt(data, 0), ", hex=", bytesToHex(data), ", back=",
            bytesToStr(bytesFromHex("4142")));

    // ------------------------------------------------------------- operators
    int x = 5;
    x += 3;
    x -= 2;
    x *= 2;
    x %= 5;
    x **= 2;
    println("arithmetic: x=", x, ", 10/4=", 10 / 4, ", 10/%4=", 10 /% 4,
            ", 10%4=", 10 % 4, ", 2**10=", 2 ** 10);
    println("comparisons: ", 5 > 3, ", ", 5 is 5, ", ", 5 isnt 4, ", ",
            "a" < "b");
    println("logic: ", true and false, ", ", true or false, ", ",
            true nand false, ", ", false nor false, ", ", true xor false, ", ",
            not true);
    println("bitwise: ", 6 bitand 3, ", ", 6 bitor 3, ", ", 6 bitxor 3, ", ",
            6 bitnand 3, ", ", 6 bitxnor 3, ", ", 6 bitnor 3, ", ",
            1 bitleft 4, ", ", 32 bitright 2, ", ", bitnot 6);
    println("floor division: ", -7 /% 3, ", unary minus: ", -number);

    // ----------------------------------------------------------------- lists
    list numbers = [int 1, int 2, int 3, int 4, int 5];
    println("list: ", numbers, ", length: ", returnLength(numbers));
    println("listGet: ", listGet(numbers, 0), " / ", listGet(numbers, -1));
    numbers = listPush(numbers, 6);
    println("after listPush: ", numbers, ", listPop: ", listPop(numbers));
    println("listSet: ", listSet(numbers, 0, 10), ", listSlice: ",
            listSlice(numbers, 1, 4));
    println("listIndex: ", listIndex(numbers, 4), ", listContains: ",
            listContains(numbers, 4), ", listJoin: ", listJoin(numbers, "-"));
    println("listRemove: ", listRemove(numbers, 2), ", listHead: ",
            listHead(numbers, 2), ", listTail: ", listTail(numbers, 2));
    println("listCount: ", listCount(numbers, 2), ", listExtend: ",
            listExtend(numbers, [int 7, int 8]));
    println("listInsert: ", listInsert(numbers, 0, 0), ", listClear: ",
            listClear(numbers), ", listRepeat: ", listRepeat("x", 3));
    println("listAvg: ", listAvg([int 2, int 4, int 6]), ", listZip: ",
            listZip([str "a", str "b"], [int 1, int 2]));
    println("sortList: ", sortList([int 3, int 1, int 2]), ", reverseList: ",
            reverseList(numbers), ", listMin/Max: ", listMin(numbers), " / ",
            listMax(numbers));
    println("listFirst/Last: ", listFirst(numbers), " / ", listLast(numbers),
            ", sumOf: ", sumOf(numbers), ", anyOf/allOf: ", anyOf(numbers),
            " / ", allOf(numbers));
    list nested = listPush(listPush([], [int 1, int 2]), [int 3]);
    println("listFlatten: ", listFlatten(nested), ", listUnique: ",
            listUnique([int 1, int 1, int 2, int 3, int 3]));
    println("range: ", range(5), ", seqFromTo: ", seqFromTo(0, 10, 2));

    // ---------------------------------------------------------------- tuples
    tuple point = (int 10, int 20, int 30);
    tuple other = tupleCreate(40, 50);
    println("tuple: ", point, ", type: ", returnType(point), ", length: ",
            tupleLen(point));
    println("tupleGet: ", tupleGet(point, 1), ", first/last: ",
            tupleFirst(point), " / ", tupleLast(point), ", contains: ",
            contains(point, 20), ", index: ", tupleIndex(point, 30));
    println("tupleSlice: ", tupleSlice(point, 1, 3), ", tupleConcat: ",
            tupleConcat(point, other), ", tupleCount: ",
            tupleCount(tupleCreate(20, 20, 30), 20));
    println("tupleSortDesc: ", tupleSortDesc(tupleCreate(3, 1, 2)),
            ", tupleMin/Max: ", tupleMin(point), " / ", tupleMax(point),
            ", tupleMean: ", tupleMean(point));
    println("tupleJoin: ", tupleJoin(point, "-"), ", tupleJsonArray: ",
            tupleJsonArray(point), ", tupleToList: ", tupleToList(point));

    // ----------------------------------------------------------- control flow
    if (enabled) {
        println("if: enabled");
    } elif (number > 100) {
        println("elif: unreachable");
    } else {
        println("else: unreachable");
    }

    int selected = 2;
    switch (selected) {
        case(1){ println("switch: one"); }
        case(2){ println("switch: two"); }
        default(){ println("switch: other"); }
    }

    any pattern = [1, 2];
    switch (pattern) {
        case([1, item]){ println("switch pattern: ", item); }
        default(){ println("switch pattern: none"); }
    }

    int whileValue = 0;
    while (whileValue < 4) {
        whileValue += 1;
        if (whileValue is 2) { continue; }
        println("while: ", whileValue);
    }

    int cfor = 0;
    for (int i = 0; i < 4; i = i + 1) {
        cfor += i;
    }
    println("for: sum=", cfor);

    int implicit = 0;
    for (int k = 0; k < 3) {
        implicit += k;
    }
    println("for implicit update: sum=", implicit);

    list rangeValues = [];
    for (int r = 0..=6..2) {
        rangeValues = listPush(rangeValues, r);
    }
    println("range for: ", listJoin(rangeValues, ","));

    int doValue = 0;
    int doRestarts = 0;
    doWhile (doValue < 3) {
        doValue += 1;
        if (doValue is 2 and doRestarts is 0) {
            doRestarts += 1;
            restart;
        }
        println("doWhile: ", doValue);
    }

    iterate (2) {
        println("iterate: tick");
    }

    int foreverValue = 0;
    forever(){
        foreverValue += 1;
        if (foreverValue is 2) { break; }
        println("forever: ", foreverValue);
    }

    // ---------------------------------------------------------- try / catch
    try {
        int bad = 1 /% 0;
        println("unreachable");
    } catch (str error) {
        println("try/catch: caught ", error, ", traceback>0=",
                returnLength(exceptionInfo()) > 0);
    }

    try {
        raise("custom failure");
    } catch {
        println("try/catch: raised error handled");
    }

    // -------------------------------------------------------------- functions
    println("add: ", global.add(10, 3), ", ", add(10, 3));
    println("func: ", doubleIt(21));
    println("generic: ", firstOf(1), ", ", firstOf("one"));

    local square(int value) -> int {
        return value * value;
    }
    println("local: ", square(6), ", ", local.square(7));

    lambda greet(str who) -> str {
        return inter"Hello, {who}!";
    }
    println("lambda: ", greet("Lynxer"));

    function doubler = doubleIt;
    println("function value: ", doubler(6), ", apply: ",
            apply(doubler, 5));
    function addTen = makeAdder(10);
    println("closure: ", addTen(3));

    // ------------------------------------------------- ownership / borrowing
    int source = 42;
    int destination = 0;
    varTransfer(source, destination);
    println("ownership: transfer=", destination);
    source = 7;
    println("ownership: reinitialised source=", source);

    int reader = 10;
    int readAlias = 0;
    varBorrow(reader, readAlias);
    println("ownership: borrow=", borrowing(readAlias), ", beingBorrowed=",
            beingBorrowed(reader), ", value=", readAlias);
    varEndBorrow(readAlias);

    int mutableBase = 5;
    int mutableAlias = 0;
    varBorrowMutate(mutableBase, mutableAlias);
    mutableAlias = 55;
    println("ownership: mutable borrow=", mutableBase, ", ", mutableAlias);
    varEndBorrow(mutableAlias);

    int swapLeft = 1;
    int swapRight = 2;
    varSwapVal(swapLeft, swapRight);
    println("ownership: swapVal=", swapLeft, ", ", swapRight);
    varSwapAll(swapLeft, swapRight);
    println("ownership: swapAll=", swapLeft, ", ", swapRight);

    int sharedBase = 42;
    shared int sharedAlias = sharedBase;
    sharedAlias = 100;
    println("ownership: shared=", sharedBase, ", ", sharedAlias);
    unshare(sharedAlias);
    sharedAlias = 200;
    println("ownership: unshared=", sharedBase, ", ", sharedAlias);

    // -------------------------------------------------- sentinel / object
    sentinel missing = sentinel("MISSING");
    println("sentinel: ", returnType(missing), ", identity=",
            missing is missing);
    any emptyObject = object();
    println("object: type=", returnType(emptyObject));

    // ------------------------------------------------------ aggregate types
    Point p = new Point(3, 4);
    p.x = 10;
    println("struct: ", p.x, ", ", p.y);

    Counter counter = new Counter(5);
    counter.increment();
    println("class: ", counter.get(), ", field=", counter.value);

    Animal pet = new Dog("Rex");
    println("inheritance: ", pet.name, " says ", pet.speak());

    println("enum: ", status.Ready, ", ", describeStatus(status.Ready), ", ",
            describeStatus(status.Failed("disk")));

    vargroup profile = {
        str title = "Engineer",
        int years = 5
    };
    int profile.years = 6;
    println("vargroup: ", profile.title, ", ", profile.years);

    vargroup nestedGroup = {
        int n = 1,
        vargroup sub = { str k = "x" }
    };
    println("vargroup nested: ", nestedGroup.sub.k);

    // ------------------------------------------------------------ codeblocks
    codeblock savedBlock = {
        println("codeblock: stored and executed");
    };
    runBlock(){{savedBlock}};

    runBlock(){
        println("codeblock: caller-supplied inline block");
    };

    str inlineText = "inline";
    exec(inlineText) {
        println("codeblock: inline exec ", inlineText);
    }

    codeblock typedBlock = {
        println("codeblock: typed ", name, " ", age);
    }[str name, int age];
    exec("Alice", 30){{typedBlock}};

    codeblock inferredBlock = {
        println("codeblock: inferred ", inferredValue);
    };
    exec("value"){{inferredBlock}};

    // ---------------------------------------------------------------- async
    int task = asyncRun(global.add, [40, 2]);
    println("async: await=", await task);
    any gathered = asyncGather(asyncRun(global.add, [1, 2]),
                               asyncRun(global.add, [3, 4]));
    println("async: gather=", gathered);

    // ------------------------------------------------------ essential stdlib
    // math
    println("math: pi>0=", global.m.pi() > 0, ", sqrt=", global.m.sqrt(144),
            ", gcd=", global.m.gcd(12, 18), ", prime97=",
            global.m.isPrime(97));
    println("math: factorial=", global.m.factorial(5), ", clamp=",
            global.m.clamp(15, 0, 10), ", roundTo=",
            global.m.roundTo(3.14159, 2));
    println("math: mean=", global.m.mean([int 1, int 2, int 3, int 4]),
            ", median=", global.m.median([int 1, int 2, int 3]),
            ", linspace=", global.m.linspace(0.0, 1.0, 5));

    // typing
    println("typing: isInt=", global.types.isInt(1), ", toInt=",
            global.types.toInt("42"), ", toStr=", global.types.toStr(3.5));
    println("typing: zfill=", global.types.zfill("42", 5), ", splitFirst=",
            global.types.splitFirst("a=b", "="), ", listChunk=",
            global.types.listChunk(range(6), 2));

    // text
    println("text: reverse=", global.text.reverse("abc"), ", title=",
            global.text.title("hello world"), ", count=",
            global.text.count("banana", "na"));
    println("text: split=", global.text.split("a,b,c", ","), ", zfill=",
            global.text.zfill("-42", 6));

    // json
    str doc = "{\"name\": \"Ada\", \"age\": 36}";
    println("json: valid=", global.json.jsonValid(doc), ", name=",
            global.json.jsonGet(doc, "name"), ", age=",
            global.json.jsonGetInt(doc, "age"));
    println("json: keys=", global.json.jsonKeys(doc), ", updated=",
            global.json.jsonSetInt(doc, "age", 37));
    println("json: object=", global.json.jsonObject([str "a", int 1]),
            ", array=", global.json.jsonArray([int 1, int 2]));

    // os
    println("os: cwd>0=", returnLength(global.os.getcwd()) > 0, ", temp>0=",
            returnLength(global.os.tempDir()) > 0);
    println("os: joinPath=", global.os.joinPath("parent", "child"),
            ", basename=", global.os.basename("/a/b.txt"), ", dirname=",
            global.os.dirname("/a/b.txt"));
    println("os: host=", global.os.getSystemName(), ", cpus>0=",
            global.os.cpuCount() > 0);

    // path
    println("path: name=", global.path.name("/tmp/report.tar.gz"),
            ", stem=", global.path.stem("report.tar.gz"), ", suffix=",
            global.path.suffix("report.tar.gz"));
    println("path: suffixes=", global.path.suffixes("archive.tar.gz"),
            ", parts=", global.path.parts("/a/b"), ", absolute=",
            global.path.isAbsolute("/a/b"));
    println("path: join=", global.path.join("a", "b"), ", normalize=",
            global.path.normalize("a/./b/../c"));

    // fileIO
    str tempPath = global.fileIO.tempFile(".txt");
    bool wrote = global.fileIO.writeFile(tempPath, "alpha\nbeta\n");
    println("fileIO: wrote=", wrote, ", lines=",
            global.fileIO.readLines(tempPath), ", size=",
            global.fileIO.fileSize(tempPath));
    println("fileIO: delete=", global.fileIO.deleteFile(tempPath),
            ", exists=", global.fileIO.fileExists(tempPath));

    // time
    println("time: now>0=", returnLength(global.time.now()) > 0, ", leap=",
            global.time.isLeapYear(2024), ", feb2024=",
            global.time.daysInMonth(2024, 2));
    println("time: addDays=", global.time.addDays("2026-02-27", 2),
            ", diffDays=", global.time.diffDays("2026-01-01", "2026-01-03"));

    // random (seeded, so the sequence is reproducible)
    global.random.seed(7);
    println("random: randint=", global.random.randint(1, 6), ", randrange=",
            global.random.randrange(0, 10), ", coin=",
            global.random.coinflip());

    // sys
    println("sys: ", global.sys.platform(), " ", global.sys.architecture(),
            " ", global.sys.version());
    println("sys: byteOrder=", global.sys.getByteOrder(), ", encoding=",
            global.sys.getDefaultEncoding(), ", frozen=",
            global.sys.isFrozen());
    println("sys versionInfo: ", global.sys.versionInfo());

    // --------------------------------------------------------------- raylib
    // Window-free smoke test (no display needed).
    println("raylib: flagWindowHidden=", global.raylib.flagWindowHidden(),
            ", mouseButtonLeft=", global.raylib.mouseButtonLeft());
    println("raylib: random=", global.raylib.getRandomValue(3, 3));
    int redHandle = global.raylib.colorFromHSV(0.0, 1.0, 1.0);
    println("raylib: color r/g/a=", global.raylib.colorGetR(redHandle), "/",
            global.raylib.colorGetG(redHandle), "/",
            global.raylib.colorGetA(redHandle));
    global.raylib.colorFree(redHandle);
    int vecHandle = global.raylib.vector2New(1.5, 2.5);
    println("raylib: vec=", global.raylib.vector2GetX(vecHandle), ",",
            global.raylib.vector2GetY(vecHandle));
    global.raylib.vector2SetX(vecHandle, 9.0);
    println("raylib: vecX=", global.raylib.vector2GetX(vecHandle));
    global.raylib.vector2Free(vecHandle);

    // --------------------------------------------------------------- asserts
    assert(true, "assert passes");
    println("=== done ===");
}
