//// syntax.lynx — Lynxer language syntax showcase ////

// Comments:
// single-line comments start with //
///
   multiline comments use, well, you see, i didn't place the triple / here because that ends the block of multiline comments
   so well, as you see
///

// setup() must be the first global declaration.
// importAs() binds a module to the alias supplied as its second argument.
global setup(){
    importAs("math", "m");
    importAs("typing", "types");
}

// Global functions are declared before main().
global add(int a, int b){
    return a + b;
}

global identity(any value){
    return value;
}

global main(){
    println("=== Lynxer syntax showcase ===");

    // Primitive types and constants.
    int number = 42;
    float decimal = 3.14;
    str greeting = "hello";
    bool enabled = true;
    any anything = none;
    const int MAX = 100;
    println("types: ", number, ", ", decimal, ", ", greeting, ", ",
            enabled, ", ", anything, ", const=", MAX);

    // Functions and multiple arguments.
    println("add(10, 3) = ", global.add(10, 3));
    println("identity(\"Lynxer\") = ", global.identity("Lynxer"));
    println("math alias m.sqrt(144) = ", global.m.sqrt(144));

    // Arithmetic, comparisons, logic, and bitwise operators.
    int x = 5;
    x += 3;
    x -= 2;
    println("arithmetic: x=", x, ", 10%3=", 10 % 3, ", 2^10=", global.m.pow(2, 10));
    println("comparisons: ", 5 > 3, ", ", 5 == 5, ", ", 5 != 4);
    println("logic: ", true && false, ", ", true !&& false, ", ",
            true || false, ", ", true !|| false, ", ", !!true);
    println("bitwise: ", 6 & 3, ", ", 6 !& 3, ", ", 6 ^ 3, ", ",
            6 !^ 3, ", ", 6 | 3, ", ", 6 !| 3, ", ",
            1 << 4, ", ", 32 >> 2);

    // Lists.
    list numbers = [int 1, int 2, int 3, int 4, int 5];
    println("list: ", numbers);
    println("list length: ", returnLength(numbers));
    println("list get first: ", listGet(numbers, 0));
    numbers = listPush(numbers, 6);
    println("after listPush: ", numbers);
    println("list slice: ", listSlice(numbers, 1, 4));
    println("list index of 4: ", listIndex(numbers, 4));
    println("list contains 4: ", listContains(numbers, 4));
    println("common contains(list, 5): ", contains(numbers, 5));

    // Tuples are declared with the tuple type and are immutable sequences.
    // A list literal on the right side is converted to a tuple.
    tuple point = (int 10, int 20, int 30);
    tuple other = tupleCreate(40, 50);
    tuple combined = tupleConcat(point, other);
    tuple middle = tupleSlice(combined, 1, 4);
    println("tuple: ", point);
    println("tuple type: ", returnType(point));
    println("tuple length: ", tupleLen(point));
    println("tuple get index 1: ", tupleGet(point, 1));
    println("tuple first/last: ", tupleFirst(point), " / ", tupleLast(point));
    println("tuple contains 20: ", contains(point, 20));
    println("tuple index of 30: ", tupleIndex(point, 30));
    println("tuple count of 20: ", tupleCount(tupleCreate(20, 20, 30), 20));
    println("tuple slice: ", middle);
    println("tuple concat: ", combined);
    println("tuple as list: ", tupleToList(point));
    println("tuple as JSON: ", tupleJsonArray(point));
    println("list to tuple: ", listToTuple(numbers));

    // Higher-level tuple helpers live in the typing module.
    tuple reversed = global.types.tupleReverse(point);
    tuple sorted = global.types.tupleSort(tupleCreate(5, 2, 4, 1));
    tuple unique = global.types.tupleUnique(tupleCreate(1, 1, 2, 3, 3));
    println("typing tupleReverse: ", reversed);
    println("typing tupleSort: ", sorted);
    println("typing tupleUnique: ", unique);
    println("typing tupleSum: ", global.types.tupleSum(point));
    println("typing tupleJoin: ", global.types.tupleJoin(point, "-"));
    list pointList = global.types.toList(point);
    tuple pointTuple = global.types.toTuple(pointList);
    println("typing toList(tuple): ", pointList);
    println("typing toTuple(list): ", pointTuple);
    println("typing isSequence(point): ", global.types.isSequence(point));
    println("typing lenSequence(point): ", global.types.lenSequence(point));
    println("typing toString(point): ", global.types.toString(point));
    println("typing toNumber(\"3.5\"): ", global.types.toNumber("3.5"));

    // Built-ins are available without importing a module.
    println("returnType(point): ", returnType(point));
    println("returnLength(point): ", returnLength(point));
    println("contains(list, value): ", contains(numbers, 3));
    println("contains(tuple, value): ", contains(point, 30));

    // Control flow.
    if(enabled){
        println("if: enabled");
    } else {
        println("if: disabled");
    }

    int i = 0;
    while(i < 3){
        println("while iteration ", i);
        i += 1;
    }

    for(int j = 0; j < 3; j = j + 1){
        println("for iteration ", j);
    }

    // Raw Python receives primitive values and tuple variables as Python tuples.
    int total = 0;
    rawPy(){
        total = sum(numbers)
    }
    println("rawPy sum: ", total);

    // Multiple arguments replace chains of print("label"); print(value); print("\n").
    println("one call, ", "multiple arguments, ", number, ", ", point);

    // Sentinels compare by identity.
    sentinel missing = sentinel("MISSING");
    println("sentinel type: ", returnType(missing));
    println("sentinel identity: ", missing == missing);

    // Codeblocks can be stored and executed later.
    codeblock helloWorld = {
        println("Hello world!");
    };
    exec(){{helloWorld}}
    codeblock example = {
        println("provided codeblock value: ", text);
    };
    exec("Hello!"){{example}}
    str text = "left";
    exec(str text){
        println("exec argument: ", text);
    }

    println("=== done ===");
}