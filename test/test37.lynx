global setup(){
    import("game");
}

global drawFrame(){
    global.game.beginDraw();
    global.game.drawRect(400, 300, 800, 600, 24, 32, 48);
    global.game.drawText("CLICK ME!", 400, 285, 255, 255, 255, 24);
    global.game.drawText("Arcade through game.lynx", 400, 450,
                         180, 220, 255, 18);
    global.game.endDraw();
}

global updateFrame(float dt){
    // A one-frame smoke test keeps the fixture non-blocking.
    global.game.close();
}

global mousePress(float x, float y, int button, int modifiers){
    if(button == global.game.mouseButtonCode("LEFT")
       and x >= 300 and x <= 500 and y >= 250 and y <= 350){
        global.game.setTitle("Clicked");
    }
}

global main(){
    global.game.init("Clicker", 800, 600);
    global.game.setDrawCallback("global.drawFrame");
    global.game.setUpdateCallback("global.updateFrame");
    global.game.setMousePressCallback("global.mousePress");
    global.game.setBackground(24, 32, 48);
    global.game.setFPSCap(60);
    global.game.run();
}