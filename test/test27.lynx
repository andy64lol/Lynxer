global setup(){}
global main(){
    int source = memoryAllocate(16);
    int destination = memoryCallocate(2, 8);
    memoryWriteInt32(source, 0, 123456);
    memoryWriteInt32(source, 12, -654321);
    memoryCopy(destination, source, 16);
    println(memoryReadInt32(destination, 0));
    println(memoryReadInt32(destination, 12));
    memorySet(destination, 255, 0);
    memoryFree(source);
    memoryFree(destination);
}