global setup(){}
global render(str prefix){content}{content2}{
    print(prefix);
    exec(){{content}}
    exec(){{content2}}
}
global main(){
    global.render("value: "){
        sleep(1); //sleeps for 1 second here
        println("42");
    }{
        sleep(0.01);
        println("Hello!");
    }
    local anotherExample(){ex1}{
        exec(){{ex1}}
    }
    local.anotherExample(){
        println("another example, this is local function");
    }
}