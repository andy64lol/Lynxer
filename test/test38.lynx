// Interactive game: an animated showcase of every drawing primitive.
// Shapes pulse, sprites bounce off the walls and flash on contact.
// SPACE pauses, ESC quits.  Run with `lynxer test38.lynx`.
global setup(){
    import("game");
    float clock = 0.0;
    float pulse = 0.0;
    float pulseDir = 1.0;
    bool paused = false;
    int items = -1;
    int shapes = -1;
    int hero = -1;
    int buddy = -1;
}

// ── Scene construction ─────────────────────────────────────────────────────
global makeSprites(){
    items = global.game.makeSpriteList();

    // NOTE: setSpriteVelocity is px/frame at 60 FPS (arcade multiplies by
    // 60 * dt), so a value of 3 is roughly 180 px per second.
    hero = global.game.makeSolidSprite(44, 44, 255, 96, 96, 200, 140);
    global.game.setSpriteVelocity(hero, 3.2, 2.2);
    global.game.addToList(items, hero);

    buddy = global.game.makeSolidSprite(44, 44, 96, 200, 255, 620, 120);
    global.game.setSpriteVelocity(buddy, -2.6, 2.8);
    global.game.addToList(items, buddy);

    int third = global.game.makeSolidSprite(40, 40, 255, 214, 96, 420, 180);
    global.game.setSpriteVelocity(third, 2.0, -2.9);
    global.game.addToList(items, third);

    int orbA = global.game.makeCircleSprite(22, 200, 130, 255, 330, 90);
    global.game.setSpriteVelocity(orbA, -1.9, 2.4);
    global.game.setSpriteAlpha(orbA, 230);
    global.game.addToList(items, orbA);

    int orbB = global.game.makeCircleSprite(18, 160, 255, 200, 760, 170);
    global.game.setSpriteVelocity(orbB, 2.4, -2.0);
    global.game.addToList(items, orbB);
}

// Batched (static) geometry — drawn with a single call each frame.
global makeShapeBatch(){
    shapes = global.game.makeShapeList();
    global.game.addRectToShapeList(shapes, 90, 250, 120, 60, 72, 96, 160);
    global.game.addCircleToShapeList(shapes, 230, 250, 30, 120, 220, 150);
    global.game.addLineToShapeList(shapes, 300, 220, 420, 280, 200, 210, 240, 3);
}

// ── Motion ─────────────────────────────────────────────────────────────────
global bounceSprites(){
    int count = global.game.getSpriteListCount(items);
    for(int i = 0; i < count; i += 1){
        int spr = global.game.getSpriteFromList(items, i);
        float x = global.game.getSpriteX(spr);
        float y = global.game.getSpriteY(spr);
        float vx = global.game.getSpriteVX(spr);
        float vy = global.game.getSpriteVY(spr);
        if(x < 40 and vx < 0){ global.game.setSpriteVelocity(spr, -vx, vy); }
        if(x > 860 and vx > 0){ global.game.setSpriteVelocity(spr, -vx, vy); }
        if(y < 50 and vy < 0){ global.game.setSpriteVelocity(spr, vx, -vy); }
        if(y > 205 and vy > 0){ global.game.setSpriteVelocity(spr, vx, -vy); }
    }
}

// ── Frame hooks ────────────────────────────────────────────────────────────
global drawFrame(){
    global.game.beginDraw();
    global.game.drawGradientRect(450, 310, 900, 620, 44, 52, 82, 12, 14, 24);

    global.game.drawTextAnchored("Shape & sprite showcase", 450, 596,
                                 130, 220, 255, 26, "center", "center");

    // Row A — filled and outlined primitives
    global.game.drawRect(80, 520, 100, 70, 232, 76, 76);
    global.game.drawRectOutline(225, 520, 100, 70, 255, 255, 255, 3);
    global.game.drawCircle(370, 520, 30 + pulse * 12, 96, 196, 120);
    global.game.drawCircleOutline(515, 520, 32, 255, 214, 64, 3);
    global.game.drawEllipse(660, 520, 110, 56, 92, 140, 232);
    global.game.drawRectRoundedFilled(805, 520, 110, 70, 168, 92, 224, 14);

    // Row B — polygons, arcs and the pulsing star
    global.game.drawTriangle(80, 470, 130, 390, 30, 390, 232, 120, 200);
    global.game.drawTriangleOutline(225, 470, 275, 390, 175, 390,
                                    255, 255, 255, 3);
    global.game.drawPolygon("[340,400, 400,400, 415,460, 325,460]",
                            92, 180, 240);
    global.game.drawPolygonOutline("[470,400, 560,400, 575,460, 455,460]",
                                   255, 255, 255, 3);
    global.game.drawArc(660, 430, 100, 80, 255, 196, 64, 0, 270, 4);
    global.game.drawStar(805, 430, 34 + pulse * 12, 15, 6, 255, 208, 72);

    // Row C — lines, points and gradients
    global.game.drawLine(40, 300, 120, 360, 255, 255, 255, 3);
    global.game.drawDashedLine(170, 360, 280, 300, 160, 240, 255, 3, 12);
    global.game.drawPolyline("[320,300, 360,360, 400,300, 440,360]",
                             120, 255, 180, 3);
    global.game.drawPoints("[480,300, 510,330, 540,300, 570,330]",
                           255, 255, 255, 8);
    global.game.drawCross(660, 330, 24, 255, 96, 96, 4);
    global.game.drawGradientRect(805, 330, 130, 90, 40, 120, 220, 200, 60, 220);

    // Batched shapes and the bouncing sprites
    global.game.drawShapeList(shapes);
    global.game.drawSpriteList(items);

    global.game.drawText("Sprites flash white on contact  ·  SPACE pause  ·  ESC quit",
                         20, 16, 150, 170, 200, 16);
    global.game.drawTextAnchored("FPS: " + strOf(global.game.getFPS()),
                                 880, 596, 140, 255, 180, 16, "right", "center");
    if(paused){
        global.game.drawTextAnchored("PAUSED", 450, 250,
                                     255, 220, 80, 40, "center", "center");
    }
    global.game.endDraw();
}

global updateFrame(float dt){
    if(paused){ return; }

    clock += dt;

    // Ping-pong 0..1 driver for the pulsing shapes
    pulse += pulseDir * dt * 1.4;
    if(pulse > 1){ pulse = 1; pulseDir = -1; }
    if(pulse < 0){ pulse = 0; pulseDir = 1; }

    global.game.updateSpriteList(items);
    global.bounceSprites();

    // Flash the hero while it overlaps the buddy
    if(global.game.spriteCollides(hero, buddy)){
        global.game.setSpriteColor(hero, 255, 255, 255, 255);
    } else {
        global.game.setSpriteColor(hero, 255, 96, 96, 255);
    }
}

global keyPress(int symbol, int modifiers){
    if(symbol == global.game.keyCode("ESCAPE")){
        global.game.close();
    }
    if(symbol == global.game.keyCode("SPACE")){
        paused = not paused;
    }
}

global main(){
    global.game.init("Shape showcase", 900, 620);
    global.game.setBackground(12, 14, 24);
    global.game.setFPSCap(60);
    global.makeSprites();
    global.makeShapeBatch();
    global.game.setDrawCallback("global.drawFrame");
    global.game.setUpdateCallback("global.updateFrame");
    global.game.setKeyPressCallback("global.keyPress");
    global.game.run();
}
