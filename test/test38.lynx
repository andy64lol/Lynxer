// Drawing, sprites, sprite lists, collision, and shape batches.
global setup(){
    import("game");
}

global drawFrame(){
    global.game.beginDraw();
    global.game.drawRect(100, 550, 120, 80, 220, 60, 60);
    global.game.drawRectOutline(240, 550, 120, 80, 255, 255, 255, 2);
    global.game.drawCircle(380, 550, 40, 60, 220, 100);
    global.game.drawCircleOutline(500, 550, 40, 255, 255, 0, 2);
    global.game.drawEllipse(620, 550, 100, 50, 60, 140, 240);
    global.game.drawEllipseOutline(740, 550, 100, 50, 255, 255, 255, 2);
    global.game.drawTriangle(100, 400, 160, 300, 40, 300, 220, 80, 220);
    global.game.drawTriangleOutline(240, 400, 300, 300, 180, 300,
                                    255, 255, 255, 2);
    global.game.drawPolygon("[350,300, 430,300, 460,380, 320,380]",
                            80, 180, 240);
    global.game.drawPolygonOutline("[500,300, 580,300, 610,380, 470,380]",
                                   255, 255, 255, 2);
    global.game.drawArc(700, 350, 100, 100, 255, 220, 40, 0, 270, 3);
    global.game.drawArcFilled(100, 180, 100, 100, 40, 180, 255, 0, 220);
    global.game.drawStar(260, 180, 55, 24, 5, 255, 200, 40);
    global.game.drawDashedLine(350, 150, 500, 220, 255, 255, 255, 2, 12);
    global.game.drawPolyline("[550,150, 600,210, 660,150]",
                            100, 255, 180, 3);
    global.game.drawPoints("[700,150, 730,180, 760,150]",
                           255, 255, 255, 6);
    global.game.drawCross(400, 80, 25, 255, 80, 80, 3);
    global.game.drawTextStyled("Shapes", 20, 20, 255, 255, 255, 18,
                              "", false, false, "left");
    global.game.drawSpriteList(0);
    global.game.drawShapeList(0);
    global.game.endDraw();
}

global updateFrame(float dt){
    global.game.updateSpriteList(0);
    global.game.close();
}

global main(){
    global.game.init("Drawing API", 800, 600);
    int sprites = global.game.makeSpriteList();
    int first = global.game.makeSolidSprite(40, 40, 255, 80, 80, 100, 100);
    int second = global.game.makeCircleSprite(20, 80, 160, 255, 120, 100);
    global.game.setSpriteVelocity(first, 10, 0);
    global.game.setSpriteAngle(second, 30);
    global.game.setSpriteAlpha(first, 220);
    global.game.setSpriteVisible(second, true);
    global.game.addToList(sprites, first);
    global.game.addToList(sprites, second);
    int shapes = global.game.makeShapeList();
    global.game.addRectToShapeList(shapes, 600, 80, 80, 30, 80, 160, 255);
    global.game.addCircleToShapeList(shapes, 700, 80, 15, 255, 160, 60);
    global.game.addLineToShapeList(shapes, 550, 40, 760, 40, 255, 255, 255, 2);
    global.game.setDrawCallback("global.drawFrame");
    global.game.setUpdateCallback("global.updateFrame");
    global.game.run();
}