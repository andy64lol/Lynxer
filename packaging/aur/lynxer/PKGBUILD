# Maintainer: Andy <andy64lolxd@gmail.com>
pkgname=lynxer
pkgver=0.1.9b2
pkgrel=5
pkgdesc="A small, statically-flavoured C-style programming language with a standalone native runtime"
arch=('x86_64' 'aarch64')
url="https://github.com/andy64lol/Lynxer"
license=('MIT')
depends=('libffi' 'alsa-lib' 'bzip2')
makedepends=('rust' 'pkgconf' 'cmake' 'clang' 'curl' 'git' 'libglvnd' 'libx11' 'libxext'
             'libxrandr' 'libxi' 'libxinerama' 'libxcursor' 'libxxf86vm')
_commit=f3844eb3d2cfa47cf610f7c85ff479bad2a13a7f
source=("git+https://github.com/andy64lol/Lynxer.git#commit=$_commit")
sha256sums=('SKIP')

# The pinned VCS source checks out to the repository name.
_srcdir="Lynxer"

build() {
  cd "$_srcdir"
  make buildLynxer
}

package() {
  cd "$_srcdir"

  # A config text file can claim anything (0.1.9b1 once shipped inside a
  # 0.1.9b1h package). Only the interpreter's own --version is authoritative.
  version="$(./lynxer/lynxer --version)"
  if [[ "$version" != "Lynxer $pkgver" ]]; then
    error "Built Lynxer version '$version' does not match pkgver $pkgver"
    return 1
  fi

  # The project's own installer lays an interpreter out as one self-contained
  # tree ($PREFIX/lib/lynxer: binary + stdlib + config + embedding runtime and
  # headers) plus a $PREFIX/bin symlink.
  LYNXER_PREFIX="$pkgdir/usr" ./lynxer/lynxer --install

  # ...but it points the symlink at its absolute build-time path; repoint it at
  # the real installed binary.
  ln -sf /usr/lib/lynxer/lynxer "$pkgdir/usr/bin/lynxer"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
